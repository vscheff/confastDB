@using System.Globalization
@inherits InputBase<decimal?>

<input @attributes="AdditionalAttributes"
       type="text"
       class="@CssClass"
       inputmode="decimal"
       value="@CurrentValueAsString"
       @onchange="HandleChange" />

@code {
    [Parameter]
    public int DecimalPlaces { get; set; } = 2;

    private void HandleChange(ChangeEventArgs args) =>
        CurrentValueAsString = args.Value?.ToString();

    protected override string? FormatValueAsString(decimal? value) =>
        value?.ToString($"N{DecimalPlaces}", CultureInfo.InvariantCulture);

    protected override bool TryParseValueFromString(
        string? value,
        out decimal? result,
        out string validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null!;
            return true;
        }

        if (decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsedValue)
            && decimal.Round(parsedValue, DecimalPlaces) == parsedValue)
        {
            result = parsedValue;
            validationErrorMessage = null!;
            return true;
        }

        result = null;
        validationErrorMessage = DecimalPlaces == 0
            ? "Enter a whole number."
            : $"Enter a number with no more than {DecimalPlaces} decimal places.";
        return false;
    }
}
