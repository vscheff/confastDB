@inherits LayoutComponentBase
@implements IDisposable
@using System.Collections.Immutable
@using Confast.Web.Features.Navigation
@using Confast.Web.Time
@inject EffectivePermissionService NavigationPermissions
@inject AuthorizationChangeNotifications AuthorizationChanges
@inject AuthenticationStateProvider AuthenticationState
@inject IJSRuntime JS
@inject IWebHostEnvironment HostEnvironment
@inject DevelopmentDateOverrideTimeProvider DevelopmentClock
@inject NavigationManager Navigation
@inject IServiceProvider Services

@if (navigationReady)
{
    <CascadingValue Name="AuthorizationRevision" Value="authorizationRevision">
        <header class="app-header">
            <div class="header-brand-group">
                @if (homeRoute is not null)
                {
                    @if (RendererInfo.IsInteractive)
                    {
                        <button class="main-menu-toggle desktop-menu-toggle" type="button" aria-controls="application-sidebar"
                                aria-expanded="@(!compact ? "true" : "false")"
                                aria-label="@(compact ? "Expand sidebar" : "Collapse sidebar")" @onclick="() => compact = !compact">
                            <NavigationIcon Icon="NavigationIconName.Menu" />
                        </button>
                    }
                    <button class="main-menu-toggle @(RendererInfo.IsInteractive ? "drawer-menu-toggle" : null)" type="button"
                            aria-label="Open navigation" aria-haspopup="dialog" aria-controls="navigation-drawer"
                            aria-expanded="false" data-navigation-open>
                        <NavigationIcon Icon="NavigationIconName.Menu" />
                    </button>
                    <span class="header-brand-divider" aria-hidden="true"></span>
                }
                @if (signedIn && homeRoute is null)
                {
                    <span class="brand">ConFastDB</span>
                }
                else
                {
                    <a class="brand" href="@(homeRoute ?? NavigationCatalog.Home.Route)">ConFastDB</a>
                }
            </div>
            @if (HostEnvironment.IsDevelopment() && CanNavigate(Permissions.Authorization.ManageSecurity))
            {
                <form class="development-date-control" @onsubmit="SetDevelopmentDateAsync" @onsubmit:preventDefault>
                    <label for="development-date">Development date</label>
                    <input id="development-date" type="date" @bind="developmentDate" />
                    <button type="submit">Set</button>
                    @if (DevelopmentClock.HasOverride)
                    {
                        <button type="button" @onclick="UseSystemDateAsync">Use system date</button>
                    }
                </form>
                @if (developmentError is not null) { <span role="alert">@developmentError</span> }
            }
            <AuthorizeView>
                <Authorized Context="authenticationState">
                    <div class="user-menu">
                        <span>@GetDisplayName(authenticationState.User)</span>
                        <a class="header-link" href="/logout">Log out</a>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <div class="app-shell">
            @if (homeRoute is not null && RendererInfo.IsInteractive)
            {
                <aside id="application-sidebar" class="app-sidebar @(compact ? "app-sidebar-compact" : null)">
                    <ApplicationNavigation IdPrefix="sidebar" HomeRoute="@homeRoute" Groups="visibleGroups"
                                           Expanded="expandedCategories" Compact="compact" ToggleCategory="ToggleSidebarCategory"
                                           ActiveItem="activeItem" ActivePath="@activePath" />
                </aside>
            }
            <div class="app-content">
                <main class="app-main">
                    @Body
                </main>
            </div>
        </div>

        @if (homeRoute is not null)
        {
            <dialog id="navigation-drawer" class="navigation-drawer" aria-labelledby="navigation-drawer-title">
                <div class="navigation-drawer-content">
                    <div class="navigation-drawer-header">
                        <h2 id="navigation-drawer-title">Navigation</h2>
                        <form method="dialog">
                            <button type="submit" class="navigation-drawer-close" aria-label="Close navigation" autofocus>
                                <NavigationIcon Icon="NavigationIconName.Close" />
                            </button>
                        </form>
                    </div>
                    <ApplicationNavigation IdPrefix="drawer" HomeRoute="@homeRoute" Groups="visibleGroups"
                                           Expanded="expandedCategories" ToggleCategory="ToggleCategory"
                                           ActiveItem="activeItem" ActivePath="@activePath" />
                </div>
            </dialog>
        }

        @if (!IsInspectionPrintRoute)
        {
            <AuthorizeView Context="chatAuthenticationState">
                <Authorized>
                    <ChatPanel @key="chatAuthenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
                </Authorized>
            </AuthorizeView>
        }

    </CascadingValue>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly HashSet<NavigationCategoryId> expandedCategories = [];
    private ImmutableArray<NavigationGroup> visibleGroups = [];
    private NavigationItem? activeItem;
    private NavigationCategoryId? drawerCategory;
    private string activePath = "/";
    private string? homeRoute;
    private long authorizationRevision, permissionRequest;
    private bool navigationReady, signedIn, compact, disposed;
    private bool IsInspectionPrintRoute => new Uri(Navigation.Uri).AbsolutePath.Trim('/').Split('/')
        is ["inspections", _, "print"];
    private DateOnly developmentDate;
    private string? developmentError;
    private EffectivePermissionSnapshot? navigationPermissions;

    private bool CanNavigate(string key) => navigationPermissions is not null
        && PermissionCatalog.ExpandRequirements([key]).All(navigationPermissions.Has);

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += NavigationChanged;
        AuthorizationChanges.Changed += AuthorizationChanged;
        AuthenticationState.AuthenticationStateChanged += AuthenticationChanged;
        await RefreshNavigationAsync();
    }

    private async Task RefreshNavigationAsync()
    {
        var request = ++permissionRequest;
        var authenticated = (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
        EffectivePermissionSnapshot? snapshot = null;
        if (authenticated)
        {
            try { snapshot = await NavigationPermissions.EvaluateCurrentAsync(); }
            catch (AuthorizationDeniedException) { }
        }

        // Route and authorization notifications can overlap while the database is queried.
        if (disposed || request != permissionRequest) return;

        if (navigationPermissions?.Version != snapshot?.Version) authorizationRevision++;
        navigationPermissions = snapshot;
        signedIn = authenticated;
        visibleGroups = NavigationCatalog.GetVisibleGroups(snapshot);
        homeRoute = NavigationCatalog.GetHomeRoute(snapshot, visibleGroups);
        UpdateActivePage();
        navigationReady = true;
    }

    private void UpdateActivePage()
    {
        var path = NavigationCatalog.GetPath(new Uri(Navigation.Uri));
        var item = NavigationCatalog.FindActive(path, visibleGroups, homeRoute);
        if ((path != activePath || item != activeItem) && item?.Category is { } category)
            expandedCategories.Add(category);

        activePath = path;
        activeItem = item;
    }

    private void ToggleCategory(NavigationCategoryId category)
    {
        if (!expandedCategories.Add(category)) expandedCategories.Remove(category);
    }

    private void ToggleSidebarCategory(NavigationCategoryId category)
    {
        if (compact)
        {
            expandedCategories.Add(category);
            drawerCategory = category;
        }
        else
        {
            ToggleCategory(category);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (drawerCategory is not { } category) return;

        drawerCategory = null;
        try { await JS.InvokeVoidAsync("confastNavigation.openCategory", category.ToString()); }
        catch (JSDisconnectedException) { }
    }

    private async void NavigationChanged(object? sender, LocationChangedEventArgs args)
    {
        await InvokeAsync(async () =>
        {
            if (disposed) return;
            UpdateActivePage();
            StateHasChanged();
            if (RendererInfo.IsInteractive && homeRoute is not null)
            {
                try { await JS.InvokeVoidAsync("confastNavigation.closeDrawer"); }
                catch (JSDisconnectedException) { }
            }
            await RefreshNavigationAsync();
            if (!disposed) StateHasChanged();
        });
    }

    private void AuthorizationChanged()
    {
        // Marshal hints to the renderer. The committing request owns its DbContext.
        _ = InvokeAsync(async () =>
        {
            if (disposed) return;
            await RefreshNavigationAsync();
            if (!disposed) StateHasChanged();
        });
    }

    private void AuthenticationChanged(Task<AuthenticationState> state)
    {
        _ = InvokeAsync(async () =>
        {
            if (disposed) return;
            navigationPermissions = null;
            visibleGroups = [];
            homeRoute = null;
            activeItem = null;
            expandedCategories.Clear();
            compact = false;
            authorizationRevision++;
            StateHasChanged();
            await RefreshNavigationAsync();
            if (!disposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        disposed = true;
        Navigation.LocationChanged -= NavigationChanged;
        AuthorizationChanges.Changed -= AuthorizationChanged;
        AuthenticationState.AuthenticationStateChanged -= AuthenticationChanged;
    }

    protected override void OnInitialized()
    {
        developmentDate = DevelopmentClock.CurrentDate;
    }

    private async Task SetDevelopmentDateAsync()
    {
        await ChangeDevelopmentDateAsync(developmentDate);
    }

    private async Task UseSystemDateAsync()
    {
        await ChangeDevelopmentDateAsync(null);
    }

    private async Task ChangeDevelopmentDateAsync(DateOnly? date)
    {
        try
        {
            if (!HostEnvironment.IsDevelopment()) return;
            await Services.GetRequiredService<Confast.Web.Features.Identity.DevelopmentUtilities>().SetDateAsync(date);
            await ReloadCurrentPageAsync();
        }
        catch (AuthorizationDeniedException)
        {
            developmentError = "Changing the Development date is no longer authorized.";
            await RefreshNavigationAsync();
        }
    }

    private Task ReloadCurrentPageAsync()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal principal) =>
        principal.FindFirst("display_name")?.Value
        ?? principal.Identity?.Name
        ?? "Signed in";
}
