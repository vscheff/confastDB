@inherits LayoutComponentBase

<header class="app-header">
    <div class="header-brand-group">
        <AuthorizeView Context="navigationAuthenticationState">
            <Authorized>
                <details class="main-menu">
                    <summary class="main-menu-toggle" aria-label="Toggle main menu">
                        <span aria-hidden="true">☰</span>
                    </summary>
                    <nav class="main-menu-panel" aria-label="Main navigation">
                        <NavLink href="/customers" Match="NavLinkMatch.Prefix">Customers</NavLink>
                        <NavLink href="/parts" Match="NavLinkMatch.Prefix">Parts</NavLink>
                        <NavLink href="/gages" Match="NavLinkMatch.Prefix">Gages</NavLink>
                        <NavLink href="/inspections" Match="NavLinkMatch.Prefix">Inspections</NavLink>
                        <AuthorizeView Roles="@(AppRoles.Quality + "," + AppRoles.Administrator)" Context="receivedPartsAuthenticationState">
                            <NavLink href="/received-parts" Match="NavLinkMatch.Prefix">Received Parts</NavLink>
                        </AuthorizeView>
                        <NavLink href="/container-tracking" Match="NavLinkMatch.Prefix">Container Tracking</NavLink>
                        <NavLink href="/production-scheduling" Match="NavLinkMatch.Prefix">Production Scheduling</NavLink>
                        <AuthorizeView Roles="@(AppRoles.Production + "," + AppRoles.Administrator)" Context="productionTrackingAuthenticationState">
                            <NavLink href="/production-tracking" Match="NavLinkMatch.Prefix">Production Tracking</NavLink>
                        </AuthorizeView>
                        <NavLink href="/suppliers" Match="NavLinkMatch.Prefix">Suppliers</NavLink>
                        <AuthorizeView Roles="@AppRoles.Administrator" Context="administratorAuthenticationState">
                            <NavLink href="/admin/users" Match="NavLinkMatch.Prefix">Users</NavLink>
                            <NavLink href="/admin/certification-email-templates" Match="NavLinkMatch.Prefix">Email Templates</NavLink>
                            <NavLink href="/admin/nominal-tolerance" Match="NavLinkMatch.Prefix">Nominal Tolerance</NavLink>
                        </AuthorizeView>
                    </nav>
                </details>
                <span class="header-brand-divider" aria-hidden="true"></span>
            </Authorized>
        </AuthorizeView>
        <a class="brand" href="/">ConFastDB</a>
    </div>
    <AuthorizeView>
        <Authorized Context="authenticationState">
            <div class="user-menu">
                <span>@GetDisplayName(authenticationState.User)</span>
                <a class="header-link" href="/logout">Log out</a>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="app-main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal principal) =>
        principal.FindFirst("display_name")?.Value
        ?? principal.Identity?.Name
        ?? "Signed in";
}
