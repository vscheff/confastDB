@inherits LayoutComponentBase
@implements IDisposable
@inject EffectivePermissionService NavigationPermissions
@inject AuthorizationChangeNotifications AuthorizationChanges

@using Confast.Web.Time
@inject IWebHostEnvironment HostEnvironment
@inject DevelopmentDateOverrideTimeProvider DevelopmentClock
@inject NavigationManager Navigation
@inject IServiceProvider Services

<CascadingValue Name="AuthorizationRevision" Value="authorizationRevision">
<header class="app-header">
    <div class="header-brand-group">
        <AuthorizeView Context="navigationAuthenticationState">
            <Authorized>
                <details class="main-menu">
                    <summary class="main-menu-toggle" aria-label="Toggle main menu">
                        <span aria-hidden="true">☰</span>
                    </summary>
                    <nav class="main-menu-panel" aria-label="Main navigation">
                        @if (CanNavigate(Permissions.Customers.Read)) { <NavLink href="/customers" Match="NavLinkMatch.Prefix">Customers</NavLink> }
                        @if (CanNavigate(Permissions.Parts.Read)) { <NavLink href="/parts" Match="NavLinkMatch.Prefix">Parts</NavLink> }
                        @if (CanNavigate(Permissions.Gages.Read)) { <NavLink href="/gages" Match="NavLinkMatch.Prefix">Gages</NavLink> }
                        @if (CanNavigate(Permissions.Inspections.Read)) { <NavLink href="/inspections" Match="NavLinkMatch.Prefix">Inspections</NavLink> }
                        @if (CanNavigate(Permissions.Receiving.Read)) { <NavLink href="/received-parts" Match="NavLinkMatch.Prefix">Received Parts</NavLink> }
                        @if (CanNavigate(Permissions.Shipments.Read)) { <NavLink href="/container-tracking" Match="NavLinkMatch.Prefix">Container Tracking</NavLink> }
                        @if (CanNavigate(Permissions.ProductionSchedules.Read)) { <NavLink href="/production-scheduling" Match="NavLinkMatch.Prefix">Production Scheduling</NavLink> }
                        @if (CanNavigate(Permissions.ProductionLogs.Read)) { <NavLink href="/production-tracking" Match="NavLinkMatch.Prefix">Production Tracking</NavLink> }
                        @if (CanNavigate(Permissions.ProductionReports.Read)) { <NavLink href="/morning-production-review">Production Review</NavLink> }
                        @if (PermissionPolicies.ProductionConfigurationReadKeys.Any(CanNavigate)) { <NavLink href="/production-scheduling/settings">Scheduling Settings</NavLink> }
                        @if (CanNavigate(Permissions.SortLogDowntimeCauses.Read)) { <NavLink href="/production-tracking/settings">Sort Log Downtime Causes</NavLink> }
                        @if (CanNavigate(Permissions.Suppliers.Read)) { <NavLink href="/suppliers" Match="NavLinkMatch.Prefix">Suppliers</NavLink> }
                        @if (CanNavigate(Permissions.Users.Read)) { <NavLink href="/admin/users" Match="NavLinkMatch.Prefix">Users</NavLink> }
                        @if (CanNavigate(Permissions.Roles.Read)) { <NavLink href="/admin/roles" Match="NavLinkMatch.Prefix">Roles</NavLink> }
                        @if (CanNavigate(Permissions.CertificationEmailTemplates.Read)) { <NavLink href="/admin/certification-email-templates" Match="NavLinkMatch.Prefix">Email Templates</NavLink> }
                        @if (CanNavigate(Permissions.CertificationEmailSettings.Read)) { <NavLink href="/admin/certification-email-settings" Match="NavLinkMatch.Prefix">Email Settings</NavLink> }
                        @if (CanNavigate(Permissions.NominalToleranceSettings.Read)) { <NavLink href="/admin/nominal-tolerance" Match="NavLinkMatch.Prefix">Nominal Tolerance</NavLink> }
                        @if (!CanNavigate(Permissions.Gages.Read) && CanNavigate(Permissions.GageTypes.Read)) { <NavLink href="/gage-types">Gage Types</NavLink> }

                    </nav>
                </details>
                <span class="header-brand-divider" aria-hidden="true"></span>
            </Authorized>
        </AuthorizeView>
        <a class="brand" href="/">ConFastDB</a>
    </div>
    @if (HostEnvironment.IsDevelopment() && CanNavigate(Permissions.Authorization.ManageSecurity))
    {
        <form class="development-date-control" @onsubmit="SetDevelopmentDateAsync" @onsubmit:preventDefault>
            <label for="development-date">Development date</label>
            <input id="development-date" type="date" @bind="developmentDate" />
            <button type="submit">Set</button>
            @if (DevelopmentClock.HasOverride)
            {
                <button type="button" @onclick="UseSystemDateAsync">Use system date</button>
            }
        </form>
        @if (developmentError is not null) { <span role="alert">@developmentError</span> }
    }
    <AuthorizeView>
        <Authorized Context="authenticationState">
            <div class="user-menu">
                <span>@GetDisplayName(authenticationState.User)</span>
                <a class="header-link" href="/logout">Log out</a>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="app-main">
    @Body
</main>

@if (!IsInspectionPrintRoute)
{
    <AuthorizeView Context="chatAuthenticationState">
        <Authorized>
            <ChatPanel @key="chatAuthenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
        </Authorized>
    </AuthorizeView>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

</CascadingValue>
@code {
    private long authorizationRevision;
    private bool refreshQueued, disposed;
    private bool IsInspectionPrintRoute => new Uri(Navigation.Uri).AbsolutePath.Trim('/').Split('/')
        is ["inspections", _, "print"];
    private DateOnly developmentDate;
    private string? developmentError;
    private EffectivePermissionSnapshot? navigationPermissions;
    private bool CanNavigate(string key) => navigationPermissions is not null && PermissionCatalog.ExpandRequirements([key]).All(navigationPermissions.Has);
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += NavigationChanged;
        AuthorizationChanges.Changed += AuthorizationChanged;
        await RefreshNavigationAsync();
    }
    private async Task RefreshNavigationAsync()
    {
        try { navigationPermissions = await NavigationPermissions.EvaluateCurrentAsync(); }
        catch (AuthorizationDeniedException) { navigationPermissions = null; }
    }
    private async void NavigationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        await InvokeAsync(async () => { await RefreshNavigationAsync(); StateHasChanged(); });
    }
    private void AuthorizationChanged()
    {
        // Marshal and coalesce hints on the renderer. Never run a subscriber on the committing request's DbContext.
        _ = InvokeAsync(async () =>
        {
            if (disposed || refreshQueued) return;
            refreshQueued = true;
            try { await RefreshNavigationAsync(); authorizationRevision++; StateHasChanged(); }
            finally { refreshQueued = false; }
        });
    }
    public void Dispose()
    {
        disposed = true;
        Navigation.LocationChanged -= NavigationChanged;
        AuthorizationChanges.Changed -= AuthorizationChanged;
    }


    protected override void OnInitialized()
    {
        developmentDate = DevelopmentClock.CurrentDate;
    }

    private async Task SetDevelopmentDateAsync()
    {
        await ChangeDevelopmentDateAsync(developmentDate);
    }

    private async Task UseSystemDateAsync()
    {
        await ChangeDevelopmentDateAsync(null);
    }

    private async Task ChangeDevelopmentDateAsync(DateOnly? date)
    {
        try
        {
            if (!HostEnvironment.IsDevelopment()) return;
            await Services.GetRequiredService<Confast.Web.Features.Identity.DevelopmentUtilities>().SetDateAsync(date);
            await ReloadCurrentPageAsync();
        }
        catch (AuthorizationDeniedException)
        {
            developmentError = "Changing the Development date is no longer authorized.";
            await RefreshNavigationAsync();
        }
    }

    private Task ReloadCurrentPageAsync()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal principal) =>
        principal.FindFirst("display_name")?.Value
        ?? principal.Identity?.Name
        ?? "Signed in";
}
