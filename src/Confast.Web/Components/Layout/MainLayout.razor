@inherits LayoutComponentBase

<header class="app-header">
    <a class="brand" href="/">Confast</a>
    <nav aria-label="Main navigation">
        <NavLink href="/customers" Match="NavLinkMatch.Prefix">Customers</NavLink>
        <NavLink href="/parts" Match="NavLinkMatch.Prefix">Parts</NavLink>
        <NavLink href="/gages" Match="NavLinkMatch.Prefix">Gages</NavLink>
        <NavLink href="/inspections" Match="NavLinkMatch.Prefix">Inspections</NavLink>
    </nav>
</header>

<main class="app-main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
