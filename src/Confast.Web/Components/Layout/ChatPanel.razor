        if (!messageTimesNeedFormatting) return;

        try
        {
            if (messageTimesNeedFormatting && thread is not null)
            {
                messageTimesNeedFormatting = false;
                var utcValues = thread.Messages.Select(x => x.SentAtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)).ToArray();
                var formatted = await JS.InvokeAsync<string[]>("confastChatTime.formatMessageTimes", new object?[] { utcValues });
                localMessageTimes = thread.Messages.Select((message, index) => (message.Id, formatted[index]))
                    .ToDictionary(x => x.Id, x => x.Item2);
                var formattedDates = await JS.InvokeAsync<string[][]>("confastChatTime.formatMessageDates", new object?[] { utcValues });
                localMessageDates = thread.Messages.Select((message, index) => (message.Id, Date: (Key: formattedDates[index][0], Label: formattedDates[index][1], HoverTime: formattedDates[index][2])))
                    .ToDictionary(x => x.Id, x => x.Date);
                var pinnedUtcValues = thread.PinnedMessages.Select(x => x.SentAtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)).ToArray();
                var pinnedFormatted = await JS.InvokeAsync<string[]>("confastChatTime.formatMessageTimes", new object?[] { pinnedUtcValues });
                localPinnedMessageTimes = thread.PinnedMessages.Select((message, index) => (message.Id, pinnedFormatted[index]))
                    .ToDictionary(x => x.Id, x => x.Item2);
            }
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            messageTimesNeedFormatting = thread is not null;
        }
    }

