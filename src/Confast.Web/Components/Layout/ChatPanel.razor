    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusNewGroupNameAfterRender)
        {
            focusNewGroupNameAfterRender = false;
            try { await newGroupNameInput.FocusAsync(); }
            catch (JSDisconnectedException) { focusNewGroupNameAfterRender = true; return; }
            catch (JSException ex) { Logger.LogWarning(ex, "Could not focus the new folder name field."); }
        }

        if (restoreThreadScrollAfterRender)
        {
            restoreThreadScrollAfterRender = false;
            try
            {
                await JS.InvokeVoidAsync("confastChatTime.restoreConversationScrollPosition");
            }
            catch (JSDisconnectedException)
            {
                restoreThreadScrollAfterRender = true;
                return;
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Could not restore the chat history scroll position.");
            }
        }

        if (scrollToLatestAfterRender)
        {
            scrollToLatestAfterRender = false;
            try
            {
                await JS.InvokeVoidAsync("confastChatTime.scrollToLatestMessage");
            }
            catch (JSDisconnectedException)
            {
                scrollToLatestAfterRender = true;
                return;
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Could not scroll chat history to the latest message.");
            }
        }

        if (NewMessageId is not null)
        {
            try { await JS.InvokeVoidAsync("confastChatTime.updateNewMessageJump"); }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex) { Logger.LogWarning(ex, "Could not update the new-message jump control."); }
        }

        if (isOpen && selectedId is not null)
            await MarkCurrentConversationReadAsync();

        if (isOpen && view == ChatView.Channels && !channelDragAttached)
        {
            channelDragReference ??= DotNetObjectReference.Create(this);
            try { channelDragAttached = await JS.InvokeAsync<bool>("confastChatTime.attachChannelDragAndDrop", channelDragReference); }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex) { Logger.LogWarning(ex, "Could not enable channel drag and drop."); }
        }

        if (isOpen && selectedId is not null && !composeKeyHandlerAttached)
        {
            try
            {
                composeKeyHandlerAttached = await JS.InvokeAsync<bool>("confastChatTime.enableEnterToSend");
            }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Could not enable Enter-to-send for the chat compose box.");
                return;
            }
        }

        if (isOpen && reactionPickerMessageId is not null)
        {
            try { await JS.InvokeVoidAsync("confastChatTime.positionReactionPicker"); }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex) { Logger.LogWarning(ex, "Could not position the chat reaction picker."); }
            if (!reactionPickerOutsideClickAttached)
            {
                reactionPickerReference ??= DotNetObjectReference.Create(this);
                try
                {
                    await JS.InvokeVoidAsync("confastChatTime.watchReactionPickerOutsideClick", reactionPickerReference);
                    reactionPickerOutsideClickAttached = true;
                }
                catch (JSDisconnectedException) { return; }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not watch for clicks outside the chat reaction picker."); }
            }
        }
        else if (reactionPickerOutsideClickAttached)
        {
            try { await JS.InvokeVoidAsync("confastChatTime.stopWatchingReactionPickerOutsideClick"); }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex) { Logger.LogWarning(ex, "Could not stop watching the chat reaction picker."); }
            reactionPickerOutsideClickAttached = false;
        }

        if (isOpen && tonePickerMessageId is not null)
        {
            try { await JS.InvokeVoidAsync("confastChatTime.positionTonePicker", tonePickerMessageId, tonePickerDefaultEmoji, tonePickerSource == 'a' ? "actions" : "grid"); }
            catch (JSDisconnectedException) { return; }
            catch (JSException ex) { Logger.LogWarning(ex, "Could not position the chat skin tone picker."); }
            if (focusTonePickerAfterRender)
            {
                focusTonePickerAfterRender = false;
                try { await JS.InvokeVoidAsync("confastChatTime.focusTonePicker"); }
                catch (JSDisconnectedException) { return; }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not focus the chat skin tone picker."); }
            }
        }

        if (!activityDatesNeedFormatting && !messageTimesNeedFormatting) return;

        try
        {
            if (activityDatesNeedFormatting)
            {
                activityDatesNeedFormatting = false;
                var utcValues = conversations.Select(x => x.ActivityAtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)).ToArray();
                var formatted = await JS.InvokeAsync<string[]>("confastChatTime.formatActivityDates", new object?[] { utcValues });
                localActivityDates = conversations.Select((row, index) => (row.Id, formatted[index]))
                    .ToDictionary(x => x.Id, x => x.Item2);
            }
            if (messageTimesNeedFormatting && thread is not null)
            {
                messageTimesNeedFormatting = false;
                var utcValues = thread.Messages.Select(x => x.SentAtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)).ToArray();
                var formatted = await JS.InvokeAsync<string[]>("confastChatTime.formatMessageTimes", new object?[] { utcValues });
                localMessageTimes = thread.Messages.Select((message, index) => (message.Id, formatted[index]))
                    .ToDictionary(x => x.Id, x => x.Item2);
            }
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            activityDatesNeedFormatting = true;
            messageTimesNeedFormatting = thread is not null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await EnsureCurrentUserContextAsync();
            await RefreshAsync();
            _ = RefreshUnreadCountPeriodicallyAsync();
        }
        catch (UnauthorizedAccessException) { }
    }

    private async Task EnsureCurrentUserContextAsync()
    {
        var resolvedUserId = await Chat.GetCurrentUserIdAsync();
        if (currentUserId == resolvedUserId) return;

        subscription?.Dispose();
        currentUserId = resolvedUserId;
        tonePreferences = (await Chat.GetEmojiTonePreferencesAsync()).ToDictionary();
        lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
        subscription = Notifications.Subscribe(resolvedUserId, () => _ = InvokeAsync(RefreshFromNotificationAsync));
        selectedId = null;
        thread = null;
        pendingNewMessageIds.Clear();
        channelGroups = [];
        conversations = [];
        unreadTotal = 0;
        conversationRefreshVersion++;
    }

    private async Task RefreshFromNotificationAsync()
    {
        if (disposed) return;
        try
        {
            await RefreshAsync();
            lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
            if (isOpen && selectedId is long id)
            {
                var previousMessageId = thread?.Conversation.Id == id
                    ? thread.Messages.LastOrDefault()?.Id ?? 0
                    : 0;
                var wasNearBottom = false;
                try { wasNearBottom = await JS.InvokeAsync<bool>("confastChatTime.isNearLatestMessage"); }
                catch (JSDisconnectedException) { return; }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not read the chat scroll position."); }

                if (selectedId == id) await LoadThreadAsync(id);
                if (selectedId == id && thread?.Conversation.Id == id &&
                    thread.Messages.LastOrDefault()?.Id is long latestMessageId && latestMessageId > previousMessageId)
                {
                    if (wasNearBottom)
                    {
                        pendingNewMessageIds.Remove(id);
                        scrollToLatestAfterRender = true;
                    }
                    else pendingNewMessageIds[id] = latestMessageId;
                }
            }
            StateHasChanged();
        }
        catch (UnauthorizedAccessException)
        {
            selectedId = null;
            thread = null;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        await EnsureCurrentUserContextAsync();
        var version = ++conversationRefreshVersion;
        var userId = currentUserId;
        var refreshedConversations = await Chat.GetConversationsAsync();
        var refreshedGroups = await Chat.GetChannelGroupsAsync();
        if (disposed || version != conversationRefreshVersion || userId != currentUserId) return;

        conversations = refreshedConversations;
        channelGroups = refreshedGroups;
        unreadTotal = conversations.Sum(x => x.UnreadCount);
        activityDatesNeedFormatting = true;
    }

    private async Task RefreshUnreadCountPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshLifetime.Token))
            {
                if (disposed) continue;
                await InvokeAsync(async () =>
                {
                    if (disposed) return;
                    if (isOpen)
                        await RefreshAsync();
                    else
                    {
                        await EnsureCurrentUserContextAsync();
                        var version = ++conversationRefreshVersion;
                        var userId = currentUserId;
                        var total = await Chat.GetTotalUnreadCountAsync(refreshLifetime.Token);
                        if (version == conversationRefreshVersion && userId == currentUserId) unreadTotal = total;
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (refreshLifetime.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (disposed) { }
    }

    private async Task TogglePanel()
    {
        if (isOpen)
