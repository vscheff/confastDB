                <h2 id="chat-delete-title">Delete message?</h2>
                <p id="chat-delete-description">This message will disappear from the conversation.</p>
                <div class="chat-delete-actions">
                    <button type="button" class="button button-secondary" @onclick="CancelDeleteMessage">Cancel</button>
                    <button type="button" class="button button-danger" @ref="confirmDeleteButton" @onclick="ConfirmDeleteMessageAsync">Delete</button>
                </div>
            </section>
        </div>
