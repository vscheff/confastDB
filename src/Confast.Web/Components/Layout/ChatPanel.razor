                    <button type="button" class="button button-secondary" @onclick="CancelPinMessage">Cancel</button>
                    <button type="button" class="button button-primary" @ref="confirmPinButton" @onclick="ConfirmPinMessageAsync">@(pendingPinValue ? "Pin" : "Unpin")</button>
                </div>
            </section>
        </div>
