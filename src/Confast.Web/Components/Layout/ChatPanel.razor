            var updated = await JS.InvokeAsync<string?>("confastChatTime.insertMention", mentionStart, tag);
            if (updated is null) return;
            draftInputVersion++;
            draft = updated;
            mentionMenuOpen = false;
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Logger.LogWarning(ex, "Could not insert the chat mention."); }
    }

