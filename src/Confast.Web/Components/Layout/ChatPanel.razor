@using Confast.Web.Features.Chat
@using Confast.Web.Features.Identity
@inject ChatService Chat
@inject UserProfilePictureService ProfilePictures
@inject UserPresenceService Presence
@inject ChatNotifications Notifications
@inject IJSRuntime JS
@inject ILogger<ChatPanel> Logger
@implements IAsyncDisposable

<button class="chat-launcher" type="button" @onclick="TogglePanel" aria-label="Open chat" aria-expanded="@isOpen">
    <span aria-hidden="true">✉</span> Chat
    @if (currentUserId is not null)
    {
        <span class="chat-presence-dot @PresenceClass(currentUserId)" title="@PresenceDescription(currentUserId)"></span>
    }
    @if (unreadTotal > 0)
    {
        <span class="chat-launcher-count @(hasUnreadAlert ? "attention" : "")">@(unreadTotal > 99 ? "99+" : unreadTotal.ToString())</span>
    }
</button>

@if (isOpen)
{
    <section class="chat-panel" aria-label="Chat">
        <svg class="chat-emoji-icon-definitions" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
            <symbol id="chat-emoji-icon-smile" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 10h.01M16 10h.01M8 15c1 1.3 2.3 2 4 2s3-.7 4-2" /></symbol>
            <symbol id="chat-emoji-icon-people" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3" /><path d="M4.5 20c.5-4.2 3-6.5 7.5-6.5s7 2.3 7.5 6.5" /></symbol>
            <symbol id="chat-emoji-icon-nature" viewBox="0 0 24 24"><path d="M20 4C10 4 4 8 4 15a5 5 0 0 0 5 5c7 0 11-6 11-16ZM5 19c2-4 6-7 12-10" /></symbol>
            <symbol id="chat-emoji-icon-food" viewBox="0 0 24 24"><path d="M3 11h18c0 5-3.5 8-9 8s-9-3-9-8ZM7 21h10M9 3c-2 2 2 3 0 5M15 3c-2 2 2 3 0 5" /></symbol>
            <symbol id="chat-emoji-icon-travel" viewBox="0 0 24 24"><circle cx="5" cy="17" r="3" /><circle cx="19" cy="17" r="3" /><path d="m5 17 4-8 4 8h6l-4-8H9m4 8 3-5M13 6h3" /></symbol>
            <symbol id="chat-emoji-icon-activities" viewBox="0 0 24 24"><path d="M7 8h10c2 0 3.2 1.1 3.6 3l1 5c.4 2-1.4 3-2.8 2L16 16H8l-2.8 2c-1.4 1-3.2 0-2.8-2l1-5C3.8 9.1 5 8 7 8ZM7 12v4m-2-2h4M16 12h.01M19 14h.01" /></symbol>
            <symbol id="chat-emoji-icon-objects" viewBox="0 0 24 24"><path d="M8 3h8l3 8H5l3-8ZM12 11v8M7 21h10" /></symbol>
            <symbol id="chat-emoji-icon-symbols" viewBox="0 0 24 24"><path d="M12 20s-9-5.6-9-11a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 5.4-9 11-9 11Z" /></symbol>
            <symbol id="chat-emoji-icon-flags" viewBox="0 0 24 24"><path d="M5 22V3m0 1c3-2 5 2 8 0s5 0 6 0v11c-3-2-5 2-8 0s-4-1-6 0" /></symbol>
        </svg>
        <header class="chat-panel-header">
            <div class="chat-panel-heading">
                <button type="button" class="chat-sidebar-toggle" aria-label="@(sidebarCollapsed ? "Show conversations" : "Hide conversations")"
                        title="@(sidebarCollapsed ? "Show conversations" : "Hide conversations")" aria-controls="chat-conversation-sidebar"
                        aria-expanded="@(!sidebarCollapsed)" @onclick="ToggleSidebar">☰</button>
                <strong>Messages</strong>
            </div>
            <button type="button" class="chat-icon-button" @onclick="ClosePanel" aria-label="Close chat">×</button>
        </header>
        @if (error is not null)
        {
            <p class="chat-error" role="alert">@error</p>
        }
        <div class="chat-panel-body @(selectedId is not null ? "chat-has-thread" : "") @(sidebarCollapsed ? "chat-sidebar-collapsed" : "")">
            <aside id="chat-conversation-sidebar" class="chat-sidebar">
                <div class="chat-sidebar-scroll">
                <div class="chat-tabs" aria-label="Chat views">
                    <button type="button" class="@(view is ChatView.Conversations or ChatView.NewDirect ? "active" : "")" @onclick="() => ChangeView(ChatView.Conversations)">
                        Conversations
                        @if (unreadConversations > 0)
                        {
                            <span class="chat-tab-count attention" aria-label="@unreadConversations unread messages">@(unreadConversations > 99 ? "99+" : unreadConversations.ToString())</span>
                        }
                    </button>
                    <button type="button" class="@(view is ChatView.Channels or ChatView.NewChannel ? "active" : "")" @onclick="() => ChangeView(ChatView.Channels)">
                        Channels
                        @if (unreadChannels > 0)
                        {
                            <span class="chat-tab-count @(conversations.Any(x => x.Kind == ConversationKind.Channel && x.HasUnreadMention) ? "attention" : "")" aria-label="@unreadChannels unread messages">@(unreadChannels > 99 ? "99+" : unreadChannels.ToString())</span>
                        }
                    </button>
                </div>
                @if (view == ChatView.Conversations)
                {
                    <div class="chat-create-actions">
                        <button class="button button-secondary" type="button" @onclick="() => ChangeView(ChatView.NewDirect)">New Message</button>
                    </div>
                    @if (!conversations.Any(x => x.Kind == ConversationKind.Direct))
                    {
                        <p class="chat-empty">No direct messages yet.</p>
                    }
                    @foreach (var row in conversations.Where(x => x.Kind == ConversationKind.Direct))
                    {
                        <button @key="row.Id" type="button" class="chat-conversation chat-direct-conversation @(selectedId == row.Id ? "selected" : "")" @onclick="() => OpenThreadAsync(row.Id)">
                            <span class="chat-avatar" aria-hidden="true">
                                @if (PictureUrl(row.OtherUserId) is { } pictureUrl) { <img src="@pictureUrl" alt="" /> }
                                else { @Initials(row.Name) }
                            </span>
                            <span class="chat-conversation-top"><strong><span class="chat-presence-dot @PresenceClass(row.OtherUserId)" title="@PresenceDescription(row.OtherUserId)"></span> @row.Name</strong><span class="chat-conversation-meta"><time>@GetActivityDate(row)</time>@if (row.UnreadCount > 0) { <b class="chat-unread-count attention">@row.UnreadCount</b> }</span></span>
                            @if (PresenceOf(row.OtherUserId) is { } contact && (contact.StatusEmoji is not null || contact.StatusMessage is not null))
                            {
                                <span class="chat-user-status">@contact.StatusEmoji @contact.StatusMessage</span>
                            }
                        </button>
                    }
                }
                else if (view == ChatView.Channels)
                {
                    <div class="chat-create-actions">
                        <button class="button button-secondary" type="button" @onclick="() => StartNewChannel(null)">New Channel</button>
                        <button class="button button-secondary" type="button" aria-expanded="@addingFolder" @onclick="StartAddingFolder">Add folder</button>
                    </div>
                    @if (!conversations.Any(x => x.Kind == ConversationKind.Channel) && channelGroups.Count == 0) { <p class="chat-empty">No channels yet.</p> }
                    <div class="chat-layout-root-drop" data-chat-root-drop="" aria-hidden="true"></div>
                    @foreach (var item in ChannelLayout())
                    {
                        @if (item.Group is { } group)
                        {
                            <div @key="(nameof(ChatChannelGroup), group.Id)" class="chat-folder-row chat-layout-row"
                                 data-chat-item-kind="folder" data-chat-drag-kind="@(group.CanManage ? "folder" : null)" data-chat-drag-id="@group.Id"
                                 data-chat-parent="@group.ParentGroupId" data-chat-depth="@item.Depth"
                                 style="@($"--chat-depth:{item.Depth}")" title="@(group.CanManage ? "Drag to move folder" : null)">
                                <div class="chat-group-heading">
                                    <span class="chat-folder-label">
                                        <strong>@group.Name</strong>
                                        <button type="button" class="chat-folder-chevron" aria-label="@(collapsedFolderIds.Contains(group.Id) ? "Expand" : "Collapse") folder @group.Name"
                                                aria-expanded="@(collapsedFolderIds.Contains(group.Id) ? "false" : "true")" @onclick="() => ToggleFolderCollapsed(group.Id)">
                                            @if (collapsedFolderIds.Contains(group.Id))
                                            {
                                                <svg aria-hidden="true" viewBox="0 0 16 16"><path d="m6 3 5 5-5 5" /></svg>
                                            }
                                            else
                                            {
                                                <svg aria-hidden="true" viewBox="0 0 16 16"><path d="m3 6 5 5 5-5" /></svg>
                                            }
                                        </button>
                                    </span>
                                    <button type="button" class="chat-folder-add" aria-label="Add channel to @group.Name" @onclick="() => StartNewChannel(group.Id)">＋</button>
                                </div>
                            </div>
                        }
                        else if (item.Channel is { } row)
                        {
                            <div @key="(nameof(Conversation), row.Id)" class="chat-channel-row chat-layout-row"
                                 data-chat-item-kind="channel" data-chat-drag-kind="@(item.Pinned ? null : "channel")" data-chat-drag-id="@row.Id"
                                 data-chat-drop-disabled="@(item.Pinned ? "true" : null)"
                                 data-chat-parent="@item.ParentGroupId" data-chat-depth="@item.Depth"
                                 style="@($"--chat-depth:{item.Depth}")" title="@(item.Pinned ? null : "Drag to reorder channel")">
                                <button type="button" class="chat-conversation @(selectedId == row.Id ? "selected" : "")" @onclick="() => OpenThreadAsync(row.Id)">
                                    <span class="chat-conversation-top"><strong># @row.Name</strong><span class="chat-conversation-meta"><time>@GetActivityDate(row)</time>@if (row.UnreadCount > 0) { <b class="chat-unread-count @(row.HasUnreadMention ? "attention" : "")">@row.UnreadCount</b> }</span></span>
                                </button>
                                <button type="button" class="chat-channel-action-toggle" data-chat-settings-toggle="@row.Id" aria-label="Settings for @row.Name" aria-haspopup="dialog" aria-controls="chat-channel-settings-@row.Id" aria-expanded="@(channelActionsId == row.Id ? "true" : "false")" @onclick="() => ToggleChannelActionsAsync(row)">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10.1 2.8h3.8l.5 2.2c.6.2 1.2.4 1.7.7l2-1.2 2.7 2.7-1.2 2c.3.5.5 1.1.7 1.7l2.2.5v3.8l-2.2.5c-.2.6-.4 1.2-.7 1.7l1.2 2-2.7 2.7-2-1.2c-.5.3-1.1.5-1.7.7l-.5 2.2h-3.8l-.5-2.2c-.6-.2-1.2-.4-1.7-.7l-2 1.2-2.7-2.7 1.2-2c-.3-.5-.5-1.1-.7-1.7l-2.2-.5v-3.8l2.2-.5c.2-.6.4-1.2.7-1.7l-1.2-2 2.7-2.7 2 1.2c.5-.3 1.1-.5 1.7-.7l.5-2.2Z"/><circle cx="12" cy="12" r="3.2"/></svg>
                                </button>
                                @if (channelActionsId == row.Id)
                                {
                                    <div id="chat-channel-settings-@row.Id" class="chat-channel-settings" role="dialog" aria-label="Settings for @row.Name">
                                        @if (row.IsOwner || currentUserIsAdministrator)
                                        {
                                            <form @onsubmit="() => RenameChannelAsync(row.Id)" @onsubmit:preventDefault>
                                                <label for="chat-rename-channel-@row.Id">Channel name</label>
                                                <div class="chat-channel-settings-entry">
                                                    <input id="chat-rename-channel-@row.Id" maxlength="120" @bind="channelRenameDraft" @bind:event="oninput" />
                                                    <button type="submit" disabled="@string.IsNullOrWhiteSpace(channelRenameDraft)">Save</button>
                                                </div>
                                            </form>
                                        }
                                        @if (row.Visibility == ChannelVisibility.Private)
                                        {
                                            <div class="chat-channel-settings-members">
                                                <strong>Members</strong>
                                                @foreach (var member in channelSettingsMembers)
                                                {
                                                    <div class="chat-channel-settings-member">
                                                        <span>@member.Name</span>
                                                        @if (row.IsOwner && member.Id != currentUserId)
                                                        {
                                                            <button type="button" aria-label="Remove @member.Name from @row.Name" @onclick="() => RemoveChannelSettingsMemberAsync(row.Id, member.Id)">Remove</button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            @if (row.IsOwner)
                                            {
                                                <div class="chat-channel-settings-add">
                                                    <label for="chat-settings-add-member-@row.Id">Add user</label>
                                                    <div class="chat-channel-settings-entry">
                                                        <select id="chat-settings-add-member-@row.Id" @bind="channelSettingsAddMemberId">
                                                            <option value="">Select a user</option>
                                                            @foreach (var user in users.Where(x => channelSettingsMembers.All(member => member.Id != x.Id)))
                                                            {
                                                                <option value="@user.Id">@user.Name</option>
                                                            }
                                                        </select>
                                                        <button type="button" disabled="@string.IsNullOrEmpty(channelSettingsAddMemberId)" @onclick="() => AddChannelSettingsMemberAsync(row.Id)">Add</button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p>All active users belong to public channels.</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    @if (addingFolder)
                    {
                        <section class="chat-channel-group chat-folder-draft">
                            <form class="chat-group-create" @onsubmit="CreateGroupAsync" @onsubmit:preventDefault @onkeydown="HandleNewFolderKeyDown">
                                <label class="sr-only" for="chat-new-group-name">Folder name</label>
                                <input id="chat-new-group-name" @ref="newGroupNameInput" maxlength="120" placeholder="Folder name" @bind="newGroupName" @bind:event="oninput" />
                                <button type="submit" class="button button-secondary" disabled="@string.IsNullOrWhiteSpace(newGroupName)">Save</button>
                                <button type="button" class="button button-secondary" @onclick="CancelAddingFolder">Cancel</button>
                            </form>
                        </section>
                    }
                }
                else if (view == ChatView.NewDirect)
                {
                    <h3>New Message</h3>
                    <label for="chat-direct-user">User</label>
                    <select id="chat-direct-user" @bind="directUserId">
                        <option value="">Select a user</option>
                        @foreach (var user in users) { <option value="@user.Id">@user.Name — @PresenceLabel(PresenceOf(user.Id)?.State ?? UserPresenceState.Offline) @PresenceOf(user.Id)?.StatusEmoji @PresenceOf(user.Id)?.StatusMessage</option> }
                    </select>
                    <div class="chat-form-actions">
                        <button type="button" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(directUserId)" @onclick="StartDirectAsync">Open Conversation</button>
                        <button type="button" class="button button-secondary" @onclick="CancelNewDirect">Cancel</button>
                    </div>
                }
                else if (view == ChatView.NewChannel)
                {
                    <h3>New Channel</h3>
                    @if (newChannelGroupId is long destinationId)
                    {
                        <p class="chat-channel-destination">In @(channelGroups.FirstOrDefault(x => x.Id == destinationId)?.Name ?? "folder")</p>
                    }
                    <label for="chat-channel-name">Name</label>
                    <input id="chat-channel-name" maxlength="120" @bind="channelName" @bind:event="oninput" />
                    <label for="chat-channel-visibility">Visibility</label>
                    <select id="chat-channel-visibility" @bind="channelVisibility">
                        <option value="@ChannelVisibility.Public">Public</option>
                        <option value="@ChannelVisibility.Private">Private</option>
                    </select>
                    @if (channelVisibility == ChannelVisibility.Private)
                    {
                        <fieldset class="chat-member-choices">
                            <legend>Initial Members</legend>
                            @foreach (var user in users)
                            {
                                <label><input type="checkbox" checked="@initialMembers.Contains(user.Id)" @onchange="e => ToggleInitialMember(user.Id, e.Value is true)" /> @user.Name</label>
                            }
                        </fieldset>
                    }
                    else { <p>All active users are added to public channels.</p> }
                    <div class="chat-form-actions">
                        <button type="button" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(channelName)" @onclick="CreateChannelAsync">Create Channel</button>
                        <button type="button" class="button button-secondary" @onclick="CancelNewChannel">Cancel</button>
                    </div>
                }
                </div>
                @if (showPresenceEditor)
                {
                    <section class="chat-presence-editor" aria-label="Profile and status">
                        <div class="chat-picture-editor">
                            <div class="chat-picture-avatar">
                                <span class="chat-avatar" aria-hidden="true">
                                    @if (PictureUrl(currentUserId) is { } myPictureUrl) { <img src="@myPictureUrl" alt="" /> }
                                    else { @Initials(currentUserDisplayName ?? "Me") }
                                </span>
                                <InputFile id="chat-profile-picture-input" class="chat-profile-picture-input" aria-label="Upload profile picture" OnChange="UploadProfilePictureAsync" accept="image/png,image/jpeg,image/gif,image/webp" />
                                <label for="chat-profile-picture-input" class="chat-avatar-edit" title="Change profile picture" aria-label="Change profile picture">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m14.5 5.5 4 4M4 20l4.5-1 11-11a2.12 2.12 0 0 0-3-3l-11 11L4 20Z" /></svg>
                                </label>
                            </div>
                            <strong class="chat-picture-name">@(currentUserDisplayName ?? "My profile")</strong>
                        </div>
                        <div class="chat-presence-setting">
                            <div class="chat-presence-control" @onmouseenter="ShowPresencePicker" @onmouseleave="HidePresencePicker"
                                 @onfocusin="ShowPresencePicker" @onkeydown="HandlePresencePickerKeyDown">
                                <button type="button" class="chat-presence-current" aria-haspopup="true" aria-expanded="@showPresencePicker"
                                        title="@(ProfileCustomStatus is { } customStatus ? customStatus : "Change presence")"
                                        @onclick="ShowPresencePicker">
                                    <span class="chat-presence-dot @PresenceClass(currentUserId)"></span>
                                    @PresenceLabel(CurrentPresenceState)
                                    <span aria-hidden="true">›</span>
                                </button>
                                @if (showPresencePicker)
                                {
                                    <div class="chat-presence-menu" role="menu" aria-label="Set presence">
                                        @foreach (var choice in Enum.GetValues<UserPresencePreference>())
                                        {
                                            <button type="button" role="menuitemradio" aria-checked="@(CurrentPresencePreference == choice)"
                                                    class="@(CurrentPresencePreference == choice ? "selected" : "")"
                                                    @onclick="() => SelectPresenceAsync(choice)">
                                                <span class="chat-presence-dot @PresenceChoiceClass(choice)"></span>
                                                @PresenceLabel(choice)
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            @if (ProfileCustomStatus is { } profileStatus)
                            {
                                <span class="chat-editor-custom-status">@profileStatus</span>
                            }
                        </div>
                        <div class="chat-status-edit-row">
                            <button type="button" class="chat-status-emoji-button" aria-label="Choose status emoji" aria-expanded="@showStatusEmojiPicker" @onclick="() => showStatusEmojiPicker = !showStatusEmojiPicker">@(statusEmojiDraft ?? "＋")</button>
                            <input aria-label="Status message" maxlength="140" placeholder="Set a status message" @bind="statusMessageDraft" @bind:event="oninput" />
                            <button type="button" class="button button-primary" @onclick="SaveCustomStatusAsync">Save</button>
                            <button type="button" class="button button-secondary" @onclick="ClearCustomStatusAsync" disabled="@(statusEmojiDraft is null && string.IsNullOrWhiteSpace(statusMessageDraft))">Clear</button>
                        </div>
                        @if (showStatusEmojiPicker)
                        {
                            <div class="chat-status-emoji-picker" aria-label="Choose status emoji">
                                <div class="chat-status-emoji-filters">
                                    <input aria-label="Find status emoji" placeholder="Find an emoji" @bind="statusEmojiSearch" @bind:event="oninput" />
                                </div>
                                <div class="chat-emoji-groups chat-status-emoji-groups" aria-label="Status emoji categories">
                                    @foreach (var group in ChatEmojiCatalog.Groups)
                                    {
                                        <button type="button" class="@(statusEmojiGroup == group ? "selected" : "")" title="@group" aria-label="@group" aria-pressed="@(statusEmojiGroup == group)" @onclick="() => statusEmojiGroup = group">
                                            <svg aria-hidden="true" focusable="false"><use href="@GetEmojiGroupIcon(group)" /></svg>
                                        </button>
                                    }
                                </div>
                                <div class="chat-status-emoji-grid">
                                    @foreach (var option in StatusEmojiOptions)
                                    {
                                        <button type="button" title="@option.Name" aria-label="@option.Name" @onclick="() => ChooseStatusEmoji(option.Emoji)">@option.Emoji</button>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }
                <div class="chat-profile-dock">
                    <button type="button" class="chat-profile-toggle" aria-expanded="@showPresenceEditor" aria-label="@(currentUserDisplayName ?? "Profile and status settings")" @onclick="TogglePresenceEditor">
                        <span class="chat-avatar chat-profile-avatar" aria-hidden="true">
                            @if (PictureUrl(currentUserId) is { } profilePictureUrl) { <img src="@profilePictureUrl" alt="" /> }
                            else { @Initials(currentUserDisplayName ?? "Me") }
                            <span class="chat-presence-dot @PresenceClass(currentUserId)"></span>
                        </span>
                        <span class="chat-profile-copy">
                            <strong>@(currentUserDisplayName ?? "My profile")</strong>
                            <span>@PresenceLabel(CurrentPresenceState) @ProfileCustomStatus</span>
                        </span>
                    </button>
                </div>
            </aside>
            <div class="chat-thread">
                @if (thread is null)
                {
                    <p class="chat-empty">Select a conversation to see its messages.</p>
                }
                else
                {
                    <div class="chat-thread-header">
                        <button type="button" class="chat-back" @onclick="BackToList" aria-label="Back to conversations">←</button>
                        <strong>@(thread.Conversation.Kind == ConversationKind.Channel ? "# " : "")@thread.Conversation.Name</strong>
                        @if (thread.Conversation.Kind == ConversationKind.Channel && !showMembers)
                        {
                            <button type="button" class="chat-icon-button" aria-expanded="@showMembers" aria-controls="chat-members-sidebar" @onclick="() => showMembers = !showMembers">Members (@thread.Members.Count)</button>
                        }
                    </div>
                    <div class="chat-history-container">
                    <div id="chat-message-history" class="chat-messages" data-conversation-id="@thread.Conversation.Id" role="log" aria-label="Message history"
                         @onclick="MarkCurrentConversationReadAsync" @onscroll="MarkCurrentConversationReadAsync">
                        @if (thread.Messages.Count == 100) { <p class="chat-history-limit">Showing the latest 100 messages.</p> }
                        @foreach (var message in thread.Messages)
                        {
                            <article @key="message.Id" data-chat-message-id="@message.Id" tabindex="0" class="chat-message @(message.SenderUserId == currentUserId ? "mine" : "") @(reactionPickerMessageId == message.Id ? "picker-open" : "") @(tonePickerOpenedByTouch && tonePickerMessageId == message.Id ? "tone-picker-touch-open" : "")">
                                @if (message.SenderUserId is not null)
                                {
                                    <span class="chat-avatar chat-message-avatar" aria-hidden="true">
                                        @if (PictureUrl(message.SenderUserId) is { } senderPictureUrl) { <img src="@senderPictureUrl" alt="" /> }
                                        else { @Initials(message.SenderName) }
                                    </span>
                                }
                                <div class="chat-message-meta">
                                    @if (message.SenderUserId is { } senderId && senderId != currentUserId)
                                    {
                                        <button type="button" class="chat-sender-link" title="@PresenceDescription(senderId)"
                                                data-chat-profile-anchor="@SenderAnchorKey(message.Id)" aria-haspopup="dialog" aria-controls="chat-user-popover"
                                                aria-expanded="@(profileAnchorKey == SenderAnchorKey(message.Id))"
                                                @onclick="() => ToggleMessageProfile(senderId, message.SenderName, SenderAnchorKey(message.Id))">@message.SenderName</button>
                                    }
                                    else { <strong>@message.SenderName</strong> }
                                    <time>
                                        @GetMessageTime(message)
                                        @if (message.EditedAtUtc is not null)
                                        {
                                            <span> (edited)</span>
                                        }
                                    </time>
                                </div>
                                @if (editingMessageId == message.Id)
                                {
                                    <form class="chat-edit-form" @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                                        <label class="sr-only" for="chat-edit-body">Edit message</label>
                                        <textarea id="chat-edit-body" rows="3" maxlength="4000" @bind="editDraft" @bind:event="oninput"></textarea>
                                        <div><button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(editDraft)">Save</button><button type="button" class="button button-secondary" @onclick="CancelEdit">Cancel</button></div>
                                    </form>
                                }
                                else
                                {
