    private async Task UploadProfilePictureAsync(InputFileChangeEventArgs args)
    {
        try
        {
            error = null;
            var file = args.File;
            if (file.Size is 0 or > MaximumSourcePictureBytes)
                throw new InvalidOperationException("Choose a picture smaller than 25 MB.");
            if (file.ContentType is not ("image/png" or "image/jpeg" or "image/gif" or "image/webp"))
                throw new InvalidOperationException("Choose a PNG, JPEG, GIF, or WebP picture.");

            await JS.InvokeVoidAsync("confastProfilePictureEditor.prepare", "chat-profile-picture-input", MaximumSourcePictureBytes);
            pictureEditorError = null;
            pictureEditorNeedsMount = true;
            showStatusEmojiPicker = false;
            showPresencePicker = false;
            showPictureEditor = true;
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not open the selected profile picture.");
            error = "Could not open this picture. Choose a PNG, JPEG, GIF, or WebP file.";
        }
    }

    private async Task ApplyPictureEditorAsync()
    {
        if (savingPicture) return;
        savingPicture = true;
        pictureEditorError = null;
        try
        {
            await using var picture = await JS.InvokeAsync<IJSStreamReference>(
                "confastProfilePictureEditor.render", UserProfilePictureService.MaximumPictureBytes);
            await using var stream = await picture.OpenReadStreamAsync(UserProfilePictureService.MaximumPictureBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await ProfilePictures.SaveAsync(buffer.ToArray());
            pictureVersions = await ProfilePictures.GetVersionsAsync();
            await ClosePictureEditorAsync();
        }
        catch (InvalidOperationException ex) { pictureEditorError = ex.Message; }
        catch (UnauthorizedAccessException ex) { pictureEditorError = ex.Message; }
        catch (IOException ex) { pictureEditorError = $"Could not save this picture: {ex.Message}"; }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not crop or compress the profile picture.");
            pictureEditorError = "Could not prepare this picture. Try another file.";
        }
        finally { savingPicture = false; }
    }

    private Task CancelPictureEditorAsync() =>
        savingPicture ? Task.CompletedTask : ClosePictureEditorAsync();

    private async Task ClosePictureEditorAsync()
    {
        showPictureEditor = false;
        pictureEditorNeedsMount = false;
        pictureEditorError = null;
        try { await JS.InvokeVoidAsync("confastProfilePictureEditor.dispose"); }
