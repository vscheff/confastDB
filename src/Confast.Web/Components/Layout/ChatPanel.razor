@using Confast.Web.Features.Chat
@inject ChatService Chat
@inject ChatNotifications Notifications
@inject IJSRuntime JS
@inject ILogger<ChatPanel> Logger
@implements IAsyncDisposable

<button class="chat-launcher" type="button" @onclick="TogglePanel" aria-label="Open chat" aria-expanded="@isOpen">
    <span aria-hidden="true">✉</span> Chat
    @if (unreadTotal > 0)
    {
        <span class="chat-launcher-count">@(unreadTotal > 99 ? "99+" : unreadTotal.ToString())</span>
    }
</button>

@if (isOpen)
{
    <section class="chat-panel" aria-label="Chat">
        <header class="chat-panel-header">
            <div class="chat-panel-heading">
                <button type="button" class="chat-sidebar-toggle" aria-label="@(sidebarCollapsed ? "Show conversations" : "Hide conversations")"
                        title="@(sidebarCollapsed ? "Show conversations" : "Hide conversations")" aria-controls="chat-conversation-sidebar"
                        aria-expanded="@(!sidebarCollapsed)" @onclick="ToggleSidebar">☰</button>
                <strong>Messages</strong>
            </div>
            <button type="button" class="chat-icon-button" @onclick="ClosePanel" aria-label="Close chat">×</button>
        </header>
        @if (error is not null)
        {
            <p class="chat-error" role="alert">@error</p>
        }
        <div class="chat-panel-body @(selectedId is not null ? "chat-has-thread" : "") @(sidebarCollapsed ? "chat-sidebar-collapsed" : "")">
            <aside id="chat-conversation-sidebar" class="chat-sidebar">
                <div class="chat-tabs" aria-label="Chat views">
                    <button type="button" class="@(view is ChatView.Conversations or ChatView.NewDirect ? "active" : "")" @onclick="() => ChangeView(ChatView.Conversations)">Conversations</button>
                    <button type="button" class="@(view is ChatView.Channels or ChatView.NewChannel ? "active" : "")" @onclick="() => ChangeView(ChatView.Channels)">Channels</button>
                </div>
                @if (view == ChatView.Conversations)
                {
                    <div class="chat-create-actions">
                        <button class="button button-secondary" type="button" @onclick="() => ChangeView(ChatView.NewDirect)">New Message</button>
                    </div>
                    @if (!conversations.Any(x => x.Kind == ConversationKind.Direct))
                    {
                        <p class="chat-empty">No direct messages yet.</p>
                    }
                    @foreach (var row in conversations.Where(x => x.Kind == ConversationKind.Direct))
                    {
                        <button @key="row.Id" type="button" class="chat-conversation @(selectedId == row.Id ? "selected" : "")" @onclick="() => OpenThreadAsync(row.Id)">
                            <span class="chat-conversation-top"><strong>@row.Name</strong><time>@GetActivityDate(row)</time></span>
                            <span class="chat-conversation-bottom"><span>@(row.Preview ?? "No messages yet")</span>@if (row.UnreadCount > 0) { <b>@row.UnreadCount</b> }</span>
                        </button>
                    }
                }
                else if (view == ChatView.Channels)
                {
                    <div class="chat-create-actions">
                        <button class="button button-secondary" type="button" @onclick="() => ChangeView(ChatView.NewChannel)">New Channel</button>
                        <button class="button button-secondary" type="button" aria-expanded="@addingFolder" @onclick="StartAddingFolder">Add folder</button>
                    </div>
                    @if (!conversations.Any(x => x.Kind == ConversationKind.Channel)) { <p class="chat-empty">No channels yet.</p> }
                    @if (ChannelsInGroup(null).Count > 0 || channelGroups.Count > 0)
                    {
                        <div class="chat-channel-drop-zone" data-channel-drop-group="" data-channel-drop-before="">Ungrouped</div>
                    }
                    @foreach (var row in ChannelsInGroup(null))
                    {
                        <div @key="row.Id" class="chat-channel-row" data-chat-drag-channel="@row.Id" data-channel-drop-group="" data-channel-drop-before="@row.Id" title="Drag to reorder channel">
                            <button type="button" class="chat-conversation @(selectedId == row.Id ? "selected" : "")" @onclick="() => OpenThreadAsync(row.Id)">
                                <span class="chat-conversation-top"><strong># @row.Name</strong><time>@GetActivityDate(row)</time></span>
                                <span class="chat-conversation-bottom"><span>@(row.Preview ?? "No messages yet")</span>@if (row.UnreadCount > 0) { <b>@row.UnreadCount</b> }</span>
                            </button>
                            <button type="button" class="chat-channel-action-toggle" aria-label="Options for @row.Name" aria-expanded="@(channelActionsId == row.Id)" @onclick="() => ToggleChannelActions(row.Id)">⋯</button>
                            @if (channelActionsId == row.Id)
                            {
                                <div class="chat-channel-controls">
                                    <button type="button" disabled="@(!CanMoveChannel(row, -1))" aria-label="Move @row.Name up" @onclick="() => MoveChannelStepAsync(row, -1)">↑</button>
                                    <button type="button" disabled="@(!CanMoveChannel(row, 1))" aria-label="Move @row.Name down" @onclick="() => MoveChannelStepAsync(row, 1)">↓</button>
                                    <select aria-label="Move @row.Name to group" value="" @onchange="e => MoveChannelToGroupAsync(row.Id, e.Value?.ToString())">
                                        <option value="">Move to group…</option>
                                        @foreach (var group in channelGroups) { <option value="@group.Id">@group.Name</option> }
                                    </select>
                                </div>
                            }
                        </div>
                    }
                    @foreach (var group in channelGroups)
                    {
                        <section @key="group.Id" class="chat-channel-group">
                            <div class="chat-channel-drop-zone chat-group-heading" data-channel-drop-group="@group.Id" data-channel-drop-before="">
                                @if (editingGroupId == group.Id)
                                {
                                    <form class="chat-group-rename" @onsubmit="SaveGroupNameAsync" @onsubmit:preventDefault>
                                        <input aria-label="Group name" maxlength="120" @bind="groupNameDraft" @bind:event="oninput" />
                                        <button type="submit" aria-label="Save group name">✓</button>
                                        <button type="button" aria-label="Cancel group rename" @onclick="CancelGroupRename">×</button>
                                    </form>
                                }
                                else
                                {
                                    <strong>@group.Name</strong>
                                    <span class="chat-group-controls">
                                        <button type="button" disabled="@(!CanMoveGroup(group, -1))" aria-label="Move folder @group.Name up" @onclick="() => MoveGroupStepAsync(group, -1)">↑</button>
                                        <button type="button" disabled="@(!CanMoveGroup(group, 1))" aria-label="Move folder @group.Name down" @onclick="() => MoveGroupStepAsync(group, 1)">↓</button>
                                        @if (group.CanManage)
                                        {
                                            <button type="button" aria-label="Rename folder @group.Name" @onclick="() => StartGroupRename(group)">✎</button>
                                            <button type="button" aria-label="Delete folder @group.Name" @onclick="() => confirmDeleteGroupId = group.Id">×</button>
                                        }
                                    </span>
                                }
                            </div>
                            @if (confirmDeleteGroupId == group.Id)
                            {
                                <div class="chat-group-delete-confirm">
                                    <span>Move this folder's channels to Ungrouped?</span>
                                    <button type="button" @onclick="() => DeleteGroupAsync(group.Id)">Delete folder</button>
                                    <button type="button" @onclick="() => confirmDeleteGroupId = null">Cancel</button>
                                </div>
                            }
                            @if (ChannelsInGroup(group.Id).Count == 0)
                            {
                                <p class="chat-empty-folder">Drag a channel here.</p>
                            }
                            @foreach (var row in ChannelsInGroup(group.Id))
                            {
                                <div @key="row.Id" class="chat-channel-row" data-chat-drag-channel="@row.Id" data-channel-drop-group="@group.Id" data-channel-drop-before="@row.Id" title="Drag to reorder channel">
                                    <button type="button" class="chat-conversation @(selectedId == row.Id ? "selected" : "")" @onclick="() => OpenThreadAsync(row.Id)">
                                        <span class="chat-conversation-top"><strong># @row.Name</strong><time>@GetActivityDate(row)</time></span>
                                        <span class="chat-conversation-bottom"><span>@(row.Preview ?? "No messages yet")</span>@if (row.UnreadCount > 0) { <b>@row.UnreadCount</b> }</span>
                                    </button>
                                    <button type="button" class="chat-channel-action-toggle" aria-label="Options for @row.Name" aria-expanded="@(channelActionsId == row.Id)" @onclick="() => ToggleChannelActions(row.Id)">⋯</button>
                                    @if (channelActionsId == row.Id)
                                    {
                                        <div class="chat-channel-controls">
                                            <button type="button" disabled="@(!CanMoveChannel(row, -1))" aria-label="Move @row.Name up" @onclick="() => MoveChannelStepAsync(row, -1)">↑</button>
                                            <button type="button" disabled="@(!CanMoveChannel(row, 1))" aria-label="Move @row.Name down" @onclick="() => MoveChannelStepAsync(row, 1)">↓</button>
                                            <select aria-label="Move @row.Name to group" value="@group.Id" @onchange="e => MoveChannelToGroupAsync(row.Id, e.Value?.ToString())">
                                                <option value="">Ungrouped</option>
                                                @foreach (var destination in channelGroups) { <option value="@destination.Id">@destination.Name</option> }
                                            </select>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                    @if (addingFolder)
                    {
                        <section class="chat-channel-group chat-folder-draft">
                            <form class="chat-group-create" @onsubmit="CreateGroupAsync" @onsubmit:preventDefault @onkeydown="HandleNewFolderKeyDown">
                                <label class="sr-only" for="chat-new-group-name">Folder name</label>
                                <input id="chat-new-group-name" @ref="newGroupNameInput" maxlength="120" placeholder="Folder name" @bind="newGroupName" @bind:event="oninput" />
                                <button type="submit" class="button button-secondary" disabled="@string.IsNullOrWhiteSpace(newGroupName)">Save</button>
                                <button type="button" class="button button-secondary" @onclick="CancelAddingFolder">Cancel</button>
                            </form>
                        </section>
                    }
                }
                else if (view == ChatView.NewDirect)
                {
                    <h3>New Message</h3>
                    <label for="chat-direct-user">User</label>
                    <select id="chat-direct-user" @bind="directUserId">
                        <option value="">Select a user</option>
                        @foreach (var user in users) { <option value="@user.Id">@user.Name</option> }
                    </select>
                    <div class="chat-form-actions">
                        <button type="button" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(directUserId)" @onclick="StartDirectAsync">Open Conversation</button>
                        <button type="button" class="button button-secondary" @onclick="CancelNewDirect">Cancel</button>
                    </div>
                }
                else if (view == ChatView.NewChannel)
                {
                    <h3>New Channel</h3>
                    <label for="chat-channel-name">Name</label>
                    <input id="chat-channel-name" maxlength="120" @bind="channelName" @bind:event="oninput" />
                    <label for="chat-channel-visibility">Visibility</label>
                    <select id="chat-channel-visibility" @bind="channelVisibility">
                        <option value="@ChannelVisibility.Public">Public</option>
                        <option value="@ChannelVisibility.Private">Private</option>
                    </select>
                    @if (channelVisibility == ChannelVisibility.Private)
                    {
                        <fieldset class="chat-member-choices">
                            <legend>Initial Members</legend>
                            @foreach (var user in users)
                            {
                                <label><input type="checkbox" checked="@initialMembers.Contains(user.Id)" @onchange="e => ToggleInitialMember(user.Id, e.Value is true)" /> @user.Name</label>
                            }
                        </fieldset>
                    }
                    else { <p>All active users are added to public channels.</p> }
                    <div class="chat-form-actions">
                        <button type="button" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(channelName)" @onclick="CreateChannelAsync">Create Channel</button>
                        <button type="button" class="button button-secondary" @onclick="CancelNewChannel">Cancel</button>
                    </div>
                }
            </aside>
            <div class="chat-thread">
                @if (thread is null)
                {
                    <p class="chat-empty">Select a conversation to see its messages.</p>
                }
                else
                {
                    <div class="chat-thread-header">
                        <button type="button" class="chat-back" @onclick="BackToList" aria-label="Back to conversations">←</button>
                        <strong>@(thread.Conversation.Kind == ConversationKind.Channel ? "# " : "")@thread.Conversation.Name</strong>
                        @if (thread.Conversation.Kind == ConversationKind.Channel)
                        {
                            <button type="button" class="chat-icon-button" @onclick="() => showMembers = !showMembers">Members (@thread.Members.Count)</button>
                        }
                    </div>
                    @if (showMembers && thread.Conversation.Kind == ConversationKind.Channel)
                    {
                        <div class="chat-members">
                            @foreach (var member in thread.Members)
                            {
                                <div><span>@member.Name</span>
                                    @if (thread.Conversation.IsOwner && thread.Conversation.Visibility == ChannelVisibility.Private && member.Id != currentUserId)
                                    {
                                        <button type="button" @onclick="() => RemoveMemberAsync(member.Id)">Remove</button>
                                    }
                                </div>
                            }
                            @if (thread.Conversation.IsOwner && thread.Conversation.Visibility == ChannelVisibility.Private)
                            {
                                <label for="chat-add-member">Add Member</label>
                                <select id="chat-add-member" @bind="addMemberId"><option value="">Select a user</option>
                                    @foreach (var user in users.Where(x => thread.Members.All(m => m.Id != x.Id))) { <option value="@user.Id">@user.Name</option> }
                                </select>
                                <button type="button" disabled="@string.IsNullOrEmpty(addMemberId)" @onclick="AddMemberAsync">Add</button>
                            }
                        </div>
                    }
                    <div class="chat-history-container">
                    <div id="chat-message-history" class="chat-messages" data-conversation-id="@thread.Conversation.Id" role="log" aria-label="Message history"
                         @onclick="MarkCurrentConversationReadAsync" @onscroll="MarkCurrentConversationReadAsync">
                        @if (thread.Messages.Count == 100) { <p class="chat-history-limit">Showing the latest 100 messages.</p> }
                        @foreach (var message in thread.Messages)
                        {
                            <article @key="message.Id" data-chat-message-id="@message.Id" tabindex="0" class="chat-message @(message.SenderUserId == currentUserId ? "mine" : "") @(reactionPickerMessageId == message.Id ? "picker-open" : "") @(tonePickerOpenedByTouch && tonePickerMessageId == message.Id ? "tone-picker-touch-open" : "")">
                                <div class="chat-message-meta">
                                    @if (message.SenderUserId is { } senderId && senderId != currentUserId)
                                    {
                                        <button type="button" class="chat-sender-link"
                                                @onclick="() => OpenDirectFromMessageAsync(senderId)">@message.SenderName</button>
                                    }
                                    else { <strong>@message.SenderName</strong> }
                                    <time>
                                        @GetMessageTime(message)
                                        @if (message.EditedAtUtc is not null)
                                        {
                                            <span> (edited)</span>
                                        }
                                    </time>
                                </div>
                                @if (editingMessageId == message.Id)
                                {
                                    <form class="chat-edit-form" @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                                        <label class="sr-only" for="chat-edit-body">Edit message</label>
                                        <textarea id="chat-edit-body" rows="3" maxlength="4000" @bind="editDraft" @bind:event="oninput"></textarea>
                                        <div><button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(editDraft)">Save</button><button type="button" class="button button-secondary" @onclick="CancelEdit">Cancel</button></div>
                                    </form>
                                }
                                else
                                {
                                    <p>@(message.IsDeleted ? "Message deleted" : message.Body)</p>
                                }
                                @if (!message.IsDeleted && editingMessageId != message.Id)
                                {
                                    <div class="chat-reaction-actions" aria-label="React to message">
                                        @foreach (var reaction in QuickReactions)
                                        {
                                            <button type="button" data-tone-message="@message.Id" data-tone-base="@reaction.BaseEmoji" data-tone-source="actions"
                                                    title="@GetToneTitle(reaction.BaseEmoji)" aria-label="React with @reaction.Emoji"
                                                    @onpointerenter="args => StartToneHover(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onpointerleave="CancelToneDelay" @onpointerdown="args => StartTonePress(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onpointerup="EndTonePress" @onpointercancel="CancelToneDelay"
                                                    @oncontextmenu:preventDefault
                                                    @onkeydown="args => OpenToneWithKeyboard(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onclick="() => AddQuickReactionAsync(message.Id, reaction.BaseEmoji, reaction.Emoji)">@reaction.Emoji</button>
                                        }
                                        <button type="button" class="chat-reaction-more" aria-label="More reactions" aria-expanded="@(reactionPickerMessageId == message.Id)" @onclick="() => ToggleReactionPicker(message.Id)">＋</button>
                                    </div>
                                    @if (reactionPickerMessageId == message.Id)
                                    {
                                        <div class="chat-emoji-picker" role="dialog" aria-label="Choose a reaction" @onkeydown="HandleEmojiPickerKeyDown" @onclick:stopPropagation>
                                            <label class="sr-only" for="chat-emoji-search-@message.Id">Find an Emoji</label>
                                            <input id="chat-emoji-search-@message.Id" placeholder="Find an Emoji" @bind="emojiSearch" @bind:event="oninput" />
                                            <svg class="chat-emoji-icon-definitions" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                                                <symbol id="chat-emoji-icon-smile" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 10h.01M16 10h.01M8 15c1 1.3 2.3 2 4 2s3-.7 4-2" /></symbol>
                                                <symbol id="chat-emoji-icon-people" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3" /><path d="M4.5 20c.5-4.2 3-6.5 7.5-6.5s7 2.3 7.5 6.5" /></symbol>
                                                <symbol id="chat-emoji-icon-nature" viewBox="0 0 24 24"><path d="M20 4C10 4 4 8 4 15a5 5 0 0 0 5 5c7 0 11-6 11-16ZM5 19c2-4 6-7 12-10" /></symbol>
                                                <symbol id="chat-emoji-icon-food" viewBox="0 0 24 24"><path d="M3 11h18c0 5-3.5 8-9 8s-9-3-9-8ZM7 21h10M9 3c-2 2 2 3 0 5M15 3c-2 2 2 3 0 5" /></symbol>
                                                <symbol id="chat-emoji-icon-travel" viewBox="0 0 24 24"><circle cx="5" cy="17" r="3" /><circle cx="19" cy="17" r="3" /><path d="m5 17 4-8 4 8h6l-4-8H9m4 8 3-5M13 6h3" /></symbol>
                                                <symbol id="chat-emoji-icon-activities" viewBox="0 0 24 24"><path d="M7 8h10c2 0 3.2 1.1 3.6 3l1 5c.4 2-1.4 3-2.8 2L16 16H8l-2.8 2c-1.4 1-3.2 0-2.8-2l1-5C3.8 9.1 5 8 7 8ZM7 12v4m-2-2h4M16 12h.01M19 14h.01" /></symbol>
                                                <symbol id="chat-emoji-icon-objects" viewBox="0 0 24 24"><path d="M8 3h8l3 8H5l3-8ZM12 11v8M7 21h10" /></symbol>
                                                <symbol id="chat-emoji-icon-symbols" viewBox="0 0 24 24"><path d="M12 20s-9-5.6-9-11a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 5.4-9 11-9 11Z" /></symbol>
                                                <symbol id="chat-emoji-icon-flags" viewBox="0 0 24 24"><path d="M5 22V3m0 1c3-2 5 2 8 0s5 0 6 0v11c-3-2-5 2-8 0s-4-1-6 0" /></symbol>
                                            </svg>
                                            <div class="chat-emoji-groups" aria-label="Emoji categories">
                                                @foreach (var group in ChatEmojiCatalog.Groups)
                                                {
                                                    <button type="button" class="@(emojiGroup == group ? "selected" : "")" title="@group" aria-label="@group" aria-pressed="@(emojiGroup == group)" @onclick="() => SelectEmojiGroup(group)">
                                                        <svg aria-hidden="true" focusable="false"><use href="@GetEmojiGroupIcon(group)" /></svg>
                                                    </button>
                                                }
                                            </div>
                                            <div class="chat-emoji-grid">
                                                @foreach (var family in VisibleEmojiFamilies)
                                                {
                                                    <button type="button" data-tone-message="@message.Id" data-tone-base="@family.Default.Emoji" data-tone-source="grid"
                                                            title="@GetToneTitle(family.Default.Emoji)"
                                                            aria-label="React with @GetToneTitle(family.Default.Emoji)"
                                                            @onpointerenter="args => StartToneHover(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onpointerleave="CancelToneDelay" @onpointerdown="args => StartTonePress(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onpointerup="EndTonePress" @onpointercancel="CancelToneDelay"
                                                            @oncontextmenu:preventDefault
                                                            @onkeydown="args => OpenToneWithKeyboard(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onclick="() => AddPreferredReactionAsync(message.Id, family.Default.Emoji)">@PreferredEmoji(family.Default.Emoji)</button>
                                                }
                                            </div>
                                            @if (!VisibleEmojiFamilies.Any()) { <p class="chat-emoji-empty">No emoji found.</p> }
                                        </div>
                                    }
                                    @if (tonePickerMessageId == message.Id && ChatEmojiCatalog.FindFamily(tonePickerDefaultEmoji!) is { } toneFamily)
                                    {
                                        @if (tonePickerOpenedByTouch)
                                        {
                                            <div class="chat-tone-backdrop" @onclick="CloseTonePicker"></div>
                                        }
                                        <div class="chat-tone-picker" role="group" aria-label="Skin tones for @toneFamily.Default.Name" @onkeydown="HandleTonePickerKeyDown">
                                            @foreach (var tone in toneFamily.Tones.Where(IsEmojiSupported))
                                            {
                                                <button type="button" title="@tone.Name" aria-label="React with @tone.Name"
                                                        class="@(PreferredEmoji(toneFamily.Default.Emoji) == tone.Emoji ? "selected" : "")"
                                                        @onclick="() => SelectToneAndReactAsync(message.Id, toneFamily.Default.Emoji, tone.Emoji)">@tone.Emoji</button>
                                            }
                                        </div>
                                    }
                                }
                                @if (!message.IsDeleted && message.Reactions.Count > 0)
                                {
                                    <div class="chat-reactions" aria-label="Message reactions">
                                        @foreach (var reaction in message.Reactions)
                                        {
                                            var names = string.Join(", ", reaction.Users.Select(x => x.Name));
                                            var selected = reaction.Users.Any(x => x.Id == currentUserId);
                                            <button type="button" class="chat-reaction @(selected ? "selected" : "")" aria-label="@reaction.Emoji reacted by @names. @(selected ? "Remove your reaction" : "Add your reaction")" aria-pressed="@selected" @onclick="() => ToggleReactionAsync(message.Id, reaction.Emoji)">
                                                <span>@reaction.Emoji</span><span>@reaction.Users.Count</span><span class="chat-reaction-tooltip" role="tooltip">@names</span>
                                            </button>
                                        }
                                    </div>
                                }
                                @if (message.SenderUserId == currentUserId && !message.IsDeleted)
                                {
                                    @if (editingMessageId != message.Id)
                                    {
                                        <button type="button" class="chat-message-action" @onclick="() => StartEdit(message)">Edit</button>
                                        <button type="button" class="chat-message-action chat-delete" @onclick="() => DeleteMessageAsync(message.Id)">Delete</button>
                                    }
                                }
                            </article>
                        }
                    </div>
                    @if (NewMessageId is long latestNewMessageId)
                    {
                        <button type="button" class="chat-new-message-jump" data-new-message-id="@latestNewMessageId"
                                @onclick="JumpToNewMessageAsync">New messages ↓</button>
                    }
                    </div>
                    <form class="chat-compose" @onsubmit="SendAsync" @onsubmit:preventDefault>
                        <label class="sr-only" for="chat-message-body">Message</label>
                        <textarea id="chat-message-body" rows="2" maxlength="4000" placeholder="Write a message" @bind="draft" @bind:event="oninput"
                                  @onfocus="MarkCurrentConversationReadAsync" @onclick="MarkCurrentConversationReadAsync"></textarea>
                        <button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(draft)">Send</button>
                    </form>
                }
            </div>
        </div>
    </section>
}

@code {
    private enum ChatView { Conversations, Channels, NewDirect, NewChannel }
    private sealed record EmojiSupportResult(double MaxVersion, string[] UnsupportedEmoji);
    private IDisposable? subscription;
    private string? currentUserId;
    private bool isOpen;
    private bool disposed;
    private bool showMembers;
    private int unreadTotal;
    private bool sidebarCollapsed;
    private bool addingFolder;
    private bool focusNewGroupNameAfterRender;
    private ElementReference newGroupNameInput;
    private string newGroupName = string.Empty;
    private long? channelActionsId;
    private long? editingGroupId;
    private long? confirmDeleteGroupId;
    private string groupNameDraft = string.Empty;
    private DotNetObjectReference<ChatPanel>? channelDragReference;
    private bool channelDragAttached;
    private long? selectedId;
    private string? error;
    private string directUserId = string.Empty;
    private string channelName = string.Empty;
    private ChannelVisibility channelVisibility = ChannelVisibility.Public;
