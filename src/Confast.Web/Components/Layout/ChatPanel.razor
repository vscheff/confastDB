    private RenderFragment RenderDraftBody() => builder =>
    {
        if (thread?.Conversation.Kind != ConversationKind.Channel) return;
        var body = ChatMentionParser.NormalizeTags(draft, thread.Members);
        var parts = ChatMentionParser.GetParts(body, ChatMentionParser.FindTokens(body, thread.Members));
        var sequence = 0;
        foreach (var part in parts)
        {
            if (!part.IsTag)
            {
                builder.AddContent(sequence++, part.Text);
                continue;
            }
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "chat-message-tag");
            builder.AddContent(sequence++, part.Text);
            builder.CloseElement();
        }
    };

    private RenderFragment RenderMessageBody(ChatMessageRow message) => builder =>
    {
        if (message.IsDeleted)
        {
            builder.AddContent(0, "Message deleted");
            return;
        }

        for (var index = 0; index < message.Parts.Count; index++)
        {
            var part = message.Parts[index];
            if (!part.IsTag)
            {
                builder.AddContent(1, part.Text);
                continue;
            }

            if (part.UserId is null)
            {
                builder.OpenElement(2, "span");
                builder.AddAttribute(3, "class", "chat-message-tag");
                builder.AddContent(4, part.Text);
                builder.CloseElement();
                continue;
            }

            var anchorKey = $"tag-{message.Id}-{index}";
            builder.OpenElement(5, "button");
            builder.AddAttribute(6, "type", "button");
            builder.AddAttribute(7, "class", "chat-message-tag chat-message-user-tag");
            builder.AddAttribute(8, "data-chat-profile-anchor", anchorKey);
            builder.AddAttribute(9, "aria-haspopup", "dialog");
            builder.AddAttribute(10, "aria-controls", "chat-user-popover");
            builder.AddAttribute(11, "aria-expanded", profileAnchorKey == anchorKey);
            builder.AddAttribute(12, "onclick", EventCallback.Factory.Create(this,
                () => ToggleMessageProfile(part.UserId, part.Name!, anchorKey)));
            builder.AddContent(13, part.Text);
            builder.CloseElement();
        }
    };

