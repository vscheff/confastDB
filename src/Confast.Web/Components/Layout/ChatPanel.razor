    protected override async Task OnInitializedAsync()
    {
        try
        {
            await EnsureCurrentUserContextAsync();
            await RefreshAsync();
            _ = RefreshUnreadCountPeriodicallyAsync();
        }
        catch (UnauthorizedAccessException) { }
    }

    private async Task EnsureCurrentUserContextAsync()
    {
        var resolvedUserId = await Chat.GetCurrentUserIdAsync();
        if (currentUserId == resolvedUserId) return;

        if (showPictureEditor) await ClosePictureEditorAsync();
        subscription?.Dispose();
        currentUserId = resolvedUserId;
        currentUserIsAdministrator = false;
        showPresencePicker = false;
        showPresenceEditor = false;
        currentUserDisplayName = await ProfilePictures.GetCurrentUserDisplayNameAsync();
        tonePreferences = (await Chat.GetEmojiTonePreferencesAsync()).ToDictionary();
        lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
        subscription = Notifications.Subscribe(resolvedUserId, () => _ = InvokeAsync(RefreshFromNotificationAsync));
        selectedId = null;
        thread = null;
        collapsedFolderIds.Clear();
        pinnedChannelsByFolder.Clear();
        pendingNewMessageIds.Clear();
        channelGroups = [];
        conversations = [];
        unreadTotal = 0;
        hasUnreadAlert = false;
        presenceByUser = new Dictionary<string, UserPresence>();
        pictureVersions = new Dictionary<string, Guid>();
        conversationRefreshVersion++;
    }

    private async Task RefreshFromNotificationAsync()
    {
        if (disposed) return;
        try
        {
            await RefreshAsync();
            lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
            if (isOpen && selectedId is long id)
            {
                var previousMessageId = thread?.Conversation.Id == id
                    ? thread.Messages.LastOrDefault()?.Id ?? 0
                    : 0;
                var wasNearBottom = false;
                try { wasNearBottom = await JS.InvokeAsync<bool>("confastChatTime.isNearLatestMessage"); }
                catch (JSDisconnectedException) { return; }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not read the chat scroll position."); }

                if (selectedId == id) await LoadThreadAsync(id);
                if (selectedId == id && thread?.Conversation.Id == id &&
                    thread.Messages.LastOrDefault()?.Id is long latestMessageId && latestMessageId > previousMessageId)
                {
                    if (wasNearBottom)
                    {
                        pendingNewMessageIds.Remove(id);
                        scrollToLatestAfterRender = true;
                    }
                    else pendingNewMessageIds[id] = latestMessageId;
                }
            }
            StateHasChanged();
        }
        catch (UnauthorizedAccessException)
        {
            selectedId = null;
            thread = null;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        await EnsureCurrentUserContextAsync();
        var version = ++conversationRefreshVersion;
        var userId = currentUserId;
        var refreshedConversations = await Chat.GetConversationsAsync();
        var refreshedAdministrator = await Chat.IsCurrentUserAdministratorAsync();
        var refreshedGroups = await Chat.GetChannelGroupsAsync();
        var refreshedPresence = await Presence.GetVisibleAsync();
        var refreshedPictures = await ProfilePictures.GetVersionsAsync();
        if (disposed || version != conversationRefreshVersion || userId != currentUserId) return;

        conversations = refreshedConversations;
        currentUserIsAdministrator = refreshedAdministrator;
        channelGroups = refreshedGroups;
        collapsedFolderIds.RemoveWhere(id => channelGroups.All(x => x.Id != id));
        foreach (var (folderId, channelId) in pinnedChannelsByFolder.ToArray())
            if (!collapsedFolderIds.Contains(folderId) || !IsChannelInFolder(channelId, folderId))
                pinnedChannelsByFolder.Remove(folderId);
        presenceByUser = refreshedPresence;
        pictureVersions = refreshedPictures;
        unreadTotal = conversations.Sum(x => x.UnreadCount);
        hasUnreadAlert = conversations.Any(x => x.HasUnreadMention ||
            (x.Kind == ConversationKind.Direct && x.UnreadCount > 0));
        activityDatesNeedFormatting = true;
    }

    private async Task RefreshUnreadCountPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshLifetime.Token))
            {
                if (disposed) continue;
                await InvokeAsync(async () =>
                {
                    if (disposed) return;
                    await UpdatePresenceHeartbeatAsync();
                    if (isOpen)
                        await RefreshAsync();
                    else
                    {
                        await EnsureCurrentUserContextAsync();
                        var version = ++conversationRefreshVersion;
                        var userId = currentUserId;
                        var total = await Chat.GetTotalUnreadCountAsync(refreshLifetime.Token);
                        var hasAlert = await Chat.HasUnreadAlertAsync(refreshLifetime.Token);
                        if (version == conversationRefreshVersion && userId == currentUserId)
                        {
                            unreadTotal = total;
                            hasUnreadAlert = hasAlert;
                        }
                        presenceByUser = await Presence.GetVisibleAsync(refreshLifetime.Token);
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (refreshLifetime.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (disposed) { }
    }

