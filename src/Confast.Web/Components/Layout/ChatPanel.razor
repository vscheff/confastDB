    @if (renamingFolderId is long editCategoryId)
    {
        <div class="chat-delete-backdrop" @onclick="CancelRenamingFolder">
            <section class="chat-delete-dialog" role="dialog" aria-modal="true" aria-label="Edit Category" @onclick:stopPropagation @onkeydown="HandleRenameFolderKeyDown">
                <h2>Edit Category</h2>
                <form @onsubmit="() => RenameFolderAsync(editCategoryId)" @onsubmit:preventDefault>
                    <label for="chat-category-name">Category name</label>
                    <input id="chat-category-name" @ref="renameFolderInput" maxlength="120" @bind="renameFolderDraft" @bind:event="oninput" />
                    <div class="chat-delete-actions"><button type="button" class="button button-secondary" @onclick="CancelRenamingFolder">Cancel</button><button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(renameFolderDraft)">Save</button></div>
                </form>
            </section>
        </div>
