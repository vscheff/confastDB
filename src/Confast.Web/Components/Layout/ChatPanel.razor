    private void StartToneHover(long messageId, string defaultEmoji, char source,
        Microsoft.AspNetCore.Components.Web.PointerEventArgs args)
    {
        if (args.PointerType != "mouse") return;
        if (tonePickerMessageId == messageId && tonePickerDefaultEmoji == defaultEmoji) return;
        if (tonePickerMessageId is not null) CloseTonePicker();
        StartToneDelay(messageId, defaultEmoji, source, 1000, openedByTouch: false);
    }

    private void StartTonePress(long messageId, string defaultEmoji, char source,
        Microsoft.AspNetCore.Components.Web.PointerEventArgs args)
    {
        // A new press is deliberate; only the click from releasing the original long press is suppressed.
        suppressToneTriggerClick = null;
        if (args.PointerType != "mouse" &&
            (tonePickerMessageId != messageId || tonePickerDefaultEmoji != defaultEmoji))
            StartToneDelay(messageId, defaultEmoji, source, 500, openedByTouch: true);
    }

