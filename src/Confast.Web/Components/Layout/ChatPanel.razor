    private async Task EnsureCurrentUserContextAsync()
    {
        var resolvedUserId = await Chat.GetCurrentUserIdAsync();
        if (currentUserId == resolvedUserId) return;

        if (showPictureEditor) await ClosePictureEditorAsync();
        subscription?.Dispose();
        currentUserId = resolvedUserId;
        incomingPreviews.Clear();
        currentUserIsAdministrator = false;
        showPresencePicker = false;
        showPresenceEditor = false;
        currentUserDisplayName = await ProfilePictures.GetCurrentUserDisplayNameAsync();
        tonePreferences = (await Chat.GetEmojiTonePreferencesAsync()).ToDictionary();
        lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
        subscription = Notifications.Subscribe(resolvedUserId,
            messageId => _ = InvokeAsync(() => RefreshFromNotificationAsync(messageId, resolvedUserId)));
        selectedId = null;
        thread = null;
        CancelCreateThread();
        sidebarReplyingTo = null;
        fullChannelThreadId = null;
        sidebarChannelThreadId = null;
        sidebarThread = null;
        channelThreads = [];
        activeChannelThreads = [];
        manuallyMarkedUnreadConversationId = null;
        manuallyMarkedUnreadOtherConversationVisited = false;
        collapsedFolderIds.Clear();
        pinnedChannelsByFolder.Clear();
        pendingNewMessageIds.Clear();
        channelGroups = [];
        notificationSettings = new(new Dictionary<long, ChatNotificationSetting>(), new Dictionary<long, ChatNotificationSetting>());
        notificationUnread = new Dictionary<long, ChatNotificationUnreadSummary>();
        categoryContext = null;
        pendingDeleteCategory = null;
        channelContext = duplicateChannelSource = pendingDeleteChannel = null;
        conversationContext = null;
        editContextGroupAfterRender = null;
        pendingLeaveConversation = null;
        showCreateChannelCard = false;
        conversations = [];
        showNewMessageCard = false;
        unreadTotal = 0;
        hasUnreadAlert = false;
        presenceByUser = new Dictionary<string, UserPresence>();
        pictureVersions = new Dictionary<string, Guid>();
        conversationRefreshVersion++;
    }

    private async Task RefreshFromNotificationAsync(long? incomingMessageId, string notificationUserId)
    {
        if (disposed || currentUserId != notificationUserId) return;
        var showIncomingPreview = !isOpen;
        try
        {
            await RefreshAsync();
            if (showIncomingPreview && !isOpen && CurrentPresencePreference != UserPresencePreference.DoNotDisturb
                && incomingMessageId is long messageId)
            {
                var preview = await Chat.GetIncomingMessagePreviewAsync(messageId);
                if (!disposed && !isOpen && currentUserId == notificationUserId && preview is not null
                    && CurrentPresencePreference != UserPresencePreference.DoNotDisturb
                    && !incomingPreviews.Any(x => x.Id == messageId))
                {
                    incomingPreviews.Add(preview);
                    _ = ExpireIncomingPreviewAsync(messageId, refreshLifetime.Token);
                }
            }
            lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
            if (isOpen && selectedId is long id)
            {
                var previousMessageId = thread?.Conversation.Id == id
                    ? thread.Messages.LastOrDefault()?.Id ?? 0
                    : 0;
                var wasNearBottom = false;
                try { wasNearBottom = await JS.InvokeAsync<bool>("confastChatTime.isNearLatestMessage"); }
                catch (JSDisconnectedException) { return; }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not read the chat scroll position."); }

                if (selectedId == id) await LoadThreadAsync(id);
                if (sidebarChannelThreadId is long sideId && selectedId == id)
                    await LoadSidebarThreadAsync(sideId);
                if (selectedId == id && thread?.Conversation.Id == id &&
                    thread.Messages.LastOrDefault()?.Id is long latestMessageId && latestMessageId > previousMessageId)
                {
                    if (wasNearBottom)
                    {
                        pendingNewMessageIds.Remove(id);
                        scrollToLatestAfterRender = true;
                    }
                    else if (fullChannelThreadId is null) pendingNewMessageIds[id] = latestMessageId;
                }
            }
            StateHasChanged();
        }
        catch (UnauthorizedAccessException)
        {
            selectedId = null;
            thread = null;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        await EnsureCurrentUserContextAsync();
        var version = ++conversationRefreshVersion;
        var userId = currentUserId;
        var refreshedConversations = await Chat.GetConversationsAsync();
        var refreshedActiveThreads = await Chat.GetActiveChannelThreadsAsync();
        var refreshedAdministrator = await Chat.IsCurrentUserAdministratorAsync();
        var refreshedGroups = await Chat.GetChannelGroupsAsync();
        var refreshedNotificationSettings = await Chat.GetNotificationSettingsAsync();
        var refreshedNotificationUnread = await Chat.GetNotificationUnreadCountsAsync();
        var refreshedPresence = await Presence.GetVisibleAsync();
        var refreshedPictures = await ProfilePictures.GetVersionsAsync();
        if (disposed || version != conversationRefreshVersion || userId != currentUserId) return;

        conversations = refreshedConversations;
        if (conversationContext is { } conversationMenu)
            conversationContext = conversations.FirstOrDefault(x => x.Id == conversationMenu.Id);
        if (channelContext is { } context && conversations.All(x => x.Id != context.Id)) channelContext = null;
        if (channelActionsId is long editId && conversations.All(x => x.Id != editId)) channelActionsId = null;
        if (selectedId is long currentId && conversations.All(x => x.Id != currentId))
        {
            selectedId = null;
            thread = sidebarThread = null;
            sidebarChannelThreadId = fullChannelThreadId = null;
        }
        activeChannelThreads = refreshedActiveThreads;
        currentUserIsAdministrator = refreshedAdministrator;
        channelGroups = refreshedGroups;
        notificationSettings = refreshedNotificationSettings;
        notificationUnread = refreshedNotificationUnread;
        incomingPreviews.RemoveAll(x => conversations.All(row => row.Id != x.ConversationId)
            || !ChannelSetting(x.ConversationId).AllowsPopup(x.IsMention));
        collapsedFolderIds.RemoveWhere(id => channelGroups.All(x => x.Id != id));
        foreach (var (folderId, channelId) in pinnedChannelsByFolder.ToArray())
            if (!collapsedFolderIds.Contains(folderId) || !IsChannelInFolder(channelId, folderId))
                pinnedChannelsByFolder.Remove(folderId);
        presenceByUser = refreshedPresence;
        if (CurrentPresencePreference == UserPresencePreference.DoNotDisturb) incomingPreviews.Clear();
        pictureVersions = refreshedPictures;
        unreadTotal = notificationUnread.Values.Sum(x => x.Count);
        hasUnreadAlert = notificationUnread.Values.Any(x => x.HasAlert);
    }

    private async Task RefreshUnreadCountPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshLifetime.Token))
            {
                if (disposed) continue;
                await InvokeAsync(async () =>
                {
                    if (disposed) return;
                    await UpdatePresenceHeartbeatAsync();
                    if (isOpen)
                    {
                        await RefreshAsync();
                        thread = RefreshPollTimes(thread);
                        sidebarThread = RefreshPollTimes(sidebarThread);
                    }
                    else
                    {
                        await EnsureCurrentUserContextAsync();
                        var version = ++conversationRefreshVersion;
                        var userId = currentUserId;
                        var summary = await Chat.GetNotificationUnreadSummaryAsync(refreshLifetime.Token);
                        var total = summary.Count;
                        var hasAlert = summary.HasAlert;
                        if (version == conversationRefreshVersion && userId == currentUserId)
                        {
                            unreadTotal = total;
                            hasUnreadAlert = hasAlert;
                        }
                        presenceByUser = await Presence.GetVisibleAsync(refreshLifetime.Token);
                        if (CurrentPresencePreference == UserPresencePreference.DoNotDisturb) incomingPreviews.Clear();
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (refreshLifetime.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (disposed) { }
    }

