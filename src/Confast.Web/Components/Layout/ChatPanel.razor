    private async Task OpenThreadAsync(long id)
    {
        CancelCreateThread();
        fullChannelThreadId = null;
        sidebarChannelThreadId = null;
        sidebarThread = null;
        showThreadsMenu = false;
        showComposeMenu = false;
        replyingTo = null;
        CloseTextMenu();
        moreActionsMessageId = null;
        pendingDeleteMessageId = null;
        pendingPinMessageId = null;
        // Reopening the same thread immediately must not undo Mark Unread.
        var returnToMarkedUnread = (manuallyMarkedUnreadConversationId == id
            && manuallyMarkedUnreadOtherConversationVisited)
            || (manuallyMarkedUnreadConversationId is null
                && conversations.Any(row => row.Id == id && row.IsManuallyUnread));
        if (manuallyMarkedUnreadConversationId is long markedId && id != markedId)
            manuallyMarkedUnreadOtherConversationVisited = true;
        channelActionsId = null;
        CloseTonePicker();
        CloseMessageProfile();
        error = null;
        selectedId = id;
        showMembers = false;
        showPinnedMessages = false;
        if (returnToMarkedUnread)
        {
            await readStateGate.WaitAsync();
            try
            {
                await Chat.MarkConversationReadAsync(id);
                manuallyMarkedUnreadConversationId = null;
                manuallyMarkedUnreadOtherConversationVisited = false;
                pendingNewMessageIds.Remove(id);
            }
            finally { readStateGate.Release(); }
        }
        await LoadThreadAsync(id);
        if (selectedId == id && thread?.Conversation.Id == id)
        {
            UpdatePinnedChannelsForSelection(id);
            if (currentUserId is { } userId)
            {
                var storageView = thread.Conversation.Kind == ConversationKind.Channel ? "channels" : "conversations";
                try { await JS.InvokeVoidAsync("confastChatTime.rememberChatThread", userId, storageView, id); }
                catch (JSDisconnectedException) { }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not remember the selected chat thread."); }
            }
        }
    }

    private async Task LoadThreadAsync(long id)
    {
        try
        {
            viewingOlderMessages = false;
            thread = await Chat.GetThreadAsync(id, channelThreadId: fullChannelThreadId);
            channelThreads = thread.Conversation.Kind == ConversationKind.Channel
                ? await Chat.GetChannelThreadsAsync(id) : [];
            messageTimesNeedFormatting = true;
            restoreThreadScrollAfterRender = true;
            if (fullChannelThreadId is null && thread.Conversation.UnreadCount > 0
                && thread.Messages.LastOrDefault()?.Id is long latestMessageId)
                pendingNewMessageIds[id] = latestMessageId;
            await RefreshAsync();
        }
        catch (UnauthorizedAccessException)
        {
            selectedId = null;
            thread = null;
            sidebarThread = null;
            sidebarChannelThreadId = null;
            error = "You no longer have access to that conversation.";
            await RefreshAsync();
        }
    }

