    private async Task RestoreSelectedThreadAsync(bool restoreView)
    {
        if (currentUserId is not { } userId) return;

        try
        {
            if (restoreView)
            {
                var savedView = await JS.InvokeAsync<string?>("confastChatTime.selectedChatView", userId);
                view = savedView switch
                {
                    "channels" => ChatView.Channels,
                    "conversations" => ChatView.Conversations,
                    _ => view is ChatView.Channels or ChatView.NewChannel
                        ? ChatView.Channels : ChatView.Conversations
                };
            }

            var storageView = view == ChatView.Channels ? "channels" : "conversations";
            await JS.InvokeVoidAsync("confastChatTime.rememberChatView", userId, storageView);
            var savedId = await JS.InvokeAsync<long?>("confastChatTime.selectedChatThread", userId, storageView);
            if (savedId is not long id) return;

            if (conversations.Any(row => row.Id == id &&
                (view == ChatView.Channels ? row.Kind == ConversationKind.Channel : row.Kind != ConversationKind.Channel)))
            {
                await OpenThreadAsync(id);
                if (selectedId != id)
                    await JS.InvokeVoidAsync("confastChatTime.forgetChatThread", userId, storageView);
            }
            else
                await JS.InvokeVoidAsync("confastChatTime.forgetChatThread", userId, storageView);
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Logger.LogWarning(ex, "Could not restore the selected chat thread."); }
    }

    private sealed record ChannelLayoutItem(ChatChannelGroupRow? Group, ChatConversationRow? Channel,
        int Depth, long? ParentGroupId, int SortOrder, bool Pinned = false)
    {
        public long Id => Group?.Id ?? Channel!.Id;
        public bool IsFolder => Group is not null;
    }

    private IReadOnlyList<ChannelLayoutItem> SiblingLayout(long? parentId, int depth = 0) =>
        channelGroups.Where(x => x.ParentGroupId == parentId)
            .Select(x => new ChannelLayoutItem(x, null, depth, parentId, x.SortOrder))
            .Concat(conversations.Where(x => x.Kind == ConversationKind.Channel && x.ChannelGroupId == parentId && x.PinnedToTopAtUtc == null)
                .Select(x => new ChannelLayoutItem(null, x, depth, parentId, x.ChannelSortOrder)))
            .OrderBy(x => x.SortOrder).ThenBy(x => x.IsFolder ? 0 : 1).ThenBy(x => x.Id).ToArray();

    private IReadOnlyList<ChannelLayoutItem> ChannelLayout()
    {
        var result = conversations.Where(x => x.Kind == ConversationKind.Channel && x.PinnedToTopAtUtc != null)
            .OrderBy(x => x.PinnedToTopAtUtc).ThenBy(x => x.Id)
            .Select(x => new ChannelLayoutItem(null, x, 0, null, x.ChannelSortOrder, Pinned: true)).ToList();
        var visited = new HashSet<long>();
        void Append(long? parentId, int depth)
        {
            foreach (var item in SiblingLayout(parentId, depth))
            {
                result.Add(item);
                if (item.Group is not { } group || !visited.Add(group.Id)) continue;
                if (collapsedFolderIds.Contains(group.Id))
                {
                    if (pinnedChannelsByFolder.TryGetValue(group.Id, out var pinnedId) &&
                        conversations.FirstOrDefault(x => x.Id == pinnedId && x.Kind == ConversationKind.Channel) is { } pinned &&
                        IsChannelInFolder(pinnedId, group.Id) && pinned.PinnedToTopAtUtc == null)
                        result.Add(new ChannelLayoutItem(null, pinned, depth + 1, group.Id,
                            pinned.ChannelSortOrder, Pinned: true));
                }
                else Append(group.Id, depth + 1);
            }
        }
        Append(null, 0);
        return result;
    }

    private bool IsChannelInFolder(long channelId, long folderId)
    {
        var parentId = conversations.FirstOrDefault(x => x.Id == channelId && x.Kind == ConversationKind.Channel)?.ChannelGroupId;
        var visited = new HashSet<long>();
        while (parentId is long id && visited.Add(id))
        {
            if (id == folderId) return true;
            parentId = channelGroups.FirstOrDefault(x => x.Id == id)?.ParentGroupId;
        }
        return false;
    }

    private (int Count, bool HasMention) GetFolderUnreadSummary(long folderId)
    {
        long? visibleSelectedChannelId = null;
        if (collapsedFolderIds.Contains(folderId) && selectedId is long selectedChannelId &&
            pinnedChannelsByFolder.TryGetValue(folderId, out var pinnedChannelId) && pinnedChannelId == selectedChannelId &&
            conversations.Any(x => x.Id == selectedChannelId && x.Kind == ConversationKind.Channel) &&
            IsChannelInFolder(selectedChannelId, folderId))
            visibleSelectedChannelId = selectedChannelId;

        var unreadChannels = conversations.Where(x => x.Kind == ConversationKind.Channel && NotificationUnread(x.Id).Count > 0 &&
            x.Id != visibleSelectedChannelId && x.PinnedToTopAtUtc == null && IsChannelInFolder(x.Id, folderId)).ToArray();
        return (unreadChannels.Sum(x => NotificationUnread(x.Id).Count), unreadChannels.Any(x => NotificationUnread(x.Id).HasAlert));
    }

    private void ToggleFolderCollapsed(long folderId)
    {
        if (!collapsedFolderIds.Add(folderId))
        {
            collapsedFolderIds.Remove(folderId);
            pinnedChannelsByFolder.Remove(folderId);
            return;
        }
        if (selectedId is long channelId && IsChannelInFolder(channelId, folderId))
            pinnedChannelsByFolder[folderId] = channelId;
    }

    private void UpdatePinnedChannelsForSelection(long channelId)
    {
        var selectedParent = conversations.FirstOrDefault(x => x.Id == channelId && x.Kind == ConversationKind.Channel)?.ChannelGroupId;
        foreach (var (folderId, pinnedId) in pinnedChannelsByFolder.ToArray())
        {
            var pinnedParent = conversations.FirstOrDefault(x => x.Id == pinnedId)?.ChannelGroupId;
            if (selectedParent is not null && selectedParent == pinnedParent && IsChannelInFolder(channelId, folderId))
                pinnedChannelsByFolder[folderId] = channelId;
            else
                pinnedChannelsByFolder.Remove(folderId);
        }
    }

