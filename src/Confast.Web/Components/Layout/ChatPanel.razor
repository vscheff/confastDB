    private IReadOnlyList<MentionOption> MentionOptions
    {
        get
        {
            if (thread?.Conversation.Kind != ConversationKind.Channel) return [];
            var options = new List<MentionOption>
            {
                new("everyone", "All channel members"),
                new("here", "Members currently online")
            };
            foreach (var member in thread.Members)
            {
                var tag = ChatMentionParser.TagForMember(member, thread.Members);
                options.Add(new MentionOption(tag, member.Name));
            }
            return options.Where(x => x.Tag.Contains(mentionQuery, StringComparison.OrdinalIgnoreCase)
                    || (x.Description?.Contains(mentionQuery, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToArray();
        }
    }

    private async Task HandleDraftInputAsync(ChangeEventArgs args)
    {
        var inputVersion = ++draftInputVersion;
        var rawDraft = args.Value?.ToString() ?? string.Empty;
        draft = rawDraft;
        if (thread?.Conversation.Kind == ConversationKind.Channel)
        {
            var normalized = ChatMentionParser.NormalizeTags(rawDraft, thread.Members);
            if (normalized != rawDraft)
            {
                try
                {
                    if (await JS.InvokeAsync<bool>("confastChatTime.normalizeDraftText", rawDraft, normalized)
                        && inputVersion == draftInputVersion)
                        draft = normalized;
                }
                catch (JSDisconnectedException) { }
                catch (JSException ex) { Logger.LogWarning(ex, "Could not normalize chat tags in the draft."); }
            }
        }
        await UpdateMentionQueryAsync();
    }

    private Task HandleDraftCaretAsync() => UpdateMentionQueryAsync();

    private async Task HandleDraftClickAsync()
    {
