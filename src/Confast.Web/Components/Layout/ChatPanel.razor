                            <div class="chat-draft-editor @(thread.Conversation.Kind == ConversationKind.Channel ? "chat-draft-overlay-active" : "")">
                                @if (thread.Conversation.Kind == ConversationKind.Channel)
                                {
                                    <div id="chat-draft-preview" class="chat-draft-preview" aria-hidden="true">@RenderDraftBody()</div>
                                }
                                <textarea id="chat-message-body" rows="2" maxlength="4000" placeholder="Write a message" value="@draft"
                                          @oninput="HandleDraftInputAsync" @onkeyup="HandleDraftCaretAsync"
                                          @onfocus="MarkCurrentConversationReadAsync" @onclick="HandleDraftClickAsync"
                                          aria-controls="chat-mention-menu" aria-expanded="@mentionMenuOpen"></textarea>
                            </div>
                            @if (mentionMenuOpen && thread.Conversation.Kind == ConversationKind.Channel)
                            {
                                var mentionOptions = MentionOptions;
                                <div @key="(mentionStart, mentionQuery)" id="chat-mention-menu" class="chat-mention-menu" role="listbox" aria-label="Tag a channel member">
                                    <button id="chat-mention-dismiss" type="button" class="chat-mention-dismiss" aria-label="Close tag suggestions" @onclick="() => mentionMenuOpen = false">×</button>
                                    @for (var index = 0; index < mentionOptions.Count; index++)
                                    {
                                        var option = mentionOptions[index];
                                        <button type="button" role="option" aria-selected="@(index == 0 ? "true" : "false")" @onclick="() => SelectMentionAsync(option.Tag)">
                                            <strong>@@@option.Tag</strong>
                                            @if (option.Description is not null) { <span>@option.Description</span> }
                                        </button>
                                    }
                                    @if (mentionOptions.Count == 0) { <p>No matching members.</p> }
                                </div>
                            }
                        </div>
                        <button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(draft)">Send</button>
                    </form>
