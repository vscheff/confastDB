    private bool IsEmojiSupported(ChatEmojiOption option) =>
        option.Version <= supportedEmojiVersion && !unsupportedEmoji.Contains(option.Emoji);

    private int AvailableToneCount(string defaultEmoji) =>
        ChatEmojiCatalog.FindFamily(defaultEmoji)?.Tones.Count(IsEmojiSupported) ?? 0;

    private string PreferredEmoji(string defaultEmoji)
    {
        if (tonePreferences.TryGetValue(defaultEmoji, out var preferred))
        {
            var option = ChatEmojiCatalog.FindFamily(defaultEmoji)?.Tones.FirstOrDefault(x => x.Emoji == preferred);
            if (option is not null && IsEmojiSupported(option)) return preferred;
        }
        return defaultEmoji;
    }

    private string GetToneTitle(string defaultEmoji)
    {
        var family = ChatEmojiCatalog.FindFamily(defaultEmoji);
        return family is null ? defaultEmoji : family.Default.Name;
    }

    private Task AddPreferredReactionAsync(long messageId, string defaultEmoji) =>
        SuppressTouchReleaseClick(messageId, defaultEmoji, 'g')
            ? Task.CompletedTask
            : AddReactionAsync(messageId, PreferredEmoji(defaultEmoji));

    private Task AddQuickReactionAsync(long messageId, string defaultEmoji, string emoji) =>
        SuppressTouchReleaseClick(messageId, defaultEmoji, 'a')
            ? Task.CompletedTask
            : AddReactionAsync(messageId, emoji);

    private bool SuppressTouchReleaseClick(long messageId, string defaultEmoji, char source)
    {
        var suppress = suppressToneTriggerClick == (messageId, defaultEmoji, source);
        suppressToneTriggerClick = null;
        return suppress;
    }

    private void StartToneHover(long messageId, string defaultEmoji, char source,
        Microsoft.AspNetCore.Components.Web.PointerEventArgs args)
    {
        if (args.PointerType != "mouse") return;
        if (tonePickerMessageId == messageId && tonePickerDefaultEmoji == defaultEmoji) return;
        if (tonePickerMessageId is not null) CloseTonePicker();
        StartToneDelay(messageId, defaultEmoji, source, 1000, openedByTouch: false);
    }

    private void StartTonePress(long messageId, string defaultEmoji, char source,
        Microsoft.AspNetCore.Components.Web.PointerEventArgs args)
    {
        // A new press is deliberate; only the click from releasing the original long press is suppressed.
        suppressToneTriggerClick = null;
        if (args.PointerType != "mouse" &&
            (tonePickerMessageId != messageId || tonePickerDefaultEmoji != defaultEmoji))
            StartToneDelay(messageId, defaultEmoji, source, 500, openedByTouch: true);
    }

    private void EndTonePress(Microsoft.AspNetCore.Components.Web.PointerEventArgs args)
    {
        if (args.PointerType != "mouse") CancelToneDelay();
    }

    private void OpenToneWithKeyboard(long messageId, string defaultEmoji, char source,
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "ArrowDown")
        {
            focusTonePickerAfterRender = true;
            OpenTonePicker(messageId, defaultEmoji, source, openedByTouch: false);
        }
    }

    private void HandleTonePickerKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseTonePicker();
    }

    private void StartToneDelay(long messageId, string defaultEmoji, char source, int milliseconds,
        bool openedByTouch)
    {
        if (AvailableToneCount(defaultEmoji) <= 1) return;
        CancelToneDelay();
        var delay = new CancellationTokenSource();
        toneDelay = delay;
        _ = OpenToneAfterDelayAsync(messageId, defaultEmoji, source, milliseconds, openedByTouch, delay);
    }

    private async Task OpenToneAfterDelayAsync(long messageId, string defaultEmoji, char source,
        int milliseconds, bool openedByTouch, CancellationTokenSource delay)
    {
        try
        {
            await Task.Delay(milliseconds, delay.Token);
            await InvokeAsync(() =>
            {
                if (!disposed && !delay.IsCancellationRequested)
                    OpenTonePicker(messageId, defaultEmoji, source, openedByTouch);
            });
        }
        catch (OperationCanceledException) when (delay.IsCancellationRequested) { }
        finally
        {
            if (toneDelay == delay) toneDelay = null;
            delay.Dispose();
        }
    }

    private void OpenTonePicker(long messageId, string defaultEmoji, char source, bool openedByTouch)
    {
        if (AvailableToneCount(defaultEmoji) <= 1) return;
        tonePickerMessageId = messageId;
        tonePickerDefaultEmoji = defaultEmoji;
        tonePickerSource = source;
        tonePickerOpenedByTouch = openedByTouch;
        if (openedByTouch) suppressToneTriggerClick = (messageId, defaultEmoji, source);
        StateHasChanged();
    }

    private void CancelToneDelay()
    {
        toneDelay?.Cancel();
        toneDelay = null;
    }

    private void CloseTonePicker()
    {
        CancelToneDelay();
        suppressToneTriggerClick = null;
        focusTonePickerAfterRender = false;
        tonePickerMessageId = null;
        tonePickerDefaultEmoji = null;
        tonePickerOpenedByTouch = false;
    }

    private Task SelectToneAndReactAsync(long messageId, string defaultEmoji, string emoji) => RunAsync(async () =>
    {
        await Chat.SetEmojiTonePreferenceAsync(defaultEmoji, emoji);
        if (emoji == defaultEmoji) tonePreferences.Remove(defaultEmoji);
        else tonePreferences[defaultEmoji] = emoji;
        CloseTonePicker();
        await Chat.AddReactionAsync(messageId, emoji);
        lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
        reactionPickerMessageId = null;
        await LoadThreadAsync(selectedId!.Value);
    });

    private Task AddReactionAsync(long messageId, string emoji) => RunAsync(async () =>
    {
        CloseTonePicker();
        await Chat.AddReactionAsync(messageId, emoji);
        lastReactionEmoji = await Chat.GetLastReactionEmojiAsync();
        reactionPickerMessageId = null;
        await LoadThreadAsync(selectedId!.Value);
    });

    private void StartEdit(ChatMessageRow message)
    {
        editingMessageId = message.Id;
        editDraft = message.Body ?? string.Empty;
    }

    private void CancelEdit()
    {
        editingMessageId = null;
        editDraft = string.Empty;
    }

    private Task SaveEditAsync() => RunAsync(async () =>
    {
        await Chat.EditOwnMessageAsync(editingMessageId!.Value, editDraft);
        CancelEdit();
        await LoadThreadAsync(selectedId!.Value);
    });

    private void ToggleInitialMember(string id, bool selected)
    {
        if (selected) initialMembers.Add(id);
        else initialMembers.Remove(id);
    }

    private string GetActivityDate(ChatConversationRow row) =>
        localActivityDates.GetValueOrDefault(row.Id, row.ActivityAtUtc.ToString("MMM d"));

    private string GetMessageTime(ChatMessageRow message) =>
        localMessageTimes.GetValueOrDefault(message.Id,
            message.SentAtUtc.ToString("MMM d, h:mm tt") + " UTC");

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        CancelToneDelay();
        refreshLifetime.Cancel();
        refreshLifetime.Dispose();
        subscription?.Dispose();
        if (reactionPickerOutsideClickAttached)
        {
            try { await JS.InvokeVoidAsync("confastChatTime.stopWatchingReactionPickerOutsideClick"); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        reactionPickerReference?.Dispose();
        channelDragReference?.Dispose();
    }
}
