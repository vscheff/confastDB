    private async Task LoadThreadAsync(long id)
    {
        try
        {
            thread = await Chat.GetThreadAsync(id);
            messageTimesNeedFormatting = true;
            restoreThreadScrollAfterRender = true;
            if (thread.Conversation.UnreadCount > 0 && thread.Messages.LastOrDefault()?.Id is long latestMessageId)
                pendingNewMessageIds[id] = latestMessageId;
            await RefreshAsync();
        }
        catch (UnauthorizedAccessException)
        {
            selectedId = null;
            thread = null;
            error = "You no longer have access to that conversation.";
            await RefreshAsync();
        }
    }

    private async Task MarkCurrentConversationReadAsync()
    {
        if (!isOpen || selectedId is not long id || thread?.Conversation.Id != id || markingCurrentConversationRead)
            return;
        if (!pendingNewMessageIds.ContainsKey(id) && !conversations.Any(x => x.Id == id && x.UnreadCount > 0)) return;

        markingCurrentConversationRead = true;
        try
        {
            if (!await JS.InvokeAsync<bool>("confastChatTime.isNearLatestMessage")) return;
            if (selectedId != id || thread?.Conversation.Id != id) return;

            var latestLoadedMessageId = thread.Messages.LastOrDefault()?.Id;
            if (latestLoadedMessageId is long messageId && conversations.Any(x => x.Id == id && x.UnreadCount > 0))
            {
                await Chat.MarkReadAsync(id, messageId);
                await RefreshAsync();
            }
            if (pendingNewMessageIds.TryGetValue(id, out var pendingMessageId) &&
                latestLoadedMessageId is long loadedMessageId && pendingMessageId <= loadedMessageId)
                pendingNewMessageIds.Remove(id);
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Logger.LogWarning(ex, "Could not read the chat scroll position."); }
        catch (UnauthorizedAccessException)
        {
            selectedId = null;
            thread = null;
            await RefreshAsync();
        }
        finally
        {
            markingCurrentConversationRead = false;
        }
    }

