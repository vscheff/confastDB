    private string PresenceDescription(string? userId)
    {
        var value = PresenceOf(userId);
        if (value is null) return "Offline";
        var status = string.Join(" ", new[] { value.StatusEmoji, value.StatusMessage }
            .Where(x => !string.IsNullOrWhiteSpace(x)));
        return status.Length == 0 ? PresenceLabel(value.State) : $"{PresenceLabel(value.State)} — {status}";
    }

