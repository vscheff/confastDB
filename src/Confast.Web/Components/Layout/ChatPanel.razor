    private async Task UpdateMentionQueryAsync()
    {
        if (thread?.Conversation.Kind != ConversationKind.Channel)
        {
            mentionMenuOpen = false;
            return;
        }
        try
        {
            var availableTags = thread.Members.SelectMany(member => new[]
            {
                ChatMentionParser.TagForMember(member, thread.Members), member.Name
            }).ToArray();
            var query = await JS.InvokeAsync<MentionQuery?>("confastChatTime.getMentionQuery", new object?[] { availableTags });
            mentionMenuOpen = query is not null;
            mentionQuery = query?.Query ?? string.Empty;
            mentionStart = query?.Start ?? 0;
        }
        catch (JSDisconnectedException) { mentionMenuOpen = false; }
        catch (JSException ex) { Logger.LogWarning(ex, "Could not inspect the chat mention query."); }
    }

    private async Task SelectMentionAsync(string tag)
