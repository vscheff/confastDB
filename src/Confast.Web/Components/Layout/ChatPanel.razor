                                            <button type="button" data-tone-message="@message.Id" data-tone-base="@reaction.BaseEmoji" data-tone-source="actions"
                                                    title="@GetToneTitle(reaction.BaseEmoji)" aria-label="React with @reaction.Emoji"
                                                    @onpointerenter="args => StartToneHover(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onpointerleave="CancelToneDelay" @onpointerdown="args => StartTonePress(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onpointerup="EndTonePress" @onpointercancel="CancelToneDelay"
                                                    @oncontextmenu:preventDefault
                                                    @onkeydown="args => OpenToneWithKeyboard(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onclick="() => AddQuickReactionAsync(message.Id, reaction.BaseEmoji, reaction.Emoji)">@reaction.Emoji</button>
                                        }
                                        <button type="button" class="chat-reaction-more" aria-label="More reactions" aria-expanded="@(reactionPickerMessageId == message.Id)" @onclick="() => ToggleReactionPicker(message.Id)">＋</button>
                                    </div>
                                    @if (reactionPickerMessageId == message.Id)
                                    {
                                        <div class="chat-emoji-picker" role="dialog" aria-label="Choose a reaction" @onkeydown="HandleEmojiPickerKeyDown" @onclick:stopPropagation>
                                            <label class="sr-only" for="chat-emoji-search-@message.Id">Find an Emoji</label>
                                            <input id="chat-emoji-search-@message.Id" placeholder="Find an Emoji" @bind="emojiSearch" @bind:event="oninput" />
                                            <div class="chat-emoji-groups" aria-label="Emoji categories">
                                                @foreach (var group in ChatEmojiCatalog.Groups)
                                                {
                                                    <button type="button" class="@(emojiGroup == group ? "selected" : "")" title="@group" aria-label="@group" aria-pressed="@(emojiGroup == group)" @onclick="() => SelectEmojiGroup(group)">
                                                        <svg aria-hidden="true" focusable="false"><use href="@GetEmojiGroupIcon(group)" /></svg>
                                                    </button>
                                                }
                                            </div>
                                            <div class="chat-emoji-grid">
                                                @foreach (var family in VisibleEmojiFamilies)
                                                {
                                                    <button type="button" data-tone-message="@message.Id" data-tone-base="@family.Default.Emoji" data-tone-source="grid"
                                                            title="@GetToneTitle(family.Default.Emoji)"
                                                            aria-label="React with @GetToneTitle(family.Default.Emoji)"
                                                            @onpointerenter="args => StartToneHover(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onpointerleave="CancelToneDelay" @onpointerdown="args => StartTonePress(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onpointerup="EndTonePress" @onpointercancel="CancelToneDelay"
                                                            @oncontextmenu:preventDefault
                                                            @onkeydown="args => OpenToneWithKeyboard(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onclick="() => AddPreferredReactionAsync(message.Id, family.Default.Emoji)">@PreferredEmoji(family.Default.Emoji)</button>
                                                }
                                            </div>
                                            @if (!VisibleEmojiFamilies.Any()) { <p class="chat-emoji-empty">No emoji found.</p> }
                                        </div>
                                    }
                                    @if (tonePickerMessageId == message.Id && ChatEmojiCatalog.FindFamily(tonePickerDefaultEmoji!) is { } toneFamily)
                                    {
                                        @if (tonePickerOpenedByTouch)
                                        {
                                            <div class="chat-tone-backdrop" @onclick="CloseTonePicker"></div>
                                        }
                                        <div class="chat-tone-picker" role="group" aria-label="Skin tones for @toneFamily.Default.Name" @onkeydown="HandleTonePickerKeyDown">
                                            @foreach (var tone in toneFamily.Tones.Where(IsEmojiSupported))
                                            {
                                                <button type="button" title="@tone.Name" aria-label="React with @tone.Name"
                                                        class="@(PreferredEmoji(toneFamily.Default.Emoji) == tone.Emoji ? "selected" : "")"
                                                        @onclick="() => SelectToneAndReactAsync(message.Id, toneFamily.Default.Emoji, tone.Emoji)">@tone.Emoji</button>
                                            }
                                        </div>
                                    }
                                }
                                @if (!message.IsDeleted && message.Reactions.Count > 0)
