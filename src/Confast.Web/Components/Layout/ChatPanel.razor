            <div class="chat-category-submenu">
                <button type="button" role="menuitem" aria-haspopup="menu" @onclick="() => categoryNotificationsExpanded = !categoryNotificationsExpanded">Notification Settings <span aria-hidden="true">›</span><small>@ChatNotificationMenu.Label(CategorySetting(category.Id).Mode)</small></button>
                <div class="chat-category-submenu-items @(categoryNotificationsExpanded ? "expanded" : "")">
