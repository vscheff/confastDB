    @if (showPictureEditor)
    {
        <div class="chat-picture-edit-backdrop" @onclick="CancelPictureEditorAsync">
            <section class="chat-picture-edit-dialog" role="dialog" aria-modal="true" aria-labelledby="chat-picture-edit-title"
                     @onclick:stopPropagation @onkeydown="HandlePictureEditorKeyDown">
                <header class="chat-picture-edit-header">
                    <h2 id="chat-picture-edit-title">Edit profile picture</h2>
                    <button type="button" class="chat-picture-edit-close" aria-label="Cancel picture editing"
                            disabled="@savingPicture" @onclick="CancelPictureEditorAsync">×</button>
