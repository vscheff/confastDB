    private IReadOnlyList<MentionOption> MentionOptions
    {
        get
        {
            if (thread?.Conversation.Kind != ConversationKind.Channel) return [];
            var options = new List<MentionOption>
            {
                new("everyone", "All channel members"),
                new("here", "Members currently online")
            };
            foreach (var member in thread.Members)
            {
                var tag = ChatMentionParser.TagForMember(member, thread.Members);
                options.Add(new MentionOption(tag, member.Name));
            }
            return options.Where(x => x.Tag.Contains(mentionQuery, StringComparison.OrdinalIgnoreCase)
                    || (x.Description?.Contains(mentionQuery, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToArray();
        }
    }

