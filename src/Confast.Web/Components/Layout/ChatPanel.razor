    private bool CanMoveChannel(ChatConversationRow row, int direction)
    {
        var channels = ChannelsInGroup(row.ChannelGroupId);
        var index = Array.FindIndex(channels.ToArray(), x => x.Id == row.Id);
        return index + direction >= 0 && index + direction < channels.Count;
    }

    private Task MoveChannelStepAsync(ChatConversationRow row, int direction) => RunAsync(async () =>
    {
        var channels = ChannelsInGroup(row.ChannelGroupId);
        var index = Array.FindIndex(channels.ToArray(), x => x.Id == row.Id);
        if (index + direction < 0 || index + direction >= channels.Count) return;
        var beforeId = direction < 0 ? channels[index - 1].Id
            : index + 2 < channels.Count ? channels[index + 2].Id : (long?)null;
        await Chat.MoveChannelAsync(row.Id, row.ChannelGroupId, beforeId);
    });

    private Task MoveChannelToGroupAsync(long channelId, string? value) => RunAsync(async () =>
    {
        long? groupId = null;
        if (!string.IsNullOrEmpty(value))
        {
            if (!long.TryParse(value, out var parsedId))
                throw new InvalidOperationException("Choose a valid channel group.");
            groupId = parsedId;
        }
        await Chat.MoveChannelAsync(channelId, groupId, null);
    });

    private bool CanMoveGroup(ChatChannelGroupRow group, int direction)
    {
        var index = Array.FindIndex(channelGroups.ToArray(), x => x.Id == group.Id);
        return index + direction >= 0 && index + direction < channelGroups.Count;
    }

    private Task MoveGroupStepAsync(ChatChannelGroupRow group, int direction) => RunAsync(async () =>
    {
        var index = Array.FindIndex(channelGroups.ToArray(), x => x.Id == group.Id);
        if (index + direction < 0 || index + direction >= channelGroups.Count) return;
        var beforeId = direction < 0 ? channelGroups[index - 1].Id
            : index + 2 < channelGroups.Count ? channelGroups[index + 2].Id : (long?)null;
        await Chat.MoveChannelGroupAsync(group.Id, beforeId);
    });

