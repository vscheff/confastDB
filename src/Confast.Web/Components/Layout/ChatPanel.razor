    private RenderFragment RenderDraftBody() => builder =>
    {
        if (thread?.Conversation.Kind != ConversationKind.Channel) return;
        var body = ChatMentionParser.NormalizeTags(draft, thread.Members);
        var parts = ChatMentionParser.GetParts(body, ChatMentionParser.FindTokens(body, thread.Members));
        var sequence = 0;
        foreach (var part in parts)
        {
            if (!part.IsTag)
            {
                builder.AddContent(sequence++, part.Text);
                continue;
            }
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "chat-message-tag");
            builder.AddContent(sequence++, part.Text);
            builder.CloseElement();
        }
    };

    private RenderFragment RenderMessageBody(ChatMessageRow message) => builder =>
    {
        if (message.IsDeleted)
        {
            builder.AddContent(0, "Message deleted");
            return;
        }

        var document = new HtmlParser().ParseDocument(ChatMarkdown.ToSafeHtml(message.Body ?? string.Empty));
        var tags = message.Parts.Where(part => part.IsTag).DistinctBy(part => part.Text).OrderByDescending(part => part.Text.Length).ToArray();
        var sequence = 0;

        void RenderNode(INode node)
        {
            if (node is IText textNode)
            {
                var value = textNode.Data;
                for (var parent = textNode.ParentElement; parent is not null; parent = parent.ParentElement)
                {
                    if (parent.LocalName is "code" or "pre" or "a")
                    {
                        builder.AddContent(sequence++, value);
                        return;
                    }
                }
                var cursor = 0;
                while (cursor < value.Length)
                {
                    var match = tags.Select((tag, index) => (tag, index, position: value.IndexOf(tag.Text, cursor, StringComparison.Ordinal)))
                        .Where(candidate => candidate.position >= 0)
                        .OrderBy(candidate => candidate.position).ThenByDescending(candidate => candidate.tag.Text.Length).FirstOrDefault();
                    if (match.tag is null)
                    {
                        builder.AddContent(sequence++, value[cursor..]);
                        break;
                    }
                    if (match.position > cursor) builder.AddContent(sequence++, value[cursor..match.position]);
                    var part = match.tag;
                    if (part.UserId is null)
                    {
                        builder.OpenElement(sequence++, "span");
                        builder.AddAttribute(sequence++, "class", "chat-message-tag");
                    }
                    else
                    {
                        var anchorKey = $"tag-{message.Id}-{match.index}";
                        builder.OpenElement(sequence++, "button");
                        builder.AddAttribute(sequence++, "type", "button");
                        builder.AddAttribute(sequence++, "class", "chat-message-tag chat-message-user-tag");
                        builder.AddAttribute(sequence++, "data-chat-profile-anchor", anchorKey);
                        builder.AddAttribute(sequence++, "aria-haspopup", "dialog");
                        builder.AddAttribute(sequence++, "aria-controls", "chat-user-popover");
                        builder.AddAttribute(sequence++, "aria-expanded", profileAnchorKey == anchorKey);
                        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this,
                            () => ToggleMessageProfile(part.UserId, part.Name!, anchorKey)));
                    }
                    builder.AddContent(sequence++, value.Substring(match.position, part.Text.Length));
                    builder.CloseElement();
                    cursor = match.position + part.Text.Length;
                }
                return;
            }

            if (node is not IElement element) return;
            builder.OpenElement(sequence++, element.LocalName);
            foreach (var attribute in element.Attributes)
                builder.AddAttribute(sequence++, attribute.Name, attribute.Value);
            if (element.LocalName == "input") builder.AddAttribute(sequence++, "disabled", true);
            foreach (var child in element.ChildNodes) RenderNode(child);
            builder.CloseElement();
        }

        foreach (var node in document.Body!.ChildNodes) RenderNode(node);
    };

