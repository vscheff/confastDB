@using Confast.Web.Features.Chat
@using Confast.Web.Features.Identity
@using AngleSharp.Dom
@using AngleSharp.Html.Parser
@using Microsoft.AspNetCore.Components.Forms
@inject ChatService Chat
@inject UserProfilePictureService ProfilePictures
@inject UserPresenceService Presence
@inject ChatNotifications Notifications
@inject IJSRuntime JS
@inject ILogger<ChatPanel> Logger
@implements IAsyncDisposable

<button class="chat-launcher" type="button" @onclick="TogglePanel" aria-label="Open chat" aria-expanded="@isOpen">
    <span aria-hidden="true">✉</span> Chat
    @if (currentUserId is not null)
    {
        <span class="chat-presence-dot @PresenceClass(currentUserId)" title="@PresenceDescription(currentUserId)"></span>
    }
    @if (unreadTotal > 0)
    {
        <span class="chat-launcher-count @(hasUnreadAlert ? "attention" : "")">@(unreadTotal > 99 ? "99+" : unreadTotal.ToString())</span>
    }
</button>

@if (!isOpen && CurrentPresencePreference != UserPresencePreference.DoNotDisturb && incomingPreviews.Count > 0)
{
    <div class="chat-incoming-previews" aria-live="polite" aria-relevant="additions" aria-label="New chat messages">
        @foreach (var preview in incomingPreviews)
        {
            <button @key="preview.Id" type="button" class="chat-incoming-preview" @onclick="() => OpenIncomingPreviewAsync(preview)">
                <span class="chat-incoming-preview-heading"><strong>@preview.SenderName</strong><span>@PreviewConversationName(preview)</span></span>
                <span class="chat-incoming-preview-body">@(string.IsNullOrWhiteSpace(preview.Body) ? string.Join(", ", preview.AttachmentNames) : preview.Body)</span>
                @if (!string.IsNullOrWhiteSpace(preview.Body) && preview.AttachmentNames.Count > 0)
                {
                    <span class="chat-incoming-preview-attachments">📎 @string.Join(", ", preview.AttachmentNames)</span>
                }
            </button>
        }
    </div>
}

@if (isOpen)
{
    <section class="chat-panel @(openingAtMessage ? "chat-panel-positioning" : "")" aria-label="Chat">
        <svg class="chat-emoji-icon-definitions" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
            <symbol id="chat-emoji-icon-smile" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 10h.01M16 10h.01M8 15c1 1.3 2.3 2 4 2s3-.7 4-2" /></symbol>
            <symbol id="chat-emoji-icon-people" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3" /><path d="M4.5 20c.5-4.2 3-6.5 7.5-6.5s7 2.3 7.5 6.5" /></symbol>
            <symbol id="chat-emoji-icon-nature" viewBox="0 0 24 24"><path d="M20 4C10 4 4 8 4 15a5 5 0 0 0 5 5c7 0 11-6 11-16ZM5 19c2-4 6-7 12-10" /></symbol>
            <symbol id="chat-emoji-icon-food" viewBox="0 0 24 24"><path d="M3 11h18c0 5-3.5 8-9 8s-9-3-9-8ZM7 21h10M9 3c-2 2 2 3 0 5M15 3c-2 2 2 3 0 5" /></symbol>
            <symbol id="chat-emoji-icon-travel" viewBox="0 0 24 24"><circle cx="5" cy="17" r="3" /><circle cx="19" cy="17" r="3" /><path d="m5 17 4-8 4 8h6l-4-8H9m4 8 3-5M13 6h3" /></symbol>
            <symbol id="chat-emoji-icon-activities" viewBox="0 0 24 24"><path d="M7 8h10c2 0 3.2 1.1 3.6 3l1 5c.4 2-1.4 3-2.8 2L16 16H8l-2.8 2c-1.4 1-3.2 0-2.8-2l1-5C3.8 9.1 5 8 7 8ZM7 12v4m-2-2h4M16 12h.01M19 14h.01" /></symbol>
            <symbol id="chat-emoji-icon-objects" viewBox="0 0 24 24"><path d="M8 3h8l3 8H5l3-8ZM12 11v8M7 21h10" /></symbol>
            <symbol id="chat-emoji-icon-symbols" viewBox="0 0 24 24"><path d="M12 20s-9-5.6-9-11a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 5.4-9 11-9 11Z" /></symbol>
            <symbol id="chat-emoji-icon-flags" viewBox="0 0 24 24"><path d="M5 22V3m0 1c3-2 5 2 8 0s5 0 6 0v11c-3-2-5 2-8 0s-4-1-6 0" /></symbol>
        </svg>
        <header class="chat-panel-header">
            <div class="chat-panel-heading">
                <button type="button" class="chat-sidebar-toggle" aria-label="@(sidebarCollapsed ? "Show conversations" : "Hide conversations")"
                        title="@(sidebarCollapsed ? "Show conversations" : "Hide conversations")" aria-controls="chat-conversation-sidebar"
                        aria-expanded="@(!sidebarCollapsed)" @onclick="ToggleSidebar">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M9 4v16" />
                        @if (sidebarCollapsed)
                        {
                            <path d="m12 9 3 3-3 3" />
                        }
                        else
                        {
                            <path d="m15 9-3 3 3 3" />
                        }
                    </svg>
                </button>
                <strong>Messages</strong>
            </div>
            <div class="chat-header-actions">
                <button type="button" class="chat-icon-button chat-inbox-button" @ref="inboxButton" @onclick="() => showInbox = !showInbox" aria-label="Inbox" title="Inbox" aria-expanded="@showInbox">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v16H3V4a1 1 0 0 1 1-1Z" /><path d="M3 14h5l2 3h4l2-3h5" /></svg>
                </button>
                <button type="button" class="chat-icon-button chat-close-button" @onclick="ClosePanel" aria-label="Close chat">×</button>
            </div>
        </header>
        @if (showInbox)
        {
            <ChatInbox Revision="conversationRefreshVersion" Conversations="conversations" Groups="channelGroups" PictureUrl="PictureUrl" Closed="CloseInboxAsync" Opened="OpenInboxMessageAsync" Read="MarkInboxMessageReadAsync" ReadAll="MarkAllInboxMessagesReadAsync" />
        }
        @if (error is not null)
        {
            <p class="chat-error" role="alert">@error</p>
        }
        <div class="chat-panel-body @(selectedId is not null ? "chat-has-thread" : "") @(sidebarCollapsed ? "chat-sidebar-collapsed" : "")">
            <aside id="chat-conversation-sidebar" class="chat-sidebar">
                <div class="chat-sidebar-scroll">
                <div class="chat-tabs" aria-label="Chat views">
                    <button type="button" class="@(view == ChatView.Conversations ? "active" : "")" @onclick="() => ChangeViewAsync(ChatView.Conversations)">
                        Conversations
                        @if (unreadConversations > 0)
                        {
                            <span class="chat-tab-count attention" aria-label="@unreadConversations unread messages">@(unreadConversations > 99 ? "99+" : unreadConversations.ToString())</span>
                        }
                    </button>
                    <button type="button" class="@(view is ChatView.Channels or ChatView.NewChannel ? "active" : "")" @onclick="() => ChangeViewAsync(ChatView.Channels)">
                        Channels
                        @if (unreadChannels > 0)
                        {
                            <span class="chat-tab-count @(conversations.Any(x => x.Kind == ConversationKind.Channel && NotificationUnread(x.Id).HasAlert) ? "attention" : "")" aria-label="@unreadChannels unread messages">@(unreadChannels > 99 ? "99+" : unreadChannels.ToString())</span>
                        }
                    </button>
                </div>
                @if (view == ChatView.Conversations)
                {
                    <div class="chat-create-actions">
                        <button class="button button-secondary" type="button" @onclick="StartNewMessageAsync">New Message</button>
                    </div>
                    @if (!conversations.Any(x => x.Kind != ConversationKind.Channel))
                    {
                        <p class="chat-empty">No conversations yet.</p>
                    }
                    @foreach (var row in conversations.Where(x => x.Kind != ConversationKind.Channel))
                    {
                        <div @key="row.Id" class="chat-conversation-row">
                        <button type="button" class="chat-conversation @(selectedId == row.Id ? "selected" : "") @(ChannelSetting(row.Id).IsMuted ? "chat-conversation-muted" : "")" @onclick="() => OpenThreadAsync(row.Id)"
                                @oncontextmenu="args => OpenConversationContext(row, args)" @oncontextmenu:preventDefault
                                @onkeydown="args => HandleConversationContextKey(row, args)" aria-haspopup="menu" aria-controls="chat-conversation-context">
                            <span class="chat-conversation-top">
                                @if (row.Kind == ConversationKind.Group)
                                {
                                    <span class="chat-group-avatar" aria-hidden="true">
                                        <ChatGroupIcon Conversation="row" PictureUrl="PictureUrl" ImageRevision="conversationRefreshVersion" />
                                    </span>
                                }
                                else if (row.Kind == ConversationKind.Direct)
                                {
                                    <span class="chat-conversation-user-avatar">
                                        <span class="chat-conversation-user-picture" aria-hidden="true">
                                            @if (PictureUrl(row.OtherUserId) is { } userPictureUrl) { <img src="@userPictureUrl" alt="" /> }
                                            else { @Initials(row.Name) }
                                        </span>
                                        <span class="chat-presence-dot @PresenceClass(row.OtherUserId)" role="img" aria-label="@PresenceDescription(row.OtherUserId)" title="@PresenceDescription(row.OtherUserId)"></span>
                                    </span>
                                }
                                <strong class="@(NotificationUnread(row.Id).Count > 0 ? "unread" : "")" title="@row.Name">@row.Name</strong>@if (NotificationUnread(row.Id).Count > 0) { <span class="chat-conversation-meta"><b class="chat-unread-count attention">@NotificationUnread(row.Id).Count</b></span> }
                            </span>
                        </button>
                        <button type="button" class="chat-conversation-leave" title="Leave Conversation" aria-label="Leave conversation: @row.Name" @onclick="() => RequestLeaveConversation(row)">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M6 18 18 6" /></svg>
                        </button>
                        </div>
                    }
                }
                else if (view == ChatView.Channels)
                {
                    <div class="chat-create-actions">
                        <button class="button button-secondary" type="button" @onclick="() => StartNewChannel(null)">New Channel</button>
                        <button class="button button-secondary" type="button" aria-expanded="@addingFolder" @onclick="StartAddingFolder">Add folder</button>
                    </div>
                    @if (!conversations.Any(x => x.Kind == ConversationKind.Channel) && channelGroups.Count == 0) { <p class="chat-empty">No channels yet.</p> }
                    <div class="chat-layout-root-drop" data-chat-root-drop="" aria-hidden="true"></div>
                    @if (conversations.Any(x => x.Kind == ConversationKind.Channel && x.PinnedToTopAtUtc != null))
                    { <div class="chat-pinned-channel-heading">Pinned</div> }
                    @foreach (var item in ChannelLayout())
                    {
                        @if (item.Group is { } group)
                        {
                            var folderCollapsed = collapsedFolderIds.Contains(group.Id);
                            (int Count, bool HasMention) folderUnread = folderCollapsed ? GetFolderUnreadSummary(group.Id) : (0, false);
                            var folderAction = folderCollapsed ? "Expand" : "Collapse";
                            var folderLabel = folderUnread.Count > 0
                                ? $"{folderAction} folder {group.Name}, {folderUnread.Count} unread messages"
                                : $"{folderAction} folder {group.Name}";
                            <div @key="(nameof(ChatChannelGroup), group.Id)" class="chat-folder-row chat-layout-row"
                                 data-chat-item-kind="folder" data-chat-drag-kind="@(group.CanManage ? "folder" : null)" data-chat-drag-id="@group.Id"
                                 data-chat-parent="@group.ParentGroupId" data-chat-depth="@item.Depth"
                                 style="@($"--chat-depth:{item.Depth}")" title="@(group.CanManage ? "Drag to move folder" : null)"
                                 @oncontextmenu="args => OpenCategoryContext(group, args)" @oncontextmenu:preventDefault>
                                <div class="chat-group-heading">
                                        <button type="button" class="chat-folder-label" aria-label="@folderLabel" title="@folderLabel"
                                                aria-expanded="@(folderCollapsed ? "false" : "true")" @onclick="() => ToggleFolderCollapsed(group.Id)">
                                            <strong>@group.Name</strong>
                                            @if (folderUnread.Count > 0)
                                            {
                                                <span class="chat-unread-count @(folderUnread.HasMention ? "attention" : "")" aria-hidden="true">@(folderUnread.Count > 99 ? "99+" : folderUnread.Count)</span>
                                            }
                                            <span class="chat-folder-chevron" aria-hidden="true">
                                                @if (collapsedFolderIds.Contains(group.Id))
                                                {
                                                    <svg viewBox="0 0 16 16"><path d="m6 3 5 5-5 5" /></svg>
                                                }
                                                else
                                                {
                                                    <svg viewBox="0 0 16 16"><path d="M3 6 L8 11 L13 6" /></svg>
                                                }
                                            </span>
                                        </button>
                                        <button type="button" class="chat-folder-add" aria-label="Add channel to @group.Name" title="Add channel to @group.Name" @onclick="() => StartNewChannel(group.Id)">＋</button>
                                </div>
                            </div>
                        }
                        else if (item.Channel is { } row)
                        {
                            <div @key="(nameof(Conversation), row.Id)" class="chat-channel-row chat-layout-row @(row.PinnedToTopAtUtc != null ? "chat-personally-pinned-channel-row" : "") @(ChannelSetting(row.Id).IsMuted ? "chat-channel-muted" : "")"
                                 data-chat-item-kind="channel" data-chat-drag-kind="@(item.Pinned ? null : "channel")" data-chat-drag-id="@row.Id"
                                 data-chat-drop-disabled="@(item.Pinned ? "true" : null)"
                                 data-chat-parent="@item.ParentGroupId" data-chat-depth="@item.Depth"
                                 style="@($"--chat-depth:{item.Depth}")" title="@(item.Pinned ? null : "Drag to reorder channel")" @oncontextmenu="args => OpenChannelContext(row, args)" @oncontextmenu:preventDefault>
                                <button type="button" class="chat-conversation @(selectedId == row.Id ? "selected" : "")" @onclick="() => OpenThreadAsync(row.Id)">
                                    <span class="chat-conversation-top"><strong class="@(NotificationUnread(row.Id).Count > 0 ? "unread" : "")"># @row.Name</strong>@if (NotificationUnread(row.Id).Count > 0) { <span class="chat-conversation-meta"><b class="chat-unread-count @(NotificationUnread(row.Id).HasAlert ? "attention" : "")">@NotificationUnread(row.Id).Count</b></span> }</span>
                                </button>
                                <button type="button" class="chat-channel-action-toggle" data-chat-settings-toggle="@row.Id" aria-label="Settings for @row.Name" title="Settings for @row.Name" aria-haspopup="menu" aria-controls="chat-channel-context" @onclick="args => OpenChannelContext(row, args)">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10.1 2.8h3.8l.5 2.2c.6.2 1.2.4 1.7.7l2-1.2 2.7 2.7-1.2 2c.3.5.5 1.1.7 1.7l2.2.5v3.8l-2.2.5c-.2.6-.4 1.2-.7 1.7l1.2 2-2.7 2.7-2-1.2c-.5.3-1.1.5-1.7.7l-.5 2.2h-3.8l-.5-2.2c-.6-.2-1.2-.4-1.7-.7l-2 1.2-2.7-2.7 1.2-2c-.3-.5-.5-1.1-.7-1.7l-2.2-.5v-3.8l2.2-.5c.2-.6.4-1.2.7-1.7l-1.2-2 2.7-2.7 2 1.2c.5-.3 1.1-.5 1.7-.7l.5-2.2Z"/><circle cx="12" cy="12" r="3.2"/></svg>
                                </button>
                                @if (channelActionsId == row.Id)
                                {
                                    <div id="chat-channel-settings-@row.Id" class="chat-channel-settings" role="dialog" aria-label="Edit Channel">
                                        <header class="chat-channel-edit-heading"><strong>Edit Channel</strong><button type="button" aria-label="Close channel editor" @onclick="() => channelActionsId = null">×</button></header>
                                        @if (row.IsOwner || currentUserIsAdministrator)
                                        {
                                            <button type="button" class="chat-channel-delete-button" @onclick="() => BeginDeleteChannel(row)">Delete Channel</button>
                                            <form @onsubmit="() => RenameChannelAsync(row.Id)" @onsubmit:preventDefault>
                                                <label for="chat-rename-channel-@row.Id">Channel name</label>
                                                <div class="chat-channel-settings-entry">
                                                    <input id="chat-rename-channel-@row.Id" maxlength="120" @bind="channelRenameDraft" @bind:event="oninput" />
                                                    <button type="submit" disabled="@string.IsNullOrWhiteSpace(channelRenameDraft)">Save</button>
                                                </div>
                                            </form>
                                            <form class="chat-channel-topic-edit" @onsubmit="() => SaveChannelTopicAsync(row.Id)" @onsubmit:preventDefault>
                                                <label for="chat-channel-topic-@row.Id">Channel Topic</label>
                                                <textarea id="chat-channel-topic-@row.Id" rows="3" maxlength="4000" @bind="channelTopicDraft" @bind:event="oninput"></textarea>
                                                <button type="submit">Save Topic</button>
                                            </form>
                                        }
                                        @if (row.Visibility == ChannelVisibility.Private)
                                        {
                                            <div class="chat-channel-settings-members">
                                                <strong>Members</strong>
                                                @foreach (var member in channelSettingsMembers)
                                                {
                                                    <div class="chat-channel-settings-member">
                                                        <span>@member.Name</span>
                                                        @if (row.IsOwner && member.Id != currentUserId)
                                                        {
                                                            <button type="button" class="chat-channel-member-remove" title="Remove @member.Name" aria-label="Remove @member.Name from @row.Name" @onclick="() => RemoveChannelSettingsMemberAsync(row.Id, member.Id)">
                                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            @if (row.IsOwner)
                                            {
                                                <div class="chat-channel-settings-add">
                                                    <label for="chat-settings-add-member-@row.Id">Add user</label>
                                                    <div class="chat-channel-settings-entry">
                                                        <select id="chat-settings-add-member-@row.Id" @bind="channelSettingsAddMemberId">
                                                            <option value="">Select a user</option>
                                                            @foreach (var user in users.Where(x => channelSettingsMembers.All(member => member.Id != x.Id)))
                                                            {
                                                                <option value="@user.Id">@user.Name</option>
                                                            }
                                                        </select>
                                                        <button type="button" disabled="@string.IsNullOrEmpty(channelSettingsAddMemberId)" @onclick="() => AddChannelSettingsMemberAsync(row.Id)">Add</button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p>All active users belong to public channels.</p>
                                        }
                                    </div>
                                }
                            </div>
                            @foreach (var active in activeChannelThreads.Where(x => x.ConversationId == row.Id))
                            {
                                <button @key="active.Id" type="button" class="chat-active-thread @(sidebarChannelThreadId == active.Id || fullChannelThreadId == active.Id ? "selected" : "")"
                                        style="@($"--chat-depth:{item.Depth}")" title="Thread in #@row.Name"
                                        @onclick="() => OpenChannelThreadFullAsync(active.Id, row.Id)">
                                    <span aria-hidden="true">↳</span><span>@active.Title</span>
                                </button>
                            }
                        }
                    }
                    @if (addingFolder)
                    {
                        <section class="chat-channel-group chat-folder-draft">
                            <form class="chat-group-create" @onsubmit="CreateGroupAsync" @onsubmit:preventDefault @onkeydown="HandleNewFolderKeyDown">
                                <label class="sr-only" for="chat-new-group-name">Folder name</label>
                                <input id="chat-new-group-name" @ref="newGroupNameInput" maxlength="120" placeholder="Folder name" @bind="newGroupName" @bind:event="oninput" />
                                <button type="submit" class="button button-secondary" disabled="@string.IsNullOrWhiteSpace(newGroupName)">Save</button>
                                <button type="button" class="button button-secondary" @onclick="CancelAddingFolder">Cancel</button>
                            </form>
                        </section>
                    }
                }
                </div>
                @if (showPresenceEditor)
                {
                    <section class="chat-presence-editor" aria-label="Profile and status">
                        <div class="chat-picture-editor">
                            <div class="chat-picture-avatar">
                                <span class="chat-avatar" aria-hidden="true">
                                    @if (PictureUrl(currentUserId) is { } myPictureUrl) { <img src="@myPictureUrl" alt="" /> }
                                    else { @Initials(currentUserDisplayName ?? "Me") }
                                </span>
                                <InputFile id="chat-profile-picture-input" class="chat-profile-picture-input" aria-label="Upload profile picture" OnChange="UploadProfilePictureAsync" accept="image/png,image/jpeg,image/gif,image/webp" />
                                <label for="chat-profile-picture-input" class="chat-avatar-edit" title="Change profile picture" aria-label="Change profile picture">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m14.5 5.5 4 4M4 20l4.5-1 11-11a2.12 2.12 0 0 0-3-3l-11 11L4 20Z" /></svg>
                                </label>
                            </div>
                            <strong class="chat-picture-name">@(currentUserDisplayName ?? "My profile")</strong>
                        </div>
                        <div class="chat-presence-setting">
                            <div class="chat-presence-control" @onmouseenter="ShowPresencePicker" @onmouseleave="HidePresencePicker"
                                 @onfocusin="ShowPresencePicker" @onkeydown="HandlePresencePickerKeyDown">
                                <button type="button" class="chat-presence-current" aria-haspopup="true" aria-expanded="@showPresencePicker"
                                        title="@(ProfileCustomStatus is { } customStatus ? customStatus : "Change presence")"
                                        @onclick="ShowPresencePicker">
                                    <span class="chat-presence-dot @PresenceClass(currentUserId)"></span>
                                    @PresenceLabel(CurrentPresenceState)
                                    <span aria-hidden="true">›</span>
                                </button>
                                @if (showPresencePicker)
                                {
                                    <div class="chat-presence-menu" role="menu" aria-label="Set presence">
                                        @foreach (var choice in Enum.GetValues<UserPresencePreference>())
                                        {
                                            <div class="chat-presence-option" @onmouseenter="() => presenceDurationChoice = choice" @onmouseleave="() => presenceDurationChoice = null">
                                            <button type="button" role="menuitemradio" aria-checked="@(CurrentPresencePreference == choice)"
                                                    aria-haspopup="@(choice != UserPresencePreference.Online ? "menu" : null)"
                                                    aria-expanded="@(choice != UserPresencePreference.Online && presenceDurationChoice == choice)"
                                                    class="@(CurrentPresencePreference == choice ? "selected" : "")"
                                                    @onfocus="() => presenceDurationChoice = choice"
                                                    @onclick="() => OpenPresenceDurationAsync(choice)">
                                                <span class="chat-presence-dot @PresenceChoiceClass(choice)"></span>
                                                @PresenceLabel(choice)
                                                @if (choice != UserPresencePreference.Online) { <span class="chat-presence-arrow" aria-hidden="true">›</span> }
                                            </button>
                                            @if (choice != UserPresencePreference.Online && presenceDurationChoice == choice)
                                            {
                                                <div class="chat-presence-duration-menu" role="menu" aria-label="@($"{PresenceLabel(choice)} duration")">
                                                    @foreach (var duration in PresenceDurations)
                                                    {
                                                        <button type="button" role="menuitem" @onclick="() => SelectPresenceAsync(choice, duration.Duration)">@duration.Label</button>
                                                    }
                                                </div>
                                            }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            @if (ProfileCustomStatus is { } profileStatus)
                            {
                                <span class="chat-editor-custom-status">@profileStatus</span>
                            }
                        </div>
                        <div class="chat-status-edit-row">
                            <button type="button" class="chat-status-emoji-button" aria-label="Choose status emoji" aria-expanded="@showStatusEmojiPicker" @onclick="() => showStatusEmojiPicker = !showStatusEmojiPicker">@(statusEmojiDraft ?? "＋")</button>
                            <input aria-label="Status message" maxlength="140" placeholder="Set a status message" @bind="statusMessageDraft" @bind:event="oninput" />
                            <button type="button" class="button button-primary" @onclick="SaveCustomStatusAsync">Save</button>
                            <button type="button" class="button button-secondary" @onclick="ClearCustomStatusAsync" disabled="@(statusEmojiDraft is null && string.IsNullOrWhiteSpace(statusMessageDraft))">Clear</button>
                        </div>
                        @if (showStatusEmojiPicker)
                        {
                            <div class="chat-status-emoji-picker" aria-label="Choose status emoji">
                                <div class="chat-status-emoji-filters">
                                    <input aria-label="Find status emoji" placeholder="Find an emoji" @bind="statusEmojiSearch" @bind:event="oninput" />
                                </div>
                                <div class="chat-emoji-groups chat-status-emoji-groups" aria-label="Status emoji categories">
                                    @foreach (var group in ChatEmojiCatalog.Groups)
                                    {
                                        <button type="button" class="@(statusEmojiGroup == group ? "selected" : "")" title="@group" aria-label="@group" aria-pressed="@(statusEmojiGroup == group)" @onclick="() => statusEmojiGroup = group">
                                            <svg aria-hidden="true" focusable="false"><use href="@GetEmojiGroupIcon(group)" /></svg>
                                        </button>
                                    }
                                </div>
                                <div class="chat-status-emoji-grid">
                                    @foreach (var option in StatusEmojiOptions)
                                    {
                                        <button type="button" title="@option.Name" aria-label="@option.Name" @onclick="() => ChooseStatusEmoji(option.Emoji)">@option.Emoji</button>
                                    }
                                </div>
                            </div>
                        }
                    </section>
                }
                <div class="chat-profile-dock">
                    <button type="button" class="chat-profile-toggle" aria-expanded="@showPresenceEditor" aria-label="@(currentUserDisplayName ?? "Profile and status settings")" @onclick="TogglePresenceEditor">
                        <span class="chat-avatar chat-profile-avatar" aria-hidden="true">
                            @if (PictureUrl(currentUserId) is { } profilePictureUrl) { <img src="@profilePictureUrl" alt="" /> }
                            else { @Initials(currentUserDisplayName ?? "Me") }
                            <span class="chat-presence-dot @PresenceClass(currentUserId)"></span>
                        </span>
                        <span class="chat-profile-copy">
                            <strong>@(currentUserDisplayName ?? "My profile")</strong>
                            <span>@PresenceLabel(CurrentPresenceState) @ProfileCustomStatus</span>
                        </span>
                    </button>
                </div>
            </aside>
            <div class="chat-sidebar-resize-edge" role="separator" aria-label="Resize conversations and channels sidebar"
                 aria-controls="chat-conversation-sidebar" aria-orientation="vertical" aria-valuemin="200" aria-valuenow="270" tabindex="0"></div>
            <div class="chat-thread">
                @if (thread is null)
                {
                    <p class="chat-empty">Select a conversation to see its messages.</p>
                }
                else
                {
                    <div class="chat-thread-header">
                        <button type="button" class="chat-back" @onclick="BackToList" aria-label="Back to conversations">←</button>
                        <div class="chat-thread-heading">
                        @if (thread.Conversation.Kind == ConversationKind.Group)
                        {
                            <button type="button" class="chat-group-name-button" title="@thread.Conversation.Name" aria-label="Edit Group Chat: @thread.Conversation.Name"
                                    aria-haspopup="dialog" aria-controls="chat-group-rename" @onclick="OpenGroupEditorAsync">
                                <span>@thread.Conversation.Name</span>
                                <svg class="chat-group-name-pencil" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m16 3 5 5-12 12-6 1 1-6Z M14 5l5 5" /></svg>
                            </button>
                        }
                        else
                        {
                        <strong title="@thread.Conversation.Name">
                            @if (thread.ChannelThread is { } fullThread)
                            {
                                <button type="button" class="chat-thread-breadcrumb" @onclick="ReturnToChannelAsync"># @thread.Conversation.Name</button>
                                <span aria-hidden="true"> › </span><span><svg class="chat-thread-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M6 4v16M6 8h9a3 3 0 0 1 0 6h-5"/><circle cx="6" cy="4" r="1"/><circle cx="10" cy="14" r="1"/></svg> @fullThread.Title</span>
                            }
                            else { @(thread.Conversation.Kind == ConversationKind.Channel ? "# " : "")@thread.Conversation.Name }
                        </strong>
                        }
                        @if (thread.Conversation.Kind == ConversationKind.Channel && thread.ChannelThread is null && thread.Conversation.Topic is { } topic)
                        {
                            <button type="button" class="chat-channel-topic" @onclick="ToggleChannelTopicAsync" aria-haspopup="dialog" aria-label="Read full channel topic">@topic</button>
                            <section @key="thread.Conversation.Id" id="chat-channel-topic-card" class="chat-channel-topic-card" popover="auto" role="dialog" aria-label="Channel Topic">
                                <header><strong>Channel Topic</strong><button type="button" popovertarget="chat-channel-topic-card" popovertargetaction="hide" aria-label="Close channel topic">×</button></header>
                                <p>@topic</p>
                            </section>
                        }
                        </div>
                        <div class="chat-thread-header-actions">
                            @if (thread.Conversation.Kind is ConversationKind.Direct or ConversationKind.Group)
                            {
                                <button type="button" class="chat-icon-button" title="Add Members" aria-label="Add Members" aria-haspopup="dialog" aria-controls="chat-add-members" @onclick="OpenAddMembersAsync">
                                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="7" r="4" /><path d="M2 21v-2a7 7 0 0 1 14 0v2M19 8v8M15 12h8" /></svg>
                                </button>
                                <section @key="(nameof(addMembersRevision), thread.Conversation.Id)" id="chat-add-members" class="chat-group-edit" popover="manual" aria-label="Add Members">
                                    <ChatNewMessage @key="(thread.Conversation.Id, addMembersRevision)" AddingToConversation="thread.Conversation" ExistingMembers="thread.Members" Users="users" CurrentUserId="@(currentUserId ?? string.Empty)" PictureUrl="PictureUrl" Created="MembersAddedAsync" Closed="CloseAddMembersAsync" />
                                </section>
                            }
                            @if (thread.Conversation.Kind == ConversationKind.Group)
                            {
                                <section @key="thread.Conversation.Id" id="chat-group-rename" class="chat-group-edit" popover="manual" aria-label="Edit Group Chat">
                                    <ChatNewMessage @key="(thread.Conversation.Id, groupEditRevision)" EditingConversation="thread.Conversation" Users="users" CurrentUserId="@(currentUserId ?? string.Empty)" PictureUrl="PictureUrl" Created="GroupEditedAsync" Closed="CloseGroupEditorAsync" />
                                </section>
                            }
                            @if (thread.Conversation.Kind == ConversationKind.Channel)
                            {
                                <div class="chat-thread-list-control" data-chat-thread-menu>
                                    <button type="button" class="chat-icon-button" title="Threads" aria-label="Threads" aria-haspopup="dialog"
                                            aria-expanded="@showThreadsMenu" @onclick="ToggleThreadsMenu">
                                        <svg class="chat-thread-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M6 4v16M6 8h9a3 3 0 0 1 0 6h-5"/><circle cx="6" cy="4" r="1"/><circle cx="10" cy="14" r="1"/></svg>
                                    </button>
                                    @if (showThreadsMenu)
                                    {
                                        <section class="chat-thread-list-menu" role="dialog" aria-label="Channel threads">
                                            <header>
                                                <strong>Threads (@channelThreads.Count)</strong>
                                                <button type="button" class="chat-thread-menu-create" @onclick="BeginCreateThread">Create Thread</button>
                                                <button type="button" aria-label="Close threads" @onclick="() => showThreadsMenu = false">×</button>
                                            </header>
                                            <div class="chat-thread-list-items">
                                                @if (channelThreads.Count == 0) { <p>No threads yet.</p> }
                                                @foreach (var listed in channelThreads)
                                                {
                                                    <button type="button" @onclick="() => OpenChannelThreadFullAsync(listed.Id)">
                                                        <strong>@listed.Title</strong>
                                                        <small>@listed.MessageCount @(listed.MessageCount == 1 ? "message" : "messages") · @(IsActiveThread(listed) ? "Active" : "Inactive")</small>
                                                    </button>
                                                }
                                            </div>
                                        </section>
                                    }
                                </div>
                            }
                            @if (thread.Conversation.Kind == ConversationKind.Channel)
                            {
                                <button type="button" id="chat-notifications-trigger" class="chat-icon-button" title="@(ChannelSetting(thread.Conversation.Id).IsMuted ? "Notification Settings (Muted)" : "Notification Settings")" aria-label="@(ChannelSetting(thread.Conversation.Id).IsMuted ? "Notification Settings (Muted)" : "Notification Settings")" aria-haspopup="menu" @onclick="ToggleNotificationMenuAsync">
                                    <svg aria-hidden="true" viewBox="0 0 24 24">
                                        @if (ChannelSetting(thread.Conversation.Id).IsMuted)
                                        {
                                            <path d="m3 4.27 1.27-1.27L21 19.73 19.73 21l-2-2H4v-1l2-2v-5c0-1.23.29-2.37.8-3.36L3 4.27ZM18 14.17V11c0-3.07-1.63-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68c-.32.08-.63.18-.92.31L18 14.17ZM12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2Z" />
                                        }
                                        else
                                        {
                                            <path d="M18 16v-5c0-3.07-1.63-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.63 5.36 6 7.93 6 11v5l-2 2v1h16v-1l-2-2ZM12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2Z" />
                                        }
                                    </svg>
                                </button>
                                <section @key="thread.Conversation.Id" id="chat-channel-notifications" class="chat-notification-popover" popover="auto" aria-label="Channel Notification Settings">
                                    <ChatNotificationMenu Setting="ChannelSetting(thread.Conversation.Id)" CategoryDefault="CategoryDefaultFor(thread.Conversation.Id)"
                                        Selected="mode => SetChannelNotificationsAsync(thread.Conversation.Id, mode)" Muted="mute => MuteChannelAsync(thread.Conversation.Id, mute)" />
                                </section>
                            }
                            <div class="chat-pinned-control">
                                <button type="button" class="chat-icon-button" title="Pinned messages" aria-label="Pinned messages"
                                        data-chat-pinned-trigger aria-haspopup="dialog"
                                        aria-expanded="@(showPinnedMessages ? "true" : "false")" aria-controls="chat-pinned-menu" @onclick="TogglePinnedMessages">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 3 8 3 9 5 9 10 5 14 5 16 11 16 11 22 13 22 13 16 19 16 19 14 15 10 15 5 16 3Z" /></svg>
                                </button>
                                @if (showPinnedMessages)
                                {
                                    <section id="chat-pinned-menu" class="chat-pinned-menu" role="dialog" aria-label="Pinned messages" @onclick:stopPropagation>
                                        <header class="chat-pinned-header">
                                            <strong>Pinned Messages <span>(@thread.PinnedMessages.Count)</span></strong>
                                            <button type="button" class="chat-icon-button" aria-label="Close pinned messages" @onclick="DismissPinnedMessages">×</button>
                                        </header>
                                        <div class="chat-pinned-list">
                                            @if (thread.PinnedMessages.Count == 0)
                                            {
                                                <p class="chat-pinned-empty">No pinned messages.</p>
                                            }
                                            @foreach (var pinned in thread.PinnedMessages)
                                            {
                                                <article @key="pinned.Id" class="chat-pinned-message" tabindex="0">
                                                    <strong>@pinned.SenderName</strong>
                                                    <time datetime="@pinned.SentAtUtc.ToString("O")">@GetPinnedMessageTime(pinned)</time>
                                                    <p>@pinned.Body</p>
                                                    <div class="chat-pinned-actions" aria-label="Pinned message actions">
                                                        <button type="button" @onclick="() => JumpToPinnedMessageAsync(pinned.Id)">Jump to Message</button>
                                                        <button type="button" @onclick="args => RequestPinMessageAsync(pinned.Id, false, args.ShiftKey)">Unpin</button>
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                            @if (thread.Conversation.Kind is ConversationKind.Channel or ConversationKind.Group && thread.ChannelThread is null)
                            {
                                <button type="button" class="chat-icon-button" title="Members (@thread.Members.Count)" aria-label="Members (@thread.Members.Count)"
                                        aria-expanded="@showMembers" aria-controls="chat-members-sidebar" @onclick="ToggleMembers">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z" /></svg>
                                </button>
                            }
                        </div>
                    </div>
                    @if (thread.ChannelThread?.StartedFromMessage is { } fullSourceMessage)
                    {
                        <p class="chat-thread-source">Started from a reply: @fullSourceMessage</p>
                    }
                    <div class="chat-history-container">
                    <div id="chat-message-history" class="chat-messages" data-conversation-id="@(fullChannelThreadId is long displayedThreadId ? $"thread-{displayedThreadId}" : thread.Conversation.Id.ToString())" role="log" aria-label="Message history"
                         @onclick="MarkCurrentConversationReadAsync" @onscroll="MarkCurrentConversationReadAsync">
                        @if (thread.Messages.Count == 100) { <p class="chat-history-limit">Showing the latest 100 messages.</p> }
                        @{ string? previousMessageDate = null; ChatMessageRow? previousMessage = null; }
                        @foreach (var message in thread.Messages)
                        {
                            var messageDate = GetMessageDate(message);
                            var isGrouped = previousMessage is not null
                                && previousMessage.Type == ChatMessageType.Text
                                && message.Type == ChatMessageType.Text
                                && message.ReplyToMessageId is null
                                && message.SenderUserId is not null
                                && message.SenderUserId == previousMessage.SenderUserId
                                && messageDate.Key == previousMessageDate
                                && message.SentAtUtc >= previousMessage.SentAtUtc
                                && message.SentAtUtc - previousMessage.SentAtUtc <= TimeSpan.FromMinutes(5);
                            var isReplyToCurrentUser = message.Type == ChatMessageType.Text
                                && currentUserId is not null
                                && message.ReplyToSenderUserId == currentUserId
                                && message.SenderUserId != currentUserId;
                            if (previousMessageDate is not null && previousMessageDate != messageDate.Key)
                            {
                                <div class="chat-date-divider" role="separator" aria-label="@messageDate.Label">
                                    <span>@messageDate.Label</span>
                                </div>
                            }
                            previousMessageDate = messageDate.Key;
                            previousMessage = message;
                            <article @key="message.Id" data-chat-message-id="@message.Id" tabindex="0" class="chat-message @(message.Type is ChatMessageType.PinNotice or ChatMessageType.ThreadNotice or ChatMessageType.MemberAddedNotice or ChatMessageType.MemberLeftNotice ? "chat-pin-notice" : "") @(isGrouped ? "chat-message-grouped" : "") @(message.SenderUserId == currentUserId ? "mine" : "") @(isReplyToCurrentUser ? "reply-to-me" : "") @(reactionPickerMessageId == message.Id ? "picker-open" : "") @(moreActionsMessageId == message.Id ? "more-menu-open" : "") @(tonePickerOpenedByTouch && tonePickerMessageId == message.Id ? "tone-picker-touch-open" : "")">
                                @if (message.Type == ChatMessageType.ThreadNotice && message.ChannelThreadId is long announcedThreadId)
                                {
                                    var announced = channelThreads.FirstOrDefault(x => x.Id == announcedThreadId);
                                    <div class="chat-thread-notice">
                                        <p>
                                            @if (message.SenderUserId is { } noticeSenderId)
                                            {
                                                <button type="button" class="chat-thread-notice-author" data-chat-profile-anchor="@SenderAnchorKey(message.Id)" aria-haspopup="dialog"
                                                        aria-controls="chat-user-popover" aria-expanded="@(profileAnchorKey == SenderAnchorKey(message.Id))"
                                                        @onclick="() => ToggleMessageProfile(noticeSenderId, message.SenderName, SenderAnchorKey(message.Id))">@message.SenderName</button>
                                            }
                                            else { <strong>@message.SenderName</strong> }
                                            started a thread:
                                            <button type="button" class="chat-thread-notice-link chat-thread-notice-title" @onclick="() => OpenChannelThreadSidebarAsync(announcedThreadId)">@(announced?.Title ?? "Thread")</button>.
                                            See all <button type="button" class="chat-thread-notice-link chat-thread-notice-threads" @onclick="OpenThreadsMenu">threads</button>.
                                            <time class="chat-thread-notice-time" datetime="@message.SentAtUtc.ToString("O")">@GetMessageTime(message)</time>
                                        </p>
                                        @if (announced is not null)
                                        {
                                            <button type="button" class="chat-thread-notice-card" @onclick="() => OpenChannelThreadSidebarAsync(announcedThreadId)">
                                                <strong>@announced.Title</strong><span>@announced.MessageCount @(announced.MessageCount == 1 ? "Message" : "Messages") ›</span>
                                                @if (announced.LatestMessage is { } latest) { <small>@latest</small> }
                                            </button>
                                        }
                                    </div>
                                }
                                else if (message.Type is ChatMessageType.MemberAddedNotice or ChatMessageType.MemberLeftNotice)
                                {
                                    <p class="chat-pin-notice-copy">
                                        <button type="button" data-chat-profile-anchor="@SenderAnchorKey(message.Id)" aria-haspopup="dialog"
                                                aria-controls="chat-user-popover" aria-expanded="@(profileAnchorKey == SenderAnchorKey(message.Id))"
                                                @onclick="() => ToggleMessageProfile(message.SenderUserId!, message.SenderName, SenderAnchorKey(message.Id))">@message.SenderName</button>
                                        @(" ")
                                        @foreach (var part in message.Parts)
                                        {
                                            @if (part.UserId is { } addedUserId)
                                            {
                                                <button type="button" data-chat-profile-anchor="@AddedMemberAnchorKey(message.Id)" aria-haspopup="dialog"
                                                        aria-controls="chat-user-popover" aria-expanded="@(profileAnchorKey == AddedMemberAnchorKey(message.Id))"
                                                        @onclick="() => ToggleMessageProfile(addedUserId, part.Name ?? part.Text, AddedMemberAnchorKey(message.Id))">@part.Text</button>
                                            }
                                            else { @part.Text }
                                        }
                                        <time class="chat-pin-notice-time" datetime="@message.SentAtUtc.ToString("O")">@GetMessageTime(message)</time>
                                    </p>
                                }
                                else if (message.Type == ChatMessageType.PinNotice)
                                {
                                    <p class="chat-pin-notice-copy">
                                        <button type="button" data-chat-profile-anchor="@SenderAnchorKey(message.Id)" aria-haspopup="dialog"
                                                aria-controls="chat-user-popover" aria-expanded="@(profileAnchorKey == SenderAnchorKey(message.Id))"
                                                @onclick="() => ToggleMessageProfile(message.SenderUserId!, message.SenderName, SenderAnchorKey(message.Id))">@message.SenderName</button>
                                        pinned
                                        @if (message.ReplyToMessageId is long pinnedMessageId && message.ReplyToBody is not null)
                                        {
                                            <button type="button" @onclick="() => JumpToMessageAsync(pinnedMessageId)">a message</button>
                                        }
                                        else { <span>a message</span> }
                                         to this @(thread.ChannelThread is not null ? "thread" : thread.Conversation.Kind == ConversationKind.Channel ? "channel" : "conversation"). See all
                                        <button type="button" data-chat-pinned-trigger @onclick="OpenPinnedMessages">pinned messages</button>.
                                        <time class="chat-pin-notice-time" datetime="@message.SentAtUtc.ToString("O")">@GetMessageTime(message)</time>
                                    </p>
                                }
                                else
                                {
                                @if (isGrouped)
                                {
                                    <span class="sr-only">@message.SenderName, @GetMessageTime(message)</span>
                                    <time class="chat-message-hover-time" datetime="@message.SentAtUtc.ToString("O")">@messageDate.HoverTime</time>
                                }
                                else if (message.SenderUserId is not null)
                                {
                                    <button type="button" class="chat-avatar chat-message-avatar chat-profile-picture-button"
                                            aria-label="Open profile for @message.SenderName" aria-haspopup="dialog" aria-controls="chat-user-popover"
                                            data-chat-profile-anchor="@SenderAvatarAnchorKey(message.Id)"
                                            aria-expanded="@(profileAnchorKey == SenderAvatarAnchorKey(message.Id))"
                                            @onclick="() => ToggleMessageProfile(message.SenderUserId, message.SenderName, SenderAvatarAnchorKey(message.Id))">
                                        @if (PictureUrl(message.SenderUserId) is { } senderPictureUrl) { <img src="@senderPictureUrl" alt="" /> }
                                        else { @Initials(message.SenderName) }
                                    </button>
                                }
                                @if (message.ReplyToMessageId is long originalId && message.ReplyToBody is not null)
                                {
                                    <button type="button" class="chat-reply-preview" title="Jump to original message"
                                            @onclick="() => JumpToMessageAsync(originalId)">
                                        <span class="chat-avatar chat-reply-avatar" aria-hidden="true">
                                            @if (PictureUrl(message.ReplyToSenderUserId) is { } replyPictureUrl) { <img src="@replyPictureUrl" alt="" /> }
                                            else { @Initials(message.ReplyToSenderName ?? "System") }
                                        </span>
                                        <strong>@message.ReplyToSenderName</strong>
                                        <span class="chat-reply-text">@message.ReplyToBody</span>
                                    </button>
                                }
                                @if (!isGrouped)
                                {
                                <div class="chat-message-meta">
                                    @if (message.SenderUserId is { } senderId)
                                    {
                                        <button type="button" class="chat-sender-link" title="@PresenceDescription(senderId)"
                                                data-chat-profile-anchor="@SenderAnchorKey(message.Id)" aria-haspopup="dialog" aria-controls="chat-user-popover"
                                                aria-expanded="@(profileAnchorKey == SenderAnchorKey(message.Id))"
                                                @onclick="() => ToggleMessageProfile(senderId, message.SenderName, SenderAnchorKey(message.Id))">@message.SenderName</button>
                                    }
                                    else { <strong>@message.SenderName</strong> }
                                    <time>
                                        @GetMessageTime(message)
                                        @if (message.EditedAtUtc is not null)
                                        {
                                            <span> (edited)</span>
                                        }
                                    </time>
                                </div>
                                }
                                @if (editingMessageId == message.Id)
                                {
                                    <form class="chat-edit-form" @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                                        <label class="sr-only" for="chat-edit-body">Edit message</label>
                                        <div class="chat-markdown-editor">
                                            <textarea id="chat-edit-body" rows="3" maxlength="4000" @bind="editDraft" @bind:event="oninput"></textarea>
                                            @if (ChatMarkdown.ToPreviewHtml(editDraft) is { } editPreviewHtml)
                                            {
                                                <div class="chat-message-body chat-markdown-preview" role="region" aria-label="Markdown preview">@((MarkupString)editPreviewHtml)</div>
                                            }
                                        </div>
                                        <div class="chat-edit-actions"><button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(editDraft)">Save</button><button type="button" class="button button-secondary" @onclick="CancelEdit">Cancel</button></div>
                                    </form>
                                }
                                else
                                {
                                    @if (message.Attachments.Count == 0 || !string.Equals(message.Body, "Shared a file", StringComparison.Ordinal))
                                    {
                                        <div class="chat-message-body">@if (message.Poll is not null) { <ChatPollCard Message="message" PictureUrlForUser="PictureUrl" Vote="answerId => VotePollAsync(message.Id, answerId)" /> } else if (message.GiphyId is { } gifId) { <ChatGifImage @key="gifId" GiphyId="@gifId" Expanded="OpenExpandedGif" /> } else { @RenderMessageBody(message) }</div>
                                    }
                                }
                                @foreach (var attachment in message.Attachments)
                                {
                                    <div class="chat-attachment">
                                        @if (attachment.Kind == ChatAttachmentKind.Image)
                                        {
                                            <div class="chat-attachment-media">
                                                <button type="button" class="chat-attachment-image-button" aria-label="Expand @attachment.FileName" @onclick="() => OpenExpandedAttachment(attachment)">
                                                    <img src="@AttachmentUrl(attachment.Id)" alt="@attachment.FileName" loading="lazy" />
                                                </button>
                                            </div>
                                        }
                                        else if (attachment.Kind == ChatAttachmentKind.Video)
                                        {
                                            <div class="chat-attachment-media">
                                                <video src="@AttachmentUrl(attachment.Id)" controls preload="metadata" playsinline aria-label="@attachment.FileName"></video>
                                                <a class="chat-attachment-download" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false" title="Download @attachment.FileName" aria-label="Download @attachment.FileName">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                </a>
                                            </div>
                                        }
                                        else if (attachment.Kind == ChatAttachmentKind.Text)
                                        {
                                            var language = GetTextLanguage(attachment.Id, attachment.FileName);
                                            <div class="chat-attachment-code-card">
                                                <pre id="chat-code-@message.Id" class="chat-attachment-code-preview @(IsTextExpanded(attachment.Id) ? "expanded" : "") @(IsWordWrapEnabled(attachment.Id) ? "wrapped" : "unwrapped")"><code>@((MarkupString)ChatTextHighlighter.ToSafeHtml(IsTextExpanded(attachment.Id) ? attachment.Text : PreviewText(attachment.Text), language))</code></pre>
                                                <div class="chat-attachment-code-toolbar">
                                                    <button type="button" class="chat-code-caret" title="@(IsTextExpanded(attachment.Id) ? "Collapse preview" : "Show all lines")" aria-label="@(IsTextExpanded(attachment.Id) ? "Collapse preview" : "Show all lines")" aria-expanded="@(IsTextExpanded(attachment.Id) ? "true" : "false")" aria-controls="chat-code-@message.Id" @onclick="() => ToggleTextExpanded(attachment.Id)">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                    </button>
                                                    <div class="chat-code-file-details"><span title="@attachment.FileName">@attachment.FileName</span><small>@FormatFileSize(attachment.Size)</small></div>
                                                    <div class="chat-code-actions">
                                                        <button type="button" title="Language: @ChatTextHighlighter.Label(language)" aria-label="Change language, currently @ChatTextHighlighter.Label(language)" aria-haspopup="menu" aria-expanded="@(textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Language && !textMenuInExpandedViewer ? "true" : "false")" data-chat-text-menu-trigger @onclick="() => ToggleTextMenu(attachment.Id, TextAttachmentMenu.Language)"><span aria-hidden="true">&lt;&gt;</span></button>
                                                        <button type="button" title="Open full text viewer" aria-label="Open full text viewer" @onclick="() => OpenExpandedAttachment(attachment)"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 4H4v4m0-4 6 6m6 10h4v-4m0 4-6-6M16 4h4v4m0-4-6 6M8 20H4v-4m0 4 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
                                                        <button type="button" title="File options" aria-label="File options" aria-haspopup="menu" aria-expanded="@(textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Options && !textMenuInExpandedViewer ? "true" : "false")" data-chat-text-menu-trigger @onclick="() => ToggleTextMenu(attachment.Id, TextAttachmentMenu.Options)">⋯</button>
                                                    </div>
                                                </div>
                                                @if (textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Language && !textMenuInExpandedViewer)
                                                {
                                                    <div class="chat-code-menu chat-code-language-menu" role="menu" data-chat-text-menu>
                                                        <strong>Language</strong>
                                                        @foreach (var choice in ChatTextHighlighter.Languages)
                                                        {
                                                            <button type="button" role="menuitemradio" aria-checked="@(language == choice.Language ? "true" : "false")" @onclick="() => SetTextLanguage(attachment.Id, choice.Language)">@choice.Label</button>
                                                        }
                                                    </div>
                                                }
                                                else if (textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Options && !textMenuInExpandedViewer)
                                                {
                                                    <div class="chat-code-menu chat-code-options-menu" role="menu" data-chat-text-menu>
                                                        <a role="menuitem" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false">Download file</a>
                                                        <label><input type="checkbox" checked="@IsWordWrapEnabled(attachment.Id)" @onchange="args => SetWordWrap(attachment.Id, args.Value is true)" /> Word wrap</label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="chat-attachment-file-card">
                                                <svg class="chat-attachment-file-icon" viewBox="0 0 32 40" aria-hidden="true" focusable="false"><path d="M4 1h16l10 10v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2Z" fill="currentColor"/><path d="M20 1v9a2 2 0 0 0 2 2h8" fill="#fff" opacity=".78"/></svg>
                                                <div class="chat-attachment-file-details">
                                                    <a class="chat-attachment-file-name chat-attachment-file-name-link" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false" title="Download @attachment.FileName">@attachment.FileName</a>
                                                    <span class="chat-attachment-file-size">@FormatFileSize(attachment.Size)</span>
                                                </div>
                                                <a class="chat-attachment-download" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false" title="Download @attachment.FileName" aria-label="Download @attachment.FileName">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (!message.IsDeleted && message.Type == ChatMessageType.Text && editingMessageId != message.Id)
                                {
                                    <div class="chat-reaction-actions" aria-label="Message actions">
                                        @foreach (var reaction in QuickReactions)
                                        {
                                            <button type="button" data-tone-message="@message.Id" data-tone-base="@reaction.BaseEmoji" data-tone-source="actions"
                                                    title="@GetToneTitle(reaction.BaseEmoji)" aria-label="React with @reaction.Emoji"
                                                    @onpointerenter="args => StartToneHover(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onpointerleave="CancelToneDelay" @onpointerdown="args => StartTonePress(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onpointerup="EndTonePress" @onpointercancel="CancelToneDelay"
                                                    @oncontextmenu:preventDefault
                                                    @onkeydown="args => OpenToneWithKeyboard(message.Id, reaction.BaseEmoji, 'a', args)"
                                                    @onclick="() => AddQuickReactionAsync(message.Id, reaction.BaseEmoji, reaction.Emoji)">@reaction.Emoji</button>
                                        }
                                        <span class="chat-action-divider" aria-hidden="true"></span>
                                        <button type="button" class="chat-reaction-more" aria-label="More reactions" aria-expanded="@(reactionPickerMessageId == message.Id)" @onclick="() => ToggleReactionPicker(message.Id)">＋</button>
                                        @if (message.SenderUserId == currentUserId && message.GiphyId is null)
                                        {
                                            <button type="button" class="chat-edit-action" title="Edit message" aria-label="Edit message" @onclick="() => StartEdit(message)">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25Zm17.7-10.04a1 1 0 0 0 0-1.42l-2.5-2.5a1 1 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 2-1.66Z" /></svg>
                                            </button>
                                        }
                                        <button type="button" class="chat-reply-action" title="Reply" aria-label="Reply to message" @onclick="() => StartReply(message)">
                                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 8V4L2 12l8 8v-4c6.5 0 10 2 12 5-.5-8-4-13-12-13Z" /></svg>
                                        </button>
                                        <button type="button" class="chat-more-action" title="More message actions" aria-label="More message actions"
                                                data-chat-more-trigger="@message.Id"
                                                aria-haspopup="menu" aria-controls="chat-message-more-@message.Id" aria-expanded="@(moreActionsMessageId == message.Id)"
                                                @onclick="() => ToggleMessageActions(message.Id)">⋯</button>
                                    </div>
                                    @if (moreActionsMessageId == message.Id)
                                    {
                                        <div id="chat-message-more-@message.Id" class="chat-message-more-menu" role="menu" aria-label="More message actions" @onclick:stopPropagation>
                                            <div class="chat-message-more-quick" role="group" aria-label="Quick reactions">
                                                @foreach (var reaction in QuickReactions)
                                                {
                                                    <button type="button" role="menuitem" title="@GetToneTitle(reaction.BaseEmoji)" aria-label="React with @reaction.Emoji"
                                                            @onclick="() => AddMenuReactionAsync(message.Id, reaction.Emoji)">@reaction.Emoji</button>
                                                }
                                            </div>
                                            <div class="chat-message-more-divider" role="separator"></div>
                                            <button type="button" role="menuitem" @onclick="() => ToggleReactionPicker(message.Id)">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16ZM8 9a1.25 1.25 0 1 0 0 2.5A1.25 1.25 0 0 0 8 9Zm8 0a1.25 1.25 0 1 0 0 2.5A1.25 1.25 0 0 0 16 9Zm-8.5 5.2a5 5 0 0 0 9 0l-1.8-.9a3 3 0 0 1-5.4 0l-1.8.9Z" /></svg>
                                                Add Reaction
                                            </button>
                                            <div class="chat-message-more-divider" role="separator"></div>
                                            @if (message.SenderUserId == currentUserId && message.GiphyId is null)
                                            {
                                                <button type="button" role="menuitem" @onclick="() => StartEdit(message)">
                                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25Zm17.7-10.04a1 1 0 0 0 0-1.42l-2.5-2.5a1 1 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 2-1.66Z" /></svg>
                                                    Edit Message
                                                </button>
                                            }
                                            <button type="button" role="menuitem" @onclick="() => StartReply(message)">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 8V4L2 12l8 8v-4c6.5 0 10 2 12 5-.5-8-4-13-12-13Z" /></svg>
                                                Reply
                                            </button>
                                            @if (thread.Conversation.Kind == ConversationKind.Channel && thread.ChannelThread is null && message.ReplyToMessageId is not null)
                                            {
                                                <button type="button" role="menuitem" @onclick="() => OfferThreadFromReply(message)">Start Thread from Reply</button>
                                            }
                                            <div class="chat-message-more-divider" role="separator"></div>
                                            <button type="button" role="menuitem" @onclick="() => CopyMessageTextAsync(message)">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 3h10a2 2 0 0 1 2 2v12h-2V5H8V3Zm-4 4h10a2 2 0 0 1 2 2v12H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Zm0 2v10h10V9H4Z" /></svg>
                                                Copy Text
                                            </button>
                                            <button type="button" role="menuitem" @onclick="args => RequestPinMessageAsync(message.Id, message.PinnedAtUtc is null, args.ShiftKey)">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 3H8l1 2v5l-4 4v2h6v6h2v-6h6v-2l-4-4V5l1-2Z" /></svg>
                                                @(message.PinnedAtUtc is null ? "Pin Message" : "Unpin Message")
                                            </button>
                                            <button type="button" role="menuitem" @onclick="() => MarkMessageUnreadAsync(message.Id)">
                                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 2a7 7 0 1 1 0 14 7 7 0 0 1 0-14Zm-1 2h2v5.5l3.5 2.1-1 1.7-4.5-2.8V7Z" /></svg>
                                                Mark Unread
                                            </button>
                                            @if (message.SenderUserId == currentUserId)
                                            {
                                                <div class="chat-message-more-divider" role="separator"></div>
                                                <button type="button" role="menuitem" class="chat-more-delete" @onclick="args => RequestDeleteMessageAsync(message.Id, args.ShiftKey)">
                                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 3h8l1 2h4v2H3V5h4l1-2Zm-2 6h12l-1 12H7L6 9Zm4 2v8h2v-8h-2Zm4 0v8h2v-8h-2Z" /></svg>
                                                    Delete Message
                                                </button>
                                            }
                                        </div>
                                    }
                                    @if (reactionPickerMessageId == message.Id)
                                    {
                                        <div class="chat-emoji-picker" role="dialog" aria-label="Choose a reaction" @onkeydown="HandleEmojiPickerKeyDown" @onclick:stopPropagation>
                                            <label class="sr-only" for="chat-emoji-search-@message.Id">Find an Emoji</label>
                                            <input id="chat-emoji-search-@message.Id" placeholder="Find an Emoji" @bind="emojiSearch" @bind:event="oninput" />
                                            <div class="chat-emoji-groups" aria-label="Emoji categories">
                                                @foreach (var group in ChatEmojiCatalog.Groups)
                                                {
                                                    <button type="button" class="@(emojiGroup == group ? "selected" : "")" title="@group" aria-label="@group" aria-pressed="@(emojiGroup == group)" @onclick="() => SelectEmojiGroup(group)">
                                                        <svg aria-hidden="true" focusable="false"><use href="@GetEmojiGroupIcon(group)" /></svg>
                                                    </button>
                                                }
                                            </div>
                                            <div class="chat-emoji-grid">
                                                @foreach (var family in VisibleEmojiFamilies)
                                                {
                                                    <button type="button" data-tone-message="@message.Id" data-tone-base="@family.Default.Emoji" data-tone-source="grid"
                                                            title="@GetToneTitle(family.Default.Emoji)"
                                                            aria-label="React with @GetToneTitle(family.Default.Emoji)"
                                                            @onpointerenter="args => StartToneHover(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onpointerleave="CancelToneDelay" @onpointerdown="args => StartTonePress(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onpointerup="EndTonePress" @onpointercancel="CancelToneDelay"
                                                            @oncontextmenu:preventDefault
                                                            @onkeydown="args => OpenToneWithKeyboard(message.Id, family.Default.Emoji, 'g', args)"
                                                            @onclick="() => AddPreferredReactionAsync(message.Id, family.Default.Emoji)">@PreferredEmoji(family.Default.Emoji)</button>
                                                }
                                            </div>
                                            @if (!VisibleEmojiFamilies.Any()) { <p class="chat-emoji-empty">No emoji found.</p> }
                                        </div>
                                    }
                                    @if (tonePickerMessageId == message.Id && ChatEmojiCatalog.FindFamily(tonePickerDefaultEmoji!) is { } toneFamily)
                                    {
                                        @if (tonePickerOpenedByTouch)
                                        {
                                            <div class="chat-tone-backdrop" @onclick="CloseTonePicker"></div>
                                        }
                                        <div class="chat-tone-picker" role="group" aria-label="Skin tones for @toneFamily.Default.Name" @onkeydown="HandleTonePickerKeyDown">
                                            @foreach (var tone in toneFamily.Tones.Where(IsEmojiSupported))
                                            {
                                                <button type="button" title="@tone.Name" aria-label="React with @tone.Name"
                                                        class="@(PreferredEmoji(toneFamily.Default.Emoji) == tone.Emoji ? "selected" : "")"
                                                        @onclick="() => SelectToneAndReactAsync(message.Id, toneFamily.Default.Emoji, tone.Emoji)">@tone.Emoji</button>
                                            }
                                        </div>
                                    }
                                }
                                @if (!message.IsDeleted && message.Reactions.Count > 0)
                                {
                                    <div class="chat-reactions" aria-label="Message reactions">
                                        @foreach (var reaction in message.Reactions)
                                        {
                                            var names = string.Join(", ", reaction.Users.Select(x => x.Name));
                                            var selected = reaction.Users.Any(x => x.Id == currentUserId);
                                            <button type="button" class="chat-reaction @(selected ? "selected" : "")" aria-label="@reaction.Emoji reacted by @names. @(selected ? "Remove your reaction" : "Add your reaction")" aria-pressed="@selected" @onclick="() => ToggleReactionAsync(message.Id, reaction.Emoji)">
                                                <span>@reaction.Emoji</span><span>@reaction.Users.Count</span><span class="chat-reaction-tooltip" role="tooltip">@names</span>
                                            </button>
                                        }
                                    </div>
                                }
                                }
                            </article>
                        }
                    </div>
                    @if (viewingOlderMessages)
                    {
                        <button type="button" class="chat-new-message-jump" @onclick="ReturnToLatestMessagesAsync">Latest messages ↓</button>
                    }
                    else if (NewMessageId is long latestNewMessageId)
                    {
                        <button type="button" class="chat-new-message-jump" data-new-message-id="@latestNewMessageId"
                                @onclick="JumpToNewMessageAsync">New messages ↓</button>
                    }
                    </div>
                    <form class="chat-compose" @onsubmit="SendAsync" @onsubmit:preventDefault>
                        <label class="sr-only" for="chat-message-body">Message</label>
                        <div class="chat-compose-input">
                         @if (messageSchedule is DateTime schedule)
                         {
                             <div class="chat-schedule-summary" role="status"><span>Scheduling message for @ScheduleLabel(schedule)</span><button type="button" aria-label="Remove message schedule" @onclick="() => messageSchedule = null">×</button></div>
                         }
                         @if (replyingTo is { } reply)
                         {
                             <div class="chat-reply-draft">
                                 <span>Replying to <strong>@reply.SenderName</strong></span>
                                 <span class="chat-reply-draft-body">@reply.Body</span>
                                 <button type="button" title="Cancel reply" aria-label="Cancel reply" @onclick="CancelReply">×</button>
                             </div>
                             @if (showThreadReplyOffer)
                             {
                                 <div class="chat-thread-reply-offer">
                                     <span>This is already a reply.</span>
                                     <button type="button" @onclick="() => OfferThreadFromReply(reply)">Start a Thread</button>
                                     <button type="button" @onclick="() => showThreadReplyOffer = false">Reply here</button>
                                 </div>
                             }
                             }
                            <div class="chat-compose-editor-wrap">
                            <div class="chat-markdown-editor chat-draft-editor @(thread.Conversation.Kind == ConversationKind.Channel ? "chat-draft-overlay-active" : "")">
                                <div class="chat-compose-add" data-chat-compose-menu>
                                    <button type="button" class="chat-attach-button" title="Add to message" aria-label="Add to message" aria-haspopup="menu" aria-expanded="@showComposeMenu" @onclick="ToggleComposeMenu">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                                    </button>
                                    <InputFile id="chat-attachment-picker" @key="attachmentInputVersion" class="chat-hidden-file-input" multiple OnChange="SelectAttachmentAsync" aria-label="Upload files" />
                                </div>
                                @if (pendingAttachments.Count > 0)
                                {
                                    <div class="chat-compose-attachment-previews" aria-label="Attached files">
                                        @for (var index = 0; index < pendingAttachments.Count; index++)
                                        {
                                            var attachmentIndex = index;
                                            var pendingFile = pendingAttachments[index];
                                            <div class="chat-compose-attachment-card" title="@pendingFile.FileName">
                                                @if (pendingFile.Kind == ChatAttachmentKind.Image && pendingFile.PreviewUrl.Length > 0)
                                                {
                                                    <img src="@pendingFile.PreviewUrl" alt="@pendingFile.FileName" />
                                                }
                                                else if (pendingFile.Kind == ChatAttachmentKind.Video && pendingFile.PreviewUrl.Length > 0)
                                                {
                                                    <video src="@pendingFile.PreviewUrl" preload="metadata" muted playsinline aria-label="@pendingFile.FileName"></video>
                                                }
                                                else
                                                {
                                                    <svg class="chat-compose-file-icon" viewBox="0 0 32 40" aria-hidden="true" focusable="false"><path d="M4 1h16l10 10v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2Z" fill="currentColor"/><path d="M20 1v9a2 2 0 0 0 2 2h8" fill="#fff" opacity=".78"/></svg>
                                                }
                                                <span class="chat-compose-attachment-name">@pendingFile.FileName</span>
                                                <button type="button" aria-label="Remove @pendingFile.FileName" @onclick="() => RemovePendingAttachment(attachmentIndex)">×</button>
                                            </div>
                                        }
                                    </div>
                                }
                                <button type="button" class="chat-compose-emoji-button chat-compose-gif-button" title="Send a GIF" aria-label="Send a GIF" aria-expanded="@composerEmojiPickerOpen" aria-controls="chat-compose-emoji-picker" @onmousedown:preventDefault="true" @onclick="() => ToggleComposerEmojiPickerAsync(true)"><span aria-hidden="true">GIF</span></button>
                                <button type="button" class="chat-compose-emoji-button" title="Insert emoji" aria-label="Insert emoji" aria-expanded="@composerEmojiPickerOpen" aria-controls="chat-compose-emoji-picker" @onmousedown:preventDefault="true" @onclick="() => ToggleComposerEmojiPickerAsync(false)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8.5 14.2c.8 1.2 2 1.8 3.5 1.8s2.7-.6 3.5-1.8M9 9.5h.01M15 9.5h.01" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                                </button>
                                <div class="chat-draft-source">
                                    @if (thread.Conversation.Kind == ConversationKind.Channel)
                                    {
                                        <div id="chat-draft-preview" class="chat-draft-preview" aria-hidden="true">@RenderDraftBody()</div>
                                    }
                                    <textarea id="chat-message-body" @ref="messageBodyInput" rows="1" maxlength="4000" placeholder="Write a message" value="@draft"
                                              @oninput="HandleDraftInputAsync" @onkeyup="HandleDraftCaretAsync"
                                              @onfocus="MarkCurrentConversationReadAsync" @onclick="HandleDraftClickAsync"
                                              aria-controls="chat-mention-menu" aria-expanded="@mentionMenuOpen"></textarea>
                                </div>
                                @if (ChatMarkdown.ToPreviewHtml(draft) is { } draftPreviewHtml)
                                {
                                    <div class="chat-message-body chat-markdown-preview" role="region" aria-label="Markdown preview">@((MarkupString)draftPreviewHtml)</div>
                                }
                            </div>
                            @if (showComposeMenu)
                            {
                                <div class="chat-compose-add-menu" data-chat-compose-menu role="menu">
                                    <label role="menuitem" for="chat-attachment-picker" tabindex="0" @onkeydown="HandleAttachmentLabelKeyDown">Upload a File</label>
                                    @if (thread.Conversation.Kind == ConversationKind.Channel)
                                    {
                                        <button type="button" role="menuitem" @onclick="BeginCreateThread">Create Thread</button>
                                    }
                                    <button type="button" role="menuitem" @onclick="() => BeginPoll(false)">Create Poll</button>
                                    <ChatMessageScheduleMenu Selected="SetMessageSchedule" Custom="() => OpenCustomMessageSchedule(false)" />
                                </div>
                            }
                            @if (composerEmojiPickerOpen)
                            {
                                <div id="chat-compose-emoji-picker" class="chat-emoji-picker chat-compose-emoji-picker" role="dialog" aria-label="Choose emoji or GIFs" @onkeydown="HandleComposerEmojiPickerKeyDown" @onclick:stopPropagation>
                                    <div class="chat-picker-tabs" role="tablist" aria-label="Emoji and GIFs"><button type="button" role="tab" aria-selected="@(composerGifTab ? "true" : "false")" @onclick="() => composerGifTab = true">GIFs</button><button type="button" role="tab" aria-selected="@(composerGifTab ? "false" : "true")" @onclick="() => composerGifTab = false">Emoji</button></div>
                                    @if (composerGifTab) { <ChatGifPicker Selected="id => SendSelectedGifAsync(id, false)" /> }
                                    else
                                    {
                                    <label class="sr-only" for="chat-compose-emoji-search">Find an emoji</label>
                                    <input id="chat-compose-emoji-search" placeholder="Find an Emoji" @bind="emojiSearch" @bind:event="oninput" />
                                    <div class="chat-emoji-groups" aria-label="Emoji categories">
                                        @foreach (var group in ChatEmojiCatalog.Groups)
                                        {
                                            <button type="button" class="@(emojiGroup == group ? "selected" : "")" title="@group" aria-label="@group" aria-pressed="@(emojiGroup == group)" @onclick="() => SelectEmojiGroup(group)">
                                                <svg aria-hidden="true" focusable="false"><use href="@GetEmojiGroupIcon(group)" /></svg>
                                            </button>
                                        }
                                    </div>
                                    <div class="chat-emoji-grid">
                                        @foreach (var family in VisibleEmojiFamilies)
                                        {
                                            <button type="button" title="Insert @family.Default.Name" aria-label="Insert @family.Default.Name" @onclick="() => InsertComposerEmojiAsync(PreferredEmoji(family.Default.Emoji))">@PreferredEmoji(family.Default.Emoji)</button>
                                        }
                                    </div>
                                    @if (!VisibleEmojiFamilies.Any()) { <p class="chat-emoji-empty">No matching emoji.</p> }
                                    }
                                </div>
                            }
                            </div>
                            @if (mentionMenuOpen && thread.Conversation.Kind == ConversationKind.Channel)
                            {
                                var mentionOptions = MentionOptions;
                                <div @key="(mentionStart, mentionQuery)" id="chat-mention-menu" class="chat-mention-menu" role="listbox" aria-label="Tag a channel member">
                                    <button id="chat-mention-dismiss" type="button" class="chat-mention-dismiss" aria-label="Close tag suggestions" @onclick="() => mentionMenuOpen = false">×</button>
                                    @for (var index = 0; index < mentionOptions.Count; index++)
                                    {
                                        var option = mentionOptions[index];
                                        <button type="button" role="option" aria-selected="@(index == 0 ? "true" : "false")" @onclick="() => SelectMentionAsync(option.Tag)">
                                            <strong>@@@option.Tag</strong>
                                            @if (option.Description is not null) { <span>@option.Description</span> }
                                        </button>
                                    }
                                    @if (mentionOptions.Count == 0) { <p>No matching members.</p> }
                                </div>
                            }
                        </div>
                        <button type="submit" class="button button-primary" disabled="@(string.IsNullOrWhiteSpace(draft) && pendingAttachments.Count == 0)">Send</button>
                    </form>
                }
            </div>
            @if (isCreatingChannelThread && fullChannelThreadId is null)
            {
                <aside class="chat-channel-thread-sidebar chat-channel-thread-create-sidebar" aria-label="Create a channel thread">
                    <header>
                        <strong>New Thread</strong>
                        <button type="button" aria-label="Cancel creating thread" @onclick="CancelCreateThread">×</button>
                    </header>
                    @if (threadSourceMessageId is long sourceId
                        && thread?.Messages.FirstOrDefault(message => message.Id == sourceId)?.Body is { } sourceBody)
                    {
                        <p class="chat-thread-source">Starting from this reply: @sourceBody</p>
                    }
                    <form class="chat-channel-thread-create-form" @onsubmit="CreateThreadAsync" @onsubmit:preventDefault>
                        <label for="chat-thread-title-input">Thread name</label>
                        <input id="chat-thread-title-input" maxlength="120" placeholder="Thread name" @bind="newThreadTitle" @bind:event="oninput" />
                        <label for="chat-thread-first-message">First message</label>
                        <textarea id="chat-thread-first-message" rows="4" maxlength="4000" placeholder="Add the first message" @bind="newThreadMessage" @bind:event="oninput"></textarea>
                        <div class="chat-channel-thread-create-actions">
                            <button type="button" class="button button-secondary" @onclick="CancelCreateThread">Cancel</button>
                            <button type="submit" class="button button-primary" disabled="@(string.IsNullOrWhiteSpace(newThreadTitle) || string.IsNullOrWhiteSpace(newThreadMessage))">Start Thread</button>
                        </div>
                    </form>
                </aside>
            }
            else if (sidebarThread is { } selectedChannelThread && fullChannelThreadId is null)
            {
                <aside class="chat-channel-thread-sidebar" aria-label="Thread: @selectedChannelThread.ChannelThread?.Title">
                    <header>
                        <button type="button" class="chat-channel-thread-sidebar-title" title="Open thread in full view" @onclick="() => OpenChannelThreadFullAsync(selectedChannelThread.ChannelThread!.Id)">
                            <svg class="chat-thread-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M6 4v16M6 8h9a3 3 0 0 1 0 6h-5"/><circle cx="6" cy="4" r="1"/><circle cx="10" cy="14" r="1"/></svg> @selectedChannelThread.ChannelThread?.Title <span aria-hidden="true">↗</span>
                        </button>
                        <button type="button" aria-label="Close thread" @onclick="CloseChannelThreadSidebar">×</button>
                    </header>
                    @if (selectedChannelThread.ChannelThread?.StartedFromMessage is { } sourceMessage)
                    {
                        <p class="chat-thread-source">Started from a reply: @sourceMessage</p>
                    }
                    <div class="chat-channel-thread-sidebar-actions">
                        <button type="button" aria-expanded="@showSidebarPins" @onclick="() => showSidebarPins = !showSidebarPins">Pinned (@selectedChannelThread.PinnedMessages.Count)</button>
                    </div>
                    @if (showSidebarPins)
                    {
                        <div class="chat-channel-thread-pins">
                            @if (selectedChannelThread.PinnedMessages.Count == 0) { <p>No pinned messages.</p> }
                            @foreach (var pinned in selectedChannelThread.PinnedMessages)
                            {
                                <div><strong>@pinned.SenderName</strong><p>@pinned.Body</p><button type="button" @onclick="args => RequestPinMessageAsync(pinned.Id, false, args.ShiftKey)">Unpin</button></div>
                            }
                        </div>
                    }
                    <div id="chat-sidebar-message-history" class="chat-channel-thread-sidebar-messages" role="log" aria-label="Thread messages">
                        @foreach (var entry in selectedChannelThread.Messages)
                        {
                            @if (entry.Type is ChatMessageType.Text or ChatMessageType.Poll)
                            {
                                <article @key="entry.Id" data-chat-message-id="@entry.Id" class="chat-channel-thread-entry">
                                    <div><strong>@entry.SenderName</strong><time datetime="@entry.SentAtUtc.ToString("O")">@entry.SentAtUtc.ToLocalTime().ToString("g")</time></div>
                                    @if (entry.ReplyToBody is { } replyBody) { <small>↳ @replyBody</small> }
                                    @if (entry.Attachments.Count == 0 || !string.Equals(entry.Body, "Shared a file", StringComparison.Ordinal))
                                    {
                                        <div class="chat-message-body">@if (entry.Poll is not null) { <ChatPollCard Message="entry" PictureUrlForUser="PictureUrl" Vote="answerId => VotePollAsync(entry.Id, answerId)" /> } else if (entry.GiphyId is { } gifId) { <ChatGifImage @key="gifId" GiphyId="@gifId" Expanded="OpenExpandedGif" /> } else { @RenderMessageBody(entry) }</div>
                                    }
                                    @foreach (var attachment in entry.Attachments)
                                    {
                                        <div class="chat-attachment">
                                            @if (attachment.Kind == ChatAttachmentKind.Image)
                                            {
                                                <div class="chat-attachment-media">
                                                    <button type="button" class="chat-attachment-image-button" aria-label="Expand @attachment.FileName" @onclick="() => OpenExpandedAttachment(attachment)">
                                                        <img src="@AttachmentUrl(attachment.Id)" alt="@attachment.FileName" loading="lazy" />
                                                    </button>
                                                </div>
                                            }
                                            else if (attachment.Kind == ChatAttachmentKind.Video)
                                            {
                                                <div class="chat-attachment-media">
                                                    <video src="@AttachmentUrl(attachment.Id)" controls preload="metadata" playsinline aria-label="@attachment.FileName"></video>
                                                    <a class="chat-attachment-download" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false" title="Download @attachment.FileName" aria-label="Download @attachment.FileName">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                    </a>
                                                </div>
                                            }
                                            else if (attachment.Kind == ChatAttachmentKind.Text)
                                            {
                                                var language = GetTextLanguage(attachment.Id, attachment.FileName);
                                                <div class="chat-attachment-code-card">
                                                    <pre id="chat-code-@entry.Id" class="chat-attachment-code-preview @(IsTextExpanded(attachment.Id) ? "expanded" : "") @(IsWordWrapEnabled(attachment.Id) ? "wrapped" : "unwrapped")"><code>@((MarkupString)ChatTextHighlighter.ToSafeHtml(IsTextExpanded(attachment.Id) ? attachment.Text : PreviewText(attachment.Text), language))</code></pre>
                                                    <div class="chat-attachment-code-toolbar">
                                                        <button type="button" class="chat-code-caret" title="@(IsTextExpanded(attachment.Id) ? "Collapse preview" : "Show all lines")" aria-label="@(IsTextExpanded(attachment.Id) ? "Collapse preview" : "Show all lines")" aria-expanded="@(IsTextExpanded(attachment.Id) ? "true" : "false")" aria-controls="chat-code-@entry.Id" @onclick="() => ToggleTextExpanded(attachment.Id)">
                                                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                        </button>
                                                        <div class="chat-code-file-details"><span title="@attachment.FileName">@attachment.FileName</span><small>@FormatFileSize(attachment.Size)</small></div>
                                                        <div class="chat-code-actions">
                                                            <button type="button" title="Language: @ChatTextHighlighter.Label(language)" aria-label="Change language, currently @ChatTextHighlighter.Label(language)" aria-haspopup="menu" aria-expanded="@(textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Language && !textMenuInExpandedViewer ? "true" : "false")" data-chat-text-menu-trigger @onclick="() => ToggleTextMenu(attachment.Id, TextAttachmentMenu.Language)"><span aria-hidden="true">&lt;&gt;</span></button>
                                                            <button type="button" title="Open full text viewer" aria-label="Open full text viewer" @onclick="() => OpenExpandedAttachment(attachment)"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 4H4v4m0-4 6 6m6 10h4v-4m0 4-6-6M16 4h4v4m0-4-6 6M8 20H4v-4m0 4 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
                                                            <button type="button" title="File options" aria-label="File options" aria-haspopup="menu" aria-expanded="@(textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Options && !textMenuInExpandedViewer ? "true" : "false")" data-chat-text-menu-trigger @onclick="() => ToggleTextMenu(attachment.Id, TextAttachmentMenu.Options)">⋯</button>
                                                        </div>
                                                    </div>
                                                    @if (textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Language && !textMenuInExpandedViewer)
                                                    {
                                                        <div class="chat-code-menu chat-code-language-menu" role="menu" data-chat-text-menu>
                                                            <strong>Language</strong>
                                                            @foreach (var choice in ChatTextHighlighter.Languages)
                                                            {
                                                                <button type="button" role="menuitemradio" aria-checked="@(language == choice.Language ? "true" : "false")" @onclick="() => SetTextLanguage(attachment.Id, choice.Language)">@choice.Label</button>
                                                            }
                                                        </div>
                                                    }
                                                    else if (textMenuMessageId == attachment.Id && textMenuKind == TextAttachmentMenu.Options && !textMenuInExpandedViewer)
                                                    {
                                                        <div class="chat-code-menu chat-code-options-menu" role="menu" data-chat-text-menu>
                                                            <a role="menuitem" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false">Download file</a>
                                                            <label><input type="checkbox" checked="@IsWordWrapEnabled(attachment.Id)" @onchange="args => SetWordWrap(attachment.Id, args.Value is true)" /> Word wrap</label>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="chat-attachment-file-card">
                                                    <svg class="chat-attachment-file-icon" viewBox="0 0 32 40" aria-hidden="true" focusable="false"><path d="M4 1h16l10 10v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2Z" fill="currentColor"/><path d="M20 1v9a2 2 0 0 0 2 2h8" fill="#fff" opacity=".78"/></svg>
                                                    <div class="chat-attachment-file-details">
                                                        <a class="chat-attachment-file-name chat-attachment-file-name-link" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false" title="Download @attachment.FileName">@attachment.FileName</a>
                                                        <span class="chat-attachment-file-size">@FormatFileSize(attachment.Size)</span>
                                                    </div>
                                                    <a class="chat-attachment-download" href="@AttachmentDownloadUrl(attachment.Id)" download="@attachment.FileName" data-enhance-nav="false" title="Download @attachment.FileName" aria-label="Download @attachment.FileName">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (entry.Type == ChatMessageType.Text)
                                    {
                                    <div class="chat-channel-thread-entry-actions">
                                        <button type="button" @onclick="() => sidebarReplyingTo = entry">Reply</button>
                                        <button type="button" @onclick="args => RequestPinMessageAsync(entry.Id, entry.PinnedAtUtc is null, args.ShiftKey)">@(entry.PinnedAtUtc is null ? "Pin" : "Unpin")</button>
                                    </div>
                                    }
                                </article>
                            }
                        }
                    </div>
                    @if (sidebarMessageSchedule is DateTime sidebarSchedule)
                    {
                        <div class="chat-schedule-summary" role="status"><span>Scheduling message for @ScheduleLabel(sidebarSchedule)</span><button type="button" aria-label="Remove message schedule" @onclick="() => sidebarMessageSchedule = null">×</button></div>
                    }
                    <form id="chat-sidebar-thread-compose" class="chat-compose chat-channel-thread-compose" @onsubmit="SendSidebarThreadAsync" @onsubmit:preventDefault>
                        <div class="chat-compose-input">
                            @if (sidebarReplyingTo is { } sideReply)
                            {
                                <div class="chat-reply-draft">Replying to @sideReply.SenderName: @sideReply.Body <button type="button" @onclick="() => sidebarReplyingTo = null">×</button></div>
                            }
                            <label class="sr-only" for="chat-sidebar-thread-draft">Message</label>
                            <div class="chat-compose-editor-wrap">
                                <div class="chat-markdown-editor chat-draft-editor">
                                    <div class="chat-compose-add" data-chat-compose-menu>
                                        <button type="button" class="chat-attach-button" title="Add to message" aria-label="Add to message" aria-haspopup="menu" aria-expanded="@showSidebarComposeMenu" @onclick="ToggleSidebarComposeMenu">
                                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                                        </button>
                                        <InputFile id="chat-sidebar-attachment-picker" @key="sidebarAttachmentInputVersion" class="chat-hidden-file-input" multiple OnChange="SelectSidebarAttachmentAsync" aria-label="Upload files" />
                                    </div>
                                    @if (sidebarPendingAttachments.Count > 0)
                                    {
                                        <div class="chat-compose-attachment-previews" aria-label="Attached files">
                                            @for (var index = 0; index < sidebarPendingAttachments.Count; index++)
                                            {
                                                var attachmentIndex = index;
                                                var sidebarFile = sidebarPendingAttachments[index];
                                                <div class="chat-compose-attachment-card" title="@sidebarFile.FileName">
                                                    @if (sidebarFile.Kind == ChatAttachmentKind.Image && sidebarFile.PreviewUrl.Length > 0)
                                                    {
                                                        <img src="@sidebarFile.PreviewUrl" alt="@sidebarFile.FileName" />
                                                    }
                                                    else if (sidebarFile.Kind == ChatAttachmentKind.Video && sidebarFile.PreviewUrl.Length > 0)
                                                    {
                                                        <video src="@sidebarFile.PreviewUrl" preload="metadata" muted playsinline aria-label="@sidebarFile.FileName"></video>
                                                    }
                                                    else
                                                    {
                                                        <svg class="chat-compose-file-icon" viewBox="0 0 32 40" aria-hidden="true" focusable="false"><path d="M4 1h16l10 10v26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2Z" fill="currentColor"/><path d="M20 1v9a2 2 0 0 0 2 2h8" fill="#fff" opacity=".78"/></svg>
                                                    }
                                                    <span class="chat-compose-attachment-name">@sidebarFile.FileName</span>
                                                    <button type="button" aria-label="Remove @sidebarFile.FileName" @onclick="() => RemoveSidebarAttachment(attachmentIndex)">×</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <button type="button" class="chat-compose-emoji-button chat-compose-gif-button" title="Send a GIF" aria-label="Send a GIF" aria-expanded="@sidebarComposerEmojiPickerOpen" aria-controls="chat-sidebar-compose-emoji-picker" @onmousedown:preventDefault="true" @onclick="() => ToggleSidebarComposerEmojiPickerAsync(true)"><span aria-hidden="true">GIF</span></button>
                                <button type="button" class="chat-compose-emoji-button" title="Insert emoji" aria-label="Insert emoji" aria-expanded="@sidebarComposerEmojiPickerOpen" aria-controls="chat-sidebar-compose-emoji-picker" @onmousedown:preventDefault="true" @onclick="() => ToggleSidebarComposerEmojiPickerAsync(false)">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8.5 14.2c.8 1.2 2 1.8 3.5 1.8s2.7-.6 3.5-1.8M9 9.5h.01M15 9.5h.01" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                                    </button>
                                    <textarea id="chat-sidebar-thread-draft" rows="1" maxlength="4000" placeholder="Reply in thread" value="@sidebarDraft" @oninput="HandleSidebarDraftInput"></textarea>
                                </div>
                                @if (showSidebarComposeMenu)
                                {
                                    <div class="chat-compose-add-menu" data-chat-compose-menu role="menu">
                                        <label role="menuitem" for="chat-sidebar-attachment-picker" tabindex="0" @onkeydown="HandleSidebarAttachmentLabelKeyDown">Upload a File</label>
                                        <button type="button" role="menuitem" @onclick="() => BeginPoll(true)">Create Poll</button>
                                        <ChatMessageScheduleMenu Selected="SetSidebarMessageSchedule" Custom="() => OpenCustomMessageSchedule(true)" />
                                    </div>
                                }
                                @if (sidebarComposerEmojiPickerOpen)
                                {
                                    <div id="chat-sidebar-compose-emoji-picker" class="chat-emoji-picker chat-compose-emoji-picker" role="dialog" aria-label="Choose emoji or GIFs" @onkeydown="HandleSidebarComposerEmojiPickerKeyDown" @onclick:stopPropagation>
                                        <div class="chat-picker-tabs" role="tablist" aria-label="Emoji and GIFs"><button type="button" role="tab" aria-selected="@(sidebarGifTab ? "true" : "false")" @onclick="() => sidebarGifTab = true">GIFs</button><button type="button" role="tab" aria-selected="@(sidebarGifTab ? "false" : "true")" @onclick="() => sidebarGifTab = false">Emoji</button></div>
                                    @if (sidebarGifTab) { <ChatGifPicker Selected="id => SendSelectedGifAsync(id, true)" /> }
                                    else
                                    {
                                    <label class="sr-only" for="chat-sidebar-compose-emoji-search">Find an emoji</label>
                                        <input id="chat-sidebar-compose-emoji-search" placeholder="Find an Emoji" @bind="emojiSearch" @bind:event="oninput" />
                                        <div class="chat-emoji-groups" aria-label="Emoji categories">
                                            @foreach (var group in ChatEmojiCatalog.Groups)
                                            {
                                                <button type="button" class="@(emojiGroup == group ? "selected" : "")" title="@group" aria-label="@group" aria-pressed="@(emojiGroup == group)" @onclick="() => SelectEmojiGroup(group)">
                                                    <svg aria-hidden="true" focusable="false"><use href="@GetEmojiGroupIcon(group)" /></svg>
                                                </button>
                                            }
                                        </div>
                                        <div class="chat-emoji-grid">
                                            @foreach (var family in VisibleEmojiFamilies)
                                            {
                                                <button type="button" title="Insert @family.Default.Name" aria-label="Insert @family.Default.Name" @onclick="() => InsertSidebarComposerEmojiAsync(PreferredEmoji(family.Default.Emoji))">@PreferredEmoji(family.Default.Emoji)</button>
                                            }
                                        </div>
                                        @if (!VisibleEmojiFamilies.Any()) { <p class="chat-emoji-empty">No matching emoji.</p> }
                                    }
                                    </div>
                                }
                            </div>
                        </div>
                        <button type="submit" class="button button-primary" disabled="@(string.IsNullOrWhiteSpace(sidebarDraft) && sidebarPendingAttachments.Count == 0)">Send</button>
                    </form>
                </aside>
            }
            @if (showMembers && thread is not null && thread.Conversation.Kind is ConversationKind.Channel or ConversationKind.Group)
            {
                <aside id="chat-members-sidebar" class="chat-members-sidebar" aria-label="@(thread.Conversation.Kind == ConversationKind.Group ? "Group chat members" : "Channel members")">
                    <header class="chat-members-header">
                        <strong>Members <span>(@thread.Members.Count)</span></strong>
                        <button type="button" class="chat-icon-button" aria-label="Close members" @onclick="() => showMembers = false">×</button>
                    </header>
                    <div class="chat-members-list">
                        <section aria-labelledby="chat-members-online-heading">
                            <h3 id="chat-members-online-heading">Online — <span>@(thread.Members.Count(member => IsMemberOnline(member.Id)))</span></h3>
                            @foreach (var member in thread.Members.Where(member => IsMemberOnline(member.Id)))
                            {
                                <div class="chat-member-card">
                                    <button type="button" class="chat-avatar chat-member-avatar chat-profile-picture-button"
                                            aria-label="Open profile for @member.Name" aria-haspopup="dialog" aria-controls="chat-user-popover"
                                            data-chat-profile-anchor="@MemberAvatarAnchorKey(member.Id)"
                                            aria-expanded="@(profileAnchorKey == MemberAvatarAnchorKey(member.Id))"
                                            @onclick="() => ToggleMessageProfile(member.Id, member.Name, MemberAvatarAnchorKey(member.Id))">
                                        @if (PictureUrl(member.Id) is { } memberPictureUrl) { <img src="@memberPictureUrl" alt="" /> }
                                        else { @Initials(member.Name) }
                                        <span class="chat-presence-dot @PresenceClass(member.Id)" title="@PresenceDescription(member.Id)"></span>
                                    </button>
                                    <span class="chat-member-copy">
                                        <button type="button"
                                                    class="chat-member-link"
                                                    title="@PresenceDescription(member.Id)"
                                                    data-chat-profile-anchor="@MemberAnchorKey(member.Id)"
                                                    aria-haspopup="dialog"
                                                    aria-controls="chat-user-popover"
                                                    aria-expanded="@(profileAnchorKey == MemberAnchorKey(member.Id))"
                                                    @onclick="() => ToggleMessageProfile(
                                                        member.Id,
                                                        member.Name,
                                                        MemberAnchorKey(member.Id))">
                                                @member.Name
                                            </button>

                                        <span>
                                            @PresenceOf(member.Id)?.StatusEmoji @PresenceOf(member.Id)?.StatusMessage
                                        </span>
                                    </span>
                                    @if (thread.Conversation.IsOwner && thread.Conversation.Visibility == ChannelVisibility.Private && member.Id != currentUserId)
                                    {
                                        <button type="button" class="chat-member-remove" aria-label="Remove @member.Name" @onclick="() => RemoveMemberAsync(member.Id)">×</button>
                                    }
                                </div>
                            }
                        </section>
                        <section aria-labelledby="chat-members-offline-heading">
                            <h3 id="chat-members-offline-heading">Offline — <span>@(thread.Members.Count(member => !IsMemberOnline(member.Id)))</span></h3>
                            @foreach (var member in thread.Members.Where(member => !IsMemberOnline(member.Id)))
                            {
                                <div class="chat-member-card">
                                    <button type="button" class="chat-avatar chat-member-avatar chat-profile-picture-button"
                                            aria-label="Open profile for @member.Name" aria-haspopup="dialog" aria-controls="chat-user-popover"
                                            data-chat-profile-anchor="@MemberAvatarAnchorKey(member.Id)"
                                            aria-expanded="@(profileAnchorKey == MemberAvatarAnchorKey(member.Id))"
                                            @onclick="() => ToggleMessageProfile(member.Id, member.Name, MemberAvatarAnchorKey(member.Id))">
                                        @if (PictureUrl(member.Id) is { } memberPictureUrl)
                                        {
                                            <img src="@memberPictureUrl" alt="" />
                                        }
                                        else
                                        {
                                            @Initials(member.Name)
                                        }
                                        <span class="chat-presence-dot @PresenceClass(member.Id)"
                                                title="@PresenceDescription(member.Id)"></span>
                                    </button>

                                    <span class="chat-member-copy">
                                        <button type="button"
                                                    class="chat-member-link"
                                                    title="@PresenceDescription(member.Id)"
                                                    data-chat-profile-anchor="@MemberAnchorKey(member.Id)"
                                                    aria-haspopup="dialog"
                                                    aria-controls="chat-user-popover"
                                                    aria-expanded="@(profileAnchorKey == MemberAnchorKey(member.Id))"
                                                    @onclick="() => ToggleMessageProfile(
                                                        member.Id,
                                                        member.Name,
                                                        MemberAnchorKey(member.Id))">
                                                @member.Name
                                            </button>

                                        <span>
                                            @PresenceOf(member.Id)?.StatusEmoji @PresenceOf(member.Id)?.StatusMessage
                                        </span>
                                    </span>

                                    @if (thread.Conversation.IsOwner &&
                                            thread.Conversation.Visibility == ChannelVisibility.Private &&
                                            member.Id != currentUserId)
                                    {
                                        <button type="button"
                                                class="chat-member-remove"
                                                aria-label="Remove @member.Name"
                                                @onclick="() => RemoveMemberAsync(member.Id)">×</button>
                                    }
                                </div>
                            }
                     </section>
                    </div>
                    @if (thread.Conversation.IsOwner && thread.Conversation.Visibility == ChannelVisibility.Private)
                    {
                        <div class="chat-members-add">
                            <label for="chat-add-member">Add member</label>
                            <select id="chat-add-member" @bind="addMemberId"><option value="">Select a user</option>
                                @foreach (var user in users.Where(x => thread.Members.All(m => m.Id != x.Id))) { <option value="@user.Id">@user.Name</option> }
                            </select>
                            <button type="button" class="button button-secondary" disabled="@string.IsNullOrEmpty(addMemberId)" @onclick="AddMemberAsync">Add member</button>
                        </div>
                    }
                </aside>
            }
        </div>
        @if (profileUserId is not null)
        {
            <div id="chat-user-popover" class="chat-user-popover" role="dialog" aria-label="@profileUserName profile">
                <div class="chat-user-popover-heading">
                    @if (PictureUrl(profileUserId) is { } messageProfilePictureUrl)
                    {
                        <button type="button" class="chat-avatar chat-user-popover-avatar chat-user-picture-button"
                                aria-label="Expand profile picture for @profileUserName" aria-haspopup="dialog"
                                @onclick="() => OpenExpandedProfilePicture(messageProfilePictureUrl, profileUserName)">
                            <img src="@messageProfilePictureUrl" alt="" />
                            <span class="chat-presence-dot @PresenceClass(profileUserId)" aria-hidden="true"></span>
                        </button>
                    }
                    else
                    {
                        <span class="chat-avatar chat-user-popover-avatar" aria-hidden="true">
                            @Initials(profileUserName)
                            <span class="chat-presence-dot @PresenceClass(profileUserId)" title="@PresenceDescription(profileUserId)"></span>
                        </span>
                    }
                    <span class="chat-user-popover-identity">
                        <button type="button" class="chat-user-popover-name" @onclick="() => OpenDirectFromMessageAsync(profileUserId)">@profileUserName</button>
                        @if (PresenceOf(profileUserId) is { } profilePresence &&
                            (!string.IsNullOrWhiteSpace(profilePresence.StatusEmoji) || !string.IsNullOrWhiteSpace(profilePresence.StatusMessage)))
                        {
                            <span class="chat-user-popover-status">@profilePresence.StatusEmoji @profilePresence.StatusMessage</span>
                        }
                    </span>
                    <button type="button" class="chat-user-popover-close" aria-label="Close profile" @onclick="CloseMessageProfile">×</button>
                </div>
                <form class="chat-user-popover-compose" @onsubmit="SendMessageProfileAsync" @onsubmit:preventDefault>
                    <label class="sr-only" for="chat-user-popover-message">Message @profileUserName</label>
                    <textarea id="chat-user-popover-message" rows="2" maxlength="4000" placeholder="Message @profileUserName" @bind="profileDraft" @bind:event="oninput"></textarea>
                    <button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(profileDraft)">Send</button>
                </form>
            </div>
        }
    </section>
    @if (expandedAttachment is not null || expandedGif is not null || expandedProfilePicture is not null)
    {
        var expanded = expandedAttachment;
        var expandedTitle = expandedProfilePicture?.Title ?? expandedGif?.Title ?? expanded!.FileName;
        var expandedImageUrl = expandedProfilePicture?.Url ?? expandedGif?.Url ?? AttachmentUrl(expanded!.Id);
        var isExpandedImage = expandedProfilePicture is not null || expandedGif is not null || expanded?.Kind == ChatAttachmentKind.Image;
        <div class="chat-attachment-backdrop" @onclick="CloseExpandedAttachment">
            <section class="chat-attachment-dialog @(expandedProfilePicture is not null ? "chat-profile-picture-viewer" : null)" role="dialog" aria-modal="true" aria-label="@expandedTitle" @onclick:stopPropagation @onkeydown="HandleAttachmentDialogKeyDown">
                @if (expandedProfilePicture is null)
                {
                <header>
                    <strong>@expandedTitle</strong>
                    @if (isExpandedImage)
                    {
                        <div class="chat-attachment-image-tools">
                            <button type="button" title="@(expandedImageZoomed ? "Zoom out" : "Zoom in")" aria-label="@(expandedImageZoomed ? "Zoom out" : "Zoom in")" @onclick="ToggleExpandedImageZoom">
                                @if (expandedImageZoomed)
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5M8 10.5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5M8 10.5h5m-2.5-2.5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                }
                            </button>
                            <a href="@expandedImageUrl" target="_blank" rel="noopener noreferrer" aria-label="Open image in new tab" title="Open image in new tab">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 4h6v6m0-6-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                            @if (expanded is not null)
                            {
                                <a href="@AttachmentDownloadUrl(expanded.Id)" download="@expanded.FileName" data-enhance-nav="false" aria-label="Download image" title="Download image">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </a>
                            }
                        </div>
                    }
                    else if (expanded?.Kind == ChatAttachmentKind.Text)
                    {
                        var expandedLanguage = GetTextLanguage(expanded.Id, expanded.FileName);
                        <div class="chat-attachment-dialog-text-tools">
                            <button type="button" title="Language: @ChatTextHighlighter.Label(expandedLanguage)" aria-label="Change language, currently @ChatTextHighlighter.Label(expandedLanguage)" aria-haspopup="menu" aria-expanded="@(textMenuMessageId == expanded.Id && textMenuKind == TextAttachmentMenu.Language && textMenuInExpandedViewer ? "true" : "false")" data-chat-text-menu-trigger @onclick="() => ToggleTextMenu(expanded.Id, TextAttachmentMenu.Language, true)"><span aria-hidden="true">&lt;&gt;</span></button>
                            <button type="button" title="File options" aria-label="File options" aria-haspopup="menu" aria-expanded="@(textMenuMessageId == expanded.Id && textMenuKind == TextAttachmentMenu.Options && textMenuInExpandedViewer ? "true" : "false")" data-chat-text-menu-trigger @onclick="() => ToggleTextMenu(expanded.Id, TextAttachmentMenu.Options, true)">⋯</button>
                            @if (textMenuMessageId == expanded.Id && textMenuKind == TextAttachmentMenu.Language && textMenuInExpandedViewer)
                            {
                                <div class="chat-code-menu chat-code-language-menu" role="menu" data-chat-text-menu>
                                    <strong>Language</strong>
                                    @foreach (var choice in ChatTextHighlighter.Languages)
                                    {
                                        <button type="button" role="menuitemradio" aria-checked="@(expandedLanguage == choice.Language ? "true" : "false")" @onclick="() => SetTextLanguage(expanded.Id, choice.Language)">@choice.Label</button>
                                    }
                                </div>
                            }
                            else if (textMenuMessageId == expanded.Id && textMenuKind == TextAttachmentMenu.Options && textMenuInExpandedViewer)
                            {
                                <div class="chat-code-menu chat-code-options-menu" role="menu" data-chat-text-menu>
                                    <a role="menuitem" href="@AttachmentDownloadUrl(expanded.Id)" download="@expanded.FileName" data-enhance-nav="false">Download file</a>
                                    <label><input type="checkbox" checked="@IsWordWrapEnabled(expanded.Id)" @onchange="args => SetWordWrap(expanded.Id, args.Value is true)" /> Word wrap</label>
                                </div>
                            }
                        </div>
                    }
                    <button type="button" @ref="attachmentDialogCloseButton" aria-label="Close expanded file" @onclick="CloseExpandedAttachment">×</button>
                </header>
                }
                @if (isExpandedImage)
                {
                    <div class="chat-attachment-image-viewport @(expandedImageZoomed ? "zoomed" : null)">
                        <img src="@expandedImageUrl" alt="@expandedTitle" @ref="expandedImageElement"
                             role="button" tabindex="0" aria-label="@(expandedImageZoomed ? "Zoom out" : "Zoom in")"
                             @onclick="ToggleExpandedImageZoom" @onkeydown="HandleExpandedImageKeyDown" />
                    </div>
                }
                else if (expanded?.Kind == ChatAttachmentKind.Video)
                {
                    <video src="@AttachmentUrl(expanded.Id)" controls autoplay playsinline></video>
                }
                else if (expanded?.Kind == ChatAttachmentKind.Text)
                {
                    <pre class="chat-attachment-full-text @(IsWordWrapEnabled(expanded.Id) ? "wrapped" : "unwrapped")"><code>@((MarkupString)ChatTextHighlighter.ToSafeHtml(expanded.Text, GetTextLanguage(expanded.Id, expanded.FileName)))</code></pre>
                }
                @if (expanded?.Kind == ChatAttachmentKind.Video)
                {
                    <a class="chat-attachment-dialog-download" href="@AttachmentDownloadUrl(expanded.Id)" download="@expanded.FileName" data-enhance-nav="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 16v4h14v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Download file
                    </a>
                }
            </section>
        </div>
    }
    @if (showNewMessageCard && currentUserId is { } newMessageUserId)
    {
        <div class="chat-delete-backdrop">
            <ChatNewMessage Users="users" CurrentUserId="@newMessageUserId" PictureUrl="PictureUrl" Created="OpenCreatedMessageAsync" Closed="CloseNewMessage" />
        </div>
    }
    @if (showCreateChannelCard)
    {
        <div class="chat-delete-backdrop" @onclick="CancelNewChannel">
            <section class="chat-delete-dialog chat-channel-create-card" role="dialog" aria-modal="true" aria-label="Create Channel" @onclick:stopPropagation @onkeydown="HandleCreateChannelCardKeyDown">
                    <h3>New Channel</h3>
                    @if (newChannelGroupId is long destinationId)
                    {
                        <p class="chat-channel-destination">In @(channelGroups.FirstOrDefault(x => x.Id == destinationId)?.Name ?? "folder")</p>
                    }
                    <label for="chat-channel-name">Name</label>
                    <input id="chat-channel-name" @ref="channelCardNameInput" maxlength="120" @bind="channelName" @bind:event="oninput" />
                    <label for="chat-channel-visibility">Visibility</label>
                    <select id="chat-channel-visibility" @bind="channelVisibility">
                        <option value="@ChannelVisibility.Public">Public</option>
                        <option value="@ChannelVisibility.Private">Private</option>
                    </select>
                    @if (channelVisibility == ChannelVisibility.Private)
                    {
                        <fieldset class="chat-member-choices">
                            <legend>Initial Members</legend>
                            @foreach (var user in users)
                            {
                                <label><input type="checkbox" checked="@initialMembers.Contains(user.Id)" @onchange="e => ToggleInitialMember(user.Id, e.Value is true)" /> @user.Name</label>
                            }
                        </fieldset>
                    }
                    else { <p>All active users are added to public channels.</p> }
                    <div class="chat-form-actions">
                        <button type="button" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(channelName)" @onclick="CreateChannelAsync">Create Channel</button>
                        <button type="button" class="button button-secondary" @onclick="CancelNewChannel">Cancel</button>
                    </div>
                @if (error is not null) { <p class="chat-card-error">@error</p> }
            </section>
        </div>
    }
    @if (conversationContext is { } contextConversation)
    {
        <section id="chat-conversation-context" class="chat-category-context chat-notification-popover" popover="auto" role="menu" aria-label="Conversation Menu">
            <button type="button" role="menuitem" disabled="@(contextConversation.UnreadCount == 0)" @onclick="() => MarkContextConversationReadAsync(contextConversation.Id)">Mark As Read</button>
            <hr />
            <button type="button" class="chat-conversation-context-pin" role="menuitemcheckbox" aria-checked="@(contextConversation.PinnedToTopAtUtc != null ? "true" : "false")" @onclick="() => PinContextConversationAsync(contextConversation)">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 3 8 3 9 5 9 10 5 14 5 16 11 16 11 22 13 22 13 16 19 16 19 14 15 10 15 5 16 3Z" /></svg>
                @(contextConversation.PinnedToTopAtUtc != null ? "Unpin" : "Pin")
            </button>
            <hr />
            @if (contextConversation.Kind == ConversationKind.Group)
            {
                <button type="button" role="menuitem" @onclick="() => EditContextGroupAsync(contextConversation.Id)">Edit Group</button>
                <hr />
            }
            <ChatMuteMenu @key="contextConversation.Id" TargetName="Conversation" Setting="ChannelSetting(contextConversation.Id)" Muted="mute => MuteContextConversationAsync(contextConversation.Id, mute)" />
            @if (contextConversation.Kind == ConversationKind.Group)
            {
                <hr />
                <button type="button" role="menuitem" @onclick="() => RequestLeaveConversation(contextConversation)">Leave Group</button>
            }
        </section>
    }
    @if (channelContext is { } contextChannel)
    {
        <section id="chat-channel-context" class="chat-category-context chat-channel-context chat-notification-popover" popover="auto" role="menu" aria-label="Channel Menu">
            <button type="button" role="menuitemcheckbox" aria-checked="@(contextChannel.PinnedToTopAtUtc != null ? "true" : "false")" @onclick="() => PinChannelToTopAsync(contextChannel)">@(contextChannel.PinnedToTopAtUtc != null ? "Unpin Channel from Top" : "Pin Channel to Top")</button>
            <hr />
            <ChatMuteMenu Setting="ChannelSetting(contextChannel.Id)" Muted="mute => MuteContextChannelAsync(contextChannel.Id, mute)" />
            <div class="chat-category-submenu">
                <button type="button" role="menuitem" aria-haspopup="menu" @onclick="() => channelNotificationsExpanded = !channelNotificationsExpanded">Notification Settings <span aria-hidden="true">›</span><small>@ContextChannelNotificationLabel(contextChannel.Id)</small></button>
                <div class="chat-category-submenu-items @(channelNotificationsExpanded ? "expanded" : "")">
                    <ChatNotificationMenu Setting="ChannelSetting(contextChannel.Id)" CategoryDefault="CategoryDefaultFor(contextChannel.Id)" ShowMute="false" Selected="mode => SetContextChannelNotificationsAsync(contextChannel.Id, mode)" />
                </div>
            </div>
            <hr />
            <div class="chat-category-submenu">
                <button type="button" role="menuitem" aria-haspopup="menu" @onclick="() => channelMoveExpanded = !channelMoveExpanded">Move to... <span aria-hidden="true">›</span></button>
                <div class="chat-category-submenu-items @(channelMoveExpanded ? "expanded" : "")" role="menu" aria-label="Move Channel">
                    <div class="chat-category-submenu">
                        <button type="button" role="menuitem" aria-haspopup="menu" @onclick="() => channelCategoryExpanded = !channelCategoryExpanded">Category <span aria-hidden="true">›</span></button>
                        <div class="chat-category-submenu-items chat-channel-category-destinations @(channelCategoryExpanded ? "expanded" : "")" role="menu" aria-label="Channel Category">
                            <button type="button" role="menuitem" @onclick="() => MoveContextChannelAsync(contextChannel.Id, null)">Ungrouped</button>
                            <hr />
                            @foreach (var destination in CategoryDestinations())
                            { <button type="button" role="menuitem" @onclick="() => MoveContextChannelAsync(contextChannel.Id, destination.Id)">@destination.Name</button> }
                        </div>
                    </div>
                    <button type="button" role="menuitem" disabled="@IsChannelAtCategoryEdge(contextChannel, true)" @onclick="() => MoveContextChannelToEdgeAsync(contextChannel.Id, true)">First in Category</button>
                    <button type="button" role="menuitem" disabled="@IsChannelAtCategoryEdge(contextChannel, false)" @onclick="() => MoveContextChannelToEdgeAsync(contextChannel.Id, false)">Last in Category</button>
                </div>
            </div>
            <hr />
            <button type="button" role="menuitem" disabled="@(!contextChannel.IsOwner && !currentUserIsAdministrator)" @onclick="() => EditContextChannelAsync(contextChannel)">Edit Channel</button>
            <button type="button" role="menuitem" @onclick="() => BeginDuplicateChannel(contextChannel)">Duplicate Channel</button>
            <button type="button" role="menuitem" @onclick="() => StartNewChannel(contextChannel.ChannelGroupId)">Create Channel</button>
            <button type="button" role="menuitem" disabled="@(!contextChannel.IsOwner && !currentUserIsAdministrator)" @onclick="() => BeginDeleteChannel(contextChannel)">Delete Channel</button>
        </section>
    }
    @if (duplicateChannelSource is { } duplicateSource)
    {
        <div class="chat-delete-backdrop" @onclick="() => duplicateChannelSource = null">
            <section class="chat-delete-dialog" role="dialog" aria-modal="true" aria-label="Duplicate Channel" @onclick:stopPropagation @onkeydown="HandleDuplicateChannelKeyDown">
                <h2>Duplicate Channel</h2>
                <p>Create a channel with the same topic and member access as #@duplicateSource.Name.</p>
                <form @onsubmit="DuplicateChannelAsync" @onsubmit:preventDefault>
                    <label for="chat-duplicate-channel-name">Channel name</label>
                    <input id="chat-duplicate-channel-name" @ref="channelCardNameInput" maxlength="120" @bind="duplicateChannelName" @bind:event="oninput" />
                    @if (error is not null) { <p class="chat-card-error">@error</p> }
                    <div class="chat-delete-actions"><button type="button" class="button button-secondary" @onclick="() => duplicateChannelSource = null">Cancel</button><button type="submit" class="button button-primary" disabled="@string.IsNullOrWhiteSpace(duplicateChannelName)">Create Channel</button></div>
                </form>
            </section>
        </div>
    }
    @if (pendingLeaveConversation is { } leaveConversation)
    {
        <div class="chat-delete-backdrop" @onclick="CancelLeaveConversation">
            <section class="chat-delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="chat-leave-title" aria-describedby="chat-leave-description" @onclick:stopPropagation @onkeydown="HandleLeaveKeyDown">
                <h2 id="chat-leave-title">@(leaveConversation.Kind == ConversationKind.Group ? "Leave Group?" : "Hide Conversation?")</h2>
                <p id="chat-leave-description">@(leaveConversation.Kind == ConversationKind.Group
                    ? $"Leave {leaveConversation.Name}? The other members will see that you left. A member must add you again to rejoin."
                    : $"Hide your conversation with {leaveConversation.Name}? Its messages will be kept. It reappears when you reopen it or either of you sends a new message.")</p>
                @if (error is not null) { <p class="chat-card-error" role="alert">@error</p> }
                <div class="chat-delete-actions">
                    <button type="button" class="button button-secondary" @ref="cancelLeaveButton" disabled="@leavingConversation" @onclick="CancelLeaveConversation">Cancel</button>
                    <button type="button" class="button button-danger" disabled="@leavingConversation" @onclick="ConfirmLeaveConversationAsync">@(leaveConversation.Kind == ConversationKind.Group ? "Leave Group" : "Hide Conversation")</button>
                </div>
            </section>
        </div>
    }
    @if (pendingDeleteChannel is { } deleteChannel)
    {
        <div class="chat-delete-backdrop" @onclick="() => pendingDeleteChannel = null">
            <section class="chat-delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="chat-delete-channel-title" @onclick:stopPropagation @onkeydown="HandleChannelDeleteKeyDown">
                <h2 id="chat-delete-channel-title">Delete Channel?</h2>
                <p>Delete #@deleteChannel.Name? The channel and its messages will disappear for all members.</p>
                @if (error is not null) { <p class="chat-card-error">@error</p> }
                <div class="chat-delete-actions"><button type="button" class="button button-secondary" @onclick="() => pendingDeleteChannel = null">Cancel</button><button type="button" class="button button-danger" @onclick="ConfirmDeleteChannelAsync">Delete</button></div>
            </section>
        </div>
    }
    @if (categoryContext is { } category)
    {
        <section id="chat-category-context" class="chat-category-context chat-notification-popover" popover="auto" role="menu" aria-label="Category Settings">
            <button type="button" role="menuitemcheckbox" aria-checked="@(collapsedFolderIds.Contains(category.Id) ? "true" : "false")" @onclick="() => ToggleFolderCollapsed(category.Id)"><span aria-hidden="true">@(collapsedFolderIds.Contains(category.Id) ? "☑" : "☐")</span> Collapse Category</button>
            <button type="button" role="menuitem" @onclick="CollapseAllCategories">Collapse All Categories</button>
