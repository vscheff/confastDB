        catch (JSDisconnectedException) { return; }
        catch (JSException ex) { Logger.LogWarning(ex, "Could not scroll to the new chat message."); return; }
        await MarkCurrentConversationReadAsync();
    }

    private async Task RunAsync(Func<Task> operation)
    {
        try { error = null; await operation(); await RefreshAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        { error = ex.Message; }
    }

