        }
        await EnsureEmojiSupportAsync();
        reactionPickerMessageId = messageId;
        emojiSearch = string.Empty;
    }

    private async Task EnsureEmojiSupportAsync()
    {
        if (emojiSupportChecked || emojiSupportLoading) return;
        emojiSupportLoading = true;
        try
        {
            var support = await JS.InvokeAsync<EmojiSupportResult>(
                "confastChatTime.detectEmojiSupport", ChatEmojiCatalog.CompositeCandidates);
            supportedEmojiVersion = support.MaxVersion;
            unsupportedEmoji = support.UnsupportedEmoji.ToHashSet(StringComparer.Ordinal);
            emojiSupportChecked = true;
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not detect emoji support for this browser.");
            emojiSupportChecked = true;
        }
        finally { emojiSupportLoading = false; }
    }

