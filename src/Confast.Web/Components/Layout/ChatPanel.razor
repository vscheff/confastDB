    private bool IsEmojiSupported(ChatEmojiOption option) =>
        option.Version <= supportedEmojiVersion && !unsupportedEmoji.Contains(option.Emoji);

    private int AvailableToneCount(string defaultEmoji) =>
        ChatEmojiCatalog.FindFamily(defaultEmoji)?.Tones.Count(IsEmojiSupported) ?? 0;

    private string PreferredEmoji(string defaultEmoji)
    {
        if (tonePreferences.TryGetValue(defaultEmoji, out var preferred))
        {
            var option = ChatEmojiCatalog.FindFamily(defaultEmoji)?.Tones.FirstOrDefault(x => x.Emoji == preferred);
            if (option is not null && IsEmojiSupported(option)) return preferred;
        }
        return defaultEmoji;
    }

