    private void StartToneDelay(long messageId, string defaultEmoji, char source, int milliseconds,
        bool openedByTouch)
    {
        if (AvailableToneCount(defaultEmoji) <= 1) return;
        CancelToneDelay();
        var delay = new CancellationTokenSource();
        toneDelay = delay;
        _ = OpenToneAfterDelayAsync(messageId, defaultEmoji, source, milliseconds, openedByTouch, delay);
    }

    private async Task OpenToneAfterDelayAsync(long messageId, string defaultEmoji, char source,
        int milliseconds, bool openedByTouch, CancellationTokenSource delay)
    {
        try
        {
            await Task.Delay(milliseconds, delay.Token);
            await InvokeAsync(() =>
            {
                if (!disposed && !delay.IsCancellationRequested)
                    OpenTonePicker(messageId, defaultEmoji, source, openedByTouch);
            });
        }
        catch (OperationCanceledException) when (delay.IsCancellationRequested) { }
        finally
        {
            if (toneDelay == delay) toneDelay = null;
            delay.Dispose();
        }
    }

    private void OpenTonePicker(long messageId, string defaultEmoji, char source, bool openedByTouch)
    {
        if (AvailableToneCount(defaultEmoji) <= 1) return;
        tonePickerMessageId = messageId;
        tonePickerDefaultEmoji = defaultEmoji;
        tonePickerSource = source;
        tonePickerOpenedByTouch = openedByTouch;
        if (openedByTouch) suppressToneTriggerClick = (messageId, defaultEmoji, source);
        StateHasChanged();
    }

    private void CancelToneDelay()
    {
        toneDelay?.Cancel();
        toneDelay = null;
    }

    private void CloseTonePicker()
    {
        CancelToneDelay();
        suppressToneTriggerClick = null;
        focusTonePickerAfterRender = false;
        tonePickerMessageId = null;
        tonePickerDefaultEmoji = null;
        tonePickerOpenedByTouch = false;
    }

