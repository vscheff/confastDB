    private async Task SelectAttachmentAsync(InputFileChangeEventArgs args)
    {
        showComposeMenu = false;
        try { await JS.InvokeVoidAsync("confastChatTime.focusChatComposer"); }
        catch (JSDisconnectedException) { return; }
        catch (JSException ex) { Logger.LogWarning(ex, "Could not return focus to the chat compose box after selecting a file."); }
        error = null;
        if (pendingAttachments.Count + args.FileCount > ChatAttachmentTypes.MaximumFilesPerMessage)
        {
            error = $"A message can include at most {ChatAttachmentTypes.MaximumFilesPerMessage} files.";
            attachmentInputVersion++;
            return;
        }
        var addedFiles = new List<PendingAttachment>();
        var totalBytes = pendingAttachments.Sum(x => (long)x.Content.Length);
        try
        {
            foreach (var file in args.GetMultipleFiles(ChatAttachmentTypes.MaximumFilesPerMessage - pendingAttachments.Count))
            {
                if (file.Size is < 1 or > ChatAttachmentTypes.MaximumBytes)
                {
                    error = "Each file must be between 1 byte and 25 MB.";
                    return;
                }
                totalBytes += file.Size;
                if (totalBytes > ChatAttachmentTypes.MaximumMessageBytes)
                {
                    error = "Attachments in a message cannot total more than 25 MB.";
                    return;
                }
                await using var stream = file.OpenReadStream(ChatAttachmentTypes.MaximumBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                var content = buffer.ToArray();
                var classification = ChatAttachmentTypes.Classify(file.Name, content);
                addedFiles.Add(new PendingAttachment(file.Name, content, classification.Kind));
            }
            var previewUrls = await CreateAttachmentPreviewUrlsAsync("chat-attachment-picker", addedFiles.Count);
            for (var index = 0; index < addedFiles.Count; index++)
                addedFiles[index] = addedFiles[index] with { PreviewUrl = previewUrls[index] };
            pendingAttachments.AddRange(addedFiles);
        }
        catch (IOException ex)
        {
            Logger.LogWarning(ex, "Could not read selected chat attachment.");
            error = "The selected file could not be read.";
        }
        finally { attachmentInputVersion++; }
    }

