    private async Task<string[]> CreateAttachmentPreviewUrlsAsync(string inputId, int count)
    {
        if (count == 0) return [];
        try
        {
            var urls = await JS.InvokeAsync<string[]>("confastChatTime.createAttachmentPreviewUrls", inputId);
            return Enumerable.Range(0, count).Select(index => index < urls.Length ? urls[index] : string.Empty).ToArray();
        }
        catch (JSDisconnectedException) { return Enumerable.Repeat(string.Empty, count).ToArray(); }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not create local attachment previews.");
            return Enumerable.Repeat(string.Empty, count).ToArray();
        }
    }

    private async Task RevokeAttachmentPreviewsAsync(IEnumerable<PendingAttachment> attachments)
    {
        foreach (var attachment in attachments)
            await RevokeAttachmentPreviewAsync(attachment.PreviewUrl);
    }

    private async Task RevokeAttachmentPreviewAsync(string previewUrl)
    {
        if (string.IsNullOrEmpty(previewUrl)) return;
        try { await JS.InvokeVoidAsync("confastChatTime.revokeAttachmentPreviewUrl", previewUrl); }
        catch (JSDisconnectedException) { }
        catch (JSException ex) { Logger.LogDebug(ex, "Could not release a local attachment preview URL."); }
    }

