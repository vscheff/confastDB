    private async Task SelectSidebarAttachmentAsync(InputFileChangeEventArgs args)
    {
        showSidebarComposeMenu = false;
        try { await JS.InvokeVoidAsync("confastChatTime.focusChatComposer", "chat-sidebar-thread-draft"); }
        catch (JSDisconnectedException) { return; }
        catch (JSException ex) { Logger.LogWarning(ex, "Could not return focus to the thread compose box after selecting a file."); }
        error = null;
        if (sidebarPendingAttachments.Count + args.FileCount > ChatAttachmentTypes.MaximumFilesPerMessage)
        {
            error = $"A message can include at most {ChatAttachmentTypes.MaximumFilesPerMessage} files.";
            sidebarAttachmentInputVersion++;
            return;
        }
        var addedFiles = new List<PendingAttachment>();
        var totalBytes = sidebarPendingAttachments.Sum(x => (long)x.Content.Length);
        try
        {
            foreach (var file in args.GetMultipleFiles(ChatAttachmentTypes.MaximumFilesPerMessage - sidebarPendingAttachments.Count))
            {
                if (file.Size is < 1 or > ChatAttachmentTypes.MaximumBytes)
                {
                    error = "Each file must be between 1 byte and 25 MB.";
                    return;
                }
                totalBytes += file.Size;
                if (totalBytes > ChatAttachmentTypes.MaximumMessageBytes)
                {
                    error = "Attachments in a message cannot total more than 25 MB.";
                    return;
                }
                await using var stream = file.OpenReadStream(ChatAttachmentTypes.MaximumBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                var content = buffer.ToArray();
                var classification = ChatAttachmentTypes.Classify(file.Name, content);
                addedFiles.Add(new PendingAttachment(file.Name, content, classification.Kind));
            }
            var previewUrls = await CreateAttachmentPreviewUrlsAsync("chat-sidebar-attachment-picker", addedFiles.Count);
