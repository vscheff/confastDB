            <section class="chat-delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="chat-delete-category-title" @onclick:stopPropagation @onkeydown="HandleCategoryDeleteKeyDown">
                <h2 id="chat-delete-category-title">Delete Category?</h2>
                <p>Delete @deleteCategory.Name? Its channels and nested categories will move to Ungrouped.</p>
                <div class="chat-delete-actions"><button type="button" class="button button-secondary" @onclick="() => pendingDeleteCategory = null">Cancel</button><button type="button" class="button button-danger" @onclick="ConfirmDeleteCategoryAsync">Delete</button></div>
            </section>
        </div>
