@inherits LayoutComponentBase
@layout MainLayout
@using Confast.Web.Features.Navigation
@inject NavigationManager Navigation
@inject NavigationActivityService Activity
@inject ILogger<NavigationVisitLayout> Logger

@Body

@code {
    [CascadingParameter] private EffectivePermissionSnapshot? Permissions { get; set; }

    private NavigationItem? destination;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        // The router selects this layout only for an authorized page. Capture the path
        // when its body changes, rather than on early LocationChanged or a layout rerender.
        if (parameters.TryGetValue<RenderFragment>(nameof(Body), out var body) && !ReferenceEquals(body, Body))
            destination = NavigationCatalog.FindDestination(NavigationCatalog.GetPath(new Uri(Navigation.Uri)));

        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var observed = destination;
        try { await Activity.ObservePageAsync(Permissions, observed); }
        catch (Npgsql.NpgsqlException exception)
        {
            Logger.LogWarning(exception, "Could not record a visit to navigation destination {DestinationId}", observed?.Id);
        }
    }
}
