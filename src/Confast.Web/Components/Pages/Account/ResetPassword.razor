@page "/reset-password"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

<PageTitle>Reset password</PageTitle>

<div class="account-page">
    <section class="account-card">
        <h1>Reset password</h1>

        @if (!HasResetLink)
        {
            <div class="alert alert-error">This password reset link is incomplete.</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="alert alert-error">@Error</div>
            }
            <form method="post" action="/account/reset-password" class="account-form">
                <AntiforgeryToken />
                <input type="hidden" name="UserId" value="@UserId" />
                <input type="hidden" name="Token" value="@Token" />
                <div class="form-field">
                    <label for="new-password">New password</label>
                    <input id="new-password" name="Password" type="password" autocomplete="new-password" minlength="12" required />
                </div>
                <div class="form-field">
                    <label for="confirm-password">Confirm password</label>
                    <input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" required />
                </div>
                <p class="field-help">Use at least 12 characters with uppercase, lowercase, a number, and a symbol.</p>
                <button class="button button-primary" type="submit">Set password</button>
            </form>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool HasResetLink =>
        !string.IsNullOrWhiteSpace(UserId) && !string.IsNullOrWhiteSpace(Token);
}
