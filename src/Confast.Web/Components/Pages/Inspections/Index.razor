@page "/inspections"
@using Confast.Web.Features.Inspections
@using System.Globalization
@inject InspectionService InspectionService
@inject ILogger<Index> Logger
@inject NavigationManager Navigation

<PageTitle>Inspections</PageTitle>

<div class="page-heading">
    <div>
        <h1>Inspections</h1>
        <p>Saved inspections retain the criteria revision used when they were created.</p>
    </div>
    <div class="heading-actions">
        <button class="button button-secondary" type="button" @onclick="LoadAsync" disabled="@isLoading">
            Refresh
        </button>
        <a class="button button-primary" href="/inspections/create">Create inspection</a>
    </div>
</div>

@if (actionMessage is not null)
{
    <div class="alert @actionMessageClass" role="alert">@actionMessage</div>
}

@if (isLoading)
{
    <p class="status-message">Loading inspections…</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (inspections.Count == 0)
{
    <div class="empty-state">
        <h2>No inspections yet</h2>
        <p>Create an inspection for a Part with published inspection criteria.</p>
    </div>
}
else
{
    <div class="table-shell inspections-table-shell">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Lot#</th>
                    <th>Part Number</th>
                    <th>Inspection Date</th>
                    <th>Accepted</th>
                    <th>Completed</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inspection in inspections)
                {
                    <tr>
                        <td data-label="Lot#">@(inspection.LotNumber ?? "—")</td>
                        <td data-label="Part Number">
                            <a class="record-link" href="@($"/inspections/{inspection.Id}")">@inspection.PartNumber</a>
                        </td>
                        <td data-label="Inspection Date">@inspection.InspectionDate.ToString("yyyy-MM-dd")</td>
                        <td data-label="Accepted">@(inspection.Accepted ? "Yes" : "No")</td>
                        <td data-label="Completed">@(inspection.Completed ? "Yes" : "No")</td>
                        <td class="table-action" data-label="Actions">
                            @if (pendingDeleteId == inspection.Id)
                            {
                                <div class="row-actions delete-confirmation">
                                    <span>Delete?</span>
                                    <button class="button button-danger button-compact"
                                            type="button"
                                            @onclick="() => DeleteInspectionAsync(inspection)"
                                            disabled="@isDeleting">
                                        @(isDeleting ? "Deleting…" : "Confirm")
                                    </button>
                                    <button class="button button-secondary button-compact"
                                            type="button"
                                            @onclick="CancelDelete"
                                            disabled="@isDeleting">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="row-actions inspection-list-actions">
                                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}")">Open</a>
                                    @if (pendingDuplicateId == inspection.Id)
                                    {
                                        <div class="row-actions delete-confirmation">
                                            <label>
                                                New lot number
                                                <input required @bind="duplicateLotNumber" />
                                            </label>
                                            <label>
                                                Quantity to move (1–@((inspection.QuantityReceived!.Value - 1).ToString("N0")))
                                                <input inputmode="numeric"
                                                       value="@(duplicateQuantity?.ToString("N0", CultureInfo.InvariantCulture))"
                                                       @oninput="UpdateDuplicateQuantity"
                                                       @onkeydown="@(args => HandleDuplicateQuantityKeyDownAsync(inspection.Id, args))" />
                                            </label>
                                            <button class="button button-secondary button-compact" type="button" @onclick="() => DuplicateInspectionAsync(inspection.Id)" disabled="@isDuplicating">
                                                @(isDuplicating ? "Duplicating…" : "Confirm")
                                            </button>
                                            <button class="button button-secondary button-compact" type="button" @onclick="CancelDuplicate" disabled="@isDuplicating">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="button button-secondary" type="button" @onclick="() => BeginDuplicate(inspection)" disabled="@isDuplicating">Duplicate</button>
                                    }
                                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print")">Preview</a>
                                    <details class="inspection-print-options">
                                        <summary class="button button-secondary">Print / Download</summary>
                                        <div class="inspection-print-options-menu">
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print?autoPrint=true")" target="_blank" rel="noopener">Print</a>
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print/download")" download data-enhance-nav="false">Download</a>
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print?notesPage=second&autoPrint=true")" target="_blank" rel="noopener">Print (Show Extended Notes)</a>
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print/download?notesPage=second")" download data-enhance-nav="false">Download (Show Extended Notes)</a>
                                        </div>
                                    </details>
                                    <button class="button button-danger-outline"
                                            type="button"
                                            @onclick="() => BeginDelete(inspection.Id)"
                                            disabled="@isDeleting">
                                        Delete
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<InspectionListItem> inspections = [];
    private bool isLoading = true;
    private bool isDeleting;
    private bool isDuplicating;
    private long? pendingDeleteId;
    private long? pendingDuplicateId;
    private int? duplicateQuantity;
    private string? duplicateLotNumber;
    private string? loadError;
    private string? actionMessage;
    private string actionMessageClass = "alert-error";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        actionMessage = null;

        try
        {
            inspections = await InspectionService.GetInspectionsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load inspections");
            loadError = "Inspections could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginDelete(long inspectionId)
    {
        pendingDeleteId = inspectionId;
        actionMessage = null;
    }

    private void CancelDelete() => pendingDeleteId = null;

    private void BeginDuplicate(InspectionListItem inspection)
    {
        actionMessage = null;
        if (inspection.QuantityReceived is not > 1)
        {
            actionMessage = "Quantity received must be greater than one before an inspection can be split.";
            actionMessageClass = "alert-error";
            return;
        }

        pendingDuplicateId = inspection.Id;
        duplicateQuantity = null;
        duplicateLotNumber = null;
    }

    private void CancelDuplicate()
    {
        pendingDuplicateId = null;
        duplicateQuantity = null;
        duplicateLotNumber = null;
    }

    private void UpdateDuplicateQuantity(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
        {
            duplicateQuantity = null;
            return;
        }

        if (int.TryParse(
                value,
                NumberStyles.Integer | NumberStyles.AllowThousands,
                CultureInfo.InvariantCulture,
                out var parsedQuantity))
        {
            duplicateQuantity = parsedQuantity;
            actionMessage = null;
            return;
        }

        duplicateQuantity = null;
        actionMessage = "Enter a valid whole number.";
        actionMessageClass = "alert-error";
    }

    private async Task HandleDuplicateQuantityKeyDownAsync(long inspectionId, KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await DuplicateInspectionAsync(inspectionId);
        }
    }

    private async Task DeleteInspectionAsync(InspectionListItem inspection)
    {
        isDeleting = true;
        actionMessage = null;

        try
        {
            var result = await InspectionService.DeleteInspectionAsync(
                inspection.Id,
                inspection.Version);
            if (result.Status == InspectionOperationStatus.Succeeded)
            {
                pendingDeleteId = null;
                await LoadAsync();
                return;
            }

            actionMessage = result.Status switch
            {
                InspectionOperationStatus.NotFound => "This inspection no longer exists.",
                InspectionOperationStatus.Conflict =>
                    "Someone else changed this inspection. Refresh the list before deleting it.",
                _ => "The inspection could not be deleted. Please try again."
            };
            actionMessageClass = result.Status == InspectionOperationStatus.Conflict
                ? "alert-warning"
                : "alert-error";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to delete inspection {InspectionId}", inspection.Id);
            actionMessage = "The inspection could not be deleted. Please try again.";
            actionMessageClass = "alert-error";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task DuplicateInspectionAsync(long inspectionId)
    {
        if (string.IsNullOrWhiteSpace(duplicateLotNumber))
        {
            actionMessage = "Enter the new lot number.";
            actionMessageClass = "alert-error";
            return;
        }

        if (duplicateQuantity is not int quantityToMove)
        {
            actionMessage = "Enter the quantity to move to the duplicated inspection.";
            actionMessageClass = "alert-error";
            return;
        }

        isDuplicating = true;
        actionMessage = null;

        try
        {
            var result = await InspectionService.DuplicateInspectionAsync(
                inspectionId,
                quantityToMove,
                duplicateLotNumber);
            if (result.Status == InspectionOperationStatus.Succeeded)
            {
                CancelDuplicate();
                Navigation.NavigateTo($"/inspections/{result.InspectionId}");
                return;
            }

            actionMessage = result.Status switch
            {
                InspectionOperationStatus.NotFound => "This inspection no longer exists.",
                InspectionOperationStatus.Conflict => "The inspection changed while it was being duplicated. Please try again.",
                InspectionOperationStatus.ValidationFailed => result.Message,
                _ => "The inspection could not be duplicated. Please try again."
            };
            actionMessageClass = result.Status == InspectionOperationStatus.Conflict
                ? "alert-warning"
                : "alert-error";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to duplicate inspection {InspectionId}", inspectionId);
            actionMessage = "The inspection could not be duplicated. Please try again.";
            actionMessageClass = "alert-error";
        }
        finally
        {
            isDuplicating = false;
        }
    }
}
