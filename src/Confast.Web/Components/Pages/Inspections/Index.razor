@page "/inspections"
@using Confast.Web.Features.Inspections
@inject InspectionService InspectionService
@inject InspectionSearchNavigationContext SearchNavigation
@inject ILogger<Index> Logger
@inject NavigationManager Navigation

<PageTitle>Inspections</PageTitle>

<div class="inspection-list-page">
    <div class="page-heading">
        <div>
            <h1>Inspections</h1>
        </div>
        <div class="heading-actions">
            <button class="button button-secondary" type="button" @onclick="BeginFilter" disabled="@(isLoading || isFiltering)">
                Filter
            </button>
            <button class="button button-secondary" type="button" @onclick="LoadAsync" disabled="@isLoading">
                Refresh
            </button>
            <a class="button button-primary" href="/inspections/create">Create inspection</a>
        </div>
    </div>

    @if (actionMessage is not null)
    {
        <div class="alert @actionMessageClass" role="alert">@actionMessage</div>
    }

    @if (SearchNavigation.IsActive)
    {
        <div class="inspection-filter-summary" role="status">
            <span>Filtered inspections: @SearchNavigation.Summary (@inspections.Count)</span>
            <button class="button button-secondary button-compact" type="button" @onclick="ClearFilter" disabled="@(isLoading || isFiltering)">Clear filter</button>
        </div>
    }

    @if (showFilter)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal inspection-find-modal" role="dialog" aria-modal="true" aria-labelledby="filter-inspections-title">
                <div class="page-heading">
                    <div>
                        <h2 id="filter-inspections-title">Filter inspections</h2>
                        <p>Enter any combination of criteria. Text matches part of the value, ignoring case.</p>
                    </div>
                    <button class="button button-secondary" type="button" @onclick="CancelFilter" disabled="@isFiltering">Cancel</button>
                </div>
                <EditForm Model="filterModel" OnValidSubmit="ApplyFilterAsync" FormName="filter-inspections">
                    <div class="inspection-find-grid">
                        <div class="form-field"><label for="filter-part-number">Part number</label><InputText id="filter-part-number" @bind-Value="filterModel.PartNumber" /></div>
                        <div class="form-field"><label for="filter-lot-number">Lot number</label><InputText id="filter-lot-number" @bind-Value="filterModel.LotNumber" /></div>
                        <div class="form-field"><label for="filter-po-number">Conformance PO#</label><InputText id="filter-po-number" @bind-Value="filterModel.ConformancePoNumber" /></div>
                        <div class="form-field"><label for="filter-manufacturer-lot">Manufacturer's Lot#</label><InputText id="filter-manufacturer-lot" @bind-Value="filterModel.ManufacturerLotNumber" /></div>
                        <div class="form-field"><label for="filter-date-received">Date received</label><InputDate id="filter-date-received" @bind-Value="filterModel.DateReceived" /></div>
                        <div class="form-field"><label for="filter-inspection-date">Inspection date</label><InputDate id="filter-inspection-date" @bind-Value="filterModel.InspectionDate" /></div>
                        <div class="form-field"><label for="filter-quantity-received">Quantity received</label><InputNumber id="filter-quantity-received" @bind-Value="filterModel.QuantityReceived" /></div>
                        <div class="form-field"><label for="filter-quantity-inspected">Quantity inspected</label><InputNumber id="filter-quantity-inspected" @bind-Value="filterModel.QuantityInspected" /></div>
                        <div class="form-field"><label for="filter-inspector">Inspector</label><InputText id="filter-inspector" @bind-Value="filterModel.Inspector" /></div>
                    </div>
                    @if (filterMessage is not null)
                    {
                        <div class="alert alert-error" role="alert">@filterMessage</div>
                    }
                    <div class="form-actions">
                        <button class="button button-primary" type="submit" disabled="@isFiltering">@(isFiltering ? "Filtering…" : "Apply filter")</button>
                        <button class="button button-secondary" type="button" @onclick="ClearFilterInputs" disabled="@isFiltering">Clear</button>
                    </div>
                </EditForm>
            </section>
        </div>
    }

    @if (isLoading)
    {
        <p class="status-message">Loading inspections…</p>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-error" role="alert">@loadError</div>
    }
    else if (inspections.Count == 0)
    {
        <div class="empty-state">
            <h2>@(SearchNavigation.IsActive ? "No inspections match" : "No inspections yet")</h2>
            <p>@(SearchNavigation.IsActive ? "Try changing or clearing the filter." : "Create an inspection for a Part with published inspection criteria.")</p>
        </div>
    }
    else
    {
        <div class="table-shell inspections-table-shell">
            <table class="data-table">
                <thead>
                    <tr>
                        <th aria-sort="@(GetAriaSort(InspectionSortField.LotNumber))">
                            <button class="inspection-sort-header @(inspectionSortField == InspectionSortField.LotNumber ? "inspection-sort-header-active" : null)"
                                    type="button"
                                    aria-label="Sort by Lot number @(GetSortDirectionLabel(InspectionSortField.LotNumber))"
                                    @onclick="() => ToggleInspectionSort(InspectionSortField.LotNumber)">
                                Lot# <span class="inspection-sort-indicator" aria-hidden="true">@GetSortIndicator(InspectionSortField.LotNumber)</span>
                            </button>
                        </th>
                        <th aria-sort="@(GetAriaSort(InspectionSortField.PartNumber))">
                            <button class="inspection-sort-header @(inspectionSortField == InspectionSortField.PartNumber ? "inspection-sort-header-active" : null)"
                                    type="button"
                                    aria-label="Sort by Part Number @(GetSortDirectionLabel(InspectionSortField.PartNumber))"
                                    @onclick="() => ToggleInspectionSort(InspectionSortField.PartNumber)">
                                Part Number <span class="inspection-sort-indicator" aria-hidden="true">@GetSortIndicator(InspectionSortField.PartNumber)</span>
                            </button>
                        </th>
                        <th aria-sort="@(GetAriaSort(InspectionSortField.InspectionDate))">
                            <button class="inspection-sort-header @(inspectionSortField == InspectionSortField.InspectionDate ? "inspection-sort-header-active" : null)"
                                    type="button"
                                    aria-label="Sort by Inspection Date @(GetSortDirectionLabel(InspectionSortField.InspectionDate))"
                                    @onclick="() => ToggleInspectionSort(InspectionSortField.InspectionDate)">
                                Inspection Date <span class="inspection-sort-indicator" aria-hidden="true">@GetSortIndicator(InspectionSortField.InspectionDate)</span>
                            </button>
                        </th>
                        <th aria-sort="@(GetAriaSort(InspectionSortField.Accepted))">
                            <button class="inspection-sort-header @(inspectionSortField == InspectionSortField.Accepted ? "inspection-sort-header-active" : null)"
                                    type="button"
                                    aria-label="Sort by Accepted status @(GetSortDirectionLabel(InspectionSortField.Accepted))"
                                    @onclick="() => ToggleInspectionSort(InspectionSortField.Accepted)">
                                Accepted <span class="inspection-sort-indicator" aria-hidden="true">@GetSortIndicator(InspectionSortField.Accepted)</span>
                            </button>
                        </th>
                        <th aria-sort="@(GetAriaSort(InspectionSortField.Completed))">
                            <button class="inspection-sort-header @(inspectionSortField == InspectionSortField.Completed ? "inspection-sort-header-active" : null)"
                                    type="button"
                                    aria-label="Sort by Completed status @(GetSortDirectionLabel(InspectionSortField.Completed))"
                                    @onclick="() => ToggleInspectionSort(InspectionSortField.Completed)">
                                Completed <span class="inspection-sort-indicator" aria-hidden="true">@GetSortIndicator(InspectionSortField.Completed)</span>
                            </button>
                        </th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inspection in SortedInspections)
                    {
                        <tr>
                        <td data-label="Lot#">@(inspection.LotNumber ?? "—")</td>
                        <td data-label="Part Number">
                            <a class="record-link" href="@($"/inspections/{inspection.Id}")" @onclick="() => OpenInspection(inspection.Id)" @onclick:preventDefault="true">@inspection.PartNumber</a>
                        </td>
                        <td data-label="Inspection Date">@inspection.InspectionDate.ToString("yyyy-MM-dd")</td>
                        <td data-label="Accepted">@(inspection.Accepted ? "Yes" : "No")</td>
                        <td data-label="Completed">@(inspection.Completed ? "Yes" : "No")</td>
                        <td class="table-action" data-label="Actions">
                            @if (pendingDeleteId == inspection.Id)
                            {
                                <div class="row-actions delete-confirmation">
                                    <span>Delete?</span>
                                    <button class="button button-danger button-compact"
                                            type="button"
                                            @onclick="() => DeleteInspectionAsync(inspection)"
                                            disabled="@isDeleting">
                                        @(isDeleting ? "Deleting…" : "Confirm")
                                    </button>
                                    <button class="button button-secondary button-compact"
                                            type="button"
                                            @onclick="CancelDelete"
                                            disabled="@isDeleting">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="row-actions inspection-list-actions">
                                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}")" @onclick="() => OpenInspection(inspection.Id)" @onclick:preventDefault="true">Open</a>
                                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print")">Preview</a>
                                    <details class="inspection-print-options">
                                        <summary class="button button-secondary">Print</summary>
                                        <div class="inspection-print-options-menu">
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print?notesPage=second&autoPrint=true")" target="_blank" rel="noopener">Print (Show Extended Notes)</a>
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print?autoPrint=true")" target="_blank" rel="noopener">Print</a>
                                        </div>
                                    </details>
                                    <details class="inspection-print-options">
                                        <summary class="button button-secondary">Download</summary>
                                        <div class="inspection-print-options-menu">
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print/download?notesPage=second")" download data-enhance-nav="false">Download (Show Extended Notes)</a>
                                            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print/download")" download data-enhance-nav="false">Download</a>
                                        </div>
                                    </details>
                                    <button class="button button-danger-outline"
                                            type="button"
                                            @onclick="() => BeginDelete(inspection.Id)"
                                            disabled="@isDeleting">
                                        Delete
                                    </button>
                                </div>
                            }
                        </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<InspectionListItem> inspections = [];
    private bool isLoading = true;
    private bool isDeleting;
    private bool showFilter;
    private bool isFiltering;
    private long? pendingDeleteId;
    private string? loadError;
    private string? actionMessage;
    private string actionMessageClass = "alert-error";
    private InspectionSortField inspectionSortField = InspectionSortField.InspectionDate;
    private bool inspectionSortAscending;
    private InspectionFindModel filterModel = new();
    private string? filterMessage;

    private IEnumerable<InspectionListItem> SortedInspections =>
        (inspectionSortField, inspectionSortAscending) switch
        {
            (InspectionSortField.LotNumber, true) => inspections
                .OrderBy(x => x.LotNumber is null)
                .ThenBy(x => x.LotNumber, StringComparer.OrdinalIgnoreCase)
                .ThenBy(x => x.Id),
            (InspectionSortField.LotNumber, false) => inspections
                .OrderBy(x => x.LotNumber is null)
                .ThenByDescending(x => x.LotNumber, StringComparer.OrdinalIgnoreCase)
                .ThenByDescending(x => x.Id),
            (InspectionSortField.PartNumber, true) => inspections
                .OrderBy(x => x.PartNumber, StringComparer.OrdinalIgnoreCase)
                .ThenBy(x => x.Id),
            (InspectionSortField.PartNumber, false) => inspections
                .OrderByDescending(x => x.PartNumber, StringComparer.OrdinalIgnoreCase)
                .ThenByDescending(x => x.Id),
            (InspectionSortField.InspectionDate, true) => inspections
                .OrderBy(x => x.InspectionDate)
                .ThenBy(x => x.Id),
            (InspectionSortField.InspectionDate, false) => inspections
                .OrderByDescending(x => x.InspectionDate)
                .ThenByDescending(x => x.Id),
            (InspectionSortField.Accepted, true) => inspections
                .OrderBy(x => x.Accepted)
                .ThenByDescending(x => x.InspectionDate)
                .ThenByDescending(x => x.Id),
            (InspectionSortField.Accepted, false) => inspections
                .OrderByDescending(x => x.Accepted)
                .ThenByDescending(x => x.InspectionDate)
                .ThenByDescending(x => x.Id),
            (InspectionSortField.Completed, true) => inspections
                .OrderBy(x => x.Completed)
                .ThenByDescending(x => x.InspectionDate)
                .ThenByDescending(x => x.Id),
            _ => inspections
                .OrderByDescending(x => x.Completed)
                .ThenByDescending(x => x.InspectionDate)
                .ThenByDescending(x => x.Id)
        };

    private void ToggleInspectionSort(InspectionSortField field)
    {
        if (inspectionSortField == field)
        {
            inspectionSortAscending = !inspectionSortAscending;
            return;
        }

        inspectionSortField = field;
        inspectionSortAscending = true;
    }

    private string GetAriaSort(InspectionSortField field) =>
        inspectionSortField != field
            ? "none"
            : inspectionSortAscending ? "ascending" : "descending";

    private string GetSortIndicator(InspectionSortField field) =>
        inspectionSortField != field ? "↕" : inspectionSortAscending ? "↑" : "↓";

    private string GetSortDirectionLabel(InspectionSortField field) =>
        inspectionSortField != field
            ? ""
            : inspectionSortAscending ? "descending next" : "ascending next";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        actionMessage = null;

        try
        {
            var criteria = SearchNavigation.Criteria;
            inspections = criteria is null
                ? await InspectionService.GetInspectionsAsync()
                : await InspectionService.FindInspectionsAsync(criteria);
            if (criteria is not null)
            {
                SearchNavigation.Replace(criteria, inspections);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load inspections");
            loadError = "Inspections could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginDelete(long inspectionId)
    {
        pendingDeleteId = inspectionId;
        actionMessage = null;
    }

    private void CancelDelete() => pendingDeleteId = null;

    private async Task DeleteInspectionAsync(InspectionListItem inspection)
    {
        isDeleting = true;
        actionMessage = null;

        try
        {
            var result = await InspectionService.DeleteInspectionAsync(
                inspection.Id,
                inspection.Version);
            if (result.Status == InspectionOperationStatus.Succeeded)
            {
                pendingDeleteId = null;
                await LoadAsync();
                return;
            }

            actionMessage = result.Status switch
            {
                InspectionOperationStatus.NotFound => "This inspection no longer exists.",
                InspectionOperationStatus.Conflict =>
                    "Someone else changed this inspection. Refresh the list before deleting it.",
                _ => "The inspection could not be deleted. Please try again."
            };
            actionMessageClass = result.Status == InspectionOperationStatus.Conflict
                ? "alert-warning"
                : "alert-error";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to delete inspection {InspectionId}", inspection.Id);
            actionMessage = "The inspection could not be deleted. Please try again.";
            actionMessageClass = "alert-error";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private enum InspectionSortField
    {
        LotNumber,
        PartNumber,
        InspectionDate,
        Accepted,
        Completed
    }

    private void BeginFilter()
    {
        filterModel = SearchNavigation.Criteria is null
            ? new InspectionFindModel()
            : InspectionFindModel.Clone(SearchNavigation.Criteria);
        filterMessage = null;
        showFilter = true;
    }

    private void CancelFilter()
    {
        if (!isFiltering)
        {
            showFilter = false;
            filterMessage = null;
        }
    }

    private void ClearFilterInputs()
    {
        filterModel = new InspectionFindModel();
        filterMessage = null;
    }

    private async Task ApplyFilterAsync()
    {
        isFiltering = true;
        filterMessage = null;
        try
        {
            var results = await InspectionService.FindInspectionsAsync(filterModel);
            SearchNavigation.Replace(filterModel, results);
            inspections = results;
            showFilter = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to filter inspections");
            filterMessage = "The inspections could not be filtered. Please try again.";
        }
        finally
        {
            isFiltering = false;
        }
    }

    private async Task ClearFilter()
    {
        SearchNavigation.Clear();
        filterMessage = null;
        await LoadAsync();
    }

    private void OpenInspection(long inspectionId)
    {
        if (SearchNavigation.IsActive)
        {
            SearchNavigation.SetCurrentInspection(inspectionId);
        }

        Navigation.NavigateTo($"/inspections/{inspectionId}");
    }
}
