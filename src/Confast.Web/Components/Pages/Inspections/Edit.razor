    private async Task MoveAdditionalQuantityAsync()
    {
        if (inspection is null || pendingQuantityMove is null || additionalQuantity is not int quantity)
        {
            quantityMoveMessage = "Enter a whole quantity to move.";
            return;
        }

        isMovingQuantity = true;
        quantityMoveMessage = null;
        try
        {
            var fromId = quantityMoveDirection == "source-to-destination" ? pendingQuantityMove.SourceInspectionId : pendingQuantityMove.DestinationInspectionId;
            var toId = quantityMoveDirection == "source-to-destination" ? pendingQuantityMove.DestinationInspectionId : pendingQuantityMove.SourceInspectionId;
            var result = await InspectionService.MoveAdditionalLineageQuantityAsync(inspection.Id, fromId, toId, quantity);
            if (result.Status == InspectionOperationStatus.Succeeded)
            {
                CancelQuantityMove();
                await LoadAsync();
                activeTab = InspectionTab.History;
                saveSucceeded = true;
                saveMessage = "Quantity moved.";
                return;
            }

            quantityMoveMessage = result.Status == InspectionOperationStatus.Conflict
                ? "Someone else changed a related inspection. Reload before trying again."
                : result.Message ?? "The quantity could not be moved.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to move additional inspection quantity");
            quantityMoveMessage = "The quantity could not be moved. Please try again.";
        }
        finally
        {
            isMovingQuantity = false;
        }
    }

