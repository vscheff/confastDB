    private async Task FlipInspectionAsync()
    {
        if (inspection is null || string.IsNullOrWhiteSpace(flipLotNumber)) { flipMessage = "Enter the new lot number."; return; }
        if (flipQuantity is not int quantityToMove) { flipMessage = "Enter the quantity to move to the flipped inspection."; return; }
        isFlipping = true;
        try
        {
            var saveResult = await SavePendingInspectionAsync();
            if (saveResult.Status != InspectionOperationStatus.Succeeded) { flipMessage = saveResult.Message ?? "Save the inspection before flipping it."; return; }
            CaptureCommittedMeasurements();
            var result = await InspectionService.FlipInspectionAsync(inspection.Id, selectedFlipDefinitionId, quantityToMove, flipLotNumber);
            if (result.Status == InspectionOperationStatus.Succeeded)
            {
                CancelFlip();
                Navigation.NavigateTo($"/inspections/{result.InspectionId}");
                return;
            }
            flipMessage = result.Message ?? "The inspection could not be flipped. The configuration may have changed.";
        }
        finally { isFlipping = false; }
    }

