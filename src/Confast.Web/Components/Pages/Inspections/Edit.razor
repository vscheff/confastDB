    private async Task DownloadInspectionSheetPdfAsync()
    {
        if (inspection is null || isSaving || isCertificationWorking)
        {
            return;
        }

        isSaving = true;
        saveMessage = null;
        saveSucceeded = false;
        try
        {
            var result = await SavePendingInspectionAsync();
            if (result.Status == InspectionOperationStatus.Succeeded)
            {
                CaptureCommittedMeasurements();
                await JS.InvokeVoidAsync(
                    "confast.downloadFile",
                    $"/inspections/{InspectionId}/inspection-sheet/download");
                return;
            }

            saveMessage = result.Status switch
            {
                InspectionOperationStatus.Conflict =>
                    "Someone else changed this inspection. Reload it before creating the PDF.",
                InspectionOperationStatus.ValidationFailed => result.Message,
                InspectionOperationStatus.NotFound => "The inspection no longer exists.",
                _ => "The inspection could not be saved before creating the PDF."
            };
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to create or download the PDF for inspection {InspectionId}", InspectionId);
            saveMessage = "The inspection PDF could not be downloaded. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DuplicateInspectionAsync()
    {
        if (inspection is null || isSaving || isCertificationWorking || isDuplicating)
        {
            return;
        }

        isDuplicating = true;
        saveMessage = null;
        saveSucceeded = false;
        try
        {
            // The edit form autosaves, but explicitly commit any pending change before
            // cloning so the duplicate reflects what is currently on screen.
            var saveResult = await SavePendingInspectionAsync();
            if (saveResult.Status != InspectionOperationStatus.Succeeded)
            {
                saveMessage = saveResult.Status switch
                {
                    InspectionOperationStatus.Conflict =>
                        "Someone else changed this inspection. Reload it before duplicating.",
                    InspectionOperationStatus.ValidationFailed => saveResult.Message,
                    InspectionOperationStatus.NotFound => "The inspection no longer exists.",
                    _ => "The inspection could not be saved before duplicating. Please try again."
                };
                return;
            }

            CaptureCommittedMeasurements();
            var duplicateResult = await InspectionService.DuplicateInspectionAsync(inspection.Id);
            if (duplicateResult.Status == InspectionOperationStatus.Succeeded)
            {
                Navigation.NavigateTo($"/inspections/{duplicateResult.InspectionId}");
                return;
            }

            saveMessage = duplicateResult.Status switch
            {
                InspectionOperationStatus.NotFound => "This inspection no longer exists.",
                InspectionOperationStatus.Conflict =>
                    "The inspection changed while it was being duplicated. Please try again.",
                _ => "The inspection could not be duplicated. Please try again."
            };
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to duplicate inspection {InspectionId}", InspectionId);
            saveMessage = "The inspection could not be duplicated. Please try again.";
        }
        finally
        {
            isDuplicating = false;
        }
    }

    private async Task OpenCertificationPackageAsync()
    {
        if (inspection is null) return;
        packagePlants = await InspectionService.GetCertificationPackagePlantOptionsAsync(inspection.Id);
        selectedPackagePlantId = packagePlants.Count == 1 ? packagePlants[0].Id : 0;
        selectedPackageLotIds.Clear();
        await RefreshPackageLotsAsync();
        if (packageLots.Any(lot => lot.InspectionId == inspection.Id))
        {
            selectedPackageLotIds.Add(inspection.Id);
        }
        packageShipDate = ShipDateCalculator.NextWorkDay(DateOnly.FromDateTime(DateTime.Today));
        generatedPackage = null;
        packageMessage = null;
        packageSucceeded = false;
        showCertificationPackage = true;
    }

    private void CloseCertificationPackage() => showCertificationPackage = false;

    private async Task RefreshPackageLotsAsync()
    {
        if (inspection is null) return;
        packageLots = await InspectionService.GetCertificationPackageLotOptionsAsync(
            inspection.Id,
            selectedPackagePlantId == 0 ? null : selectedPackagePlantId);
        selectedPackageLotIds.IntersectWith(packageLots.Select(lot => lot.InspectionId));
        generatedPackage = null;
        packageMessage = null;
        showIncompletePackageLotWarning = false;
    }

    private void SetPackageLotSelected(long inspectionId, bool selected)
    {
        if (selected) selectedPackageLotIds.Add(inspectionId);
        else selectedPackageLotIds.Remove(inspectionId);
        generatedPackage = null;
        packageMessage = null;
        showIncompletePackageLotWarning = false;
    }

    private void SelectAllPackageLots()
    {
        selectedPackageLotIds.Clear();
        foreach (var lot in packageLots)
        {
            selectedPackageLotIds.Add(lot.InspectionId);
        }
        generatedPackage = null;
        packageMessage = null;
        showIncompletePackageLotWarning = false;
    }

    private void ClearPackageLots()
    {
        selectedPackageLotIds.Clear();
        generatedPackage = null;
        packageMessage = null;
        showIncompletePackageLotWarning = false;
    }

    private async Task GenerateCertificationPackageAsync()
    {
        if (selectedPackageLotIds.Count == 0)
        {
            packageSucceeded = false;
            packageMessage = "Select at least one lot.";
            return;
        }

        if (selectedPackagePlantId == 0)
        {
            packageSucceeded = false;
            packageMessage = "Select a destination plant.";
            return;
        }

        if (IncompleteSelectedPackageLots.Count > 0)
        {
            showIncompletePackageLotWarning = true;
            return;
        }

        await BuildCertificationPackageAsync(false);
    }

    private void CancelIncompletePackageLotWarning() => showIncompletePackageLotWarning = false;

    private async Task GenerateWithTemporaryCompletionAsync()
    {
        showIncompletePackageLotWarning = false;
        await BuildCertificationPackageAsync(true);
    }

    private async Task BuildCertificationPackageAsync(bool temporarilyCompleteIncompleteLots)
    {
        packageWorking = true;
        packageSucceeded = false;
        packageMessage = null;
        generatedPackage = null;
        try
        {
            if (selectedPackageLotIds.Count == 0)
            {
                packageMessage = "Select at least one lot.";
                return;
