                    InspectionOperationStatus.Conflict =>
                        "Someone else changed this inspection. Reload it before uploading a document.",
                    InspectionOperationStatus.ValidationFailed => inspectionSave.Message,
                    InspectionOperationStatus.NotFound => "The inspection no longer exists.",
                    _ => "The inspection could not be saved before uploading the document."
                };
                return;
            }

            await LoadAsync();
            if (SelectedCertification is null)
            {
                saveMessage = "The certification requirement could not be loaded. Please try again.";
                return;
            }

            foreach (var file in eventArgs.GetMultipleFiles(20))
            {
                await using var stream = file.OpenReadStream(InspectionService.MaximumCertificationDocumentBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                var result = await InspectionService.UploadCertificationDocumentAsync(
                    InspectionId,
                    certificationTypeId,
                    file.Name,
                    buffer.ToArray());
                if (result.Status != InspectionOperationStatus.Succeeded)
                {
                    await LoadAsync();
                    activeTab = InspectionTab.Certifications;
                    saveMessage = result.Message ?? "A certification document could not be uploaded.";
                    return;
                }
            }

            await LoadAsync();
            activeTab = InspectionTab.Certifications;
            selectedDocumentId = SelectedCertification?.Documents.LastOrDefault()?.Id;
            saveSucceeded = true;
            saveMessage = "Certification document uploaded.";
        }
        catch (IOException exception)
        {
            Logger.LogWarning(exception, "Rejected certification upload for inspection {InspectionId}", InspectionId);
            saveMessage = "Each PDF must be 25 MB or smaller.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to upload certification document for inspection {InspectionId}", InspectionId);
            saveMessage = "The certification document could not be uploaded. Please try again.";
        }
        finally
        {
            isCertificationWorking = false;
        }
    }

    private async Task DeleteCertificationDocumentAsync(CertificationDocumentListItem document)
    {
        isCertificationWorking = true;
        saveMessage = null;
        saveSucceeded = false;
        try
        {
            var inspectionSave = await SavePendingInspectionAsync();
            if (inspectionSave.Status != InspectionOperationStatus.Succeeded)
            {
                await LoadAsync();
                activeTab = InspectionTab.Certifications;
                saveMessage = inspectionSave.Status switch
                {
                    InspectionOperationStatus.Conflict =>
                        "Someone else changed this inspection. Reload it before deleting the document.",
                    InspectionOperationStatus.ValidationFailed => inspectionSave.Message,
                    InspectionOperationStatus.NotFound => "The inspection no longer exists.",
                    _ => "The inspection could not be saved before deleting the document."
                };
                return;
            }

            var result = await InspectionService.DeleteCertificationDocumentAsync(
                InspectionId,
                document.Id,
                document.Version);
            if (result.Status == InspectionOperationStatus.Succeeded)
            {
                selectedDocumentId = null;
                pendingCertificationDocumentDeleteId = null;
                await LoadAsync();
                activeTab = InspectionTab.Certifications;
                saveSucceeded = true;
                saveMessage = "Certification document deleted.";
                return;
            }

            saveMessage = result.Status == InspectionOperationStatus.Conflict
                ? "Someone else changed this document. Reload before trying again."
                : "The certification document no longer exists.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to delete certification document {DocumentId}", document.Id);
            saveMessage = "The certification document could not be deleted. Please try again.";
        }
        finally
        {
            isCertificationWorking = false;
        }
    }

    private async Task<InspectionOperationResult> SavePendingInspectionAsync()
    {
        if (inspection is null)
        {
            return new InspectionOperationResult(InspectionOperationStatus.NotFound, InspectionId);
        }

        // Measurement inputs and the inspection header share this edit model.
        // Certification actions reload it, so commit pending edits first.
        var result = await InspectionService.SaveInspectionAsync(inspection);
        return result;
    }

    private static string CertificationStatusIcon(InspectionCertificationListItem certification) =>
        certification.IsMissingRequired ? "⚠" : certification.Documents.Count > 0 ? "✓" : "○";

    private static string CertificationStatusClass(InspectionCertificationListItem certification) =>
        certification.IsMissingRequired ? "certification-missing" : certification.Documents.Count > 0 ? "certification-uploaded" : "certification-empty";

    private void SetBothRecordedValues(InspectionResultEditModel result, string passingEntry)
    {
        result.ActualMin = passingEntry;
        result.ActualMax = passingEntry;
        committedMinimums[result.Id] = passingEntry;
        committedMaximums[result.Id] = passingEntry;
        recordedMinimumMessages.Remove(result.Id);
        recordedMaximumMessages.Remove(result.Id);
    }

    private static string DescribeRecordedValue(string? value) =>
        value is null ? "blank" : $"“{value}”";

    private static string EvaluationText(InspectionResultEvaluation evaluation) => evaluation switch
    {
        InspectionResultEvaluation.Pass => "Pass",
        InspectionResultEvaluation.Fail => "Fail",
        _ => "Incomplete"
    };

    private static string EvaluationClass(InspectionResultEvaluation evaluation) => evaluation switch
    {
        InspectionResultEvaluation.Pass => "status-active",
        InspectionResultEvaluation.Fail => "status-fail",
        _ => "status-draft"
    };

    private enum InspectionTab
    {
        Inspection,
        MasterPrint,
        Certifications,
        History
    }
}
