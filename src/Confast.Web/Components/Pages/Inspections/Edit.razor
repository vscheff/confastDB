@page "/inspections/{InspectionId:long}"
@using Confast.Web.Features.Inspections
@using Confast.Web.Features.Customers
@using Confast.Web.Features.Identity
@using System.Globalization
@inject InspectionService InspectionService
@inject UserAdministrationService UserAdministrationService
@inject ICertificationPackageService CertificationPackageService
@inject ICertificationEmailService CertificationEmailService
@inject ICurrentEmailSender CurrentEmailSender
@inject ICertificationEmailTemplateResolver EmailTemplateResolver
@inject CertificationEmailTemplateRenderer EmailTemplateRenderer
@inject CertificationEmailHtmlSanitizer EmailHtmlSanitizer
@inject ILogger<Edit> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Inspection</PageTitle>

<div class="inspection-edit-page">
<p><a class="back-link" href="/inspections">← Inspections</a></p>

@if (isLoading)
{
    <p class="status-message">Loading inspection…</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (inspection is null)
{
    <div class="empty-state">
        <h1>Inspection not found</h1>
        <p>The inspection may have been removed.</p>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Inspection <span class="inspection-heading-identifiers">Part# @inspection.PartNumber · Lot# @(inspection.LotNumber ?? "—")</span></h1>
            <p>@inspection.CustomerName · Criteria revision @inspection.RevisionNumber@(inspection.PrintRevisionNumber is null ? null : $" · Print revision {inspection.PrintRevisionNumber}")</p>
        </div>
        <div class="inspection-indicators" aria-label="Inspection status">
            <span class="inspection-indicator @(inspection.InspectionAccepted ? "inspection-indicator-positive" : "inspection-indicator-incomplete")">
                Inspection Accepted: @(inspection.InspectionAccepted ? "Yes" : "No")
            </span>
            <span class="inspection-indicator @(inspection.InspectionCompleted ? "inspection-indicator-positive" : "inspection-indicator-incomplete")">
                Inspection Completed: @(inspection.InspectionCompleted ? "Yes" : "No")
            </span>
        </div>
        <div class="heading-actions">
            <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print")">Preview</a>
            <button class="button button-secondary"
                    type="button"
                    @onclick="DuplicateInspectionAsync"
                    disabled="@(isSaving || isCertificationWorking || isDuplicating)">
                @(isDuplicating ? "Duplicating…" : "Duplicate")
            </button>
            <details class="inspection-print-options">
                <summary class="button button-secondary">Print / Download</summary>
                <div class="inspection-print-options-menu">
                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print?autoPrint=true")" target="_blank" rel="noopener">Print</a>
                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print/download")" download data-enhance-nav="false">Download</a>
                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print?notesPage=second&autoPrint=true")" target="_blank" rel="noopener">Print (Show Extended Notes)</a>
                    <a class="button button-secondary" href="@($"/inspections/{inspection.Id}/print/download?notesPage=second")" download data-enhance-nav="false">Download (Show Extended Notes)</a>
                </div>
            </details>
            <button class="button button-primary"
                    type="button"
                    @onclick="DownloadInspectionSheetPdfAsync"
                    disabled="@(isSaving || isCertificationWorking)">
                Archive
            </button>
            <button class="button button-primary certification-package-button" type="button" @onclick="OpenCertificationPackageAsync" disabled="@(!inspection.InspectionAccepted)">
                Certification Package
            </button>
            <a class="button button-danger-outline" href="@($"/inspections/{inspection.Id}/delete")">Delete inspection</a>
        </div>
    </div>

    @if (showCertificationPackage)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal certification-package-modal" role="dialog" aria-modal="true" aria-labelledby="certification-package-title">
                <div class="page-heading">
                    <div>
                        <h2 id="certification-package-title">Certification Package</h2>
                        <p>@inspection.CustomerName</p>
                    </div>
                    <button class="button button-secondary" type="button" @onclick="CloseCertificationPackage">Close</button>
                </div>
                <div class="certification-package-controls">
                    <div class="form-field">
                        <label for="package-ship-date">Ship Date</label>
                        <InputDate id="package-ship-date" @bind-Value="packageShipDate" />
                    </div>
                    <div class="form-field">
                        <label for="package-plant">Destination plant</label>
                        <InputSelect id="package-plant" @bind-Value="selectedPackagePlantId" @bind-Value:after="RefreshPackageLotsAsync">
                            <option value="0">Select a plant</option>
                            @foreach (var plant in packagePlants) { <option value="@plant.Id">@plant.Name</option> }
                        </InputSelect>
                    </div>
                    <div class="certification-package-selection-summary" aria-live="polite">
                        <span>Lots selected</span>
                        <strong>@selectedPackageLotIds.Count</strong>
                        <small>@(SelectedPackageLots.Count == 0 ? "Choose one or more lots below." : string.Join(", ", SelectedPackageLots.Select(lot => lot.LotNumber ?? "(no lot number)")))</small>
                    </div>
                </div>
                @if (packageLots.Count == 0)
                {
                    <p class="status-message">No eligible lots are available for this destination.</p>
                }
                else
                {
                    <section class="certification-package-lot-picker" aria-labelledby="certification-package-lots-title">
                        <div class="certification-package-lot-picker-heading">
                            <div>
                                <h3 id="certification-package-lots-title">Lots to include</h3>
                                <p>Choose the completed lots that belong in this package.</p>
                            </div>
                            <div class="certification-package-lot-picker-actions">
                                <button class="button button-secondary button-compact" type="button" @onclick="SelectAllPackageLots">All</button>
                                <button class="button button-secondary button-compact" type="button" @onclick="ClearPackageLots" disabled="@(selectedPackageLotIds.Count == 0)">Clear</button>
                            </div>
                        </div>
                        <div class="certification-package-lots" role="group" aria-label="Lots to include">
                            <div class="certification-package-lot-columns" aria-hidden="true">
                                <span></span>
                                <span>Lot</span>
                                <span>Part number</span>
                                <span>Inspection date</span>
                                <span>Status</span>
                            </div>
                        @foreach (var lot in packageLots)
                        {
                            <label class="certification-package-lot @(selectedPackageLotIds.Contains(lot.InspectionId) ? "certification-package-lot-selected" : null)">
                                <input type="checkbox" checked="@selectedPackageLotIds.Contains(lot.InspectionId)"
                                       @onchange="eventArgs => SetPackageLotSelected(lot.InspectionId, eventArgs.Value is true)" />
                                <span class="certification-package-lot-check" aria-hidden="true"></span>
                                <span class="certification-package-lot-number">@(lot.LotNumber ?? "(no lot number)")</span>
                                <span class="certification-package-lot-part">@lot.PartNumber</span>
                                <time datetime="@lot.InspectionDate.ToString("yyyy-MM-dd")">@lot.InspectionDate.ToString("MMM d, yyyy")</time>
                                <small class="certification-package-lot-status @(lot.IsCompleted ? "certification-package-lot-status-complete" : "certification-package-lot-status-incomplete")">@(lot.IsCompleted ? "Completed" : "Incomplete")</small>
                            </label>
                        }
                        </div>
                    </section>
                }
                @if (generatedPackage is not null)
                {
                    <div class="alert alert-success" role="status">
                        Generated <strong>@generatedPackage.FileName</strong> for @generatedPackage.Lots.Count lot(s).
                        To: @(generatedPackage.ToRecipients.Count == 0 ? "none configured" : string.Join(", ", generatedPackage.ToRecipients))
                    </div>
                }
                @if (packageMessage is not null)
                {
                    <div class="alert @(packageSucceeded ? "alert-success" : "alert-error")" role="alert">@packageMessage</div>
                }
                <div class="heading-actions">
                    <button class="button button-secondary" type="button" @onclick="GenerateCertificationPackageAsync" disabled="@packageWorking">Generate / Validate</button>
                    <button class="button button-primary" type="button" @onclick="DownloadCertificationPackageAsync" disabled="@(packageWorking || generatedPackage is null)">Download PDF</button>
                    <button class="button button-primary" type="button" @onclick="ComposeCertificationEmailAsync" disabled="@(packageWorking || generatedPackage is null || generatedPackage.ToRecipients.Count == 0)">Email PDF</button>
                </div>
            </section>
        </div>
    }

    @if (showCertificationEmailCompose && composedEmail is not null)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal certification-package-modal certification-email-compose-modal" role="dialog" aria-modal="true" aria-labelledby="compose-certification-email-title">
                <div class="page-heading">
                    <div>
                        <h2 id="compose-certification-email-title">Compose Certification Email</h2>
                        <p>Review the rendered message. Changes here apply only to this email.</p>
                    </div>
                    <div class="heading-actions">
                        <button class="button button-secondary" type="button" disabled="@packageWorking" @onclick="CancelCertificationEmailCompose">Back</button>
                        <button class="button button-primary" type="button" disabled="@packageWorking" @onclick="SendComposedCertificationEmailAsync">Send Email</button>
                    </div>
                </div>
                @if (composeMessage is not null)
                {
                    <div class="alert @(composeSucceeded ? "alert-success" : "alert-error")" role="alert">@composeMessage</div>
                }
                <div class="certification-email-metadata">
                    <div><strong>To:</strong> @(composedEmail.ToRecipients.Count == 0 ? "none configured" : string.Join(", ", composedEmail.ToRecipients))</div>
                    @if (composedEmail.CcRecipients.Count > 0) { <div><strong>Cc:</strong> @string.Join(", ", composedEmail.CcRecipients)</div> }
                    <div><strong>Attachment:</strong> @composedEmail.AttachmentName</div>
                </div>
                <div class="form-field">
                    <label for="compose-certification-subject">Subject</label>
                    <InputText id="compose-certification-subject" @bind-Value="composedEmail.Subject" />
                </div>
                <div class="form-field">
                    <label>Message</label>
                    <RichTextEditor Value="@composedEmail.HtmlBody" ValueChanged="@(html => composedEmail.HtmlBody = html)" />
                </div>
            </section>
        </div>
    }

    @if (showIncompletePackageLotWarning)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal certification-package-modal certification-package-warning-modal" role="dialog" aria-modal="true" aria-labelledby="incomplete-package-lots-title">
                <div class="page-heading">
                    <div>
                        <h2 id="incomplete-package-lots-title">Incomplete lots selected</h2>
                        <p>The package will show these lots as Complete only while its PDF is generated.</p>
                    </div>
                </div>
                <p>All secondary processes on the selected incomplete lots will be marked Complete in memory for the generated Inspection Sheets, then restored to their current incomplete state.</p>
                <ul>
                    @foreach (var lot in IncompleteSelectedPackageLots)
                    {
                        <li>@lot.PartNumber · Lot @(lot.LotNumber ?? "(no lot number)")</li>
                    }
                </ul>
                <div class="heading-actions">
                    <button class="button button-secondary" type="button" @onclick="CancelIncompletePackageLotWarning">Cancel</button>
                    <button class="button button-primary" type="button" @onclick="GenerateWithTemporaryCompletionAsync">Temporarily mark complete and generate</button>
                </div>
            </section>
        </div>
    }

    @if (saveMessage is not null)
    {
        <div class="alert @(saveSucceeded ? "alert-success" : "alert-error")" role="alert">@saveMessage</div>
    }

    <div class="subtabs revision-tabs" role="tablist" aria-label="Inspection sections">
        <button class="subtab @(activeTab == InspectionTab.Inspection ? "subtab-active" : null)"
                type="button"
                role="tab"
                aria-selected="@(activeTab == InspectionTab.Inspection)"
                @onclick="() => activeTab = InspectionTab.Inspection">
            Inspection
        </button>
        <button class="subtab @(activeTab == InspectionTab.MasterPrint ? "subtab-active" : null)"
                type="button"
                role="tab"
                aria-selected="@(activeTab == InspectionTab.MasterPrint)"
                @onclick="() => activeTab = InspectionTab.MasterPrint">
            Master Print
        </button>
        <button class="subtab @(activeTab == InspectionTab.Certifications ? "subtab-active" : null)"
                type="button"
                role="tab"
                aria-selected="@(activeTab == InspectionTab.Certifications)"
                @onclick="ShowCertifications">
            <span>Certifications</span>
            @if (inspection.IsMissingRequiredCertifications)
            {
                <span class="tab-warning" aria-label="Missing required certifications">!</span>
            }
        </button>
    </div>

    @if (activeTab == InspectionTab.Inspection)
    {
    <EditForm Model="inspection" OnValidSubmit="SaveAsync" FormName="edit-inspection">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="inspection-header-form">
            <div class="inspection-header-group inspection-immutable-group" role="group" aria-label="Inspection criteria details">
            <div class="inspection-readonly-field inspection-part-number-field">
                <span class="inspection-readonly-label">Part Number</span>
                <span class="inspection-readonly-value">@inspection.PartNumber</span>
            </div>
            <div class="inspection-readonly-field">
                <span class="inspection-readonly-label">Criteria Rev</span>
                <span class="inspection-readonly-value">@inspection.RevisionNumber</span>
            </div>
            <div class="inspection-readonly-field">
                <span class="inspection-readonly-label">Print Rev</span>
                <span class="inspection-readonly-value">@(inspection.PrintRevisionNumber ?? "—")</span>
            </div>
            <div class="inspection-readonly-field inspection-description-field">
                <span class="inspection-readonly-label">Part Description</span>
                <span class="inspection-readonly-value">@(inspection.PartDescription ?? "—")</span>
            </div>
            <div class="inspection-readonly-field inspection-specification-field">
                <span class="inspection-readonly-label">Spec Used</span>
                <span class="inspection-readonly-value">@(inspection.SpecificationUsed ?? "—")</span>
            </div>
            </div>

            <div class="inspection-header-group inspection-mutable-group" role="group" aria-label="Inspection details">
            <div class="form-field inspection-lot-field">
                <label for="lot-number">Lot number</label>
                <InputText id="lot-number" @bind-Value="inspection.LotNumber" @bind-Value:after="SaveInspectionAfterEditAsync" />
            </div>
            <div class="form-field inspection-po-field">
                <label for="conformance-po-number">Conformance PO#</label>
                <InputText id="conformance-po-number" @bind-Value="inspection.ConformancePoNumber" @bind-Value:after="SaveInspectionAfterEditAsync" />
            </div>
            <div class="form-field inspection-manufacturer-lot-field">
                <label for="manufacturer-lot-number">Manufacturer's Lot#</label>
                <InputText id="manufacturer-lot-number" @bind-Value="inspection.ManufacturerLotNumber" @bind-Value:after="SaveInspectionAfterEditAsync" />
            </div>
            <div class="form-field inspection-received-date-field">
                <label for="date-received">Date Received</label>
                <InputDate id="date-received"
                           @bind-Value="inspection.DateReceived"
                           @bind-Value:after="SaveInspectionAfterEditAsync"
                           max="@Today" />
                <ValidationMessage For="@(() => inspection.DateReceived)" />
            </div>
            <div class="form-field inspection-date-field">
                <label for="inspection-date">Inspection date</label>
                <InputDate id="inspection-date"
                           @bind-Value="inspection.InspectionDate"
                           @bind-Value:after="SaveInspectionAfterEditAsync"
                           min="@DateReceived"
                           max="@Today" />
                <ValidationMessage For="@(() => inspection.InspectionDate)" />
            </div>
            <div class="form-field inspection-quantity-received-field">
                <label for="quantity-received">Quantity Received</label>
                <ThousandsSeparatedIntegerInput id="quantity-received"
                                                @bind-Value="inspection.QuantityReceived"
                                                @bind-Value:after="UpdateQuantityInspectedAndSaveAsync" />
                <ValidationMessage For="@(() => inspection.QuantityReceived)" />
            </div>
            <div class="form-field inspection-quantity-inspected-field">
                <label for="quantity-inspected">Quantity Inspected</label>
                <InputNumber id="quantity-inspected" tabindex="-1" @bind-Value="inspection.QuantityInspected" @bind-Value:after="SaveInspectionAfterEditAsync" />
                <ValidationMessage For="@(() => inspection.QuantityInspected)" />
            </div>
            <div class="form-field inspection-inspector-field">
                <label for="inspector">Inspector</label>
                <InputSelect id="inspector" tabindex="-1" @bind-Value="inspection.Inspector" @bind-Value:after="SaveInspectionAfterEditAsync">
                    <option value="">Select an inspector</option>
                    @foreach (var displayName in qualityUserDisplayNames)
                    {
                        <option value="@displayName">@displayName</option>
                    }
                </InputSelect>
            </div>
            </div>
        </div>

        <div class="table-shell inspection-results-shell">
            <table class="data-table inspection-results-table">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Dimension / criterion</th>
                        <th>Method</th>
                        <th>Specified max / tolerance</th>
                        <th>Specified min</th>
                        <th>Unit</th>
                        <th>Gage number</th>
                        <th>Recorded max</th>
                        <th>Recorded min</th>
                        <th>Notes</th>
                        <th>Deviation approved</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in inspection.Results)
                    {
                        var isAvailableForDataEntry = IsAvailableForDataEntry(result);
                        <tr class="@(!isAvailableForDataEntry ? "inspection-result-unavailable" : null)">
                            <td data-label="No.">@result.InspectionNumber</td>
                            <td data-label="Dimension / criterion">
                                @result.Name
                                @if (!isAvailableForDataEntry)
                                {
                                    <span class="inspection-result-waiting">Available after @result.RequiredSecondaryProcessName is complete</span>
                                }
                            </td>
                            <td data-label="Method">@(result.InspectionMethod ?? "—")</td>
                            <td data-label="Specified max / tolerance">@(result.SpecifiedMaximum ?? "—")</td>
                            <td data-label="Specified min">@(result.SpecifiedMinimum ?? "—")</td>
                            <td data-label="Unit">@(result.Unit ?? "—")</td>
                            <td data-label="Gage number">
                                <select class="inspection-gage-select"
                                        aria-label="Gage number for @result.Name"
                                        @bind="result.GageId"
                                        @bind:after="() => ApplyGageSelectionAndSaveAsync(result)"
                                        tabindex="@(result.GageId is not null || !isAvailableForDataEntry ? "-1" : "0")"
                                        disabled="@(result.GageChoices.Count == 0 || !isAvailableForDataEntry)">
                                    <option value="">@(result.GageChoices.Count == 0 ? "No gages available" : "Select gage")</option>
                                    @foreach (var gage in result.GageChoices)
                                    {
                                        <option value="@gage.Id">@gage.GageNumber</option>
                                    }
                                </select>
                            </td>
                            <td data-label="Recorded max">
                                <input class="inspection-value-input"
                                       aria-label="Recorded maximum for @result.Name"
                                       @bind="result.ActualMax"
                                       @bind:event="oninput"
                                       @onchange="() => CommitRecordedMaximumAndSaveAsync(result)"
                                       disabled="@(!isAvailableForDataEntry)" />
                                <ValidationMessage For="@(() => result.ActualMax)" />
                                @if (recordedMaximumMessages.TryGetValue(result.Id, out var maximumMessage))
                                {
                                    <div class="validation-message" role="status">@maximumMessage</div>
                                }
                            </td>
                            <td data-label="Recorded min">
                                <input class="inspection-value-input"
                                       aria-label="Recorded minimum for @result.Name"
                                       @bind="result.ActualMin"
                                       @bind:event="oninput"
                                       @onchange="() => CommitRecordedMinimumAndSaveAsync(result)"
                                       tabindex="@(ShouldSkipRecordedMinimum(result) || !isAvailableForDataEntry ? "-1" : "0")"
                                       disabled="@(!isAvailableForDataEntry)" />
                                <ValidationMessage For="@(() => result.ActualMin)" />
                                @if (recordedMinimumMessages.TryGetValue(result.Id, out var minimumMessage))
                                {
                                    <div class="validation-message" role="status">@minimumMessage</div>
                                }
                            </td>
                            <td data-label="Notes">@(result.Notes ?? "—")</td>
                            <td data-label="Deviation approved">
                                <input type="checkbox"
                                       aria-label="Deviation approved for @result.Name"
                                       tabindex="-1"
                                       @bind="result.DeviationApproved"
                                       @bind:after="SaveInspectionAfterEditAsync"
                                       disabled="@(!isAvailableForDataEntry)" />
                            </td>
                            <td data-label="Result">
                                <span class="status-pill @EvaluationClass(result.Evaluation)">@EvaluationText(result.Evaluation)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="inspection-lower-grid">
        <section class="inspection-secondary-process-section">
            <h2>Secondary Processes</h2>
            @if (inspection.SecondaryProcesses.Count == 0)
            {
                <div class="empty-state compact-empty-state">No secondary processes are required.</div>
            }
            else
            {
                <div class="table-shell">
                    <table class="data-table inspection-secondary-process-table">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Specification</th>
                                <th>PO number</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var process in inspection.SecondaryProcesses)
                            {
                                <tr>
                                    <td data-label="Process">@process.ProcessName</td>
                                    <td data-label="Specification">@(process.Specification ?? "—")</td>
                                    <td data-label="PO number">
                                        <InputText class="inspection-process-po-input"
                                                   aria-label="@($"PO number for {process.ProcessName}")"
                                                   @bind-Value="process.PurchaseOrderNumber"
                                                   @bind-Value:after="SaveInspectionAfterEditAsync" />
                                    </td>
                                    <td data-label="Status">
                                        <fieldset class="inspection-process-status">
                                            <legend class="visually-hidden">Status for @process.ProcessName</legend>
                                            <label>
                                                <input type="radio"
                                                       name="secondary-process-status-@process.Id"
                                                       checked="@process.IsComplete"
                                                       @onchange="() => SetSecondaryProcessCompletionAndSaveAsync(process, true)" />
                                                Complete
                                            </label>
                                            <label>
                                                <input type="radio"
                                                       name="secondary-process-status-@process.Id"
                                                       checked="@(!process.IsComplete)"
                                                       @onchange="() => SetSecondaryProcessCompletionAndSaveAsync(process, false)" />
                                                Incomplete
                                            </label>
                                        </fieldset>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <div class="inspection-readonly-field inspection-criteria-notes">
            <span class="inspection-readonly-label">Inspection Criteria Notes</span>
            <span class="inspection-readonly-value">@(inspection.CriteriaNotes ?? "—")</span>
        </div>
        </div>

        <section class="inspection-notes-section">
            <div class="form-field">
                <label for="inspector-notes">Inspector's Notes</label>
                <InputTextArea id="inspector-notes" @bind-Value="inspection.InspectorNotes" @bind-Value:after="SaveInspectionAfterEditAsync" />
            </div>
            <div class="form-field">
                <label for="in-house-notes">In House Notes</label>
                <InputTextArea id="in-house-notes" @bind-Value="inspection.InHouseNotes" @bind-Value:after="SaveInspectionAfterEditAsync" />
            </div>
        </section>

        <div class="form-actions">
            <button class="button button-primary" type="submit" disabled="@isSaving">
                @(isSaving ? "Saving…" : "Save inspection")
            </button>
            <a class="button button-secondary" href="/inspections">Back</a>
        </div>
    </EditForm>
    }
    else if (activeTab == InspectionTab.MasterPrint)
    {
        <section class="master-print-panel">
            <div class="master-print-toolbar">
                <div>
                    <h2>Master Print</h2>
                    @if (inspection.HasMasterPrint)
                    {
                        <p>
                            <strong>@inspection.MasterPrintFileName</strong>
                            @if (inspection.MasterPrintUploadedAtUtc is not null)
                            {
                                <span> · Uploaded @inspection.MasterPrintUploadedAtUtc.Value.ToString("u")</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p>No master print was uploaded for criteria revision @inspection.RevisionNumber.</p>
                    }
                </div>
                @if (inspection.HasMasterPrint)
                {
                    <div class="heading-actions">
                        <a class="button button-secondary" href="@MasterPrintViewerUrl" target="_blank" rel="noopener">Open in new tab</a>
                    </div>
                }
            </div>

            @if (inspection.HasMasterPrint)
            {
                <iframe class="master-print-viewer" src="@MasterPrintViewerUrl" title="Master print PDF"></iframe>
            }
        </section>
    }
    else
    {
        <section class="inspection-certifications-panel">
            <aside class="certification-navigation" aria-label="Certification types">
                @foreach (var certification in inspection.Certifications)
                {
                    <button class="certification-nav-item @(selectedCertificationTypeId == certification.CertificationTypeId ? "certification-nav-item-active" : null)"
                            type="button"
                            @onclick="() => SelectCertification(certification.CertificationTypeId)">
                        <span class="certification-status-icon @CertificationStatusClass(certification)" aria-hidden="true">@CertificationStatusIcon(certification)</span>
                        <span>
                            <strong>@certification.CertificationTypeName</strong>
                            <small>@certification.StatusText</small>
                        </span>
                    </button>
                }
            </aside>

            <div class="certification-detail">
                @if (SelectedCertification is not null)
                {
                    <div class="section-heading certification-detail-heading">
                        <div>
                            <h2>@SelectedCertification.CertificationTypeName</h2>
                            <p class="@CertificationStatusClass(SelectedCertification)">@SelectedCertification.StatusText</p>
                            @if (SelectedCertification.RequirementNotes is not null)
                            {
                                <p>@SelectedCertification.RequirementNotes</p>
                            }
                        </div>
                    </div>

                    <label class="master-print-drop-zone" for="certification-file-input">
                        <span class="master-print-drop-title">Drop a certification PDF here</span>
                        <span>or click to choose a file · multiple files supported · 25 MB maximum each</span>
                    </label>
                    <InputFile id="certification-file-input"
                               @key="SelectedCertification.CertificationTypeId"
                               class="master-print-file-input"
                               OnChange="UploadCertificationDocumentAsync"
                               accept="application/pdf,.pdf"
                               multiple
                               disabled="@isCertificationWorking" />

                    @if (SelectedCertification.Documents.Count == 0)
                    {
                        <div class="empty-state compact-empty-state">No documents have been uploaded for this certification.</div>
                    }
                    else
                    {
                        <div class="certification-document-list">
                            @foreach (var document in SelectedCertification.Documents)
                            {
                                <article class="certification-document-card">
                                    <div>
                                        <strong>@document.OriginalFileName</strong>
                                        <small>Uploaded @document.UploadedAtUtc.ToString("u")</small>
                                    </div>
                                    <div class="row-actions">
                                        <a class="button button-secondary button-compact" href="@CertificationDocumentUrl(document.Id)" target="_blank" rel="noopener">Open / Print</a>
                                        <a class="button button-secondary button-compact"
                                           href="@CertificationDocumentDownloadUrl(document.Id)"
                                           download
                                           data-enhance-nav="false">
                                            Download
                                        </a>
                                        @if (pendingCertificationDocumentDeleteId == document.Id)
                                        {
                                            <button class="button button-danger button-compact" type="button" @onclick="() => DeleteCertificationDocumentAsync(document)" disabled="@isCertificationWorking">Confirm delete</button>
                                            <button class="button button-secondary button-compact" type="button" @onclick="() => pendingCertificationDocumentDeleteId = null" disabled="@isCertificationWorking">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="button button-danger-outline button-compact" type="button" @onclick="() => pendingCertificationDocumentDeleteId = document.Id" disabled="@isCertificationWorking">Delete</button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    @if (selectedDocumentId is long documentId
                        && SelectedCertification.Documents.Any(x => x.Id == documentId))
                    {
                        <iframe class="master-print-viewer certification-document-viewer" src="@CertificationDocumentViewerUrl(documentId)" title="Certification document PDF"></iframe>
                    }
                }
            </div>
        </section>
    }
}
</div>

