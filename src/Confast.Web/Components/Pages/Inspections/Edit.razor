    private async Task DuplicateInspectionAsync()
    {
        if (inspection is null || isSaving || isCertificationWorking || isDuplicating)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(duplicateLotNumber))
        {
            duplicateMessage = "Enter the new lot number.";
            return;
        }

        if (duplicateQuantity is not int quantityToMove)
        {
            duplicateMessage = "Enter the quantity to move to the duplicated inspection.";
            return;
        }

        isDuplicating = true;
        saveMessage = null;
        saveSucceeded = false;
        try
        {
            // The edit form autosaves, but explicitly commit any pending change before
            // cloning so the duplicate reflects what is currently on screen.
            var saveResult = await SavePendingInspectionAsync();
            if (saveResult.Status != InspectionOperationStatus.Succeeded)
            {
                saveMessage = saveResult.Status switch
                {
                    InspectionOperationStatus.Conflict =>
                        "Someone else changed this inspection. Reload it before duplicating.",
                    InspectionOperationStatus.ValidationFailed => saveResult.Message,
                    InspectionOperationStatus.NotFound => "The inspection no longer exists.",
                    _ => "The inspection could not be saved before duplicating. Please try again."
                };
                return;
            }

            CaptureCommittedMeasurements();
            var duplicateResult = await InspectionService.DuplicateInspectionAsync(
                inspection.Id,
                quantityToMove,
                duplicateLotNumber);
            if (duplicateResult.Status == InspectionOperationStatus.Succeeded)
            {
                CancelDuplicate();
                Navigation.NavigateTo($"/inspections/{duplicateResult.InspectionId}");
                return;
            }

            if (duplicateResult.Status == InspectionOperationStatus.ValidationFailed)
            {
                duplicateMessage = duplicateResult.Message;
                return;
            }

            saveMessage = duplicateResult.Status switch
            {
                InspectionOperationStatus.NotFound => "This inspection no longer exists.",
                InspectionOperationStatus.Conflict =>
                    "The inspection changed while it was being duplicated. Please try again.",
                _ => "The inspection could not be duplicated. Please try again."
            };
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to duplicate inspection {InspectionId}", InspectionId);
            saveMessage = "The inspection could not be duplicated. Please try again.";
        }
        finally
        {
            isDuplicating = false;
        }
    }

