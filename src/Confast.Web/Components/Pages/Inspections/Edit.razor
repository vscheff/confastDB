    private static bool ShouldSkipRecordedMinimum(InspectionResultEditModel result) =>
        InspectionResultEvaluator.TryNormalizePassingEntry(result.ActualMax, out _);

    private bool IsAvailableForDataEntry(InspectionResultEditModel result) =>
