    private void CommitRecordedMinimum(InspectionResultEditModel result)
    {
        recordedMinimumMessages.Remove(result.Id);
        if (InspectionResultEvaluator.TryNormalizePassingEntry(
                result.ActualMin,
                out var passingEntry))
        {
            SetBothRecordedValues(result, passingEntry);
            return;
        }

        result.ActualMin = InspectionResultEvaluator.EnsureRecordedDecimalPlaces(
            result.ActualMin,
            result.SpecifiedMinimum,
            result.SpecifiedMaximum);

        if (InspectionResultEvaluator.HasInvalidRecordedOrder(result.ActualMin, result.ActualMax))
        {
            var previousValue = committedMinimums.GetValueOrDefault(result.Id);
            result.ActualMin = previousValue;
            recordedMinimumMessages[result.Id] =
                $"Reverted to {DescribeRecordedValue(previousValue)} because Recorded Min cannot be greater than Recorded Max.";
            return;
        }

        committedMinimums[result.Id] = result.ActualMin;
    }

    private async Task CommitRecordedMinimumAndSaveAsync(InspectionResultEditModel result)
    {
        CommitRecordedMinimum(result);
        await SaveInspectionAfterEditAsync();
