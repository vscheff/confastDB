    private async Task BuildCertificationPackageAsync(bool temporarilyCompleteIncompleteLots)
    {
        packageWorking = true;
        packageSucceeded = false;
        packageMessage = null;
        generatedPackage = null;
        try
        {
            if (selectedPackageLotIds.Count == 0)
            {
                packageMessage = "Select at least one lot.";
                return;
            }
            if (selectedPackagePlantId == 0)
            {
                packageMessage = "Select a destination plant.";
                return;
            }
            generatedPackage = await CertificationPackageService.BuildAsync(
                new CertificationPackageRequest(inspection!.Id, inspection.CustomerId, selectedPackageLotIds, packageShipDate, selectedPackagePlantId, temporarilyCompleteIncompleteLots),
                Navigation.BaseUri);
            packageSucceeded = true;
            packageMessage = "Certification package generated and validated.";
        }
        catch (CertificationPackageException exception)
        {
            packageMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to generate certification package for inspection {InspectionId}", InspectionId);
            packageMessage = "The certification package could not be generated.";
        }
        finally { packageWorking = false; }
    }

    private async Task DownloadCertificationPackageAsync()
    {
        if (generatedPackage is null) return;
        await JS.InvokeVoidAsync("confast.downloadBytes", generatedPackage.FileName, generatedPackage.Content);
        packageMessage = "Certification package download started.";
        packageSucceeded = true;
    }

    private async Task ComposeCertificationEmailAsync()
    {
        if (generatedPackage is null) return;
        packageWorking = true;
        packageSucceeded = false;
        try
        {
            var type = EmailTemplateRenderer.GetTemplateType(generatedPackage);
            var template = await EmailTemplateResolver.ResolveEmailTemplateAsync(type);
            var sender = await CurrentEmailSender.GetAsync();
            var draft = EmailTemplateRenderer.Render(generatedPackage, template, sender);
            composedEmail = new ComposedCertificationEmail(draft.Subject, draft.HtmlBody, draft.ToRecipients, draft.CcRecipients, draft.AttachmentName);
            composeMessage = null;
            composeSucceeded = false;
            showCertificationEmailCompose = true;
        }
        catch (CertificationEmailTemplateException exception)
        {
            packageMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to compose certification package email for inspection {InspectionId}", InspectionId);
            packageMessage = "The certification email could not be prepared.";
        }
        finally { packageWorking = false; }
    }

    private void CancelCertificationEmailCompose()
    {
        showCertificationEmailCompose = false;
        composedEmail = null;
        composeMessage = null;
    }

    private async Task SendComposedCertificationEmailAsync()
    {
        if (generatedPackage is null || composedEmail is null) return;
        packageWorking = true;
        composeMessage = null;
        try
        {
            if (string.IsNullOrWhiteSpace(composedEmail.Subject)) throw new EmailDeliveryException("Email subject is required.");
            var body = EmailHtmlSanitizer.SanitizeForEmail(composedEmail.HtmlBody);
            if (string.IsNullOrWhiteSpace(body)) throw new EmailDeliveryException("Email body contains no supported content.");
            await CertificationEmailService.SendAsync(new EmailMessage(await CurrentEmailSender.GetAsync(), composedEmail.ToRecipients,
                composedEmail.CcRecipients, composedEmail.Subject.Trim(), body, generatedPackage.FileName, generatedPackage.Content));
            composeSucceeded = true;
            composeMessage = "Certification package emailed successfully.";
            packageSucceeded = true;
            packageMessage = "Certification package emailed successfully.";
        }
        catch (EmailDeliveryException exception) { composeSucceeded = false; composeMessage = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to email certification package for inspection {InspectionId}", InspectionId);
            composeSucceeded = false;
            composeMessage = "The certification package could not be emailed.";
        }
        finally { packageWorking = false; }
    }

