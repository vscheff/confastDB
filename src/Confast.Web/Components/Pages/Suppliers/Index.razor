@page "/suppliers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Confast.Web.Features.Suppliers
@using Confast.Web.Features.ContainerTracking
@inject SupplierService Suppliers
@inject TrackingAccess Access
@inject ILogger<Index> Logger

<PageTitle>Suppliers</PageTitle>
<div class="page-heading">
    <div><h1>Suppliers</h1><p>Supplier master data for bills of lading.</p></div>
    @if (permissions.CanEdit)
    {
        <button type="button" class="button button-primary" @onclick="() => editing = new()">Create supplier</button>
    }
</div>
@if (message is not null) { <div class="alert @(isError ? "alert-error" : "alert-success")" role="status">@message</div> }
<form class="tracking-search" @onsubmit="LoadAsync" @onsubmit:preventDefault>
    <div class="form-field"><label for="supplier-search">Search suppliers</label><input id="supplier-search" type="search" @bind="search" /></div>
    <button class="button button-secondary" disabled="@busy">Search</button>
</form>
@if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="SaveAsync" FormName="supplier" class="record-form tracking-form">
        <DataAnnotationsValidator /><ValidationSummary />
        <h2>@(editing.Id == 0 ? "Create supplier" : "Edit supplier")</h2>
        <fieldset disabled="@(!permissions.CanEdit || busy)" class="tracking-fields">
            <div class="form-field"><label for="supplier-name">Name</label><InputText id="supplier-name" @bind-Value="editing.Name" maxlength="200" /></div>
            <div class="checkbox-field"><InputCheckbox id="supplier-active" @bind-Value="editing.IsActive" /><label for="supplier-active">Active supplier</label></div>
        </fieldset>
        <div class="form-actions">
            @if (permissions.CanEdit) { <button class="button button-primary" disabled="@busy">Save supplier</button> }
            <button type="button" class="button button-secondary" @onclick="() => editing = null">Close</button>
        </div>
    </EditForm>
}
<div class="table-shell">
    <table class="data-table"><thead><tr><th>Name</th><th>Status</th><th>Actions</th></tr></thead><tbody>
        @foreach (var supplier in rows)
        {
            <tr @key="supplier.Id"><td>@supplier.Name</td><td>@(supplier.IsActive ? "Active" : "Inactive")</td>
                <td><button class="button button-secondary" @onclick="() => Edit(supplier)">@(permissions.CanEdit ? "Edit" : "View")</button></td></tr>
        }
    </tbody></table>
</div>
@if (!busy && rows.Count == 0) { <p class="status-message">No suppliers found.</p> }

@code {
    private TrackingPermissions permissions = new(false, false);
    private List<SupplierEditModel> rows = [];
    private SupplierEditModel? editing;
    private string? search, message;
    private bool busy, isError;
    protected override Task OnInitializedAsync() => LoadAsync();
    private void Edit(SupplierEditModel item) => editing = new() { Id = item.Id, Name = item.Name, IsActive = item.IsActive, Version = item.Version };
    private async Task LoadAsync()
    {
        busy = true;
        try { permissions = await Access.GetAsync(); rows = await Suppliers.SearchAsync(search); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load suppliers"); message = "Suppliers could not be loaded."; isError = true; }
        finally { busy = false; }
    }
    private async Task SaveAsync()
    {
        if (busy || editing is null) return;
        busy = true;
        try
        {
            var result = await Suppliers.SaveAsync(editing);
            message = result.Message ?? "Supplier saved."; isError = !result.Succeeded;
            if (result.Succeeded) { editing = null; rows = await Suppliers.SearchAsync(search); }
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save supplier"); message = "Supplier could not be saved."; isError = true; }
        finally { busy = false; }
    }
}
