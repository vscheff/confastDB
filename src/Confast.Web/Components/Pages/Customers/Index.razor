@page "/"
@page "/customers"
@using Confast.Web.Features.Customers
@inject CustomerService CustomerService
@inject ILogger<Index> Logger

<PageTitle>Customers</PageTitle>

<div class="page-heading">
    <div>
        <h1>Customers</h1>
        <p>Select a customer to view or edit its details.</p>
    </div>
    <div class="heading-actions">
        <button class="button button-secondary" type="button" @onclick="LoadCustomersAsync" disabled="@isLoading">
            Refresh
        </button>
        <a class="button button-primary" href="/customers/create">Create customer</a>
    </div>
</div>

@if (isLoading)
{
    <p class="status-message">Loading customers…</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (customers.Count == 0)
{
    <div class="empty-state">
        <h2>No customers yet</h2>
        <p>Add a new Customer to the database to see it listed here.</p>
    </div>
}
else
{
    <div class="table-shell">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in customers)
                {
                    <tr>
                        <td data-label="Name">
                            <a class="record-link" href="@($"/customers/{customer.Id}/edit")">@customer.Name</a>
                        </td>
                        <td data-label="Status">
                            <span class="status-pill @(customer.IsActive ? "status-active" : "status-inactive")">
                                @(customer.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="table-action">
                            <a class="button button-secondary" href="@($"/customers/{customer.Id}/edit")">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<CustomerListItem> customers = [];
    private bool isLoading = true;
    private string? loadError;

    protected override Task OnInitializedAsync() => LoadCustomersAsync();

    private async Task LoadCustomersAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            customers = await CustomerService.GetCustomersAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load customers");
            loadError = "Customers could not be loaded. Check that the database is running and configured.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
