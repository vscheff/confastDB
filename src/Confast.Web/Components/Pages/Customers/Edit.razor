@page "/customers/{Id:long}/edit"
@using Confast.Web.Features.Customers
@using Confast.Web.Features.Parts
@using Confast.Web.Components.Pages.Parts
@inject CustomerService CustomerService
@inject PartService PartService
@inject CertificationPackageFilenameFormatter FilenameFormatter
@inject ILogger<Edit> Logger

<PageTitle>@(customer is null ? "Customer" : $"Edit {customer.Name}")</PageTitle>

<p><a class="back-link" href="/customers">← Customers</a></p>

@if (isLoading)
{
    <p class="status-message">Loading customer…</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (customer is null)
{
    <div class="empty-state">
        <h1>Customer not found</h1>
        <p>The customer may have been removed.</p>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <h1>@customer.Name</h1>
        </div>
        <span class="status-pill @(customer.IsActive ? "status-active" : "status-inactive")">
            @(customer.IsActive ? "Active" : "Inactive")
        </span>
    </div>

    @if (saveMessage is not null)
    {
        <div class="alert @saveMessageClass" role="status">@saveMessage</div>
    }

    <EditForm Model="customer" OnValidSubmit="SaveAsync" FormName="edit-customer" class="customer-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-field form-field-wide">
            <label for="customer-name">Name</label>
            <InputText id="customer-name" @bind-Value="customer.Name" autocomplete="organization" />
            <ValidationMessage For="() => customer.Name" />
        </div>

        <div class="form-field form-field-wide checkbox-field">
            <InputCheckbox id="is-active" @bind-Value="customer.IsActive" />
            <label for="is-active">Active customer</label>
        </div>

        <div class="form-actions form-field-wide">
            <button class="button button-primary" type="submit" disabled="@isSaving">
                @(isSaving ? "Saving…" : "Save changes")
            </button>
            <a class="button button-secondary" href="/customers">Cancel</a>
        </div>
    </EditForm>

    <div class="subtabs customer-tabs" role="tablist" aria-label="Customer sections">
        <button class="subtab @(activeTab == CustomerTab.Plants ? "subtab-active" : null)" type="button" role="tab" aria-selected="@(activeTab == CustomerTab.Plants)" @onclick="() => activeTab = CustomerTab.Plants">Plants</button>
        <button class="subtab @(activeTab == CustomerTab.Parts ? "subtab-active" : null)" type="button" role="tab" aria-selected="@(activeTab == CustomerTab.Parts)" @onclick="() => activeTab = CustomerTab.Parts">Parts</button>
    </div>

    @if (activeTab == CustomerTab.Plants)
    {
        <section class="linked-records" role="tabpanel" aria-labelledby="customer-plants-heading">
            <div class="section-heading"><div><h2 id="customer-plants-heading">Plants</h2><p>Destination, address, and certification delivery settings.</p></div></div>
            <div class="subtabs plant-tabs" role="tablist" aria-label="Plants">
                @foreach (var plant in plants)
                {
                    <button class="subtab @(!showNewPlantEditor && selectedPlantId == plant.Id ? "subtab-active" : null)" type="button" role="tab" aria-selected="@(!showNewPlantEditor && selectedPlantId == plant.Id)" @onclick="() => SelectPlantAsync(plant.Id)">@plant.Name</button>
                }
                <button class="subtab @(showNewPlantEditor ? "subtab-active" : null)" type="button" role="tab" aria-label="Create plant" aria-selected="@showNewPlantEditor" @onclick="ShowNewPlantEditor">+</button>
            </div>
            @if (plantMessage is not null) { <div class="alert @plantMessageClass" role="status">@plantMessage</div> }

            @if (showNewPlantEditor)
            {
                <EditForm Model="newPlant" OnValidSubmit="() => SavePlantAsync(newPlant)" FormName="new-plant" class="certification-recipient-row certification-recipient-new">
                    <DataAnnotationsValidator />
                    <div class="form-field"><label>Name</label><InputText @bind-Value="newPlant.Name" /><ValidationMessage For="() => newPlant.Name" /></div>
                    <div class="form-field"><label>Plant code</label><InputText @bind-Value="newPlant.PlantCode" /></div>
                    <div class="form-field form-field-wide"><label>Address line 1</label><InputText @bind-Value="newPlant.AddressLine1" autocomplete="address-line1" /></div>
                    <div class="form-field form-field-wide"><label>Address line 2</label><InputText @bind-Value="newPlant.AddressLine2" autocomplete="address-line2" /></div>
                    <div class="form-field"><label>City</label><InputText @bind-Value="newPlant.City" autocomplete="address-level2" /></div>
                    <div class="form-field"><label>State</label><InputText @bind-Value="newPlant.State" autocomplete="address-level1" /></div>
                    <div class="form-field"><label>Postal code</label><InputText @bind-Value="newPlant.PostalCode" autocomplete="postal-code" /></div>
                    <div class="row-actions certification-recipient-actions"><button class="button button-primary button-compact" type="submit" disabled="@isSavingPlant">Create plant</button></div>
                </EditForm>
            }
            else if (SelectedPlant is not null)
            {
                <EditForm Model="SelectedPlant" OnValidSubmit="() => SavePlantAsync(SelectedPlant)" FormName="@($"plant-{SelectedPlant.Id}")" class="certification-recipient-row">
                    <DataAnnotationsValidator />
                    <div class="form-field"><label>Name</label><InputText @bind-Value="SelectedPlant.Name" /><ValidationMessage For="() => SelectedPlant.Name" /></div>
                    <div class="form-field"><label>Plant code</label><InputText @bind-Value="SelectedPlant.PlantCode" /></div>
                    <div class="form-field form-field-wide"><label>Address line 1</label><InputText @bind-Value="SelectedPlant.AddressLine1" autocomplete="address-line1" /></div>
                    <div class="form-field form-field-wide"><label>Address line 2</label><InputText @bind-Value="SelectedPlant.AddressLine2" autocomplete="address-line2" /></div>
                    <div class="form-field"><label>City</label><InputText @bind-Value="SelectedPlant.City" autocomplete="address-level2" /></div>
                    <div class="form-field"><label>State</label><InputText @bind-Value="SelectedPlant.State" autocomplete="address-level1" /></div>
                    <div class="form-field"><label>Postal code</label><InputText @bind-Value="SelectedPlant.PostalCode" autocomplete="postal-code" /></div>
                    <div class="row-actions certification-recipient-actions"><button class="button button-primary button-compact" type="submit" disabled="@isSavingPlant">Save plant</button><button class="button button-danger button-compact" type="button" disabled="@isSavingPlant" @onclick="() => DeletePlantAsync(SelectedPlant)">Remove</button></div>
                </EditForm>
            }
        </section>
    }

    @if (activeTab == CustomerTab.Plants && !showNewPlantEditor && certificationDelivery is not null)
    {
        <section class="linked-records certification-delivery" role="tabpanel" aria-labelledby="certification-delivery-heading">
            <div class="section-heading">
                <div>
                    <h2 id="certification-delivery-heading">Certification Delivery</h2>
                    <p>Delivery settings for the selected destination plant.</p>
                </div>
            </div>

            @if (certificationMessage is not null)
            {
                <div class="alert @certificationMessageClass" role="status">@certificationMessage</div>
            }

            <div class="certification-delivery-grid">
                <div class="certification-delivery-panel certification-recipient-panel">
                    <h3>Recipients</h3>
                    @foreach (var recipient in certificationDelivery.Recipients)
                    {
                        <EditForm Model="recipient" OnValidSubmit="() => SaveRecipientAsync(recipient)" FormName="@($"certification-recipient-{recipient.Id}")" class="certification-recipient-row">
                            <DataAnnotationsValidator />
                            <div class="form-field">
                                <label for="@($"recipient-name-{recipient.Id}")">Name</label>
                                <InputText id="@($"recipient-name-{recipient.Id}")" @bind-Value="recipient.Name" autocomplete="name" />
                            </div>
                            <div class="form-field certification-recipient-email">
                                <label for="@($"recipient-email-{recipient.Id}")">Email</label>
                                <InputText id="@($"recipient-email-{recipient.Id}")" @bind-Value="recipient.EmailAddress" autocomplete="email" />
                                <ValidationMessage For="() => recipient.EmailAddress" />
                            </div>
                            <div class="form-field certification-recipient-type">
                                <label for="@($"recipient-type-{recipient.Id}")">Type</label>
                                <InputSelect id="@($"recipient-type-{recipient.Id}")" @bind-Value="recipient.RecipientType">
                                    <option value="@CertificationRecipientType.To">To</option>
                                    <option value="@CertificationRecipientType.Cc">Cc</option>
                                </InputSelect>
                            </div>
                            <div class="row-actions certification-recipient-actions">
                                <button class="button button-primary button-compact" type="submit" disabled="@isSavingCertification">Save</button>
                                <button class="button button-danger button-compact" type="button" disabled="@isSavingCertification" @onclick="() => DeleteRecipientAsync(recipient)">Remove</button>
                            </div>
                        </EditForm>
                    }

                    <EditForm Model="newRecipient" OnValidSubmit="() => SaveRecipientAsync(newRecipient)" FormName="new-certification-recipient" class="certification-recipient-row certification-recipient-new">
                        <DataAnnotationsValidator />
                        <div class="form-field">
                            <label for="new-recipient-name">Name</label>
                            <InputText id="new-recipient-name" @bind-Value="newRecipient.Name" autocomplete="name" />
                        </div>
                        <div class="form-field certification-recipient-email">
                            <label for="new-recipient-email">Email</label>
                            <InputText id="new-recipient-email" @bind-Value="newRecipient.EmailAddress" autocomplete="email" />
                            <ValidationMessage For="() => newRecipient.EmailAddress" />
                        </div>
                        <div class="form-field certification-recipient-type">
                            <label for="new-recipient-type">Type</label>
                            <InputSelect id="new-recipient-type" @bind-Value="newRecipient.RecipientType">
                                <option value="@CertificationRecipientType.To">To</option>
                                <option value="@CertificationRecipientType.Cc">Cc</option>
                            </InputSelect>
                        </div>
                        <div class="row-actions certification-recipient-actions">
                            <button class="button button-secondary button-compact" type="submit" disabled="@isSavingCertification">Add recipient</button>
                        </div>
                    </EditForm>
                </div>

                <div class="certification-delivery-panel">
                    <h3>Required certifications</h3>
                    <div class="certification-type-checklist">
                        @foreach (var certificationType in certificationDelivery.CertificationTypes)
                        {
                            <label>
                                <input type="checkbox" @bind="certificationType.IsRequired" />
                                <span>@certificationType.Name</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="certification-delivery-panel certification-filename-panel">
                    <h3>Package filenames</h3>
                    <div class="filename-template-grid">
                        <div class="filename-template-group">
                            <div class="form-field">
                                <label for="certification-filename-template">Single-Lot filename template</label>
                                <InputText id="certification-filename-template" @bind-Value="certificationDelivery.FilenameTemplate" @bind-Value:event="oninput" placeholder="@CertificationPackageFilenameFormatter.SystemDefaultTemplate" />
                            </div>
                            <div class="filename-token-list" aria-label="Supported single-lot filename tokens">
                                @foreach (var token in CertificationPackageFilenameFormatter.SupportedTokens)
                                {
                                    <button type="button" class="token-button" @onclick="() => InsertFilenameToken(token)">@token</button>
                                }
                            </div>
                            <p class="filename-preview"><strong>Preview:</strong> @CertificationFilenamePreview</p>
                            <p class="field-hint">Leave blank to use the system default: <code>@CertificationPackageFilenameFormatter.SystemDefaultTemplate</code></p>
                        </div>

                        <div class="filename-template-group">
                            <div class="form-field">
                                <label for="certification-single-part-multi-lot-filename-template">Single-Part, Multi-Lot filename template</label>
                                <InputText id="certification-single-part-multi-lot-filename-template" @bind-Value="certificationDelivery.SinglePartMultiLotFilenameTemplate" @bind-Value:event="oninput" placeholder="@CertificationPackageFilenameFormatter.SinglePartMultiLotSystemDefaultTemplate" />
                            </div>
                            <div class="filename-token-list" aria-label="Supported single-part multi-lot filename tokens">
                                @foreach (var token in CertificationPackageFilenameFormatter.SinglePartMultiLotSupportedTokens)
                                {
                                    <button type="button" class="token-button" @onclick="() => InsertSinglePartMultiLotFilenameToken(token)">@token</button>
                                }
                            </div>
                            <p class="filename-preview"><strong>Preview:</strong> @SinglePartMultiLotCertificationFilenamePreview</p>
                            <p class="field-hint">Used when one package contains multiple lots for the same part. Leave blank to use: <code>@CertificationPackageFilenameFormatter.SinglePartMultiLotSystemDefaultTemplate</code></p>
                        </div>

                        <div class="filename-template-group">
                            <div class="form-field">
                                <label for="certification-multi-part-filename-template">Multi-Part filename template</label>
                                <InputText id="certification-multi-part-filename-template" @bind-Value="certificationDelivery.MultiPartFilenameTemplate" @bind-Value:event="oninput" placeholder="@CertificationPackageFilenameFormatter.MultiPartSystemDefaultTemplate" />
                            </div>
                            <div class="filename-token-list" aria-label="Supported multi-part filename tokens">
                                @foreach (var token in CertificationPackageFilenameFormatter.MultiPartSupportedTokens)
                                {
                                    <button type="button" class="token-button" @onclick="() => InsertMultiPartFilenameToken(token)">@token</button>
                                }
                            </div>
                            <p class="filename-preview"><strong>Preview:</strong> @MultiPartCertificationFilenamePreview</p>
                            <p class="field-hint">Used when one package contains more than one part. Leave blank to use: <code>@CertificationPackageFilenameFormatter.MultiPartSystemDefaultTemplate</code></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions certification-delivery-actions">
                <button class="button button-primary" type="button" disabled="@isSavingCertification" @onclick="SaveCertificationConfigurationAsync">
                    @(isSavingCertification ? "Saving…" : "Save certification settings")
                </button>
            </div>
        </section>
    }

    @if (activeTab == CustomerTab.Parts)
    {
    <section class="linked-records" role="tabpanel" aria-labelledby="customer-parts-heading">
        <div class="section-heading">
            <div>
                <h2 id="customer-parts-heading">Parts</h2>
                <p>Parts assigned to @customer.Name.</p>
            </div>
            <a class="button button-primary" href="@($"/parts/create?customerId={customer.Id}")">Create part</a>
        </div>

        @if (parts.Count == 0)
        {
            <div class="empty-state compact-empty-state">This customer has no parts.</div>
        }
        else
        {
            <div class="table-shell">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Part number</th>
                            <th>Revision</th>
                            <th>Description</th>
                            <th>Destination plants</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var part in parts)
                        {
                            <tr>
                                <td data-label="Part number">
                                    <a class="record-link" href="@($"/parts/{part.Id}/edit")">@part.PartNumber</a>
                                </td>
                                <td data-label="Revision">@(part.Revision ?? "—")</td>
                                <td data-label="Description">@(part.Description ?? "—")</td>
                                <td data-label="Destination plants"><PartPlantMenu Plants="part.Plants" /></td>
                                <td data-label="Status">
                                    <span class="status-pill @(part.IsActive ? "status-active" : "status-inactive")">@(part.IsActive ? "Active" : "Inactive")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    }
}

@code {
    [Parameter]
    public long Id { get; set; }

    private CustomerEditModel? customer;
    private PlantCertificationDeliveryEditModel? certificationDelivery;
    private PlantCertificationRecipientEditModel newRecipient = new();
    private IReadOnlyList<PartListItem> parts = [];
    private List<PlantEditModel> plants = [];
    private PlantEditModel newPlant = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool isSavingCertification;
    private bool isSavingPlant;
    private string? loadError;
    private string? saveMessage;
    private string saveMessageClass = "alert-success";
    private string? certificationMessage;
    private string certificationMessageClass = "alert-success";
    private string? plantMessage;
    private string plantMessageClass = "alert-success";
    private CustomerTab activeTab = CustomerTab.Plants;
    private long selectedPlantId;
    private bool showNewPlantEditor;

    private PlantEditModel? SelectedPlant => plants.SingleOrDefault(x => x.Id == selectedPlantId);

    private string CertificationFilenamePreview
    {
        get
        {
            if (certificationDelivery is null)
            {
                return string.Empty;
            }

            try
            {
                return FilenameFormatter.Format(
                    certificationDelivery.FilenameTemplate,
                    new CertificationPackageFilenameValues(
                        customer?.Name ?? "Example Customer",
                        "ABC123",
                        "856342",
                        "PO-1001",
                        new DateOnly(2026, 8, 28),
                        new DateOnly(2026, 9, 1),
                        SelectedPlant?.Name ?? "Example Plant",
                        SelectedPlant?.PlantCode ?? "EX"));
            }
            catch (CertificationFilenameTemplateException exception)
            {
                return exception.Message;
            }
        }
    }

    private string SinglePartMultiLotCertificationFilenamePreview
    {
        get
        {
            if (certificationDelivery is null)
            {
                return string.Empty;
            }

            try
            {
                return FilenameFormatter.FormatSinglePartMultiLot(
                    certificationDelivery.SinglePartMultiLotFilenameTemplate,
                    new CertificationSinglePartMultiLotPackageFilenameValues(
                        customer?.Name ?? "Example Customer",
                        "ABC123",
                        new DateOnly(2026, 9, 1),
                        SelectedPlant?.Name ?? "Example Plant",
                        SelectedPlant?.PlantCode ?? "EX"));
            }
            catch (CertificationFilenameTemplateException exception)
            {
                return exception.Message;
            }
        }
    }

    private string MultiPartCertificationFilenamePreview
    {
        get
        {
            if (certificationDelivery is null)
            {
                return string.Empty;
            }

            try
            {
                return FilenameFormatter.FormatMultiPart(
                    certificationDelivery.MultiPartFilenameTemplate,
                    new CertificationMultiPartPackageFilenameValues(
                        customer?.Name ?? "Example Customer",
                        new DateOnly(2026, 9, 1),
                        SelectedPlant?.Name ?? "Example Plant",
                        SelectedPlant?.PlantCode ?? "EX"));
            }
            catch (CertificationFilenameTemplateException exception)
            {
                return exception.Message;
            }
        }
    }

    protected override Task OnParametersSetAsync() => LoadCustomerAsync();

    private async Task LoadCustomerAsync()
    {
        isLoading = true;
        loadError = null;
        saveMessage = null;

        try
        {
            var customerTask = CustomerService.GetCustomerAsync(Id);
            var partsTask = PartService.GetPartsForCustomerAsync(Id);
            var plantsTask = CustomerService.GetPlantsAsync(Id);

            await Task.WhenAll(customerTask, partsTask, plantsTask);
            customer = await customerTask;
            parts = await partsTask;
            plants = (await plantsTask).ToList();
            newPlant = new PlantEditModel { CustomerId = Id };
            selectedPlantId = plants.FirstOrDefault()?.Id ?? 0;
            await LoadPlantCertificationAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load customer {CustomerId}", Id);
            loadError = "The customer could not be loaded. Check that the database is running and configured.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SavePlantAsync(PlantEditModel plant)
    {
        isSavingPlant = true; plantMessage = null;
        try
        {
            var isNew = plant.Id == 0;
            var result = await CustomerService.SavePlantAsync(plant);
            if (result.Status == PlantOperationStatus.Succeeded)
            {
                plant.Id = result.Id!.Value; plant.Version = result.Version!.Value;
                if (isNew)
                {
                    plants.Add(plant);
                    newPlant = new PlantEditModel { CustomerId = Id };
                    selectedPlantId = plant.Id;
                    showNewPlantEditor = false;
                    await LoadPlantCertificationAsync();
                }
                SortPlants();
                plantMessage = isNew ? "Plant added." : "Plant saved."; plantMessageClass = "alert-success";
            }
            else { plantMessage = result.Message ?? (result.Status == PlantOperationStatus.DuplicateName ? "Plant names must be unique for this customer." : "The plant could not be saved."); plantMessageClass = "alert-error"; }
        }
        catch (Exception exception) { Logger.LogError(exception, "Failed to save plant for customer {CustomerId}", Id); plantMessage = "The plant could not be saved."; plantMessageClass = "alert-error"; }
        finally { isSavingPlant = false; }
    }

    private async Task DeletePlantAsync(PlantEditModel plant)
    {
        isSavingPlant = true; plantMessage = null;
        try
        {
            var result = await CustomerService.DeletePlantAsync(Id, plant.Id, plant.Version);
            if (result.Status == PlantOperationStatus.Succeeded)
            {
                plants.Remove(plant);
                selectedPlantId = plants.FirstOrDefault()?.Id ?? 0;
                await LoadPlantCertificationAsync();
                plantMessage = "Plant removed.";
                plantMessageClass = "alert-success";
            }
            else { plantMessage = result.Message ?? "The plant could not be removed."; plantMessageClass = "alert-error"; }
        }
        catch (Exception exception) { Logger.LogError(exception, "Failed to remove plant {PlantId}", plant.Id); plantMessage = "The plant could not be removed."; plantMessageClass = "alert-error"; }
        finally { isSavingPlant = false; }
    }

    private async Task SaveAsync()
    {
        if (customer is null)
        {
            return;
        }

        isSaving = true;
        saveMessage = null;

        try
        {
            var result = await CustomerService.SaveCustomerAsync(customer);

            switch (result.Status)
            {
                case SaveCustomerStatus.Saved:
                    customer.Version = result.Version!.Value;
                    saveMessage = "Changes saved.";
                    saveMessageClass = "alert-success";
                    break;
                case SaveCustomerStatus.NotFound:
                    saveMessage = "This customer no longer exists.";
                    saveMessageClass = "alert-error";
                    break;
                case SaveCustomerStatus.Conflict:
                    saveMessage = "Someone else changed this customer. Reload the page before trying again.";
                    saveMessageClass = "alert-warning";
                    break;
                default:
                    throw new InvalidOperationException($"Unexpected save status: {result.Status}");
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save customer {CustomerId}", customer.Id);
            saveMessage = "The changes could not be saved. Please try again.";
            saveMessageClass = "alert-error";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveRecipientAsync(PlantCertificationRecipientEditModel recipient)
    {
        isSavingCertification = true;
        certificationMessage = null;

        try
        {
            var result = await CustomerService.SavePlantCertificationRecipientAsync(recipient);
            var isNew = recipient.Id == 0;
            if (HandleCertificationResult(
                    result,
                    isNew ? "Recipient added." : "Recipient saved."))
            {
                recipient.Id = result.RecipientId!.Value;
                recipient.Version = result.Version!.Value;
                if (isNew)
                {
                    certificationDelivery!.Recipients.Add(recipient);
                    newRecipient = new PlantCertificationRecipientEditModel { PlantId = selectedPlantId };
                }
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save certification recipient for customer {CustomerId}", Id);
            SetCertificationError("The recipient could not be saved. Please try again.");
        }
        finally
        {
            isSavingCertification = false;
        }
    }

    private async Task DeleteRecipientAsync(PlantCertificationRecipientEditModel recipient)
    {
        isSavingCertification = true;
        certificationMessage = null;

        try
        {
            var result = await CustomerService.DeletePlantCertificationRecipientAsync(
                selectedPlantId,
                recipient.Id,
                recipient.Version);
            if (HandleCertificationResult(result, "Recipient removed."))
            {
                certificationDelivery!.Recipients.Remove(recipient);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to remove certification recipient {RecipientId}", recipient.Id);
            SetCertificationError("The recipient could not be removed. Please try again.");
        }
        finally
        {
            isSavingCertification = false;
        }
    }

    private async Task SaveCertificationConfigurationAsync()
    {
        if (certificationDelivery is null)
        {
            return;
        }

        isSavingCertification = true;
        certificationMessage = null;

        try
        {
            var result = await CustomerService.SavePlantCertificationConfigurationAsync(
                certificationDelivery,
                FilenameFormatter);
            if (HandleCertificationResult(result, "Certification settings saved."))
            {
                certificationDelivery.SettingsVersion = result.Version;
                certificationDelivery.OriginalRequiredCertificationTypeIds = certificationDelivery
                    .CertificationTypes
                    .Where(x => x.IsRequired)
                    .Select(x => x.Id)
                    .ToHashSet();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save certification settings for customer {CustomerId}", Id);
            SetCertificationError("The certification settings could not be saved. Please try again.");
        }
        finally
        {
            isSavingCertification = false;
        }
    }

    private bool HandleCertificationResult(
        PlantCertificationOperationResult result,
        string successMessage)
    {
        switch (result.Status)
        {
            case PlantCertificationOperationStatus.Succeeded:
                certificationMessage = successMessage;
                certificationMessageClass = "alert-success";
                return true;
            case PlantCertificationOperationStatus.NotFound:
                SetCertificationError("The plant or recipient no longer exists.");
                return false;
            case PlantCertificationOperationStatus.Conflict:
                SetCertificationError("Someone else changed these settings. Reload the page before trying again.");
                return false;
            case PlantCertificationOperationStatus.ValidationFailed:
                SetCertificationError(result.Message ?? "The certification settings are invalid.");
                return false;
            default:
                throw new InvalidOperationException($"Unexpected certification save status: {result.Status}");
        }
    }

    private void InsertFilenameToken(string token)
    {
        if (certificationDelivery is null)
        {
            return;
        }

        certificationDelivery.FilenameTemplate = $"{certificationDelivery.FilenameTemplate}{token}";
    }

    private void InsertSinglePartMultiLotFilenameToken(string token)
    {
        if (certificationDelivery is null)
        {
            return;
        }

        certificationDelivery.SinglePartMultiLotFilenameTemplate =
            $"{certificationDelivery.SinglePartMultiLotFilenameTemplate}{token}";
    }

    private void InsertMultiPartFilenameToken(string token)
    {
        if (certificationDelivery is null)
        {
            return;
        }

        certificationDelivery.MultiPartFilenameTemplate =
            $"{certificationDelivery.MultiPartFilenameTemplate}{token}";
    }

    private void SetCertificationError(string message)
    {
        certificationMessage = message;
        certificationMessageClass = "alert-error";
    }

    private async Task LoadPlantCertificationAsync()
    {
        certificationDelivery = selectedPlantId == 0
            ? null
            : await CustomerService.GetPlantCertificationDeliveryAsync(selectedPlantId);
        newRecipient = new PlantCertificationRecipientEditModel { PlantId = selectedPlantId };
    }

    private async Task SelectPlantAsync(long plantId)
    {
        selectedPlantId = plantId;
        showNewPlantEditor = false;
        certificationMessage = null;
        await LoadPlantCertificationAsync();
    }

    private void ShowNewPlantEditor()
    {
        showNewPlantEditor = true;
        plantMessage = null;
        certificationMessage = null;
    }

    private void SortPlants() =>
        plants.Sort((left, right) => StringComparer.OrdinalIgnoreCase.Compare(left.Name, right.Name));

    private enum CustomerTab
    {
        Plants,
        Parts,
    }
