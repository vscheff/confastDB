@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Permission:Users.Read")]
@inherits Confast.Web.Components.PermissionComponentBase
@inject UserAdministrationService UserService
@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

<div class="page-heading">
    <div>
        <h1>Users</h1>
        <p>Create accounts, assign roles, disable access, or permanently delete an account.</p>
    </div>
</div>

@if (errors.Count > 0)
{
    <div class="alert alert-error">@foreach (var error in errors) { <div>@error</div> }</div>
}
@if (users is null)
{
    <p>Loading users…</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(resetLink))
    {
        <div class="status-message password-reset-link">
            <strong>Password Reset Link</strong>
            <p>Give this link to the user through a trusted channel. It becomes invalid after the password is reset.</p>
            <input type="text" readonly value="@resetLink" aria-label="Password Reset Link" />
        </div>
    }

    <section class="user-admin-grid">
        <div class="table-shell">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td data-label="User">
                                <strong>@user.DisplayName</strong><br />
                                @if (!string.IsNullOrWhiteSpace(user.JobTitle))
                                {
                                    <span>@user.JobTitle</span><br />
                                }
                                <span class="muted">@user.Username · @user.Email</span>
                            </td>
                            <td data-label="Roles">@if (user.IsProtected) { <strong>Protected Root · </strong> }@(user.Roles.Count == 0 ? "None" : string.Join(", ", user.Roles))</td>
                            <td data-label="Status">
                                <span class="status-pill @(user.IsActive ? "status-active" : "status-inactive")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="table-action">
                                <button class="button button-secondary button-compact" type="button" @onclick="() => SelectUserAsync(user.Id)">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="user-editor">
            @if (editModel is null)
            {
                <h2>Create User</h2>
                <EditForm Model="createModel" OnValidSubmit="CreateUserAsync" class="record-form user-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="form-field">
                        <label for="create-username">Username</label>
                        <InputText id="create-username" autocomplete="username" @bind-Value="createModel.Username" />
                    </div>
                    <div class="form-field">
                        <label for="create-display-name">Display Name</label>
                        <InputText id="create-display-name" @bind-Value="createModel.DisplayName" />
                    </div>
                    <div class="form-field">
                        <label for="create-job-title">Job Title</label>
                        <InputText id="create-job-title" @bind-Value="createModel.JobTitle" />
                    </div>
                    <div class="form-field">
                        <label for="create-caliper">Caliper ID</label>
                        <InputSelect id="create-caliper" @bind-Value="createModel.CaliperId">
                            <option value="">Select a digital caliper</option>
                            @foreach (var caliper in digitalCalipers)
                            {
                                <option value="@caliper.Id">@caliper.GageNumber</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label for="create-email">Email</label>
                        <InputText id="create-email" type="email" @bind-Value="createModel.Email" />
                    </div>
                    <RoleCheckboxes SelectedRoles="createModel.Roles" Choices="@(administrationState?.RoleChoices ?? [])" Disabled="@(!Has(Permissions.Users.Create))" />
                    <div class="form-actions form-field-wide">
                        <button class="button button-primary" type="submit" disabled="@(saving || !Has(Permissions.Users.Create))">Create User</button>
                    </div>
                </EditForm>
                <p class="field-help">New accounts start with ReadOnly selected. Authorized role choices can replace it. Password setup requires a separately authorized reset link.</p>
            }
            else
            {
                <div class="section-heading">
                    <h2>Edit User</h2>
                    <button class="button button-secondary button-compact" type="button" @onclick="CancelEdit">New User</button>
                </div>
                @if (confirmingDelete)
                {
                    <div class="confirmation-card user-delete-confirmation">
                        <h3>Delete @editModel.Username?</h3>
                        <p>This permanently removes the account and its Identity role, claim, login, and token records. This cannot be undone.</p>
                        <div class="form-actions">
                            <button class="button button-danger" type="button" disabled="@saving" @onclick="ConfirmDeleteUserAsync">Delete Permanently</button>
                            <button class="button button-secondary" type="button" disabled="@saving" @onclick="CancelDelete">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    @if (editModel.IsProtected) { <p class="status-message">Protected Root account. Ordinary administrative changes are unavailable.</p> }
                    <EditForm Model="editModel" OnValidSubmit="UpdateUserAsync" class="record-form user-form">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="form-field">
                            <label for="edit-username">Username</label>
                            <InputText id="edit-username" disabled="@(!CanUpdateAccount)" autocomplete="username" @bind-Value="editModel.Username" />
                        </div>
                        <div class="form-field">
                            <label for="edit-display-name">Display Name</label>
                            <InputText id="edit-display-name" disabled="@(!CanUpdateAccount)" @bind-Value="editModel.DisplayName" />
                        </div>
                        <div class="form-field">
                            <label for="edit-job-title">Job Title</label>
                            <InputText id="edit-job-title" disabled="@(!CanUpdateAccount)" @bind-Value="editModel.JobTitle" />
                        </div>
                        <div class="form-field">
                            <label for="edit-caliper">Caliper ID</label>
                            <InputSelect id="edit-caliper" disabled="@(!CanUpdateAccount)" @bind-Value="editModel.CaliperId">
                                <option value="">Select a digital caliper</option>
                                @foreach (var caliper in digitalCalipers)
                                {
                                    <option value="@caliper.Id">@caliper.GageNumber@(!caliper.IsActive ? " (inactive)" : null)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-field">
                            <label for="edit-email">Email</label>
                            <InputText id="edit-email" disabled="@(!CanUpdateAccount)" type="email" @bind-Value="editModel.Email" />
                        </div>
                        <label class="checkbox-field form-field-wide">
                            <InputCheckbox disabled="@(!CanUpdateAccount)" @bind-Value="editModel.IsActive" />
                            Active
                        </label>
                        <RoleCheckboxes SelectedRoles="editModel.Roles" Choices="editModel.RoleChoices" Disabled="@(!Has(Permissions.Users.ManageRoles))" />
                        <div class="form-actions form-field-wide">
                            <button class="button button-primary" type="submit" disabled="@(saving || editModel.IsProtected || (!CanUpdateAccount && !Has(Permissions.Users.ManageRoles)))">Save Changes</button>
                            <button class="button button-secondary" type="button" disabled="@(saving || !editModel.CanManageAccount || !Has(Permissions.Users.ResetPasswords))" @onclick="GenerateResetLinkAsync">Generate Password Reset Link</button>
                            <button class="button button-danger-outline"
                                    type="button"
                                    disabled="@(saving || !editModel.CanManageAccount || !Has(Permissions.Users.Delete))"
                                    title="@(!editModel.CanManageAccount ? "Outside account management authority." : null)"
                                    @onclick="BeginDelete">Delete User</button>
                        </div>
                    </EditForm>
                    <div class="form-actions"><button class="button button-secondary" type="button" disabled="@saving" @onclick="ReloadAndReapplyAsync">Reload And Reapply</button><button class="button button-secondary" type="button" disabled="@saving" @onclick="DiscardUserChangesAsync">Discard Changes</button></div>
                    @if (Has(Permissions.Users.Read)) { <UserEffectiveAccess User="editModel" CanPreview="Has(Permissions.Users.ManageRoles)" Revision="AuthorizationRevision" /> }
                }
            }
        </div>
    </section>
}

@code {
    private IReadOnlyList<UserListItem>? users;
    private IReadOnlyList<DigitalCaliperChoice> digitalCalipers = [];
    private CreateUserInput createModel = new();
    private EditUserInput? editModel, originalEdit;
    private long observedRevision = -1;
    private readonly List<string> errors = [];
    private string? resetLink;
    private UserAdministrationState? administrationState;
    private bool Has(string key) => Can(key);
    private bool CanUpdateAccount => editModel?.CanManageAccount == true && Has(Permissions.Users.Update);
    private bool saving;
    private bool confirmingDelete;

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () => { digitalCalipers = await UserService.GetDigitalCaliperChoicesAsync(); await ReloadUsersAsync(); });
    }

    protected override Task OnPermissionsChangedAsync() => OnParametersSetAsync();
    protected override async Task OnParametersSetAsync()
    {
        if (administrationState is null || observedRevision == AuthorizationRevision) return;
        observedRevision = AuthorizationRevision;
        await RunAsync(async () =>
        {
            if (!Has(Permissions.Users.Read)) { users = null; administrationState = null; return; }
            administrationState = await UserService.GetAdministrationStateAsync();
            if (editModel is not null && await UserService.GetUserForEditAsync(editModel.Id) is { } latest)
            {
                editModel.CanManageAccount = latest.CanManageAccount;
                editModel.RoleChoices = latest.RoleChoices;
            }
        });
    }
    private Task DiscardUserChangesAsync() => editModel is null ? Task.CompletedTask : SelectUserAsync(editModel.Id);
    private Task ReloadAndReapplyAsync() => RunAsync(async () =>
    {
        if (editModel is null || originalEdit is null) return;
        var latest = await UserService.GetUserForEditAsync(editModel.Id)
            ?? throw new InvalidOperationException("The account no longer exists. Your draft has been retained.");
        editModel = UserEditRecovery.Reapply(originalEdit, editModel, latest);
        originalEdit = UserEditRecovery.Copy(latest);
        await ReloadUsersAsync();
    });

    private Task SelectUserAsync(string userId) => RunAsync(async () =>
    {
        ClearMessages();
        confirmingDelete = false;
        editModel = await UserService.GetUserForEditAsync(userId);
        originalEdit = editModel is null ? null : UserEditRecovery.Copy(editModel);
        if (editModel is not null)
        {
            digitalCalipers = await UserService.GetDigitalCaliperChoicesAsync(editModel.CaliperId);
        }
        if (editModel is null)
        {
            errors.Add("The user no longer exists.");
            await ReloadUsersAsync();
        }
    });

    private async Task CreateUserAsync()
    {
        saving = true;
        ClearMessages();
        try
        {
            var result = await UserService.CreateUserAsync(createModel);
            if (!result.Succeeded)
            {
                errors.AddRange(result.Errors);
                return;
            }

            createModel = new CreateUserInput();
            await ReloadUsersAsync();
            if (Has(Permissions.Users.ResetPasswords)) await GenerateResetLinkAsync(result.UserId!);
        }
        catch (AuthorizationDeniedException ex) { errors.Add(ex.Message); }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException ex) { errors.Add(ex.Message); }
        catch (ArgumentException ex) { errors.Add(ex.Message); }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateUserAsync()
    {
        saving = true;
        ClearMessages();
        try
        {
            var result = await UserService.UpdateUserAsync(editModel!);
            if (!result.Succeeded)
            {
                errors.AddRange(result.Errors);
                return;
            }

            await ReloadUsersAsync();
            editModel = await UserService.GetUserForEditAsync(editModel!.Id);
            originalEdit = editModel is null ? null : UserEditRecovery.Copy(editModel);
        }
        catch (AuthorizationDeniedException ex) { errors.Add(ex.Message); }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException ex) { errors.Add(ex.Message); }
        catch (ArgumentException ex) { errors.Add(ex.Message); }
        finally
        {
            saving = false;
        }
    }

    private Task GenerateResetLinkAsync() => RunAsync(() => GenerateResetLinkAsync(editModel!.Id));

    private void BeginDelete()
    {
        ClearMessages();
        confirmingDelete = true;
    }

    private void CancelDelete() => confirmingDelete = false;

    private async Task ConfirmDeleteUserAsync()
    {
        saving = true;
        ClearMessages();
        try
        {
            var result = await UserService.DeleteUserAsync(
                editModel!.Id, editModel.Version, editModel.ConcurrencyStamp);
            if (!result.Succeeded)
            {
                errors.AddRange(result.Errors);
                confirmingDelete = false;
                return;
            }

            editModel = null;
            confirmingDelete = false;
            await ReloadUsersAsync();
        }
        catch (AuthorizationDeniedException ex) { errors.Add(ex.Message); }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException ex) { errors.Add(ex.Message); }
        catch (ArgumentException ex) { errors.Add(ex.Message); }
        finally
        {
            saving = false;
        }
    }

    private async Task GenerateResetLinkAsync(string userId)
    {
        ClearMessages();
        var target = await UserService.GetUserForEditAsync(userId);
        if (target is null) { errors.Add("The user no longer exists."); return; }
        var result = await UserService.GeneratePasswordResetTokenAsync(userId, target.Version, target.ConcurrencyStamp);
        if (result.Token is null)
        {
            errors.AddRange(result.Errors);
            return;
        }

        var relativeUrl = $"reset-password?userId={Uri.EscapeDataString(userId)}&token={Uri.EscapeDataString(result.Token)}";
        resetLink = new Uri(new Uri(Navigation.BaseUri), relativeUrl).AbsoluteUri;
        await ReloadUsersAsync();
        if (editModel?.Id == userId) editModel = await UserService.GetUserForEditAsync(userId);
    }

    private async Task ReloadUsersAsync()
    {
        users = await UserService.GetUsersAsync();
        administrationState = await UserService.GetAdministrationStateAsync();
        createModel.Version = administrationState.Version;

    }

    private async Task RunAsync(Func<Task> work)
    {
        try { await work(); }
        catch (AuthorizationDeniedException ex) { errors.Add(ex.Message); }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException ex) { errors.Add(ex.Message); }
        catch (ArgumentException ex) { errors.Add(ex.Message); }
        catch (InvalidOperationException ex) { errors.Add(ex.Message); }
    }

    private void CancelEdit()
    {
        ClearMessages();
        confirmingDelete = false;
        editModel = null;
    }

    private void ClearMessages()
    {
        errors.Clear();
        resetLink = null;
    }
}
