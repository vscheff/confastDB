@page "/admin/roles"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Permission:Roles.Read")]
@inherits Confast.Web.Components.PermissionComponentBase
@inject RoleAdministrationService RoleService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Roles</PageTitle>
<div class="page-heading"></div>
@if (error is not null) { <div class="alert alert-error" role="alert">@error</div> }
@if (success is not null) { <p class="status-message" role="status">@success</p> }
@if (view is not null && Has(Permissions.Roles.Read))
{
    <section class="roles-workspace">
        <aside class="role-list">
            <label for="role-search">Search Roles</label><input id="role-search" type="search" @bind="search" @bind:event="oninput" />
            <label for="role-status">Role Status</label><select id="role-status" @bind="status"><option value="all">All Roles</option><option value="enabled">Enabled</option><option value="disabled">Disabled</option><option value="protected">Protected</option></select>
            <button class="button button-secondary" disabled="@(busy || !Has(Permissions.Roles.Create))" @onclick="RequestNew">New Role</button>
            @foreach (var role in FilteredRoles)
            {
                <button class="role-card @(selected?.Id == role.Id ? "selected" : "")" disabled="@busy" @onclick="() => RequestSelectAsync(role.Id)">
                    <strong>@role.Name</strong><span>@(role.Kind != SystemRoleKind.Ordinary ? "Protected System Role" : role.IsEnabled ? "Enabled" : "Disabled")</span>
                    <span>@role.Description</span><small>@role.Grants.Count Direct · @role.EffectiveCount Effective · @role.AssignedCount Assigned</small>
                    <small>Parents: @(role.Parents.Count == 0 ? "None" : string.Join(", ", role.Parents.Select(RoleName)))</small>
                </button>
            }
        </aside>
        <div class="role-editor">
            @if (selected is null)
            {
                <h2>Create Role</h2>
                <div class="form-field"><label for="new-role-name">Name</label><InputText id="new-role-name" @bind-Value="newName" /></div>
                <div class="form-field"><label for="new-role-description">Description</label><InputTextArea id="new-role-description" @bind-Value="newDescription" /></div>
                <div class="form-field"><label for="role-anchor">Administrative Anchor</label><InputSelect id="role-anchor" @bind-Value="anchor">
                    <option value="">@(Has(Permissions.Authorization.ManageSecurity) ? "Independent Role" : "Select A Direct Anchor")</option>
                    @foreach (var role in view.Roles.Where(x => x.CanAnchor)) { <option value="@role.Id">@role.Name</option> }
                </InputSelect></div>
                <p class="field-help">Creates an empty subordinate beneath the selected anchor. Root may create an independent role. No account is assigned automatically.</p>
                <button class="button button-primary" disabled="@(busy || !Has(Permissions.Roles.Create))" @onclick="CreateAsync">Create Role</button>
            }
            else if (draft is not null && editor is not null)
            {
                <h2>@selected.Name</h2>
                @if (selected.Kind == SystemRoleKind.Root)
                { <p class="status-message">Protected Root System Role. All recognized permissions derive from the protected account designation. Its direct grants and inheritance cannot be edited here. Private-chat membership and business restrictions still apply.</p> }
                else if (selected.Kind == SystemRoleKind.Baseline)
                { <p class="status-message">Protected ReadOnly Definition. Membership Is Optional; It Is Never Automatically Restored.</p> }
                else if (!selected.CanEdit)
                { <p class="status-message">Role Editing Is Unavailable: This Role Is Directly Held, Higher, A Peer, Or Outside Your Strictly Lower Management Scope.</p> }
                <div class="role-metadata">
                    <div class="form-field"><label for="role-name">Name</label><InputText id="role-name" disabled="@(!CanEdit(Permissions.Roles.Update))" @bind-Value="draft.Name" @bind-Value:after="Changed" /></div>
                    <div class="form-field"><label for="role-description">Description</label><InputTextArea id="role-description" disabled="@(!CanEdit(Permissions.Roles.Update))" @bind-Value="draft.Description" @bind-Value:after="Changed" /></div>
                    <label class="checkbox-field"><InputCheckbox disabled="@(!CanEdit(Permissions.Roles.Update) || !Has(Permissions.Roles.ManagePermissions))" @bind-Value="draft.IsEnabled" @bind-Value:after="Changed" />Enabled</label>
                </div>
                <p class="field-help">@editor.AssignedCount Direct Assignments · @(draft.IsDirty ? "Unsaved Changes" : "No Unsaved Changes")</p>
                <div class="form-actions role-save-actions">
                    <button class="button button-secondary" disabled="@(busy || !selected.CanEdit)" @onclick="PreviewAsync">Preview Changes</button>
                    <button class="button button-primary" disabled="@(busy || !selected.CanEdit || !draft.IsDirty || confirmingDelete)" @onclick="SaveAsync">Save Changes</button>
                    <button class="button button-secondary" disabled="@busy" @onclick="DiscardAsync">Discard Changes</button>
                    <button class="button button-secondary" disabled="@busy" @onclick="ReapplyAsync">Reload And Reapply</button>
                    <button class="button button-danger-outline" disabled="@(!CanEdit(Permissions.Roles.Delete))" @onclick="BeginDeleteAsync">Delete Role</button>
                </div>
                @if (previewStale && draft.IsDirty) { <p role="status">Inherited, Effective, And Usable Columns Show The Last Server Projection. Use The Optional Preview To Evaluate Proposed Changes.</p> }
                @if (preview is not null)
                {
                    <section class="confirmation-card" aria-label="Change Impact Preview">
                        <h3>@(confirmingDelete ? "Deletion Impact Preview" : "Change Impact Preview")</h3>
                        <p>Epoch @preview.Version.Epoch · Generation @preview.Version.Generation · Role Version @preview.ConcurrencyStamp</p>
                        <p>@(preview.Permitted ? "Currently Permitted; Save Independently Rechecks Authority And Concurrency." : preview.Rejection)</p>
                        <PermissionImpactSummary Impact="preview.SelectedRole" />
                        <p>@preview.ChangedUsers Assigned Users Would Change Effective Permissions. Account Identities Are Withheld.</p>
                        <details><summary>Affected Descendants (@preview.Descendants.Count)</summary>
                            @foreach (var item in preview.Descendants) { <h4>@item.Name @(!item.IsEnabled ? "(Disabled)" : "")</h4><PermissionImpactSummary Impact="item.Permissions" /> }
                        </details>
                        <details><summary>Your Effective Access And Management Reach</summary><PermissionImpactSummary Impact="preview.Actor" />
                            <p>Reach Added: @(preview.ReachAdded.Count == 0 ? "None" : string.Join(", ", preview.ReachAdded))</p>
                            <p>Reach Removed: @(preview.ReachRemoved.Count == 0 ? "None" : string.Join(", ", preview.ReachRemoved))</p>
                            <p>Server validation checks every direct anchor independently, including disabled anchors.</p>
                        </details>
                        @if (confirmingDelete)
                        {
                            <p>@editor.AssignedCount Direct Assignments · @preview.IncidentRelationships Incident Relationships. Assigned roles cannot be deleted. Descendants will not be reparented.</p>
                            <button class="button button-danger" disabled="@(busy || !preview.Permitted || previewStale)" @onclick="DeleteAsync">Confirm Deletion</button>
                            <button class="button button-secondary" @onclick="Changed">Cancel Deletion</button>
                        }
                    </section>
                }
                <details class="inheritance-editor" open>
                    <summary>Role Inheritance</summary>
                    <h3>Direct Parents</h3>
                    @foreach (var parent in editor.Parents.Where(x => x.Id != selected.Id && (x.Direct || x.CanAdd || draft.Parents.Contains(x.Id))))
                    {
                        <label class="checkbox-field"><input type="checkbox" checked="@draft.Parents.Contains(parent.Id)"
                            disabled="@(busy || !CanEdit(Permissions.Roles.ManageInheritance) || (!parent.CanAdd && !parent.Direct))"
                            @onchange="e => SetParent(parent.Id, e.Value is true)" />@parent.Name @(!parent.Enabled ? "(Disabled)" : "")
                            <small class="muted">@parent.Reason</small></label>
                    }
                    <details><summary>Unavailable Parent Choices</summary>
                        @foreach (var parent in editor.Parents.Where(x => x.Id != selected.Id && !x.Direct && !x.CanAdd)) { <p><b>@parent.Name</b> · @parent.Reason</p> }
                    </details>
                    <h3>Transitive Inherited Roles (Committed State)</h3><p>@string.Join(", ", TransitiveParents)</p>
                    <h3>Roles Inheriting From This Role</h3>
                    @if (editor.Descendants.Count == 0) { <p>None</p> }
                    @foreach (var child in editor.Descendants) { <p>@child.Name · @(child.Direct ? "Direct Child" : "Transitive Descendant") @(!child.Enabled ? "· Disabled" : "")</p> }
                </details>
                <h3>Permission Matrix</h3>
                <PermissionMatrix Rows="@(preview is not null && !previewStale && !confirmingDelete ? preview.Matrix : editor.Matrix)"
                    RoleNames="RoleNames" IsRoot="@(selected.Kind == SystemRoleKind.Root)" SelectedGrants="draft.Grants"
                    Disabled="@(busy || !CanEdit(Permissions.Roles.ManagePermissions))" Changed="Changed" />
            }
        </div>
    </section>
}
else { <p>Role Administration Is Unavailable.</p> }

@if (pendingSelection is not null)
{
    <dialog @ref="selectionDialog" class="modal role-selection-dialog" aria-labelledby="role-selection-title"
            aria-describedby="role-selection-description" @oncancel="KeepEditingAsync" @oncancel:preventDefault>
        <h2 id="role-selection-title">Unsaved Changes</h2>
        <p id="role-selection-description">You have unsaved changes to @selected?.Name. Switching @(pendingSelection == "" ? "to a new role" : $"to {RoleName(pendingSelection)}") will discard them. Keep editing to save your changes, or discard them and continue.</p>
        <div class="role-save-actions">
            <button type="button" class="button button-secondary" autofocus @onclick="KeepEditingAsync">Keep Editing</button>
            <button type="button" class="button button-danger-outline" @onclick="AcceptSelectionAsync">Discard And Continue</button>
        </div>
    </dialog>
}

@code {
    private ElementReference selectionDialog;
    private IJSObjectReference? dialogModule;
    private RoleAdministrationView? view;
    private RoleAdministrationItem? selected;
    private RoleEditorView? editor;
    private RoleEditDraft? draft;
    private RoleChangePreview? preview;
    private string search = "", status = "all", newName = "";
    private string? newDescription, anchor, error, success, pendingSelection;
    private bool busy, previewStale = true, confirmingDelete;
    private long observedRevision = -1;
    private bool Has(string key) => Can(key);
    private bool CanEdit(string key) => !busy && selected?.CanEdit == true && Has(key);
    private IReadOnlyDictionary<string, string> RoleNames => view?.Roles.ToDictionary(x => x.Id, x => x.Name) ?? new();
    private string RoleName(string id) => RoleNames.GetValueOrDefault(id, id);
    private IEnumerable<string> TransitiveParents => editor?.Parents.Where(x => x.Inherited && !x.Direct)
        .Select(x => x.Name + (!x.Enabled ? " (Disabled)" : "")) ?? [];
    private IEnumerable<RoleAdministrationItem> FilteredRoles => view!.Roles.Where(x =>
        (x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) == true)
        && (status switch { "enabled" => x.IsEnabled, "disabled" => !x.IsEnabled, "protected" => x.Kind != SystemRoleKind.Ordinary, _ => true }));
    protected override Task OnInitializedAsync() => RunAsync(async () => { view = await RoleService.GetRolesAsync(); });
    protected override Task OnPermissionsChangedAsync() => OnParametersSetAsync();
    protected override async Task OnParametersSetAsync()
    {
        if (view is null || observedRevision == AuthorizationRevision) return;
        observedRevision = AuthorizationRevision;
        await RunAsync(async () =>
        {
            await RefreshPermissionsAsync();
            if (!Has(Permissions.Roles.Read)) { view = null; preview = null; return; }
            view = await RoleService.GetRolesAsync();
            if (selected is not null)
            {
                selected = view.Roles.FirstOrDefault(x => x.Id == selected.Id);
                if (selected is not null) editor = await RoleService.GetEditorAsync(selected.Id);
            }
            previewStale = true;
        });
    }
    private void Changed() { previewStale = true; preview = null; confirmingDelete = false; success = null; }
    private void SetParent(string id, bool add) { if (add) draft!.Parents.Add(id); else draft!.Parents.Remove(id); Changed(); }
    private Task RequestSelectAsync(string id)
    {
        if (draft?.IsDirty == true) { pendingSelection = id; return Task.CompletedTask; }
        return RunAsync(() => SelectAsync(id));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingSelection is null) return;
        dialogModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Users/Roles.razor.js");
        await dialogModule.InvokeVoidAsync("show", selectionDialog);
    }
    private async Task KeepEditingAsync()
    {
        if (dialogModule is not null) await dialogModule.InvokeVoidAsync("close", selectionDialog);
        pendingSelection = null;
    }
    private void RequestNew()
    {
        if (draft?.IsDirty == true) pendingSelection = "";
        else NewRole();
    }
    private async Task AcceptSelectionAsync()
    {
        var id = pendingSelection;
        await KeepEditingAsync();
        if (id == "") NewRole(); else if (id is not null) await RunAsync(() => SelectAsync(id));
    }
    private void NewRole() { selected = null; editor = null; draft = null; Changed(); newName = ""; newDescription = null; anchor = null; error = null; }
    private static RoleEditorInput Baseline(RoleAdministrationItem role, RoleEditorView state) => new(role.Id, role.Name,
        role.Description, role.IsEnabled, role.Grants, role.Parents, state.ConcurrencyStamp, state.Version);
    private async Task SelectAsync(string id)
    {
        var state = await RoleService.GetEditorAsync(id);
        selected = state.Role; editor = state;
        draft = new(Baseline(selected, state)); Changed(); error = null;
    }
    private Task DiscardAsync() => RunAsync(async () => { view = await RoleService.GetRolesAsync(); await SelectAsync(draft!.Baseline.Id); });
    private Task ReapplyAsync() => RunAsync(async () =>
    {
        var intended = draft!;
        view = await RoleService.GetRolesAsync();
        var role = view.Roles.SingleOrDefault(x => x.Id == intended.Baseline.Id) ?? throw new InvalidOperationException("The role was deleted. Your draft remains available until discarded.");
        var state = await RoleService.GetEditorAsync(role.Id);
        intended.Reapply(Baseline(state.Role, state)); draft = intended; editor = state; selected = state.Role; Changed();
        success = "Intended Changes Reapplied To Current State. Review Before Saving.";
    });
    private Task CreateAsync() => RunAsync(async () =>
    {
        var id = await RoleService.CreateAsync(new(newName, newDescription, string.IsNullOrEmpty(anchor) ? null : anchor, view!.Version));
        view = await RoleService.GetRolesAsync(); await SelectAsync(id); success = "Role Created.";
    });
    private Task PreviewAsync() => RunAsync(async () => { preview = await RoleService.PreviewAsync(draft!.Input()); previewStale = false; confirmingDelete = false; });
    private Task BeginDeleteAsync() => RunAsync(async () => { preview = await RoleService.PreviewAsync(draft!.Input(true)); previewStale = false; confirmingDelete = true; });
    private Task SaveAsync() => CommitAsync(false);
    private Task DeleteAsync() => CommitAsync(true);
    private Task CommitAsync(bool delete) => RunAsync(async () =>
    {
        if (delete && (!confirmingDelete || preview?.Permitted != true || previewStale)) return;
        var id = draft!.Baseline.Id;
        await RoleService.SaveEditorAsync(draft.Input(delete));
        await RefreshPermissionsAsync(); view = await RoleService.GetRolesAsync();
        if (delete) NewRole(); else await SelectAsync(id);
        success = delete ? "Role Deleted." : "Changes Saved. Permissions And Provenance Refreshed.";
    });
    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null;
        try { await action(); }
        catch (Exception ex) when (ex is AuthorizationDeniedException or Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException or ArgumentException or InvalidOperationException)
        { error = ex.Message; previewStale = true; await RefreshPermissionsAsync(); }
        finally { busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        if (dialogModule is null) return;
        try { await dialogModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
