@using Confast.Web.Features.ContainerTracking
@using Confast.Web.Features.Suppliers
@inject ContainerTrackingService Tracking
@inject SupplierService Suppliers
@inject ILogger<BillEditor> Logger

<section class="tracking-bill-editor">
    <h2>@(model.Id == 0 ? "Create B/L" : "Edit shared B/L")</h2>
    <p>Supplier and duty apply to every group using this B/L.</p>
    @if (message is not null)
    {
        <div class="alert alert-error" role="alert">@message
            @if (existingId is long duplicateId) { <button type="button" class="button button-secondary" @onclick="() => Saved.InvokeAsync(duplicateId)">Use existing B/L</button> }
        </div>
    }
    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="bill-of-lading" class="tracking-form">
        <DataAnnotationsValidator /><ValidationSummary />
        <fieldset disabled="@(busy || !loaded)" class="tracking-fields tracking-grid">
            <div class="form-field"><label for="bl-number">B/L number</label><InputText id="bl-number" @bind-Value="model.Number" maxlength="100" /></div>
            <div class="form-field"><label for="bl-supplier">Supplier</label><InputSelect id="bl-supplier" @bind-Value="model.SupplierId">
                <option value="0">Select supplier</option>
                @foreach (var supplier in suppliers.Where(x => x.IsActive || x.Id == model.SupplierId))
                { <option value="@supplier.Id">@supplier.Name@(!supplier.IsActive ? " (inactive)" : "")</option> }
            </InputSelect></div>
            <div class="form-field"><label for="bl-duty">Duty ($)</label><ThousandsSeparatedMoneyInput id="bl-duty" @bind-Value="model.Duty" min="0" step="0.01" /></div>
        </fieldset>
        <div class="form-actions">
            <button class="button button-primary" disabled="@(busy || !loaded)">Save B/L</button>
            <button type="button" class="button button-secondary" @onclick="() => Cancelled.InvokeAsync()" disabled="@busy">Cancel</button>
            <a href="/suppliers" target="_blank" rel="noopener">Manage suppliers</a>
            <button type="button" class="button button-secondary" @onclick="ReloadSuppliersAsync" disabled="@busy">Refresh suppliers</button>
        </div>
    </EditForm>
</section>

@code {
    [Parameter] public long BillId { get; set; }
    [Parameter] public EventCallback<long> Saved { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    private BillOfLadingEditModel model = new();
    private List<SupplierEditModel> suppliers = [];
    private string? message;
    private long? existingId;
    private bool busy, loaded;
    protected override async Task OnInitializedAsync()
    {
        busy = true;
        try
        {
            if (BillId != 0) model = await Tracking.GetBillAsync(BillId) ?? throw new InvalidOperationException("B/L no longer exists.");
            suppliers = await Suppliers.SearchAsync();
            loaded = true;
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load B/L editor"); message = "B/L editor could not be loaded. Close and reopen it."; }
        finally { busy = false; }
    }
    private async Task ReloadSuppliersAsync()
    {
        try { suppliers = await Suppliers.SearchAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to refresh supplier choices"); message = "Suppliers could not be refreshed."; }
    }
    private async Task SaveAsync()
    {
        if (busy || !loaded) return;
        busy = true; existingId = null;
        try
        {
            var result = await Tracking.SaveBillAsync(model);
            message = result.Message; existingId = result.ExistingBillOfLadingId;
            if (result.Succeeded) await Saved.InvokeAsync(result.Id!.Value);
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save B/L"); message = "B/L could not be saved."; }
        finally { busy = false; }
    }
}
