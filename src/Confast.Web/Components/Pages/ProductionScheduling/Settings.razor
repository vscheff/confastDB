@page "/production-scheduling/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = AppRoles.Administrator)]
@using Confast.Web.Features.ProductionScheduling
@inject ProductionService Service
@inject ILogger<Settings> Logger
<PageTitle>Scheduling settings</PageTitle>
<div class="page-heading"><h1>Scheduling settings</h1><a class="button button-secondary" href="/production-scheduling">Back to schedule</a></div>
@if (message != null) { <div class="alert alert-error" role="alert">@message</div> }
@if (data != null)
{
<fieldset disabled="@(!ready || busy)">
<section class="production-panel"><h2>Production efficiency</h2><div class="production-fields"><label>Efficiency % <InputNumber @bind-Value="efficiency" /></label><button class="button button-primary" @onclick="() => Run(() => Service.SaveEfficiencyAsync(data.Settings.Revision, efficiency))">Save efficiency</button></div><p>Effective PPH = target PPH × efficiency ÷ 100. Calendar hours are not reduced again. Original estimates and actual checkpoints remain unchanged.</p></section>
<section class="production-panel"><h2>Machines and working calendars</h2>
<div class="production-fields"><label>Edit machine <select aria-label="Edit machine" @bind="machineId" @bind:after="SelectMachine"><option value="0">New machine</option>@foreach (var m in data.Machines) { <option value="@m.Id">@m.Name</option> }</select></label><label>Name <input @bind="machineName" /></label><label><input type="checkbox" @bind="active" /> Active</label>
@for (var i = 0; i < 7; i++) { var day = i; <label>@((DayOfWeek)day) hours <InputNumber @bind-Value="hours[day]" /></label> }
<button class="button button-primary" @onclick="SaveMachine">Save machine</button></div><p>Use zero for non-working days. Configure manual sorting as its own machine with the operator’s actual weekly hours. A zero-capacity calendar is allowed in settings and flagged as unschedulable.</p></section>
<section class="production-panel"><h2>Eligible parts and rates</h2><div class="production-fields">
<label>Machine <select aria-label="Machine" @bind="rateMachineId" @bind:after="SelectRate"><option value="0">Select machine</option>@foreach (var m in data.Machines) { <option value="@m.Id">@m.Name</option> }</select></label>
<label>Part <select aria-label="Part" @bind="partId" @bind:after="SelectRate"><option value="0">Select part</option>@foreach (var p in data.Parts) { <option value="@p.Id">@p.PartNumber</option> }</select></label>
<label>Target pieces per hour <InputNumber @bind-Value="pph" /></label><label>Part box quantity (optional) <InputNumber @bind-Value="boxQuantity" /></label><button class="button button-primary" @onclick="SaveRate">Save assignment</button><button class="button button-danger-outline" @onclick="() => Run(() => Service.RemoveRateAsync(data.Settings.Revision, rateMachineId, partId))">Remove eligibility</button></div>
<p>Box quantity belongs to the Part and applies across all machines. Leave blank when unknown; the schedule will show that boxes cannot be calculated.</p>
<table class="data-table"><thead><tr><th>Machine</th><th>Part</th><th>Target PPH</th><th>Effective PPH</th><th>Box quantity</th></tr></thead><tbody>@foreach (var m in data.Machines) { @foreach (var r in m.Parts) { <tr><td>@m.Name</td><td>@data.Parts.Single(p => p.Id == r.PartId).PartNumber</td><td>@r.TargetPph.ToString("N2")</td><td>@((r.TargetPph * data.Settings.EfficiencyPercent / 100m).ToString("N2"))</td><td>@data.Parts.Single(p => p.Id == r.PartId).BoxQuantity</td></tr> } }</tbody></table></section>
<section class="production-panel"><h2>Global holidays</h2><div class="production-fields"><label>Date <InputDate @bind-Value="holidayDate" /></label><label>Name <input @bind="holidayName" /></label><button class="button button-primary" @onclick="() => Run(() => Service.SaveHolidayAsync(data.Settings.Revision, holidayDate, holidayName, false))">Save holiday</button></div>
<table class="data-table"><thead><tr><th>Date</th><th>Name</th><th></th></tr></thead><tbody>@foreach (var h in data.Holidays) { <tr><td>@h.Date</td><td>@h.Name</td><td><button class="button button-danger-outline" @onclick="() => Run(() => Service.SaveHolidayAsync(data.Settings.Revision, h.Date, h.Name, true))">Remove</button></td></tr> }</tbody></table></section>
<section class="production-panel"><h2>Downtime reasons</h2><div class="production-fields"><label>Edit reason <select aria-label="Edit reason" @bind="reasonId" @bind:after="SelectReason"><option value="0">New reason</option>@foreach (var r in data.Reasons) { <option value="@r.Id">@r.Name @(!r.IsActive ? "(inactive)" : "")</option> }</select></label><label>Name <input @bind="reasonName" /></label><label><input type="checkbox" @bind="reasonActive" /> Active</label><button class="button button-primary" @onclick="() => Run(() => Service.SaveReasonAsync(data.Settings.Revision, reasonId, reasonName, reasonActive))">Save reason</button></div></section>
</fieldset>
}
@code {
    private ProductionSnapshot? data;
    private string? message;
    private string machineName = "", holidayName = "", reasonName = "";
    private bool busy, ready, active = true, reasonActive = true;
    private long machineId, rateMachineId, partId, reasonId;
    private decimal efficiency = 91, pph;
    private decimal? boxQuantity;
    private decimal[] hours = new decimal[7];
    private DateOnly holidayDate = DateOnly.FromDateTime(DateTime.Today);
    protected override Task OnInitializedAsync() => Run(() => Task.CompletedTask);
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { ready = true; StateHasChanged(); } }
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; message = null;
        try { await action(); data = await Service.GetAsync(); efficiency = data.Settings.EfficiencyPercent; }
        catch (Exception ex) when (ex is SchedulingException or UnauthorizedAccessException) { message = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Scheduling configuration failed"); message = "Could not save scheduling settings. Reload and retry."; }
        finally { busy = false; }
    }
    private void SelectMachine() { var m = data!.Machines.SingleOrDefault(x => x.Id == machineId); machineName = m?.Name ?? ""; active = m?.IsActive ?? true; hours = Enumerable.Range(0, 7).Select(i => m?.WorkingDays.SingleOrDefault(x => (int)x.Day == i)?.Hours ?? 0).ToArray(); }
    private Task SaveMachine() => Run(() => Service.SaveMachineAsync(data!.Settings.Revision, machineId, machineName, active, hours));
    private void SelectRate() { pph = data!.Machines.SingleOrDefault(x => x.Id == rateMachineId)?.Parts.SingleOrDefault(x => x.PartId == partId)?.TargetPph ?? 0; boxQuantity = data.Parts.SingleOrDefault(x => x.Id == partId)?.BoxQuantity; }
    private Task SaveRate() => Run(() => Service.SaveRateAsync(data!.Settings.Revision, rateMachineId, partId, pph, boxQuantity));
    private void SelectReason() { var r = data!.Reasons.SingleOrDefault(x => x.Id == reasonId); reasonName = r?.Name ?? ""; reasonActive = r?.IsActive ?? true; }
}



