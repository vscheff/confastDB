@page "/production-scheduling/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = AppRoles.Administrator)]
@using Confast.Web.Features.ProductionScheduling
@using Confast.Web.Time
@inject ProductionService Service
@inject BusinessDateProvider BusinessDate
@inject ILogger<Settings> Logger
@inject IJSRuntime Js
@implements IAsyncDisposable
<PageTitle>Scheduling Settings</PageTitle>
<div class="page-heading scheduling-page-heading"><h1>Scheduling Settings</h1><a class="button button-secondary" href="/production-scheduling">Back to Schedule</a></div>
@if (message != null) { <div class="alert alert-error" role="alert">@message</div> }
@if (data != null)
{
<div class="subtabs scheduling-tabs" role="tablist" aria-label="Scheduling settings sections">
<button id="scheduling-machines-tab" class="subtab @(activeTab == SettingsTab.Machines ? "subtab-active" : null)" type="button" role="tab" aria-controls="scheduling-machines-panel" aria-selected="@(activeTab == SettingsTab.Machines)" @onclick="() => activeTab = SettingsTab.Machines">Machines</button>
<button id="scheduling-settings-tab" class="subtab @(activeTab == SettingsTab.Settings ? "subtab-active" : null)" type="button" role="tab" aria-controls="scheduling-settings-panel" aria-selected="@(activeTab == SettingsTab.Settings)" @onclick="() => activeTab = SettingsTab.Settings">Settings</button>
</div>
<fieldset disabled="@(!ready || busy)">
@if (activeTab == SettingsTab.Settings)
{
<div id="scheduling-settings-panel" role="tabpanel" aria-labelledby="scheduling-settings-tab">
<div class="scheduling-settings-layout">
<div class="scheduling-settings-left-column">
<section class="production-panel production-efficiency-panel"><h2>Production Efficiency</h2><div class="production-fields"><label>Efficiency % <InputNumber @bind-Value="efficiency" step="1" /></label><button class="button button-primary" @onclick="() => Run(() => Service.SaveEfficiencyAsync(data.Settings.Revision, efficiency))">Save Efficiency</button></div><p>Effective PPH = target PPH × efficiency ÷ 100.</p></section>
<section class="production-panel downtime-reasons-panel"><div class="downtime-reasons-heading"><h2>Downtime Reasons</h2><button class="button button-primary" type="button" @onclick="ShowNewReasonEditor">Add Reason</button></div>
@if (showReasonEditor)
{
<div class="downtime-reason-editor"><h3>@(reasonId == 0 ? "Add Reason" : "Edit Reason")</h3><form @onsubmit="SaveReasonAsync" @onsubmit:preventDefault="true"><div class="production-fields"><label>Name <input @bind="reasonName" /></label><label><input type="checkbox" @bind="reasonActive" /> Active</label><button class="button button-primary" type="submit">Save Reason</button><button class="button button-secondary" type="button" @onclick="CancelReasonEditor">Cancel</button></div></form></div>
}
@if (data.Reasons.Count == 0)
{
<p>No downtime reasons have been added.</p>
}
else
{
<ul class="downtime-reason-list">@foreach (var reason in data.Reasons) { <li @key="reason.Id"><span>@reason.Name</span><span class="downtime-reason-status">@(reason.IsActive ? "Active" : "Inactive")</span><div class="downtime-reason-actions">@if (deleteReasonId == reason.Id) { <button class="button button-danger-outline" type="button" @onclick="DeleteReasonAsync">Confirm Delete</button><button class="button button-secondary" type="button" @onclick="CancelDeleteReason">Cancel</button> } else { <button class="button button-secondary" type="button" @onclick="() => EditReason(reason)">Edit</button><button class="button button-danger-outline" type="button" @onclick="() => ConfirmDeleteReason(reason.Id)">Delete</button> }</div></li> }</ul>
}
</section>
</div>
<section class="production-panel holiday-panel"><div class="holidays-heading"><h2>Holidays</h2><button class="button button-primary" type="button" @onclick="AddHoliday">Add Holiday</button></div>
<table class="data-table holiday-table"><thead><tr><th>Date</th><th>Name</th><th></th></tr></thead><tbody>@foreach (var holiday in holidayEditors) { <tr @key="holiday.Id"><td><span @ref="holiday.DateField"><InputDate @bind-Value="holiday.Date" /></span></td><td><form id="@holiday.FormId" @onsubmit="() => SaveHolidayAsync(holiday)" @onsubmit:preventDefault="true"><input @bind="holiday.Name" aria-label="Holiday name" /></form></td><td><div class="holiday-actions"><button class="button button-primary" type="submit" form="@holiday.FormId">Save</button><button class="button button-danger-outline" type="button" @onclick="() => RemoveHolidayAsync(holiday)">@(holiday.OriginalDate is null ? "Cancel" : "Remove")</button></div></td></tr> }</tbody></table></section>
</div>
</div>
}
else
{
<section class="production-panel" id="scheduling-machines-panel" role="tabpanel" aria-labelledby="scheduling-machines-tab"><div class="machine-tab-heading"><h2>Machines</h2><button class="button button-primary" type="button" @onclick="ShowNewMachineEditor">Add Machine</button></div>
<section class="default-working-days"><div class="default-working-days-heading"><h3>Default Work Day</h3><button class="button button-primary" @onclick="SaveDefaultWorkingDays">Save</button></div><div class="machine-calendar-day-fields">@foreach (var day in WeekdayIndexes) { <label>@((DayOfWeek)day) <InputNumber @bind-Value="defaultWorkingDayHours[day]" @bind-Value:after="SyncDefaultWorkingDayHours" step="0.1" /></label> }</div><p>Machines marked “Follows Default” update to these hours when the default is saved.</p></section>
@if (showNewMachineEditor)
{
<section class="machine-calendar machine-calendar-new"><div class="machine-editor-heading"><h3>Add Machine</h3><div class="machine-editor-actions"><button class="button button-primary" @onclick="SaveNewMachineAsync">Add Machine</button><button class="button button-secondary" type="button" @onclick="CancelNewMachine">Cancel</button></div></div><div class="machine-calendar-fields"><label>Name <input @bind="newMachine.Name" /></label><label><input type="checkbox" @bind="newMachine.Active" /> Active</label><label><input type="checkbox" @bind="newMachine.UsesDefaultWorkingDays" @bind:after="() => SyncMachineToDefault(newMachine)" /> Follows Default</label></div>
<div class="machine-calendar-hours"><div class="machine-calendar-day-fields">@foreach (var day in WeekdayIndexes) { <label>@((DayOfWeek)day) <InputNumber @bind-Value="newMachine.Hours[day]" disabled="@newMachine.UsesDefaultWorkingDays" step="0.1" /></label> }</div></div><p>Enter zero for non-working days.</p></section>
}
<div class="machine-calendar-list">
@foreach (var machine in machineEditors)
{
    <section class="machine-calendar" @key="machine.Id"><div class="machine-calendar-fields"><label>Name <input @bind="machine.Name" /></label><label><input type="checkbox" @bind="machine.Active" /> Active</label><label><input type="checkbox" @bind="machine.UsesDefaultWorkingDays" @bind:after="() => SyncMachineToDefault(machine)" /> Follows Default</label><button class="button button-primary" @onclick="() => SaveMachine(machine)">Save</button></div>
    <div class="machine-calendar-hours"><div class="machine-calendar-day-fields">@foreach (var day in WeekdayIndexes) { <label>@((DayOfWeek)day) <InputNumber @bind-Value="machine.Hours[day]" disabled="@machine.UsesDefaultWorkingDays" step="0.1" /></label> }</div></div></section>
}
</div>
</section>
}
</fieldset>
}
@code {
    private ProductionSnapshot? data;
    private string? message;
    private string reasonName = "";
    private bool busy, ready, reasonActive = true, showNewMachineEditor, showReasonEditor;
    private SettingsTab activeTab = SettingsTab.Machines;
    private long reasonId;
    private long? deleteReasonId;
    private int efficiency = 91;
    private decimal[] defaultWorkingDayHours = new decimal[7];
    private List<MachineEditor> machineEditors = [];
    private List<HolidayEditor> holidayEditors = [];
    private MachineEditor newMachine = new();
    private IJSObjectReference? dateInputNavigationModule;
    private static readonly int[] WeekdayIndexes = [1, 2, 3, 4, 5, 6, 0];
    protected override Task OnInitializedAsync() => Run(() => Task.CompletedTask);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { ready = true; StateHasChanged(); }
        if (data == null || activeTab != SettingsTab.Settings) return;

        dateInputNavigationModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./date-input-tab-navigation.js");
        foreach (var holiday in holidayEditors)
            await dateInputNavigationModule.InvokeVoidAsync("skipNativePickerOnTab", holiday.DateField);
    }
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; message = null;
        try
        {
            await action();
            data = await Service.GetAsync();
            efficiency = decimal.ToInt32(data.Settings.EfficiencyPercent);
            defaultWorkingDayHours = Enumerable.Range(0, 7).Select(i => decimal.Round(data.Settings.DefaultWorkingDays.SingleOrDefault(x => (int)x.Day == i)?.Hours ?? 0, 1)).ToArray();
            machineEditors = data.Machines.Select(MachineEditor.From).ToList();
            holidayEditors = data.Holidays.Select(HolidayEditor.From).ToList();
        }
        catch (Exception ex) when (ex is SchedulingException or UnauthorizedAccessException) { message = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Scheduling configuration failed"); message = "Could not save scheduling settings. Reload and retry."; }
        finally { busy = false; }
    }
    private Task SaveMachine(MachineEditor machine) => Run(() => Service.SaveMachineAsync(data!.Settings.Revision, machine.Id, machine.Name, machine.Active, machine.UsesDefaultWorkingDays, machine.Hours));
    private Task SaveHolidayAsync(HolidayEditor holiday) => holiday.OriginalDate is null
        ? Run(() => Service.SaveHolidayAsync(data!.Settings.Revision, holiday.Date, holiday.Name, false))
        : Run(() => Service.UpdateHolidayAsync(data!.Settings.Revision, holiday.OriginalDate.Value, holiday.Date, holiday.Name));
    private void AddHoliday() => holidayEditors.Add(new()
    {
        Date = BusinessDate.Today
    });
    private Task RemoveHolidayAsync(HolidayEditor holiday)
    {
        if (holiday.OriginalDate is null)
        {
            holidayEditors.Remove(holiday);
            return Task.CompletedTask;
        }

        return Run(() => Service.SaveHolidayAsync(data!.Settings.Revision, holiday.OriginalDate.Value, holiday.Name, true));
    }
    private Task SaveDefaultWorkingDays() => Run(() => Service.SaveDefaultWorkingDaysAsync(data!.Settings.Revision, defaultWorkingDayHours));
    private void ShowNewMachineEditor() { newMachine = new(); SyncMachineToDefault(newMachine); showNewMachineEditor = true; }
    private void CancelNewMachine() { newMachine = new(); showNewMachineEditor = false; }
    private async Task SaveNewMachineAsync()
    {
        await Run(() => Service.SaveMachineAsync(data!.Settings.Revision, newMachine.Id, newMachine.Name, newMachine.Active, newMachine.UsesDefaultWorkingDays, newMachine.Hours));
        if (message == null) showNewMachineEditor = false;
    }
    private void SyncDefaultWorkingDayHours()
    {
        foreach (var machine in machineEditors.Where(x => x.UsesDefaultWorkingDays)) SyncMachineToDefault(machine);
        if (showNewMachineEditor && newMachine.UsesDefaultWorkingDays) SyncMachineToDefault(newMachine);
    }
    private void SyncMachineToDefault(MachineEditor machine)
    {
        if (machine.UsesDefaultWorkingDays) machine.Hours = defaultWorkingDayHours.ToArray();
    }
    private void ShowNewReasonEditor() { reasonId = 0; reasonName = ""; reasonActive = true; showReasonEditor = true; }
    private void EditReason(DowntimeReason reason) { reasonId = reason.Id; reasonName = reason.Name; reasonActive = reason.IsActive; showReasonEditor = true; }
    private void CancelReasonEditor() { reasonId = 0; reasonName = ""; reasonActive = true; showReasonEditor = false; }
    private void ConfirmDeleteReason(long id) { deleteReasonId = id; }
    private void CancelDeleteReason() { deleteReasonId = null; }
    private async Task SaveReasonAsync()
    {
        await Run(() => Service.SaveReasonAsync(data!.Settings.Revision, reasonId, reasonName, reasonActive));
        if (message == null) CancelReasonEditor();
    }
    private async Task DeleteReasonAsync()
    {
        if (deleteReasonId == null) return;
        await Run(() => Service.DeleteReasonAsync(data!.Settings.Revision, deleteReasonId.Value));
        if (message == null) CancelDeleteReason();
    }

    public async ValueTask DisposeAsync()
    {
        if (dateInputNavigationModule is null) return;

        try { await dateInputNavigationModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private sealed class HolidayEditor
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string FormId => $"holiday-{Id}";
        public DateOnly? OriginalDate { get; init; }
        public DateOnly Date { get; set; }
        public string Name { get; set; } = "";
        public ElementReference DateField { get; set; }

        public static HolidayEditor From(ProductionHoliday holiday) => new() { OriginalDate = holiday.Date, Date = holiday.Date, Name = holiday.Name };
    }

    private sealed class MachineEditor
    {
        public long Id { get; init; }
        public string Name { get; set; } = "";
        public bool Active { get; set; } = true;
        public bool UsesDefaultWorkingDays { get; set; }
        public decimal[] Hours { get; set; } = new decimal[7];

        public static MachineEditor From(SortingMachine machine) => new()
        {
            Id = machine.Id,
            Name = machine.Name,
            Active = machine.IsActive,
            UsesDefaultWorkingDays = machine.UsesDefaultWorkingDays,
            Hours = Enumerable.Range(0, 7).Select(i => decimal.Round(machine.WorkingDays.SingleOrDefault(x => (int)x.Day == i)?.Hours ?? 0, 1)).ToArray()
        };
    }

    private enum SettingsTab { Settings, Machines }
}



