@page "/parts/{Id:long}/edit"
@using Confast.Web.Features.InspectionCriteria
@using Confast.Web.Features.Parts
@inject InspectionCriteriaService CriteriaService
@inject PartService PartService
@inject ILogger<Edit> Logger

<PageTitle>@(part is null ? "Part" : $"Edit {part.PartNumber}")</PageTitle>

<div class="criteria-revision-page part-detail-page">
<p><a class="back-link" href="/parts">← Parts</a></p>

@if (isLoading)
{
    <p class="status-message">Loading part…</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (part is null)
{
    <div class="empty-state">
        <h1>Part not found</h1>
        <p>The part may have been deleted.</p>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <h1>@part.PartNumber</h1>
            <p>Part ID @part.Id</p>
        </div>
        <a class="button button-danger-outline" href="@($"/parts/{part.Id}/delete")">Delete</a>
    </div>

    @if (saveMessage is not null)
    {
        <div class="alert @saveMessageClass" role="status">@saveMessage</div>
    }

    <PartForm Model="part"
              CustomerOptions="customerOptions"
              PlantOptions="plantOptions"
              OnCustomerChanged="LoadPlantsAsync"
              OnValidSubmit="SavePartAsync"
              FormName="edit-part"
              IsSaving="isSaving"
              Compact="true" />

    <section class="linked-records" aria-labelledby="inspection-criteria-heading">
        <div class="section-heading">
            <div>
                <h2 id="inspection-criteria-heading">Inspection Criteria</h2>
                @if (currentRevision is not null)
                {
                    <p>
                        <span class="status-pill status-active">Current</span>
                        Revision @currentRevision.RevisionNumber · published @currentRevision.PublishedAtUtc?.ToString("u")
                    </p>
                }
                else
                {
                    <p>Versioned requirements used to inspect this part.</p>
                }
            </div>
            <div class="heading-actions">
                @if (criteriaSummary?.DraftRevision is not null)
                {
                    <a class="button button-primary" href="@RevisionUrl(criteriaSummary.DraftRevision.Id)">Edit draft</a>
                }
                else if (currentRevision?.CanEdit == true)
                {
                    <a class="button button-primary" href="@RevisionUrl(currentRevision.Id)">Edit current revision</a>
                }
                else
                {
                    <a class="button button-primary" href="@($"/parts/{Id}/inspection-criteria/create")">
                        @(criteriaSummary?.CurrentRevision is null ? "Create initial revision" : "Create new revision")
                    </a>
                }
                <a class="button button-secondary" href="@($"/parts/{Id}/inspection-criteria")">History</a>
            </div>
        </div>

        @if (criteriaSummary?.DraftRevision is not null)
        {
            <div class="alert alert-warning" role="status">
                Revision @criteriaSummary.DraftRevision.RevisionNumber is a draft. The published revision remains current until the draft is published.
            </div>
        }

        @if (currentRevision is null)
        {
            <div class="empty-state compact-empty-state">No inspection criteria have been published for this part.</div>
        }
        else
        {
            <div class="subtabs revision-tabs" role="tablist" aria-label="Current inspection criteria sections">
                <button class="subtab @(activeCriteriaTab == PartCriteriaTab.Criteria ? "subtab-active" : null)"
                        type="button"
                        role="tab"
                        aria-selected="@(activeCriteriaTab == PartCriteriaTab.Criteria)"
                        @onclick="() => activeCriteriaTab = PartCriteriaTab.Criteria">
                    Criteria
                </button>
                <button class="subtab @(activeCriteriaTab == PartCriteriaTab.MasterPrint ? "subtab-active" : null)"
                        type="button"
                        role="tab"
                        aria-selected="@(activeCriteriaTab == PartCriteriaTab.MasterPrint)"
                        @onclick="() => activeCriteriaTab = PartCriteriaTab.MasterPrint">
                    Master Print
                </button>
                <button class="subtab @(activeCriteriaTab == PartCriteriaTab.Certifications ? "subtab-active" : null)"
                        type="button"
                        role="tab"
                        aria-selected="@(activeCriteriaTab == PartCriteriaTab.Certifications)"
                        @onclick="() => activeCriteriaTab = PartCriteriaTab.Certifications">
                    Certification Requirements
                </button>
            </div>

            @if (activeCriteriaTab == PartCriteriaTab.Criteria)
            {
                <section class="revision-details-bar" aria-label="Current revision details">
                    <div class="compact-form-field print-revision-field">
                        <label>Print Revision Number</label>
                        <input type="text" readonly value="@currentRevision.PrintRevisionNumber" />
                    </div>
                    <div class="compact-form-field part-description-field">
                        <label>Part Description</label>
                        <input type="text" readonly value="@currentRevision.PartDescription" />
                    </div>
                    <div class="compact-form-field specification-used-field">
                        <label>Spec Used</label>
                        <input type="text" readonly value="@currentRevision.SpecificationUsed" />
                    </div>
                </section>

                @if (currentRevision.Criteria.Count == 0)
                {
                    <div class="empty-state compact-empty-state">This revision has no criteria.</div>
                }
                else
                {
                    <div class="table-shell criteria-table-shell">
                        <table class="data-table criteria-table">
                            <thead><tr><th>#</th><th>Requirement</th><th>Maximum / tolerance</th><th>Minimum</th><th>Inspection method</th><th>Unit</th><th>Notes</th></tr></thead>
                            <tbody>
                                @foreach (var criterion in currentRevision.Criteria)
                                {
                                    <tr>
                                        <td data-label="#">@criterion.InspectionNumber</td>
                                        <td data-label="Requirement">@criterion.Name</td>
                                        <td data-label="Maximum / tolerance">@(criterion.MaximumOrTolerance ?? "—")</td>
                                        <td data-label="Minimum">@(criterion.Minimum ?? "—")</td>
                                        <td data-label="Inspection method">@(criterion.InspectionMethod ?? "—")</td>
                                        <td data-label="Unit">@(criterion.Unit ?? "—")</td>
                                        <td data-label="Notes">@(criterion.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="revision-lower-grid">
                    <section class="secondary-process-section">
                        <div class="section-heading secondary-process-heading">
                            <h2>Secondary Processes</h2>
                        </div>
                        @if (currentRevision.SecondaryProcessRequirements.Count == 0)
                        {
                            <div class="empty-state compact-empty-state">This revision has no secondary processes.</div>
                        }
                        else
                        {
                            <div class="table-shell">
                                <table class="data-table secondary-process-table">
                                    <thead><tr><th>Process</th><th>Specification</th></tr></thead>
                                    <tbody>
                                        @foreach (var requirement in currentRevision.SecondaryProcessRequirements)
                                        {
                                            <tr>
                                                <td data-label="Process">@requirement.ProcessName</td>
                                                <td data-label="Specification">@(requirement.Specification ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="revision-notes-section">
                        <div class="section-heading revision-notes-heading">
                            <h2>Notes</h2>
                        </div>
                        <div class="revision-notes-input revision-notes-display">
                            @(currentRevision.Notes ?? "No notes for this revision.")
                        </div>
                    </section>
                </div>
            }
            else if (activeCriteriaTab == PartCriteriaTab.MasterPrint)
            {
                <section class="master-print-panel">
                    <div class="master-print-toolbar">
                        <div>
                            <h2>Master Print</h2>
                            @if (currentRevision.HasMasterPrint)
                            {
                                <p>
                                    <strong>@currentRevision.MasterPrintFileName</strong>
                                    @if (currentRevision.MasterPrintUploadedAtUtc is not null)
                                    {
                                        <span> · Uploaded @currentRevision.MasterPrintUploadedAtUtc.Value.ToString("u")</span>
                                    }
                                </p>
                            }
                            else
                            {
                                <p>No master print has been uploaded for this revision.</p>
                            }
                        </div>
                        @if (currentRevision.HasMasterPrint)
                        {
                            <div class="heading-actions">
                                <a class="button button-secondary" href="@CurrentMasterPrintViewerUrl" target="_blank" rel="noopener">Open in new tab</a>
                            </div>
                        }
                    </div>

                    @if (currentRevision.HasMasterPrint)
                    {
                        <iframe class="master-print-viewer" src="@CurrentMasterPrintViewerUrl" title="Master print PDF"></iframe>
                    }
                </section>
            }
            else
            {
                <section class="revision-certification-section">
                    <div class="section-heading">
                        <div>
                            <h2>Certification Requirements</h2>
                            <p>Requirements saved with published revision @currentRevision.RevisionNumber.</p>
                        </div>
                    </div>
                    <div class="table-shell">
                        <table class="data-table certification-requirements-table">
                            <thead>
                                <tr>
                                    <th>Certification type</th>
                                    <th>Requirement</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var certificationType in certificationTypeChoices)
                                {
                                    var requirement = currentRevision.CertificationRequirements
                                        .SingleOrDefault(x => x.CertificationTypeId == certificationType.Id);
                                    <tr>
                                        <td data-label="Certification type">@(requirement?.CertificationTypeName ?? certificationType.Name)</td>
                                        <td data-label="Requirement">@(requirement?.RequirementLevel.ToString() ?? "Not Applicable")</td>
                                        <td data-label="Notes">@(requirement?.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
    </section>
}
</div>

@code {
    [Parameter]
    public long Id { get; set; }

    private PartEditModel? part;
    private IReadOnlyList<CustomerOption> customerOptions = [];
    private IReadOnlyList<PlantOption> plantOptions = [];
    private PartInspectionCriteriaSummary? criteriaSummary;
    private InspectionCriteriaRevisionDetails? currentRevision;
    private IReadOnlyList<CertificationTypeChoice> certificationTypeChoices = [];
    private bool isLoading = true;
    private bool isSaving;
    private string? loadError;
    private string? saveMessage;
    private string saveMessageClass = "alert-success";
    private PartCriteriaTab activeCriteriaTab;

    private string CurrentMasterPrintViewerUrl => currentRevision is null
        ? string.Empty
        : $"/pdf-viewer/index.html?file={Uri.EscapeDataString($"/parts/{Id}/inspection-criteria/{currentRevision.Id}/master-print")}";

    protected override Task OnParametersSetAsync() => LoadPartAsync();

    private async Task LoadPartAsync()
    {
        isLoading = true;
        loadError = null;
        saveMessage = null;
        currentRevision = null;
        activeCriteriaTab = PartCriteriaTab.Criteria;

        try
        {
            var partTask = PartService.GetPartAsync(Id);
            var optionsTask = PartService.GetCustomerOptionsAsync();
            var criteriaTask = CriteriaService.GetPartSummaryAsync(Id);
            var certificationTypesTask = CriteriaService.GetCertificationTypeChoicesAsync();

            await Task.WhenAll(partTask, optionsTask, criteriaTask, certificationTypesTask);
            part = await partTask;
            customerOptions = await optionsTask;
            criteriaSummary = await criteriaTask;
            certificationTypeChoices = await certificationTypesTask;
            if (part is not null)
            {
                plantOptions = await PartService.GetPlantOptionsAsync(part.CustomerId);
            }

            if (criteriaSummary?.CurrentRevision is not null)
            {
                currentRevision = await CriteriaService.GetRevisionAsync(
                    Id,
                    criteriaSummary.CurrentRevision.Id);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load part {PartId}", Id);
            loadError = "The part could not be loaded. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string RevisionUrl(long revisionId) =>
        $"/parts/{Id}/inspection-criteria/{revisionId}";

    private async Task LoadPlantsAsync(long customerId)
    {
        plantOptions = customerId > 0 ? await PartService.GetPlantOptionsAsync(customerId) : [];
    }

    private async Task SavePartAsync()
    {
        if (part is null)
        {
            return;
        }

        isSaving = true;
        saveMessage = null;

        try
        {
            var result = await PartService.SavePartAsync(part);

            switch (result.Status)
            {
                case SavePartStatus.Saved:
                    part.Version = result.Version!.Value;
                    saveMessage = "Changes saved.";
                    saveMessageClass = "alert-success";
                    break;
                case SavePartStatus.NotFound:
                    saveMessage = "This part no longer exists.";
                    saveMessageClass = "alert-error";
                    break;
                case SavePartStatus.Conflict:
                    saveMessage = "Someone else changed this part. Reload the page before trying again.";
                    saveMessageClass = "alert-warning";
                    break;
                case SavePartStatus.DuplicatePartNumber:
                    saveMessage = "That customer already has a part with this part number.";
                    saveMessageClass = "alert-error";
                    break;
                case SavePartStatus.CustomerNotFound:
                    saveMessage = "The selected customer no longer exists. Reload the page and choose another customer.";
                    saveMessageClass = "alert-error";
                    break;
                case SavePartStatus.ValidationFailed:
                    saveMessage = result.Message;
                    saveMessageClass = "alert-error";
                    break;
                default:
                    throw new InvalidOperationException($"Unexpected save status: {result.Status}");
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save part {PartId}", part.Id);
            saveMessage = "The changes could not be saved. Please try again.";
            saveMessageClass = "alert-error";
        }
        finally
        {
            isSaving = false;
        }
    }

    private enum PartCriteriaTab
    {
        Criteria,
        MasterPrint,
        Certifications
    }
}
