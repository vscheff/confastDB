@page "/production-tracking/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = AppRoles.Administrator)]
@using Confast.Web.Features.ProductionTracking
@inject ProductionTrackingService Service
@inject ILogger<Settings> Logger

<PageTitle>Production Tracking Settings</PageTitle>

<div class="page-heading"><h1>Production Tracking Settings</h1><a class="button button-secondary" href="/production-tracking">Back to Production Tracking</a></div>
@if (message is not null) { <div class="alert alert-error" role="alert">@message</div> }

<section class="tracking-settings-panel">
    <div class="settings-heading"><div><h2>Sort Log Downtime Causes</h2></div><button type="button" class="button button-primary" @onclick="AddCause">Add Cause</button></div>
    @if (editor is not null)
    {
        <form class="cause-editor" @onsubmit="SaveCauseAsync" @onsubmit:preventDefault="true">
            <label>Name <input @bind="editor.Name" maxlength="150" /></label>
            <label class="active-field"><input type="checkbox" @bind="editor.IsActive" /> Active</label>
            <div class="editor-actions"><button type="submit" class="button button-primary" disabled="@busy">Save Cause</button><button type="button" class="button button-secondary" disabled="@busy" @onclick="CancelEdit">Cancel</button></div>
        </form>
    }
    @if (causes is null) { <p>Loading downtime causes…</p> }
    else
    {
        <div class="cause-list">
            @foreach (var cause in causes)
            {
                <article class="cause-row" @key="cause.Id">
                    <div><strong>@cause.Name</strong><span>@(cause.IsActive ? "Active" : "Inactive")</span></div>
                    <div class="row-actions">
                        @if (deleteId == cause.Id)
                        {
                            <button type="button" class="button button-danger-outline" @onclick="DeleteCauseAsync">Confirm Delete</button><button type="button" class="button button-secondary" @onclick="() => deleteId = null">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="button button-secondary" @onclick="() => EditCause(cause)">Edit</button><button type="button" class="button button-danger-outline" @onclick="() => deleteId = cause.Id">Delete</button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<SortLogDowntimeCause>? causes;
    private CauseEditor? editor;
    private long? deleteId;
    private string? message;
    private bool busy;

    protected override Task OnInitializedAsync() => ReloadAsync();
    private void AddCause() => editor = new();
    private void EditCause(SortLogDowntimeCause cause) => editor = new() { Id = cause.Id, Name = cause.Name, IsActive = cause.IsActive };
    private void CancelEdit() => editor = null;

    private async Task SaveCauseAsync()
    {
        if (editor is null) return;
        await RunAsync(() => Service.SaveDowntimeCauseAsync(editor.Id, editor.Name, editor.IsActive));
        if (message is null) editor = null;
    }

    private async Task DeleteCauseAsync()
    {
        if (deleteId is null) return;
        await RunAsync(() => Service.DeleteDowntimeCauseAsync(deleteId.Value));
        if (message is null) deleteId = null;
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true; message = null;
        try { await action(); await ReloadAsync(); }
        catch (Exception exception) when (exception is ProductionTrackingException or UnauthorizedAccessException) { message = exception.Message; }
        catch (Exception exception) { Logger.LogError(exception, "Production Tracking settings operation failed"); message = "Could not save Production Tracking settings. Reload and try again."; }
        finally { busy = false; }
    }

    private async Task ReloadAsync() => causes = await Service.GetDowntimeCausesAsync();

    private sealed class CauseEditor
    {
        public long Id { get; init; }
        public string Name { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }
}
