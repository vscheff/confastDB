@page "/parts/{PartId:long}/inspection-criteria/{RevisionId:long}/criteria/{CriterionId:long}/delete"
@using Confast.Web.Features.InspectionCriteria
@inject InspectionCriteriaService CriteriaService
@inject NavigationManager Navigation
@inject ILogger<DeleteCriterion> Logger

<PageTitle>Remove inspection criterion</PageTitle>

<p><a class="back-link" href="@RevisionUrl">← Revision</a></p>

@if (isLoading)
{
    <p class="status-message">Loading criterion…</p>
}
else if (criterion is null)
{
    <div class="empty-state"><h1>Criterion not found</h1></div>
}
else
{
    <div class="confirmation-card">
        <h1>Remove @criterion.Name?</h1>
        <p>This removes the criterion from this draft revision.</p>
        @if (message is not null)
        {
            <div class="alert alert-error" role="alert">@message</div>
        }
        <div class="form-actions">
            <button class="button button-danger" @onclick="DeleteAsync" disabled="@isDeleting">@(isDeleting ? "Removing…" : "Remove criterion")</button>
            <a class="button button-secondary" href="@RevisionUrl">Cancel</a>
        </div>
    </div>
}

@code {
    [Parameter] public long PartId { get; set; }
    [Parameter] public long RevisionId { get; set; }
    [Parameter] public long CriterionId { get; set; }

    private InspectionCriterionEditModel? criterion;
    private bool isLoading = true;
    private bool isDeleting;
    private string? message;
    private string RevisionUrl => $"/parts/{PartId}/inspection-criteria/{RevisionId}";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            criterion = await CriteriaService.GetCriterionAsync(PartId, RevisionId, CriterionId);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load criterion {CriterionId} for removal", CriterionId);
            message = "The criterion could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (criterion is null)
        {
            return;
        }

        isDeleting = true;
        try
        {
            var result = await CriteriaService.DeleteCriterionAsync(
                PartId,
                RevisionId,
                CriterionId,
                criterion.Version);
            if (result.Status == CriteriaOperationStatus.Succeeded)
            {
                Navigation.NavigateTo(RevisionUrl);
                return;
            }

            message = result.Status switch
            {
                CriteriaOperationStatus.PublishedRevision => "This revision has been published and cannot be changed.",
                CriteriaOperationStatus.RevisionInUse => "This revision cannot be changed because an inspection uses it.",
                CriteriaOperationStatus.Conflict => "Another user changed this criterion. Reload before removing it.",
                CriteriaOperationStatus.NotFound => "The criterion no longer exists.",
                _ => "The criterion could not be removed."
            };
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to remove criterion {CriterionId}", CriterionId);
            message = "The criterion could not be removed. Please try again.";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
