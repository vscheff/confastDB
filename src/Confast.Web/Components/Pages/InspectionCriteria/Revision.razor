    private async Task UploadMasterPrintAsync(InputFileChangeEventArgs eventArgs)
    {
        if (revision is null)
        {
            return;
        }

        isWorking = true;
        message = null;
        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(InspectionCriteriaService.MaximumMasterPrintBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var result = await CriteriaService.UploadMasterPrintAsync(
                PartId,
                RevisionId,
                file.Name,
                buffer.ToArray(),
                revision.Version);
            if (result.Status == CriteriaOperationStatus.Succeeded)
            {
                await LoadAsync();
                activeTab = RevisionTab.MasterPrint;
                message = "Master print uploaded.";
                messageClass = "alert-success";
                return;
            }

            SetOperationMessage(result);
        }
        catch (IOException exception)
        {
            Logger.LogWarning(exception, "Rejected master print upload for revision {RevisionId}", RevisionId);
            message = "The PDF must be 25 MB or smaller.";
            messageClass = "alert-error";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to upload master print for revision {RevisionId}", RevisionId);
            message = "The master print could not be uploaded. Please try again.";
            messageClass = "alert-error";
        }
        finally
        {
            isWorking = false;
        }
    }

