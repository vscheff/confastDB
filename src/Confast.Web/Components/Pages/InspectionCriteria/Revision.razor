    private Task SetEditingUnitAsync(string? unit)
    {
        if (editingModel is null)
        {
            return Task.CompletedTask;
        }

        editingModel.Unit = unit;
        if (IsStandardCriterionUnit(unit))
        {
            preferredCriterionUnit = unit;
        }

        return Task.CompletedTask;
    }

    private static bool IsStandardCriterionUnit(string? unit) =>
        string.Equals(unit, "IN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(unit, "MM", StringComparison.OrdinalIgnoreCase);

    private void CommitMaximum()
    {
        maximumValidationMessage = null;
        if (editingModel is null)
        {
            return;
        }

        if (InspectionCriterionRangeValidator.HasInvalidNumericOrder(
                editingModel.Minimum,
                editingModel.MaximumOrTolerance))
        {
            editingModel.MaximumOrTolerance = committedMaximum;
            maximumValidationMessage =
                $"Reverted to {DescribeRangeValue(committedMaximum)} because Maximum cannot be less than Minimum.";
            return;
        }

        committedMaximum = editingModel.MaximumOrTolerance;
    }

    private void CommitMinimum()
    {
        minimumValidationMessage = null;
        if (editingModel is null)
        {
            return;
        }

        if (InspectionCriterionRangeValidator.HasInvalidNumericOrder(
                editingModel.Minimum,
                editingModel.MaximumOrTolerance))
        {
            editingModel.Minimum = committedMinimum;
            minimumValidationMessage =
                $"Reverted to {DescribeRangeValue(committedMinimum)} because Minimum cannot be greater than Maximum.";
            return;
        }

        committedMinimum = editingModel.Minimum;
    }

    private void CaptureCommittedRange()
    {
        committedMinimum = editingModel?.Minimum;
        committedMaximum = editingModel?.MaximumOrTolerance;
        ClearRangeValidation();
    }

    private void ClearRangeValidation()
    {
        minimumValidationMessage = null;
        maximumValidationMessage = null;
    }

    private static string DescribeRangeValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "blank" : $"'{value}'";

    private Task SaveEditAsync() => SaveEditAsync(addAnother: false);

    private async Task SaveEditAsync(bool addAnother)
    {
        if (editingModel is null)
        {
            return;
        }

        isWorking = true;
        message = null;
        try
        {
            var isNew = editingModel.Id == 0;
            var result = isNew
                ? await CriteriaService.AddCriterionAsync(PartId, RevisionId, editingModel)
                : await CriteriaService.SaveCriterionAsync(PartId, RevisionId, editingModel);

            if (result.Status == CriteriaOperationStatus.Succeeded)
            {
                await LoadAsync();
                if (addAnother)
                {
                    BeginAdd();
                    focusNewRequirement = true;
                }

                message = isNew ? "Criterion added." : "Criterion saved.";
                messageClass = "alert-success";
                return;
            }

            SetOperationMessage(result);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save criterion {CriterionId}", editingModel.Id);
            message = "The criterion could not be saved. Please try again.";
            messageClass = "alert-error";
        }
        finally
        {
            isWorking = false;
        }
    }

