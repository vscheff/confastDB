@page "/parts/{PartId:long}/inspection-criteria/{RevisionId:long}"
@using Confast.Web.Features.InspectionCriteria
@using Confast.Web.Features.Gages
@inject InspectionCriteriaService CriteriaService
@inject GageService GageService
@inject NavigationManager Navigation
@inject ILogger<Revision> Logger

<PageTitle>Inspection criteria revision</PageTitle>

<div class="criteria-revision-page">
<p><a class="back-link" href="@($"/parts/{PartId}/inspection-criteria")">← Revision history</a></p>

@if (isLoading)
{
    <p class="status-message">Loading revision…</p>
}
else if (loadError is not null)
{
    <div class="alert alert-error" role="alert">@loadError</div>
}
else if (revision is null)
{
    <div class="empty-state"><h1>Revision not found</h1></div>
}
else
{
    <div class="page-heading">
        <div>
            <h1>@revision.PartNumber — criteria revision @revision.RevisionNumber</h1>
            <p>
                <span class="status-pill @StatusClass">@revision.Status</span>
                Created @revision.CreatedAtUtc.ToString("u")
            </p>
        </div>
        <div class="heading-actions">
            @if (revision.IsDraft)
            {
                <button class="button button-secondary" type="button" @onclick="PublishAsync" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Publish revision</button>
            }
            @if (revision.CanEdit && !confirmRevisionDelete)
            {
                <button class="button button-danger" type="button" @onclick="BeginRevisionDelete" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Delete revision</button>
            }
            else if (revision.CanEdit)
            {
                <button class="button button-danger" type="button" @onclick="DeleteRevisionAsync" disabled="@isWorking">Confirm delete</button>
                <button class="button button-secondary" type="button" @onclick="CancelRevisionDelete" disabled="@isWorking">Cancel</button>
            }
        </div>
    </div>

    @if (revision.ChangeNote is not null)
    {
        <p><strong>Change note:</strong> @revision.ChangeNote</p>
    }

    @if (revision.IsUsedByInspection)
    {
        <div class="alert alert-success" role="status">
            This revision is read-only because an inspection has been started against it. Create a new revision to change the criteria.
        </div>
    }
    else if (!revision.IsDraft)
    {
        <div class="alert alert-warning" role="status">
            This published revision can still be edited because no inspections use it yet.
        </div>
    }

    @if (message is not null)
    {
        <div class="alert @messageClass" role="alert">@message</div>
    }

    <div class="subtabs revision-tabs" role="tablist" aria-label="Inspection criteria revision sections">
        <button class="subtab @(activeTab == RevisionTab.Criteria ? "subtab-active" : null)"
                type="button"
                role="tab"
                aria-selected="@(activeTab == RevisionTab.Criteria)"
                @onclick="() => activeTab = RevisionTab.Criteria">
            Criteria
        </button>
        <button class="subtab @(activeTab == RevisionTab.MasterPrint ? "subtab-active" : null)"
                type="button"
                role="tab"
                aria-selected="@(activeTab == RevisionTab.MasterPrint)"
                @onclick="() => activeTab = RevisionTab.MasterPrint">
            Master Print
        </button>
        <button class="subtab @(activeTab == RevisionTab.Certifications ? "subtab-active" : null)"
                type="button"
                role="tab"
                aria-selected="@(activeTab == RevisionTab.Certifications)"
                @onclick="() => activeTab = RevisionTab.Certifications">
            Certification Requirements
        </button>
    </div>

    @if (activeTab == RevisionTab.Criteria)
    {
    <section class="revision-details-bar">
            <div class="compact-form-field print-revision-field">
                <label for="print-revision-number">Print Revision Number</label>
                <input id="print-revision-number" type="text" readonly="@(!revision.CanEdit)" @bind="revisionHeaderModel.PrintRevisionNumber" @bind:event="oninput" />
            </div>
            <div class="compact-form-field part-description-field">
                <label for="part-description">Part Description</label>
                <input id="part-description" type="text" readonly="@(!revision.CanEdit)" @bind="revisionHeaderModel.PartDescription" @bind:event="oninput" />
            </div>
            <div class="compact-form-field specification-used-field">
                <label for="specification-used">Spec Used</label>
                <input id="specification-used" type="text" readonly="@(!revision.CanEdit)" @bind="revisionHeaderModel.SpecificationUsed" @bind:event="oninput" />
            </div>
            @if (revision.CanEdit)
            {
                <button class="button button-primary revision-details-save" type="button" @onclick="SaveRevisionHeaderAsync" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Save Details</button>
            }
    </section>

    <section class="criteria-section">
        <div class="section-heading secondary-process-heading">
            <h2>Requirements</h2>
            @if (revision.CanEdit)
            {
                <button class="button button-primary" type="button" @onclick="BeginAdd" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Add criterion</button>
            }
        </div>

        @if (revision.Criteria.Count == 0 && editingModel is null)
        {
            <div class="empty-state compact-empty-state">
                @(revision.IsDraft ? "This draft has no criteria. Add at least one before publishing." : "This revision has no criteria.")
            </div>
        }
        else
        {
            <div class="table-shell criteria-table-shell">
            <table class="data-table criteria-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Requirement</th>
                        <th>Maximum / tolerance</th>
                        <th>Minimum</th>
                        <th>Inspection method</th>
                        <th>Unit</th>
                        <th>Notes</th>
                        @if (revision.CanEdit)
                        {
                            <th><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < revision.Criteria.Count; index++)
                    {
                        var criterion = revision.Criteria[index];
                        var isEditing = editingModel?.Id == criterion.Id;
                        <tr class="@(isEditing ? "editing-row" : null)">
                            @if (isEditing)
                            {
                                <td data-label="#">
                                    <input class="table-input inspection-number-input" type="number" min="1" aria-label="Inspection number" @bind="editingModel!.InspectionNumber" @bind:event="oninput" />
                                </td>
                                <td data-label="Requirement">
                                    <input class="table-input requirement-input" aria-label="Requirement" @ref="requirementInput" @bind="editingModel!.Name" @bind:event="oninput" />
                                </td>
                                <td data-label="Maximum / tolerance">
                                    <input class="table-input tolerance-input" aria-label="Maximum or tolerance" @bind="editingModel!.MaximumOrTolerance" @bind:event="oninput" @onchange="CommitMaximum" />
                                    @if (maximumValidationMessage is not null)
                                    {
                                        <div class="validation-message" role="status">@maximumValidationMessage</div>
                                    }
                                </td>
                                <td data-label="Minimum">
                                    <input class="table-input tolerance-input" aria-label="Minimum" @bind="editingModel!.Minimum" @bind:event="oninput" @onchange="CommitMinimum" />
                                    @if (minimumValidationMessage is not null)
                                    {
                                        <div class="validation-message" role="status">@minimumValidationMessage</div>
                                    }
                                </td>
                                <td data-label="Inspection method">
                                    <select class="table-input" aria-label="Inspection method" @bind="editingModel!.GageTypeId">
                                        <option value="">Select</option>
                                        @foreach (var choice in methodChoices)
                                        {
                                            <option value="@choice.Id">@choice.Name@(!choice.IsActive ? " (inactive)" : null)</option>
                                        }
                                    </select>
                                </td>
                                <td data-label="Unit">
                                    <EditableUnitSelect CssClass="table-input unit-input"
                                                        Choices="unitChoices"
                                                        Value="@editingModel!.Unit"
                                                        ValueChanged="SetEditingUnitAsync" />
                                </td>
                                <td data-label="Notes">
                                    <textarea class="table-input table-notes" aria-label="Notes" title="Tab to save and add another criterion" @onkeydown="NotesKeyDownAsync" @bind="editingModel!.Notes" @bind:event="oninput"></textarea>
                                </td>
                                <td class="table-action" data-label="Actions">
                                    <div class="row-actions row-edit-actions">
                                        <button class="button button-primary" type="button" @onclick="SaveEditAsync" disabled="@isWorking">Save</button>
                                        <button class="button button-secondary" type="button" @onclick="CancelEdit" disabled="@isWorking">Cancel</button>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td data-label="#">@criterion.InspectionNumber</td>
                                <td data-label="Requirement">@criterion.Name</td>
                                <td data-label="Maximum / tolerance">@(criterion.MaximumOrTolerance ?? "—")</td>
                                <td data-label="Minimum">@(criterion.Minimum ?? "—")</td>
                                <td data-label="Inspection method">@(criterion.InspectionMethod ?? "—")</td>
                                <td data-label="Unit">@(criterion.Unit ?? "—")</td>
                                <td data-label="Notes">@(criterion.Notes ?? "—")</td>
                                @if (revision.CanEdit)
                                {
                                    <td class="table-action" data-label="Actions">
                                        @if (pendingDeleteId == criterion.Id)
                                        {
                                            <div class="row-actions delete-confirmation">
                                                <span>Remove?</span>
                                                <button class="button button-danger button-compact" type="button" @onclick="() => DeleteAsync(criterion)" disabled="@isWorking">Yes</button>
                                                <button class="button button-secondary button-compact" type="button" @onclick="CancelDelete" disabled="@isWorking">No</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row-actions">
                                                <button class="button button-secondary button-compact" type="button" title="Move up" aria-label="Move @criterion.Name up" @onclick="() => MoveAsync(criterion.Id, true)" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null || index == 0)">↑</button>
                                                <button class="button button-secondary button-compact" type="button" title="Move down" aria-label="Move @criterion.Name down" @onclick="() => MoveAsync(criterion.Id, false)" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null || index == revision.Criteria.Count - 1)">↓</button>
                                                <button class="button button-secondary" type="button" @onclick="() => BeginEdit(criterion)" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Edit</button>
                                                <button class="button button-danger-outline" type="button" @onclick="() => BeginDelete(criterion.Id)" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Remove</button>
                                            </div>
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }

                    @if (editingModel?.Id == 0)
                    {
                        <tr class="editing-row new-criterion-row">
                            <td data-label="#">
                                <input class="table-input inspection-number-input" type="number" min="1" aria-label="Inspection number" @bind="editingModel.InspectionNumber" @bind:event="oninput" />
                            </td>
                            <td data-label="Requirement">
                                <input class="table-input requirement-input" aria-label="Requirement" placeholder="Required" @ref="requirementInput" @bind="editingModel.Name" @bind:event="oninput" />
                            </td>
                            <td data-label="Maximum / tolerance">
                                <input class="table-input tolerance-input" aria-label="Maximum or tolerance" @bind="editingModel.MaximumOrTolerance" @bind:event="oninput" @onchange="CommitMaximum" />
                                @if (maximumValidationMessage is not null)
                                {
                                    <div class="validation-message" role="status">@maximumValidationMessage</div>
                                }
                            </td>
                            <td data-label="Minimum">
                                <input class="table-input tolerance-input" aria-label="Minimum" @bind="editingModel.Minimum" @bind:event="oninput" @onchange="CommitMinimum" />
                                @if (minimumValidationMessage is not null)
                                {
                                    <div class="validation-message" role="status">@minimumValidationMessage</div>
                                }
                            </td>
                                <td data-label="Inspection method">
                                <select class="table-input" aria-label="Inspection method" @bind="editingModel.GageTypeId">
                                    <option value="">Select</option>
                                    @foreach (var choice in methodChoices)
                                    {
                                        <option value="@choice.Id">@choice.Name</option>
                                    }
                                </select>
                            </td>
                            <td data-label="Unit">
                                <EditableUnitSelect CssClass="table-input unit-input"
                                                    Choices="unitChoices"
                                                    Value="@editingModel.Unit"
                                                    ValueChanged="SetEditingUnitAsync" />
                            </td>
                            <td data-label="Notes">
                                <textarea class="table-input table-notes" aria-label="Notes" title="Tab to save and add another criterion" @onkeydown="NotesKeyDownAsync" @bind="editingModel.Notes" @bind:event="oninput"></textarea>
                            </td>
                            <td class="table-action" data-label="Actions">
                                <div class="row-actions row-edit-actions">
                                    <button class="button button-primary" type="button" @onclick="SaveEditAsync" disabled="@isWorking">Add</button>
                                    <button class="button button-secondary" type="button" @onclick="CancelEdit" disabled="@isWorking">Cancel</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>

    <div class="revision-lower-grid">
    <section class="secondary-process-section">
        <div class="section-heading secondary-process-heading">
            <h2>Secondary Processes</h2>
            @if (revision.CanEdit)
            {
                <button class="button button-secondary" type="button" @onclick="BeginAddSecondaryProcess" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Add Secondary Process</button>
            }
        </div>

        @if (revision.SecondaryProcessRequirements.Count == 0 && secondaryProcessEditingModel is null)
        {
            <div class="empty-state compact-empty-state">This revision has no secondary processes.</div>
        }
        else
        {
            <div class="table-shell">
                <table class="data-table secondary-process-table">
                    <thead>
                        <tr>
                            <th>Process</th>
                            <th>Specification</th>
                            @if (revision.CanEdit)
                            {
                                <th><span class="visually-hidden">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var requirement in revision.SecondaryProcessRequirements)
                        {
                            var isEditingProcess = secondaryProcessEditingModel?.Id == requirement.Id;
                            <tr class="@(isEditingProcess ? "editing-row" : null)">
                                @if (isEditingProcess)
                                {
                                    <td data-label="Process">
                                        <select class="table-input" aria-label="Process" @bind="secondaryProcessEditingModel!.SecondaryProcessTypeId">
                                            <option value="">Select</option>
                                            @foreach (var processType in secondaryProcessTypeChoices)
                                            {
                                                <option value="@processType.Id">@processType.Name</option>
                                            }
                                        </select>
                                    </td>
                                    <td data-label="Specification"><input class="table-input" aria-label="Specification" @bind="secondaryProcessEditingModel!.Specification" @bind:event="oninput" /></td>
                                    <td class="table-action" data-label="Actions">
                                        <div class="row-actions row-edit-actions">
                                            <button class="button button-primary" type="button" @onclick="SaveSecondaryProcessAsync" disabled="@isWorking">Save</button>
                                            <button class="button button-secondary" type="button" @onclick="CancelSecondaryProcessEdit" disabled="@isWorking">Cancel</button>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td data-label="Process">@requirement.ProcessName</td>
                                    <td data-label="Specification">@(requirement.Specification ?? "—")</td>
                                    @if (revision.CanEdit)
                                    {
                                        <td class="table-action" data-label="Actions">
                                            @if (pendingSecondaryProcessDeleteId == requirement.Id)
                                            {
                                                <div class="row-actions delete-confirmation">
                                                    <span>Remove?</span>
                                                    <button class="button button-danger button-compact" type="button" @onclick="() => DeleteSecondaryProcessAsync(requirement)" disabled="@isWorking">Yes</button>
                                                    <button class="button button-secondary button-compact" type="button" @onclick="CancelSecondaryProcessDelete" disabled="@isWorking">No</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row-actions">
                                                    <button class="button button-secondary" type="button" @onclick="() => BeginEditSecondaryProcess(requirement)" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Edit</button>
                                                    <button class="button button-danger-outline" type="button" @onclick="() => BeginDeleteSecondaryProcess(requirement.Id)" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Remove</button>
                                                </div>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }

                        @if (secondaryProcessEditingModel?.Id == 0)
                        {
                            <tr class="editing-row">
                                <td data-label="Process">
                                    <select class="table-input" aria-label="Process" @bind="secondaryProcessEditingModel.SecondaryProcessTypeId">
                                        <option value="">Select</option>
                                        @foreach (var processType in secondaryProcessTypeChoices)
                                        {
                                            <option value="@processType.Id">@processType.Name</option>
                                        }
                                    </select>
                                </td>
                                <td data-label="Specification"><input class="table-input" aria-label="Specification" @bind="secondaryProcessEditingModel.Specification" @bind:event="oninput" /></td>
                                <td class="table-action" data-label="Actions">
                                    <div class="row-actions row-edit-actions">
                                        <button class="button button-primary" type="button" @onclick="SaveSecondaryProcessAsync" disabled="@isWorking">Add</button>
                                        <button class="button button-secondary" type="button" @onclick="CancelSecondaryProcessEdit" disabled="@isWorking">Cancel</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="revision-notes-section">
        <div class="section-heading revision-notes-heading">
            <h2>Notes</h2>
            @if (revision.CanEdit)
            {
                <button class="button button-primary" type="button" @onclick="SaveRevisionHeaderAsync" disabled="@(isWorking || editingModel is not null || secondaryProcessEditingModel is not null)">Save Notes</button>
            }
        </div>
        <textarea class="revision-notes-input" aria-label="Revision notes" rows="5" readonly="@(!revision.CanEdit)" @bind="revisionHeaderModel.Notes" @bind:event="oninput"></textarea>
    </section>
    </div>
    }
    else if (activeTab == RevisionTab.MasterPrint)
    {
        <section class="master-print-panel">
            <div class="master-print-toolbar">
                <div>
                    <h2>Master Print</h2>
                    @if (revision.HasMasterPrint)
                    {
                        <p>
                            <strong>@revision.MasterPrintFileName</strong>
                            @if (revision.MasterPrintUploadedAtUtc is not null)
                            {
                                <span> · Uploaded @revision.MasterPrintUploadedAtUtc.Value.ToString("u")</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p>No master print has been uploaded for this revision.</p>
                    }
                </div>
                @if (revision.HasMasterPrint)
                {
                    <div class="heading-actions">
                        <a class="button button-secondary" href="@MasterPrintViewerUrl" target="_blank" rel="noopener">Open in new tab</a>
                        @if (revision.CanEdit)
                        {
                            @if (confirmMasterPrintDelete)
                            {
                                <button class="button button-danger" type="button" @onclick="DeleteMasterPrintAsync" disabled="@isWorking">Confirm remove</button>
                                <button class="button button-secondary" type="button" @onclick="() => confirmMasterPrintDelete = false" disabled="@isWorking">Cancel</button>
                            }
                            else
                            {
                                <button class="button button-danger-outline" type="button" @onclick="() => confirmMasterPrintDelete = true" disabled="@isWorking">Remove</button>
                            }
                        }
                    </div>
                }
            </div>

            @if (revision.CanEdit)
            {
                <label class="master-print-drop-zone" for="master-print-file-input">
                    <span class="master-print-drop-title">@(revision.HasMasterPrint ? "Drop a replacement PDF here" : "Drop the master print PDF here")</span>
                    <span>or click to choose a file · 25 MB maximum</span>
                </label>
                <InputFile id="master-print-file-input"
                           class="master-print-file-input"
                           OnChange="UploadMasterPrintAsync"
                           accept="application/pdf,.pdf"
                           disabled="@isWorking" />
            }

            @if (revision.HasMasterPrint)
            {
                <iframe class="master-print-viewer" src="@MasterPrintViewerUrl" title="Master print PDF"></iframe>
            }
        </section>
    }
    else
    {
        <section class="revision-certification-section">
            <div class="section-heading">
                <div>
                    <h2>Certification Requirements</h2>
                    <p>Not Applicable is represented by no requirement row.</p>
                </div>
                @if (revision.CanEdit)
                {
                    <button class="button button-primary" type="button" @onclick="SaveCertificationRequirementsAsync" disabled="@isWorking">Save Requirements</button>
                }
            </div>
            <div class="table-shell">
                <table class="data-table certification-requirements-table">
                    <thead>
                        <tr>
                            <th>Certification type</th>
                            <th>Requirement</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var requirement in certificationRequirementModels)
                        {
                            <tr>
                                <td data-label="Certification type">@requirement.CertificationTypeName</td>
                                <td data-label="Requirement">
                                    @if (revision.CanEdit)
                                    {
                                        <select class="table-input" aria-label="Requirement for @requirement.CertificationTypeName" @bind="requirement.RequirementLevel">
                                            <option value="">Not Applicable</option>
                                            <option value="@CertificationRequirementLevel.Required">Required</option>
                                            <option value="@CertificationRequirementLevel.Optional">Optional</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span>@(requirement.RequirementLevel?.ToString() ?? "Not Applicable")</span>
                                    }
                                </td>
                                <td data-label="Notes">
                                    @if (revision.CanEdit)
                                    {
                                        <input class="table-input" aria-label="Notes for @requirement.CertificationTypeName" @bind="requirement.Notes" @bind:event="oninput" disabled="@(requirement.RequirementLevel is null)" />
                                    }
                                    else
                                    {
                                        <span>@(requirement.Notes ?? "—")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
</div>

@code {
    [Parameter] public long PartId { get; set; }
    [Parameter] public long RevisionId { get; set; }

    private InspectionCriteriaRevisionDetails? revision;
    private InspectionCriteriaRevisionHeaderEditModel revisionHeaderModel = new();
    private InspectionCriterionEditModel? editingModel;
    private SecondaryProcessRequirementEditModel? secondaryProcessEditingModel;
    private IReadOnlyList<GageTypeChoice> methodChoices = [];
    private IReadOnlyList<string> unitChoices = [];
    private IReadOnlyList<SecondaryProcessTypeChoice> secondaryProcessTypeChoices = [];
    private List<RevisionCertificationRequirementEditModel> certificationRequirementModels = [];
    private ElementReference requirementInput;
    private long? pendingDeleteId;
    private long? pendingSecondaryProcessDeleteId;
    private bool focusNewRequirement;
    private bool isLoading = true;
    private bool isWorking;
    private bool confirmRevisionDelete;
    private bool confirmMasterPrintDelete;
    private RevisionTab activeTab;
    private string? loadError;
    private string? message;
    private string? committedMinimum;
    private string? committedMaximum;
    private string? minimumValidationMessage;
    private string? maximumValidationMessage;
    private string? preferredCriterionUnit;
    private string messageClass = "alert-error";

    private string StatusClass => revision?.IsCurrent == true
        ? "status-active"
        : revision?.IsDraft == true ? "status-draft" : "status-inactive";

    private string MasterPrintUrl => $"/parts/{PartId}/inspection-criteria/{RevisionId}/master-print";

    private string MasterPrintViewerUrl =>
        $"/pdf-viewer/index.html?file={Uri.EscapeDataString(MasterPrintUrl)}";

    protected override Task OnParametersSetAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusNewRequirement)
        {
            return;
        }

        focusNewRequirement = false;
        await requirementInput.FocusAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            revision = await CriteriaService.GetRevisionAsync(PartId, RevisionId);
            if (revision is not null)
            {
                revisionHeaderModel = new InspectionCriteriaRevisionHeaderEditModel
                {
                    PrintRevisionNumber = revision.PrintRevisionNumber,
                    PartDescription = revision.PartDescription,
                    SpecificationUsed = revision.SpecificationUsed,
                    Notes = revision.Notes,
                    Version = revision.Version
                };

                preferredCriterionUnit = revision.Criteria
                    .OrderByDescending(x => x.DisplayOrder)
                    .Select(x => x.Unit)
                    .FirstOrDefault(IsStandardCriterionUnit);
            }
            await LoadMethodChoicesAsync();
            unitChoices = await CriteriaService.GetUnitChoicesAsync();
            secondaryProcessTypeChoices = await CriteriaService.GetSecondaryProcessTypeChoicesAsync();
            var certificationTypes = await CriteriaService.GetCertificationTypeChoicesAsync();
            var savedCertificationRequirements = revision?.CertificationRequirements
                .ToDictionary(x => x.CertificationTypeId) ?? [];
            certificationRequirementModels = certificationTypes.Select(type =>
            {
                savedCertificationRequirements.TryGetValue(type.Id, out var saved);
                return new RevisionCertificationRequirementEditModel
                {
                    Id = saved?.Id ?? 0,
                    CertificationTypeId = type.Id,
                    CertificationTypeName = saved?.CertificationTypeName ?? type.Name,
                    RequirementLevel = saved?.RequirementLevel,
                    Notes = saved?.Notes,
                    Version = saved?.Version ?? 0
                };
            }).ToList();
            editingModel = null;
            secondaryProcessEditingModel = null;
            pendingDeleteId = null;
            pendingSecondaryProcessDeleteId = null;
            confirmRevisionDelete = false;
            confirmMasterPrintDelete = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load criteria revision {RevisionId}", RevisionId);
            loadError = "The revision could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

