<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["lib/quill/quill.snow.css"]" />
    <link rel="stylesheet" href="@Assets["Confast.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["master-print-drop.js"]"></script>
    <script src="@Assets["inspection-print-options.js"]"></script>
    <script src="@Assets["lib/quill/quill.js"]"></script>
    <script src="@Assets["rich-text-editor.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    private static readonly InteractiveServerRenderMode InteractiveServerWithoutPrerendering =
        new(prerender: false);

    // The headless PDF renderer has a short-lived request token, not a browser
    // authentication cookie for a subsequent SignalR circuit. Keep print routes
    // server-rendered so that token is evaluated on the request that renders it.
    private IComponentRenderMode? PageRenderMode =>
        IsInspectionPrintRoute || !HttpContext.AcceptsInteractiveRouting()
            ? null
            : InteractiveServerWithoutPrerendering;

    private bool IsInspectionPrintRoute =>
        HttpContext.Request.Path.StartsWithSegments("/inspections")
        && HttpContext.Request.Path.Value?.EndsWith("/print", StringComparison.OrdinalIgnoreCase) == true;
}
