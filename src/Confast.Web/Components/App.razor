@using Confast.Web.Features.Navigation
@using Confast.Web.Features.Inspections
@inject AppearancePreferenceService AppearancePreferences
@inject ILogger<App> Logger

<!DOCTYPE html>
<html lang="en" data-appearance-mode="@appearance.ModeName" data-accent-color="@appearance.AccentColor"
      data-theme="@(appearance.Mode == AppearanceMode.System ? null : appearance.ModeName)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script src="@Assets["theme.js"]"></script>
    <ResourcePreloader />
    <link rel="icon" type="image/png" href="@Assets["images/conformance-favicon.png"]" />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <link rel="stylesheet" href="@Assets["lib/quill/quill.snow.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["navigation.css"]" />
    <link rel="stylesheet" href="@Assets["Confast.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["chat-time.js"]"></script>
    <script src="@Assets["chat-gifs.js"]"></script>
    <script src="@Assets["profile-picture-editor.js"]"></script>
    <script src="@Assets["presence.js"]"></script>
    <script src="@Assets["navigation-drawer.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["master-print-drop.js"]"></script>
    <script src="@Assets["criteria-reorder.js"]"></script>
    <script src="@Assets["inspection-print-options.js"]"></script>
    <script type="module" src="@Assets["date-input-tab-navigation.js"]"></script>
    <script src="@Assets["lib/quill/quill.js"]"></script>
    <script src="@Assets["rich-text-editor.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    private static readonly InteractiveServerRenderMode InteractiveServerWithoutPrerendering =
        new(prerender: false);

    private AppearancePreference appearance = AppearancePreference.Default;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext.User.Identity?.IsAuthenticated != true
            || HttpContext.User.Identity.AuthenticationType == InspectionPrintRenderAuthenticationHandler.SchemeName)
            return;

        // Resolve the account before emitting the document head, including on
        // static routes such as the logout confirmation.
        try { appearance = await AppearancePreferences.LoadAsync(HttpContext.User, HttpContext.RequestAborted); }
        catch (AuthorizationDeniedException) { }
        catch (Npgsql.NpgsqlException exception)
        {
            Logger.LogWarning(exception, "Could not load appearance preferences for this request.");
        }
    }

    // The headless PDF renderer has a short-lived request token, not a browser
    // authentication cookie for a subsequent SignalR circuit. Keep print routes
    // server-rendered so that token is evaluated on the request that renders it.
    private IComponentRenderMode? PageRenderMode =>
        IsInspectionPrintRoute || !HttpContext.AcceptsInteractiveRouting()
            ? null
            : InteractiveServerWithoutPrerendering;

    private bool IsInspectionPrintRoute =>
        HttpContext.Request.Path.StartsWithSegments("/inspections")
        && HttpContext.Request.Path.Value?.EndsWith("/print", StringComparison.OrdinalIgnoreCase) == true;
}
